@model depiR5gp.ViewModels.RegisterVM

@{
    ViewData["Title"] = "Create Account";
    ViewData["HideFooter"] = true;
    ViewData["HideAIAssistant"] = true;
    ViewData["NoScroll"] = true;

    var initialRole = string.Equals(
        Model?.Role,
        "Chef",
        StringComparison.OrdinalIgnoreCase
    ) ? "chef" : "customer";
}

<!-- Split-Screen Auth Layout -->
<div x-data="{
    registerRole: '@initialRole',
    showPassword: false,
    loading: false
    }"
     class="flex flex-col md:flex-row w-full h-full flex-1 min-h-0 overflow-hidden bg-[var(--color-bg)] text-[var(--color-text)] transition-colors duration-200">

    <!-- Left Panel: Register Form -->
    <div class="flex-1 flex flex-col items-center justify-center p-6 sm:p-8 lg:p-10 bg-[var(--color-bg)] overflow-y-auto min-h-0">

        <div class="w-full max-w-md flex flex-col gap-4 sm:gap-5 animate-in fade-in slide-in-from-bottom-4 duration-700 my-auto">

            <!-- Brand Badge -->
            <div class="mb-0.5">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--color-primary-light)] border border-[var(--color-primary)]/20 text-[var(--color-primary)] text-xs font-bold tracking-wider shadow-2xs">

                    <svg class="w-4 h-4"
                         xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path>
                        <path d="M7 2v20"></path>
                        <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path>

                    </svg>

                    <span>HOMECHEF</span>
                </div>
            </div>

            <!-- Header -->
            <div class="text-left space-y-1">

                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text)]">
                    Create an account
                </h1>

                <p class="text-sm text-[var(--color-text-muted)]">
                    Join our community as a customer or home chef
                </p>

            </div>

            <!-- Validation Summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly"
                     class="p-3.5 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900/50 text-xs text-red-600 dark:text-red-400 font-medium">
                </div>
            }

            <!-- Register Form -->
            <form asp-controller="Account"
                  asp-action="Register"
                  method="post"
                @@submit="loading = true"
                  class="space-y-3">

                <!-- Hidden Role -->
                <input type="hidden"
                       asp-for="Role"
                       :value="registerRole === 'chef' ? 'Chef' : 'Customer'" />

                <!-- Account Type -->
                <div class="space-y-1">

                    <label class="block text-xs font-semibold text-[var(--color-text)]">
                        Account Type
                    </label>

                    <div class="grid grid-cols-2 p-1 bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl text-xs font-semibold">

                        <button type="button"
                            @@click="registerRole = 'customer'"
                                :class="registerRole === 'customer'
                            ? 'bg-[var(--color-primary)] text-white shadow-xs font-bold'
                            : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                                class="py-1.5 px-3 rounded-lg transition-all cursor-pointer text-center">

                            Customer

                        </button>

                        <button type="button"
                            @@click="registerRole = 'chef'"
                                :class="registerRole === 'chef'
                            ? 'bg-[var(--color-primary)] text-white shadow-xs font-bold'
                            : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                                class="py-1.5 px-3 rounded-lg transition-all cursor-pointer text-center">

                            Home Chef

                        </button>

                    </div>
                </div>

                <!-- First Name & Last Name -->
                <div class="grid grid-cols-2 gap-3">

                    <!-- First Name -->
                    <div class="space-y-1">

                        <label asp-for="FirstName"
                               class="block text-xs font-semibold text-[var(--color-text)]">
                            First Name
                        </label>

                        <input asp-for="FirstName"
                               type="text"
                               placeholder="e.g. Sara"
                               autocomplete="given-name"
                               class="flex h-10 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] px-3.5 py-2 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus-visible:outline-none focus-visible:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]/25 transition-colors shadow-2xs font-medium"
                               required />

                        <span asp-validation-for="FirstName"
                              class="text-xs font-medium text-red-500 mt-0.5 block">
                        </span>

                    </div>

                    <!-- Last Name -->
                    <div class="space-y-1">

                        <label asp-for="LastName"
                               class="block text-xs font-semibold text-[var(--color-text)]">
                            Last Name
                        </label>

                        <input asp-for="LastName"
                               type="text"
                               placeholder="e.g. Ahmed"
                               autocomplete="family-name"
                               class="flex h-10 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] px-3.5 py-2 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus-visible:outline-none focus-visible:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]/25 transition-colors shadow-2xs font-medium"
                               required />

                        <span asp-validation-for="LastName"
                              class="text-xs font-medium text-red-500 mt-0.5 block">
                        </span>

                    </div>

                </div>

                <!-- Username -->
                <div class="space-y-1">

                    <label asp-for="UserName"
                           class="block text-xs font-semibold text-[var(--color-text)]">
                        Username
                    </label>

                    <input asp-for="UserName"
                           type="text"
                           placeholder="sara_ahmed"
                           autocomplete="username"
                           class="flex h-10 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] px-3.5 py-2 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus-visible:outline-none focus-visible:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]/25 transition-colors shadow-2xs font-medium"
                           required />

                    <span asp-validation-for="UserName"
                          class="text-xs font-medium text-red-500 mt-0.5 block">
                    </span>

                </div>

                <!-- Email -->
                <div class="space-y-1">

                    <label asp-for="Email"
                           class="block text-xs font-semibold text-[var(--color-text)]">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           type="email"
                           placeholder="sara@example.com"
                           autocomplete="email"
                           class="flex h-10 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] px-3.5 py-2 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus-visible:outline-none focus-visible:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]/25 transition-colors shadow-2xs font-medium"
                           required />

                    <span asp-validation-for="Email"
                          class="text-xs font-medium text-red-500 mt-0.5 block">
                    </span>

                </div>

                <!-- Phone Number -->
                <div class="space-y-1">

                    <label asp-for="PhoneNumber"
                           class="block text-xs font-semibold text-[var(--color-text)]">
                        Phone Number
                    </label>

                    <input asp-for="PhoneNumber"
                           type="tel"
                           placeholder="+20 100 000 0000"
                           autocomplete="tel"
                           class="flex h-10 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] px-3.5 py-2 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus-visible:outline-none focus-visible:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]/25 transition-colors shadow-2xs font-medium"
                           required />

                    <span asp-validation-for="PhoneNumber"
                          class="text-xs font-medium text-red-500 mt-0.5 block">
                    </span>

                </div>

                <!-- Address (Optional) -->
                <div class="space-y-1">

                    <label asp-for="Address"
                           class="block text-xs font-semibold text-[var(--color-text)]">

                        Address / Neighborhood

                        <span class="text-[var(--color-text-muted)] font-normal">
                            (Optional)
                        </span>

                    </label>

                    <input asp-for="Address"
                           type="text"
                           placeholder="e.g. Maadi, Cairo"
                           autocomplete="street-address"
                           class="flex h-10 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] px-3.5 py-2 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus-visible:outline-none focus-visible:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]/25 transition-colors shadow-2xs font-medium" />

                    <span asp-validation-for="Address"
                          class="text-xs font-medium text-red-500 mt-0.5 block">
                    </span>

                </div>

                <!-- Password -->
                <div class="space-y-1">

                    <label asp-for="Password"
                           class="block text-xs font-semibold text-[var(--color-text)]">
                        Password
                    </label>

                    <div class="relative flex items-center">

                        <input asp-for="Password"
                               :type="showPassword ? 'text' : 'password'"
                               placeholder="••••••••••••"
                               autocomplete="new-password"
                               class="flex h-10 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] px-3.5 py-2 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus-visible:outline-none focus-visible:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]/25 transition-colors shadow-2xs font-medium"
                               required />

                        <!-- Toggle Password Visibility -->
                        <button type="button"
                            @@click="showPassword = !showPassword"
                                :aria-pressed="showPassword"
                                aria-label="Toggle password visibility"
                                class="absolute inset-y-0 end-0 flex items-center justify-center w-11 text-[var(--color-text-muted)] hover:text-[var(--color-primary)] focus:outline-none transition-colors cursor-pointer rounded-e-xl">

                            <!-- Show Password Icon -->
                            <svg x-show="!showPassword"
                                 class="w-4 h-4"
                                 xmlns="http://www.w3.org/2000/svg"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                                <circle cx="12" cy="12" r="3"></circle>

                            </svg>

                            <!-- Hide Password Icon -->
                            <svg x-show="showPassword"
                                 style="display:none;"
                                 class="w-4 h-4"
                                 xmlns="http://www.w3.org/2000/svg"
                                 width="24"
                                 height="24"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                                <line x1="2" x2="22" y1="2" y2="22"></line>

                            </svg>

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="text-xs font-medium text-red-500 mt-0.5 block">
                    </span>

                </div>

                <!-- Submit Button -->
                <div class="pt-2">

                    <button type="submit"
                            :disabled="loading"
                            class="w-full h-11 inline-flex items-center justify-center rounded-xl bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] active:scale-[0.99] text-white text-sm font-bold uppercase tracking-wider transition-all duration-200 shadow-md shadow-[var(--color-primary)]/25 hover:shadow-lg hover:shadow-[var(--color-primary)]/35 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-60 cursor-pointer gap-2">

                        <!-- Loading Spinner -->
                        <svg x-show="loading"
                             style="display: none;"
                             class="mr-2 h-4 w-4 animate-spin text-white"
                             xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>

                        </svg>

                        <span x-text="loading ? 'Creating Account...' : 'Create Account'">
                            Create Account
                        </span>

                    </button>

                </div>

            </form>

            <!-- Sign In Link -->
            <p class="text-center text-sm text-[var(--color-text-muted)] pt-1">

                Already have an account?

                <a asp-controller="Account"
                   asp-action="Login"
                   class="font-semibold text-[var(--color-primary)] hover:underline ms-1">

                    Sign In

                </a>.

            </p>

        </div>

    </div>

    <!-- Right Panel: Image -->
    <div class="flex-1 relative overflow-hidden bg-[var(--color-surface-subtle)] select-none min-h-[300px] md:min-h-full">

        <img src="/icons/premium_photo-1700746098391-84d82ad82294.png"
             asp-append-version="true"
             alt="Culinary spread of authentic homemade food"
             class="absolute inset-0 h-full w-full object-cover object-center" />

        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-black/5 pointer-events-none"></div>

    </div>

</div>