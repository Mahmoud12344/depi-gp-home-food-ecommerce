@{
    ViewData["Title"] = "Create Account - HomeChef";
}
@* TODO [Backend]: @model RegisterViewModel (maps to depiR5gp.Models.Users.AppUser) *@

<main class="w-full min-h-[calc(100vh-180px)] py-12 px-4 sm:px-6 lg:px-8 flex items-center justify-center bg-[var(--color-bg)]">
    <div class="w-full max-w-xl bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
        <div class="text-center space-y-2">
            <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                <span>Back to HomeChef</span>
            </a>
            <h1 class="text-2xl font-bold uppercase tracking-tight text-[var(--color-text)]">Create Your Account</h1>
            <p class="text-xs text-[var(--color-text-muted)]">Join Cairo's verified home-cooked culinary community</p>
        </div>

        <form method="post" asp-controller="Account" asp-action="Register" class="space-y-4 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="FirstName" class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">First Name</label>
                    <input id="FirstName"
                           name="FirstName"
                           type="text"
                           required
                           placeholder="Tamer"
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                </div>
                <div>
                    <label for="LastName" class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Last Name</label>
                    <input id="LastName"
                           name="LastName"
                           type="text"
                           required
                           placeholder="Zaki"
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="Email" class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Email Address</label>
                    <input id="Email"
                           name="Email"
                           type="email"
                           required
                           placeholder="tamer.zaki@example.com"
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                </div>
                <div>
                    <label for="PhoneNumber" class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Phone Number</label>
                    <input id="PhoneNumber"
                           name="PhoneNumber"
                           type="tel"
                           required
                           placeholder="+20 100 234 5678"
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                </div>
            </div>

            <div>
                <label for="Address" class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Primary Address (Neighborhood &amp; Street)</label>
                <input id="Address"
                       name="Address"
                       type="text"
                       required
                       placeholder="Villa 12, Road 250, Degla, Maadi, Cairo"
                       class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
            </div>

            <div>
                <label for="Role" class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Account Type</label>
                <select id="Role"
                        name="Role"
                        required
                        class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium">
                    <option value="Customer">Customer — Order Home-Cooked Dishes</option>
                    <option value="Chef">Home Chef — Apply to Open a Domestic Kitchen</option>
                </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="Password" class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Password</label>
                    <input id="Password"
                           name="Password"
                           type="password"
                           required
                           placeholder="••••••••"
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                </div>
                <div>
                    <label for="ConfirmPassword" class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Confirm Password</label>
                    <input id="ConfirmPassword"
                           name="ConfirmPassword"
                           type="password"
                           required
                           placeholder="••••••••"
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                </div>
            </div>

            <button type="submit"
                    class="w-full py-3 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs">
                Create Account
            </button>
        </form>

        <div class="pt-4 border-t border-[var(--color-border-light)] text-center text-xs text-[var(--color-text-muted)]">
            Already have a HomeChef account?
            <a href="/Account/Login" class="font-bold text-[var(--color-primary)] hover:underline ms-1">Sign In</a>
        </div>
    </div>
</main>
