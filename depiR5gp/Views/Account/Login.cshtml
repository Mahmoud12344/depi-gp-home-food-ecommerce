@{
    ViewData["Title"] = "Sign In - HomeChef";
}
@* TODO [Backend]: @model LoginViewModel *@

<main class="w-full min-h-[calc(100vh-180px)] py-12 px-4 sm:px-6 lg:px-8 flex items-center justify-center bg-[var(--color-bg)]">
    <div class="w-full max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
        <div class="text-center space-y-2">
            <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                <span>Back to HomeChef</span>
            </a>
            <h1 class="text-2xl font-bold uppercase tracking-tight text-[var(--color-text)]">Welcome Back</h1>
            <p class="text-xs text-[var(--color-text-muted)]">Sign in to order fresh domestic meals or manage your kitchen</p>
        </div>

        <form method="post" asp-controller="Account" asp-action="Login" class="space-y-4 text-xs">
            <div>
                <label for="Email" class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Email Address</label>
                <input id="Email"
                       name="Email"
                       type="email"
                       required
                       placeholder="you@example.com"
                       class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
            </div>

            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label for="Password" class="font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Password</label>
                    <a href="/Account/ForgotPassword" class="font-semibold text-[var(--color-primary)] hover:underline">Forgot password?</a>
                </div>
                <input id="Password"
                       name="Password"
                       type="password"
                       required
                       placeholder="••••••••"
                       class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
            </div>

            <div class="flex items-center justify-between pt-1">
                <label class="inline-flex items-center gap-2 cursor-pointer text-[var(--color-text)] font-medium">
                    <input type="checkbox" name="RememberMe" value="true" class="rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-0" />
                    <span>Remember me on this device</span>
                </label>
            </div>

            <button type="submit"
                    class="w-full py-3 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs">
                Sign In
            </button>
        </form>

        <div class="pt-4 border-t border-[var(--color-border-light)] text-center text-xs text-[var(--color-text-muted)]">
            Don't have an account yet?
            <a href="/Account/Register" class="font-bold text-[var(--color-primary)] hover:underline ms-1">Create an Account</a>
        </div>
    </div>
</main>
