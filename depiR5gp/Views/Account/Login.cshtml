@model depiR5gp.ViewModels.LoginVM
@{
    ViewData["Title"] = "Sign In";
    ViewData["HideFooter"] = true;
    ViewData["HideAIAssistant"] = true;
}

<!-- Split-Screen Auth Layout: Warm Brown Brand Theme with Full Dark Mode Support -->
<div x-data="{ 
        email: '@(Model?.Email ?? "")', 
        password: '', 
        showPassword: false, 
        loading: false 
    }" 
    class="flex flex-col md:flex-row w-full bg-[var(--color-bg)] text-[var(--color-text)] transition-colors duration-200"
    style="min-height: calc(100vh - 80px);">

    <!-- Left Panel: Form -->
    <div class="flex-1 flex flex-col items-center justify-center p-6 sm:p-10 lg:p-14 bg-[var(--color-bg)]">
        <div class="w-full max-w-md flex flex-col gap-6 animate-in fade-in slide-in-from-bottom-4 duration-700">
            
            <!-- Brand Badge -->
            <div class="mb-1">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--color-primary-light)] border border-[var(--color-primary)]/20 text-[var(--color-primary)] text-xs font-bold tracking-wider shadow-2xs">
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path>
                        <path d="M7 2v20"></path>
                        <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path>
                    </svg>
                    <span>HOMECHEF</span>
                </div>
            </div>

            <!-- Header -->
            <div class="text-left space-y-1">
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text)]">
                    Welcome back!
                </h1>
                <p class="text-sm text-[var(--color-text-muted)]">
                    Sign in by entering your information below
                </p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900/50 text-xs text-red-600 dark:text-red-400 font-medium"></div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" @@submit="loading = true" class="space-y-4">
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Email Field -->
                <div class="space-y-1.5">
                    <label asp-for="Email" class="block text-xs font-semibold text-[var(--color-text)]">
                        Email Address
                    </label>
                    <input asp-for="Email"
                           type="text"
                           x-model="email"
                           placeholder="email@example.com"
                           autocomplete="username"
                           :disabled="loading"
                           class="flex h-11 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] px-3.5 py-2 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus-visible:outline-none focus-visible:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]/25 disabled:cursor-not-allowed disabled:opacity-50 transition-colors shadow-2xs font-medium"
                           required />
                    <span asp-validation-for="Email" class="text-xs font-medium text-red-500 mt-1 block"></span>
                </div>

            <!-- Password Field -->
            <div class="space-y-1.5">
                <label asp-for="Password" class="block text-xs font-semibold text-[var(--color-text)]">
                    Password
                </label>
                <div class="relative flex items-center">
                    <input asp-for="Password"
                           :type="showPassword ? 'text' : 'password'"
                           x-model="password"
                           placeholder="••••••••••••"
                           autocomplete="current-password"
                           :disabled="loading"
                           class="flex h-11 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] px-3.5 py-2 text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus-visible:outline-none focus-visible:border-[var(--color-primary)] focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]/25 disabled:cursor-not-allowed disabled:opacity-50 transition-colors shadow-2xs font-medium"
                           required />
                    
                    <!-- Toggle Password Visibility -->
                    <button type="button" 
                            @@click="showPassword = !showPassword" 
                            :aria-pressed="showPassword"
                            aria-label="Toggle password visibility"
                            class="absolute inset-y-0 end-0 flex items-center justify-center w-11 text-[var(--color-text-muted)] hover:text-[var(--color-primary)] focus:outline-none transition-colors cursor-pointer rounded-e-xl">
                        <svg x-show="!showPassword" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg x-show="showPassword" style="display:none;" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                            <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                            <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                            <line x1="2" x2="22" y1="2" y2="22"></line>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-xs font-medium text-red-500 mt-1 block"></span>
            </div>

                <!-- Utilities (Remember Me & Forgot Password) -->
                <div class="flex items-center justify-between pt-1">
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                        <input asp-for="RememberMe"
                               type="checkbox"
                               :disabled="loading"
                               class="h-4 w-4 rounded-sm border border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)] accent-[var(--color-primary)] cursor-pointer" />
                        <span class="text-xs font-medium text-[var(--color-text)]">
                            Remember Me
                        </span>
                    </label>
                    <a asp-controller="Account" asp-action="ForgotPassword" class="text-xs font-semibold text-[var(--color-primary)] hover:underline transition-colors">
                        Forgotten Password?
                    </a>
                </div>

                <!-- Continue Button -->
                <div class="pt-2">
                    <button type="submit"
                            :disabled="loading"
                            class="w-full h-11 inline-flex items-center justify-center rounded-xl bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] active:scale-[0.99] text-white text-sm font-bold uppercase tracking-wider transition-all duration-200 shadow-md shadow-[var(--color-primary)]/25 hover:shadow-lg hover:shadow-[var(--color-primary)]/35 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-60 cursor-pointer gap-2">
                        <svg x-show="loading" style="display: none;" class="mr-2 h-4 w-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
                        </svg>
                        <span x-text="loading ? 'Signing in...' : 'Continue'">Continue</span>
                    </button>
                </div>
            </form>

            <p class="text-center text-sm text-[var(--color-text-muted)] pt-1">
                Don't have an account? 
                <a asp-controller="Account" asp-action="Register" class="font-semibold text-[var(--color-primary)] hover:underline ms-1">
                    Create one here
                </a>.
            </p>
        </div>
    </div>

    <!-- Right Panel: Image (Always Visible & Stretched) -->
    <div class="flex-1 relative overflow-hidden bg-[var(--color-surface-subtle)] select-none min-h-[300px] md:min-h-full">
        <img src="/icons/premium_photo-1700746098391-84d82ad82294.png"
             asp-append-version="true"
             alt="Culinary spread of authentic homemade food"
             class="absolute inset-0 h-full w-full object-cover object-center" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-black/5 pointer-events-none"></div>

    </div>

</div>

@* ==============================================================================
   PREVIOUS LOGIN VIEW (PRESERVED & COMMENTED OUT AS REQUESTED)
   ==============================================================================
<div x-data="{ email: '@(Model?.Email ?? "")', password: '' }" class="w-full min-h-[80vh] py-12 px-4 flex items-center justify-center">
    <!-- Main Two-Column Card -->
    <div class="w-full max-w-4xl bg-[var(--color-card-bg)] rounded-3xl shadow-xl overflow-hidden flex flex-col md:flex-row">

        <!-- Left Column: Form -->
        <div class="w-full md:w-1/2 p-8 sm:p-12 flex flex-col justify-center">

            <h2 class="text-2xl font-bold text-center mb-8 text-[var(--color-primary)] tracking-wide">
                User Login
            </h2>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="mb-4 p-3.5 rounded-2xl bg-[var(--color-error-light)] border border-[var(--color-error)]/30 text-xs text-[var(--color-error)] font-medium"></div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" class="space-y-5">
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Username Input -->
                <div>
                    <input asp-for="Email"
                           type="text"
                           x-model="email"
                           placeholder="Username"
                           class="w-full text-sm p-4 text-center bg-gray-100 dark:bg-neutral-800 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border-none rounded-full focus:ring-2 focus:ring-[var(--color-primary)] focus:outline-hidden font-semibold transition-all"
                           required />
                    <span asp-validation-for="Email" class="text-[11px] text-[var(--color-error)] mt-1 block text-center"></span>
                    
                    <div class="flex items-center justify-center gap-2 mt-2 text-[10px] text-[var(--color-text-muted)]">
                        <span>Demo:</span>
                        <button type="button" @@click="email = 'amina.chef@example.com'" class="text-[var(--color-primary)] hover:underline">amina</button>
                        <span>·</span>
                        <button type="button" @@click="email = 'karim.admin@homechef.eg'" class="text-[var(--color-primary)] hover:underline">karim</button>
                    </div>
                </div>

                <!-- Password Input -->
                <div>
                    <input asp-for="Password"
                           type="password"
                           x-model="password"
                           placeholder="••••••••"
                           class="w-full text-sm p-4 text-center tracking-widest bg-gray-100 dark:bg-neutral-800 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border-none rounded-full focus:ring-2 focus:ring-[var(--color-primary)] focus:outline-hidden font-semibold transition-all"
                           required />
                    <span asp-validation-for="Password" class="text-[11px] text-[var(--color-error)] mt-1 block text-center"></span>
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="flex items-center justify-between px-4 text-xs font-semibold text-[var(--color-text-muted)]">
                    <div class="flex items-center gap-2">
                        <input asp-for="RememberMe"
                               type="checkbox"
                               class="rounded border-gray-300 text-[var(--color-primary)] focus:ring-[var(--color-primary)] cursor-pointer" />
                        <label asp-for="RememberMe" class="cursor-pointer select-none">
                            Remember
                        </label>
                    </div>
                    <a asp-controller="Account" asp-action="ForgotPassword"
                       class="hover:text-[var(--color-primary)] transition-colors">
                        Forgot Password?
                    </a>
                </div>

                <!-- Submit Button -->
                <button type="submit"
                        class="w-full mt-4 inline-flex items-center justify-center font-bold uppercase tracking-widest transition-all duration-200 cursor-pointer rounded-full text-sm px-6 py-4 bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] active:scale-[0.98] shadow-md hover:shadow-lg hover:shadow-[var(--color-primary)]/30">
                    SUBMIT
                </button>
            </form>

            <!-- Register Link (Replaces the top tabs for a cleaner look) -->
            <div class="mt-8 text-center text-xs text-[var(--color-text-muted)]">
                Don't have an account? 
                <a asp-controller="Account" asp-action="Register" class="text-[var(--color-primary)] font-bold hover:underline">Register</a>
            </div>
        </div>

        <!-- Right Column: Illustration -->
        <div class="md:flex md:w-1/2 p-8 items-center justify-center">
            <img src="/icons/auth-illustration.png" alt="Login Security Illustration" class="w-full max-w-sm object-contain drop-shadow-md" />
        </div>

    </div>
</div>
============================================================================== *@
