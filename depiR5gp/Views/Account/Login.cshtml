@model depiR5gp.ViewModels.LoginVM
@{
    ViewData["Title"] = "Sign In";
}
<!-- Views/Account/Login.cshtml -->
<!-- Source: home_chef/src/components/common/LoginModal.tsx (Views/Shared/Partials/_LoginModal.cshtml lines 142-214) -->

<div x-data="{ email: '@(Model?.Email ?? "")', password: '' }" class="w-full py-12 sm:py-16 px-4 flex items-center justify-center">
    <div class="relative w-full max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl shadow-2xl p-6 sm:p-8">

        <!-- Tabs -->
        <div class="flex border-b border-[var(--color-border)] mb-6">
            <a asp-controller="Account" asp-action="Login"
               class="flex-1 pb-3 text-sm font-bold uppercase tracking-wider text-center border-b-2 transition-colors cursor-pointer border-[var(--color-primary)] text-[var(--color-primary)]">
                Login
            </a>
            <a asp-controller="Account" asp-action="Register"
               class="flex-1 pb-3 text-sm font-bold uppercase tracking-wider text-center border-b-2 transition-colors cursor-pointer border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]">
                Register
            </a>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="mb-4 p-3.5 rounded-2xl bg-[var(--color-error-light)] border border-[var(--color-error)]/30 text-xs text-[var(--color-error)] font-medium"></div>
        }

        <!-- Login Form -->
        <form asp-controller="Account" asp-action="Login" method="post" class="space-y-4">
            <input type="hidden" asp-for="ReturnUrl" />

            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-[var(--color-text)] mb-1">
                    Email or Username
                </label>
                <input asp-for="Email"
                       type="text"
                       x-model="email"
                       placeholder="tamer.zaki@example.com or username"
                       class="w-full text-xs p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium"
                       required />
                <span asp-validation-for="Email" class="text-[11px] text-[var(--color-error)] mt-1 block"></span>
                @* PROTOTYPE-ONLY: BEGIN (Demo credential quick-fill pills — remove in production) *@
                <div class="flex items-center gap-2 mt-1.5 text-[10px] text-[var(--color-text-muted)]">
                    <span>Demo tip:</span>
                    <button type="button" @@click="email = 'amina.chef@example.com'" class="text-[var(--color-primary)] underline hover:opacity-80 cursor-pointer">
                        amina.chef&#64;...
                    </button>
                    <span>·</span>
                    <button type="button" @@click="email = 'karim.admin@homechef.eg'" class="text-[var(--color-primary)] underline hover:opacity-80 cursor-pointer">
                        karim.admin&#64;...
                    </button>
                </div>
                @* PROTOTYPE-ONLY: END *@
            </div>

            <div>
                <div class="flex items-center justify-between mb-1">
                    <label asp-for="Password" class="text-xs font-semibold text-[var(--color-text)]">
                        Password
                    </label>
                    <a asp-controller="Account" asp-action="ForgotPassword"
                       class="text-[11px] text-[var(--color-primary)] hover:underline cursor-pointer">
                        Forgot password?
                    </a>
                </div>
                <input asp-for="Password"
                       type="password"
                       x-model="password"
                       placeholder="••••••••"
                       class="w-full text-xs p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium"
                       required />
                <span asp-validation-for="Password" class="text-[11px] text-[var(--color-error)] mt-1 block"></span>
            </div>

            <div class="flex items-center gap-2">
                <input asp-for="RememberMe"
                       type="checkbox"
                       class="rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)] cursor-pointer" />
                <label asp-for="RememberMe" class="text-xs text-[var(--color-text-muted)] cursor-pointer select-none">
                    Remember me
                </label>
            </div>

            <button type="submit"
                    class="w-full inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] active:scale-[0.98] focus-visible:outline-[var(--color-primary)] hover:shadow-lg hover:shadow-[var(--color-primary)]/20">
                <span>Sign In</span>
            </button>
        </form>
    </div>
</div>
