@{
    ViewData["Title"] = "Account Recovery - Forgot Password";
}
<!-- Views/Account/ForgotPassword.cshtml -->
<!-- Source: Views/Shared/Partials/_ForgotPasswordModal.cshtml lines 26-76 (Subtask SCRUM-320) -->
<!-- TODO(backend): POST /Account/ForgotPassword with email generating reset token and dispatching email recovery instructions -->

<div class="w-full py-12 sm:py-16 px-4 flex items-center justify-center">
    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl space-y-6">

        <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#lock"></use></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[var(--color-text)]">
                        Account Recovery
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]">
                        Enter your email to receive recovery instructions
                    </p>
                </div>
            </div>
        </div>

        <!-- Step 1: Request Reset Link -->
        <div class="space-y-4">
            <form method="post" action="/Account/ForgotPassword" class="space-y-4 text-xs">
                @Html.AntiForgeryToken()
                <div>
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                        Registered Email Address
                    </label>
                    <input type="email"
                           name="Email"
                           required
                           placeholder="you@example.com"
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                </div>

                <button type="submit"
                        class="w-full py-3 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-sm">
                    <span>Send Password Reset Link</span>
                </button>
            </form>

            <div class="text-center pt-2">
                <a href="/Account/Login"
                   class="text-xs text-[var(--color-primary)] hover:underline font-semibold cursor-pointer">
                    Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>
