@{
    ViewData["Title"] = "Forgot Password - HomeChef";
}
@* TODO [Backend]: @model ForgotPasswordViewModel *@

<main class="w-full min-h-[calc(100vh-180px)] py-12 px-4 sm:px-6 lg:px-8 flex items-center justify-center bg-[var(--color-bg)]">
    <div class="w-full max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
        <div class="text-center space-y-2">
            <a href="/Account/Login" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors">
                <span>&larr; Back to Sign In</span>
            </a>
            <h1 class="text-2xl font-bold uppercase tracking-tight text-[var(--color-text)]">Reset Your Password</h1>
            <p class="text-xs text-[var(--color-text-muted)]">Enter your account email and we will send you a password reset link</p>
        </div>

        <form method="post" asp-controller="Account" asp-action="ForgotPassword" class="space-y-4 text-xs">
            <div>
                <label for="Email" class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Registered Email Address</label>
                <input id="Email"
                       name="Email"
                       type="email"
                       required
                       placeholder="you@example.com"
                       class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
            </div>

            <button type="submit"
                    class="w-full py-3 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs">
                Send Reset Link
            </button>
        </form>

        <div class="pt-4 border-t border-[var(--color-border-light)] text-center text-xs text-[var(--color-text-muted)]">
            Need help accessing your account?
            <a href="/Support" class="font-bold text-[var(--color-primary)] hover:underline ms-1">Contact Support</a>
        </div>
    </div>
</main>
