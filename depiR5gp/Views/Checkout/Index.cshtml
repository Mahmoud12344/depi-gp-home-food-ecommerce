@{
    ViewData["Title"] = "Checkout";
}
<!-- Views/Checkout/Index.cshtml -->
<!-- Ported from Views/Cart/Partials/_CheckoutPage.cshtml on main -->
<!-- TODO(backend): Integrate with Payment Gateway (e.g. Stripe, Paymob) and Order Placement POST action -->

<div x-data="{
    paymentMethod: 'card',
    stripeSimValue: '1',
    redeemPoints: false,
    promoCode: '',
    promoApplied: false,
    customerName: 'Tamer Zaki',
    customerPhone: '+20 100 234 5678',
    customerEmail: 'tamer.zaki@example.com',
    get loyaltyDiscount() {
        return this.redeemPoints ? 68 : 0;
    },
    get promoDiscount() {
        return this.promoApplied ? 50 : 0;
    },
    get grandTotal() {
        return Math.max(0, 510 - this.loyaltyDiscount - this.promoDiscount);
    }
}"
     class="w-full pb-24">

    <!-- Breadcrumb banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span>Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
                <a href="/Cart" class="hover:text-[var(--color-primary)] transition-colors cursor-pointer font-medium">Cart</a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
                <span class="text-[var(--color-text)] font-semibold">Checkout</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                Checkout &amp; Pickup
            </h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 leading-relaxed">
                Review pickup counter &amp; select payment method
            </p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
        <!-- TODO(backend): POST /Checkout saving Order, OrderItems, PaymentRecord, and redirecting to /Orders/Confirmation/{id} -->
        <form method="post" action="/Checkout" class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            @Html.AntiForgeryToken()
            <input type="hidden" name="paymentMethod" :value="paymentMethod" />
            <input type="hidden" name="redeemPoints" :value="redeemPoints" />

            <!-- Left Column: Form Details -->
            <div class="lg:col-span-7 space-y-8">
                <!-- 1. Contact Information -->
                <!-- TODO(backend): Pre-populate customer name, phone, and email from authenticated User Claims / CustomerProfile -->
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)] flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center text-xs">1</span>
                        <span>Contact Information</span>
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                        <div>
                            <label class="block font-semibold mb-1 text-[var(--color-text)]">Your Full Name</label>
                            <input type="text" name="customerName" required x-model="customerName"
                                   class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                        </div>
                        <div>
                            <label class="block font-semibold mb-1 text-[var(--color-text)]">Mobile Phone (for pickup calls)</label>
                            <input type="tel" name="customerPhone" required x-model="customerPhone"
                                   class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block font-semibold mb-1 text-[var(--color-text)]">Email Address</label>
                            <input type="email" name="customerEmail" required x-model="customerEmail"
                                   class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                        </div>
                    </div>
                </div>

                <!-- 2. Kitchen Pickup Details -->
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)] flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center text-xs">2</span>
                        <span>Direct Kitchen Pickup Counter</span>
                    </h2>
                    <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)] text-xs space-y-2">
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-[var(--color-primary)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#map-pin"></use></svg>
                            <div>
                                <span class="font-bold text-[var(--color-text)] block">Amina's Heritage Kitchen</span>
                                <span class="text-[var(--color-text-muted)]">Bldg 14, Road 9, Degla, Maadi, Cairo (Ground Floor Domestic Kitchen Gate)</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 text-emerald-700 dark:text-emerald-400 font-medium pt-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check-circle-2"></use></svg>
                            <span>Free direct kitchen counter pickup (0.00 EGP delivery)</span>
                        </div>
                    </div>
                </div>

                <!-- 3. Payment Method -->
                <!-- TODO(backend): Initialize Stripe PaymentIntent / Paymob session for Card payment, or register CashOnPickup transaction -->
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-7 shadow-xs space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)] flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center text-xs">3</span>
                        <span>Payment Method</span>
                    </h2>

                    <div class="space-y-3">
                        <!-- Card (Stripe Test Mode) -->
                        <div :class="paymentMethod === 'card' ? 'border-[var(--color-primary)] bg-[var(--color-card-bg)]' : 'border-[var(--color-border)]'"
                             class="border rounded-2xl p-4 transition-colors">
                            <label @@click="paymentMethod = 'card'" class="flex items-center justify-between cursor-pointer">
                                <div class="flex items-center gap-3">
                                    <div class="w-4 h-4 rounded-full border flex items-center justify-center"
                                         :class="paymentMethod === 'card' ? 'border-[var(--color-primary)]' : 'border-neutral-400'">
                                        <div x-show="paymentMethod === 'card'" class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></div>
                                    </div>
                                    <span class="text-xs font-bold uppercase text-[var(--color-text)]">Credit Card (Stripe Test Mode)</span>
                                </div>
                                <svg class="w-5 h-5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#credit-card"></use></svg>
                            </label>

                            @* PROTOTYPE-ONLY: BEGIN — Stripe Payment Outcome Simulator *@
                            <!-- Testing instructions buttons -->
                            <div x-show="paymentMethod === 'card'" class="mt-3.5 pt-3 border-t border-[var(--color-border-light)] text-xs text-[var(--color-text-muted)] space-y-2">
                                <p class="font-semibold text-[var(--color-text)]">Testing Instruction (Select simulation):</p>
                                <div class="grid grid-cols-3 gap-2">
                                    <button type="button" @@click="stripeSimValue = '1'"
                                            :class="stripeSimValue === '1' ? 'border-emerald-500 bg-emerald-100 text-emerald-950 dark:bg-emerald-950/90 dark:text-emerald-100' : 'border-[var(--color-border)]'"
                                            class="p-2.5 rounded-xl border text-[11px] font-bold text-center cursor-pointer transition-all">1: Approved</button>
                                    <button type="button" @@click="stripeSimValue = '2'"
                                            :class="stripeSimValue === '2' ? 'border-rose-500 bg-rose-100 text-rose-950 dark:bg-rose-950/90 dark:text-rose-100' : 'border-[var(--color-border)]'"
                                            class="p-2.5 rounded-xl border text-[11px] font-bold text-center cursor-pointer transition-all">2: Declined</button>
                                    <button type="button" @@click="stripeSimValue = '3'"
                                            :class="stripeSimValue === '3' ? 'border-amber-500 bg-amber-100 text-amber-950 dark:bg-amber-950/90 dark:text-amber-100' : 'border-[var(--color-border)]'"
                                            class="p-2.5 rounded-xl border text-[11px] font-bold text-center cursor-pointer transition-all">3: Gateway Error</button>
                                </div>
                            </div>
                            @* PROTOTYPE-ONLY: END *@
                        </div>

                        <!-- Cash On Pickup -->
                        <div :class="paymentMethod === 'cash' ? 'border-[var(--color-primary)] bg-[var(--color-card-bg)]' : 'border-[var(--color-border)]'"
                             class="border rounded-2xl p-4 transition-colors">
                            <label @@click="paymentMethod = 'cash'" class="flex items-center justify-between cursor-pointer">
                                <div class="flex items-center gap-3">
                                    <div class="w-4 h-4 rounded-full border flex items-center justify-center"
                                         :class="paymentMethod === 'cash' ? 'border-[var(--color-primary)]' : 'border-neutral-400'">
                                        <div x-show="paymentMethod === 'cash'" class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></div>
                                    </div>
                                    <span class="text-xs font-bold uppercase text-[var(--color-text)]">Cash On Pickup</span>
                                </div>
                                <svg class="w-5 h-5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#banknote"></use></svg>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Order Summary Card -->
            <div class="lg:col-span-5 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-7 shadow-xs space-y-6 lg:sticky lg:top-24">
                <h3 class="text-base font-bold uppercase tracking-tight text-[var(--color-text)]">
                    Order Summary
                </h3>

                <!-- Cart Items List preview -->
                <!-- TODO(backend): Loop through Model.Cart.Items -->
                <div class="divide-y divide-[var(--color-border-light)] text-xs space-y-2">
                    <!-- BEGIN SAMPLE -->
                    <div class="pt-2 flex items-center justify-between">
                        <div>
                            <span class="font-bold text-[var(--color-text)]">Baladi Duck Molokhia with Vermicelli Rice</span>
                            <span class="text-[var(--color-text-muted)] text-[11px]"> × 1</span>
                        </div>
                        <span class="font-semibold text-[var(--color-text)]">240.00 EGP</span>
                    </div>
                    <div class="pt-2 flex items-center justify-between">
                        <div>
                            <span class="font-bold text-[var(--color-text)]">Pigeon Stuffed with Spiced Freekeh</span>
                            <span class="text-[var(--color-text-muted)] text-[11px]"> × 1</span>
                        </div>
                        <span class="font-semibold text-[var(--color-text)]">270.00 EGP</span>
                    </div>
                    <!-- END SAMPLE -->
                </div>

                <!-- Loyalty Points & Promo Code (Visual-only with TODO(backend) per Rule 7) -->
                <!-- TODO(backend): Validate promo code and customer loyalty points redemption server-side -->
                <div class="space-y-3 pt-2 border-t border-[var(--color-border-light)] text-xs">
                    <label class="flex items-center justify-between p-3 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 cursor-pointer">
                        <div class="flex items-center gap-2.5">
                            <input type="checkbox" x-model="redeemPoints" class="rounded text-[var(--color-primary)] focus:ring-[var(--color-primary)]" />
                            <div>
                                <span class="font-bold text-amber-950 dark:text-amber-100 block">Redeem 340 Loyalty Points</span>
                                <span class="text-[10px] text-amber-800 dark:text-amber-300">Save 68.00 EGP on this order</span>
                            </div>
                        </div>
                        <span class="font-bold text-amber-900 dark:text-amber-200">-68.00 EGP</span>
                    </label>
                </div>

                <!-- Price breakdown -->
                <div class="border-t border-[var(--color-border)] pt-4 space-y-2 text-xs">
                    <div class="flex justify-between text-[var(--color-text-muted)]">
                        <span>Subtotal:</span>
                        <span>510.00 EGP</span>
                    </div>
                    <div x-show="redeemPoints" x-cloak class="flex justify-between text-amber-700 dark:text-amber-400 font-semibold">
                        <span>Loyalty Points Discount:</span>
                        <span>-68.00 EGP</span>
                    </div>
                    <div class="flex justify-between text-emerald-600 font-semibold">
                        <span>Pickup &amp; Handover Fee:</span>
                        <span>0.00 EGP (FREE)</span>
                    </div>
                    <div class="flex justify-between text-base font-bold text-[var(--color-primary)] border-t border-[var(--color-border-light)] pt-3">
                        <span>Total Payable:</span>
                        <span x-text="grandTotal.toFixed(2) + ' EGP'">510.00 EGP</span>
                    </div>
                </div>

                <button type="submit"
                        class="w-full inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer rounded-full text-xs md:text-sm px-8 py-3.5 gap-2.5 shadow-md bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] active:scale-[0.98]">
                    <span>Place Order &amp; Confirm Pickup</span>
                </button>
            </div>
        </form>
    </div>
</div>
