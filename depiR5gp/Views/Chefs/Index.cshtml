@model depiR5gp.Models.Chefs.ChefCatalogViewModel
@{
    ViewData["Title"] = "Verified Domestic Kitchens";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<!-- Views/Chefs/Index.cshtml -->
<!-- Ported from Views/Chefs/Partials/_BrowseChefs.cshtml on main -->
<!-- TODO(backend): Bind verified domestic chefs from database with optional filters for pickup neighborhood and kitchen search queries -->

<div x-data="{
    selectedArea: '@(Model.Filter.Area ?? "all")'
}"
     class="w-full pb-24">

    <!-- Breadcrumb banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span>Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#chevron-right"></use>
                </svg>
                <span class="text-[var(--color-text)] font-semibold">Home Chefs</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                Verified Domestic Kitchens
            </h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 max-w-2xl leading-relaxed">
                Explore vetted domestic chefs cooking authentic recipes in your neighborhood
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <!-- Filter bar (Plain GET Form) -->
        <form method="get" action="/Chefs" class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl shadow-xs">
            <input type="hidden" name="area" :value="selectedArea" />

            <!-- Area pills -->
            <!-- TODO(backend): Dynamically render distinct active pickup areas (e.g. Model.PickupNeighborhoods) -->
            <div class="flex items-center gap-2 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
                <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] shrink-0">Area:</span>
                <button type="submit"
                        @@click="selectedArea = 'all'"
                        :class="selectedArea === 'all' ? 'bg-[var(--color-primary)] text-white shadow-xs' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800'"
                        class="text-xs px-3.5 py-1.5 rounded-full font-semibold whitespace-nowrap transition-all cursor-pointer">All</button>
                @foreach (var a in Model.Areas)
                {
                    <button type="submit"
                            @@click="selectedArea = '@a.Value'"
                            :class="selectedArea === '@a.Value' ? 'bg-[var(--color-primary)] text-white shadow-xs' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800'"
                            class="text-xs px-3.5 py-1.5 rounded-full font-semibold whitespace-nowrap transition-all cursor-pointer">@a.Name.Split(',')[0]</button>
                }
            </div>

            <!-- Search box -->
            <div class="relative w-full sm:w-64 shrink-0">
                <svg class="w-4 h-4 text-[var(--color-primary)] absolute start-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#search"></use></svg>
                <input type="text"
                       name="search"
                       value="@Model.Filter.Search"
                       placeholder="Search chef or kitchen..."
                       class="w-full text-xs ps-9 pe-3 py-2 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-full focus:border-[var(--color-primary)] focus:outline-hidden font-medium shadow-2xs" />
            </div>
        </form>

        <!-- Chef List View -->
        <!-- TODO(backend): Loop through verified domestic chefs (Model.Chefs); bind Chef.Id, PhotoUrl, IsVerified, IsAvailable, KitchenName, ChefName, Rating, ReviewCount, Bio, PickupArea, and WorkingHours -->
        <div class="chef-list-container">
            @foreach (var c in Model.Chefs)
            {
                <div onclick="window.location.href='/Chefs/Details/@c.Id'" class="chef-list-item" x-data="{ favorited: false }">
                    <!-- Chef Thumbnail -->
                    <div class="chef-list-thumb">
                        @if (!string.IsNullOrEmpty(c.PhotoUrl))
                        {
                            <img src="@c.PhotoUrl"
                                 alt="@c.KitchenName"
                                 loading="lazy" />
                        }

                        <!-- Favorite Heart Button -->
                        <button type="button"
                                @@click.stop="favorited = !favorited"
                                class="chef-list-fav"
                                title="Favorite this chef">
                            <svg class="w-4 h-4" :class="favorited ? 'fill-rose-500 text-rose-500' : 'stroke-current'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <use href="#heart"></use>
                            </svg>
                        </button>
                    </div>

                    <!-- Chef Body / Details -->
                    <div class="chef-list-body">
                        <!-- Header Row: Title, Subtitle, Rating & Status -->
                        <div class="chef-list-header">
                            <div>
                                <h3 class="chef-list-title">@c.KitchenName</h3>
                                <p class="chef-list-subtitle">Chef @c.ChefName</p>
                            </div>
                            <div class="chef-list-badges">
                                <div class="chef-list-rating">
                                    <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24"><use href="#star"></use></svg>
                                    <span class="font-bold">@c.Rating.ToString("0.0", inv)</span>
                                    <span class="opacity-75">(@c.ReviewCount)</span>
                                </div>
                                <span class="chef-list-status">
                                    <span class="chef-list-pulse"></span>
                                    <span>Taking Orders Now</span>
                                </span>
                            </div>
                        </div>

                        <!-- Bio Description -->
                        <p class="chef-list-bio">@c.Bio</p>

                        <!-- Location & Hours Meta -->
                        <div class="chef-list-meta">
                            @if (c.Area != null)
                            {
                                <div class="chef-list-meta-item">
                                    <svg class="w-3.5 h-3.5 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#map-pin"></use></svg>
                                    <span>@c.AreaName</span>
                                </div>
                            }
                            <div class="chef-list-meta-item">
                                <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#clock"></use></svg>
                                <span>12:00 PM - 9:00 PM (Sat - Thu)</span>
                            </div>
                        </div>

                        <!-- Action Buttons Row -->
                        <div class="chef-list-actions">
                            <a href="/Chefs/Details/@c.Id" @@click.stop class="chef-menu-btn chef-list-btn-primary">
                                <span>View Kitchen Menu</span>
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <use href="#arrow-right"></use>
                                </svg>
                            </a>

                            <a href="/Chat" @@click.stop class="chef-list-btn-chat">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <use href="#message-circle"></use>
                                </svg>
                                <span>Chat with Chef</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>