                    <use href="#chevron-right"></use>
                </svg>
                <span class="text-[var(--color-text)] font-semibold" x-text="$store.app.language === 'ar' ? 'الطهاة' : 'Home Chefs'">Home Chefs</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]"
