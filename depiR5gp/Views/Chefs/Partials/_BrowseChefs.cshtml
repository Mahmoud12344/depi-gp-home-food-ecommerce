        @* TODO [Backend]: Filter verified domestic chefs via GET /Chefs?area=&q= *@
        <form method="get" asp-controller="Chefs" asp-action="Index" class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl shadow-xs">
            <div class="flex items-center gap-2 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
                <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] shrink-0"
                      x-text="$store.app.language === 'ar' ? 'المنطقة:' : 'Area:'">Area:</span>
                <select name="area" class="text-xs px-3.5 py-2 rounded-full font-semibold bg-[var(--color-surface-subtle)] text-[var(--color-text)] border border-[var(--color-border)] focus:border-[var(--color-primary)] focus:outline-hidden cursor-pointer">
                    <option value="all">All Areas</option>
                    <option value="maadi">Maadi, Cairo</option>
                    <option value="zamalek">Zamalek, Cairo</option>
                    <option value="heliopolis">Heliopolis, Cairo</option>
                </select>
            </div>

            <!-- Search box -->
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <div class="relative w-full sm:w-64 shrink-0">
                    <svg class="w-4 h-4 text-[var(--color-primary)] absolute start-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#search"></use></svg>
                    <input type="text"
