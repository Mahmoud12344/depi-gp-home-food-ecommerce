                           :placeholder="$store.app.language === 'ar' ? 'ابحث باسم الشيف أو المطبخ...' : 'Search chef or kitchen...'"
                           class="w-full text-xs ps-9 pe-3 py-2 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-full focus:border-[var(--color-primary)] focus:outline-hidden font-medium shadow-2xs" />
