            kitchenName: 'Hajjah Fatma Bakery',
            kitchenNameAr: 'مخبوزات الحاجة فاطمة',
            chefName: 'Hajjah Fatma',
            chefNameAr: 'الحاجة فاطمة الدسوقي',
            rating: 4.8,
            reviewCount: 145,
            bio: 'Authentic country flaky feteer and Egyptian breakfast baking with fresh cream.',
            bioAr: 'فطير فلاحي مورق ومخبوزات تقليدية بالسمن الطبيعي والقشطة البلدي الطازجة.',
            pickupArea: 'Heliopolis, Cairo',
            pickupAreaAr: 'مصر الجديدة، القاهرة',
            workingHours: '9:00 AM - 6:00 PM',
            workingHoursAr: '9:00 ص - 6:00 م',
            isAvailable: true,
            photoUrl: 'https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=800&auto=format&fit=crop&q=80'
        }
    ],
    get filteredChefs() {
        return this.chefs.filter(chef => {
            if (this.selectedArea !== 'all' && !chef.pickupArea.toLowerCase().includes(this.selectedArea.toLowerCase())) return false;
            if (this.searchTerm.trim()) {
                const q = this.searchTerm.toLowerCase().trim();
                return chef.kitchenName.toLowerCase().includes(q) ||
                       chef.kitchenNameAr.includes(q) ||
                       chef.chefName.toLowerCase().includes(q) ||
                       chef.chefNameAr.includes(q);
            }
            return true;
        });
    }
}"
