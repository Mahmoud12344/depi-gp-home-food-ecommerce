@*
  Edit Chef Profile Modal Partial
  Backlog Subtask: SCRUM-30 (Story SCRUM-27)
  Epic: SCRUM-22 Chef Profile
  TODO [Backend]: Bind to ChefDashboardController.Profile(ChefProfile model)
*@
<div x-cloak
     x-show="editProfileOpen"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

    <div @@click.away="editProfileOpen = false"
         class="relative w-full max-w-2xl bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-2xl max-h-[90vh] overflow-y-auto">

        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)] mb-6">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chef-hat"></use></svg>
                </div>
                <div>
                    <h3 class="text-base sm:text-lg font-bold uppercase tracking-wide text-[var(--color-text)]">
                        Edit Chef &amp; Kitchen Profile
                    </h3>
                    <p class="text-[11px] text-[var(--color-text-muted)]">
                        Update kitchen bio, operating schedule, and pickup counter location
                    </p>
                </div>
            </div>
            <button type="button" @@click="editProfileOpen = false" class="p-1 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
            </button>
        </div>

        <!-- Edit Form (Standard MVC POST Form) -->
        @* TODO [Backend]: POST ChefDashboardController.Profile(ChefProfile model) *@
        <form method="post" asp-controller="ChefDashboard" asp-action="Profile" class="space-y-6 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="modal-kitchen-name" class="block font-semibold mb-1 text-[var(--color-text)]">Kitchen Name (English)</label>
                    <input id="modal-kitchen-name" name="KitchenName" type="text" required value="Amina's Heritage Kitchen"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div>
                    <label for="modal-kitchen-name-ar" class="block font-semibold mb-1 text-[var(--color-text)]">Kitchen Name (Arabic)</label>
                    <input id="modal-kitchen-name-ar" name="KitchenNameAr" type="text" required value="مطبخ أمينة التراثي"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
            </div>

            <!-- Bio -->
            <div class="space-y-4">
                <div>
                    <label for="modal-bio" class="block font-semibold mb-1 text-[var(--color-text)]">Chef Bio &amp; Culinary Heritage (English)</label>
                    <textarea id="modal-bio" name="Bio" rows="3" required
                              class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden leading-relaxed">Cooking traditional Egyptian baladi recipes inherited from my grandmother in Upper Egypt, using 100% pure baladi ghee and farm-fresh poultry.</textarea>
                </div>
                <div>
                    <label for="modal-bio-ar" class="block font-semibold mb-1 text-[var(--color-text)]">Chef Bio (Arabic)</label>
                    <textarea id="modal-bio-ar" name="BioAr" rows="3" required
                              class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden leading-relaxed">أطبخ أشهى الأكلات والوصفات المصرية التراثية المتوارثة عن جدتي من صعيد مصر، بالسمن البلدي الفلاحي والطيور الطازجة يومياً.</textarea>
                </div>
            </div>

            <!-- Photo URL & Pickup Area -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="modal-area" class="block font-semibold mb-1 text-[var(--color-text)]">Pickup Neighborhood Area (Public)</label>
                    <select id="modal-area" name="PickupArea"
                            class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden">
                        <option value="Maadi" selected>Maadi (المعادي)</option>
                        <option value="Zamalek">Zamalek (الزمالك)</option>
                        <option value="New Cairo">New Cairo (القاهرة الجديدة)</option>
                        <option value="Nasr City">Nasr City (مدينة نصر)</option>
                        <option value="Heliopolis">Heliopolis (مصر الجديدة)</option>
                        <option value="Dokki">Dokki (الدقي)</option>
                    </select>
                </div>
                <div>
                    <label for="modal-photo" class="block font-semibold mb-1 text-[var(--color-text)]">Profile Photo URL</label>
                    <input id="modal-photo" name="PhotoUrl" type="url" required value="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=300&auto=format&fit=crop&q=80"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
            </div>

            <!-- Exact Pickup Street Address -->
            <div>
                <label for="modal-address" class="block font-semibold mb-1 text-[var(--color-text)]">
                    Exact Pickup Counter Address (Disclosed to customer after order confirmation)
                </label>
                <input id="modal-address" name="Address" type="text" required value="Bldg 14, Road 9, Degla, Maadi, Cairo (Ground Floor Gate)"
                       class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border)]">
                <button type="button" @@click="editProfileOpen = false"
                        class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit"
                        class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                    Save Profile Changes
                </button>
            </div>
        </form>
    </div>
</div>
