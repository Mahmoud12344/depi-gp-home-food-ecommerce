@*
  Edit Menu Item Modal Partial
  Backlog Subtask: SCRUM-46 (Story SCRUM-43)
  Epic: SCRUM-31 Menu Management
  TODO [Backend]: Bind to MenuManagementController.Edit(int id, Dish dish)
*@
<div x-cloak
     x-show="editDishModalOpen"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

    <div @@click.away="editDishModalOpen = false"
         class="relative w-full max-w-3xl bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-2xl max-h-[90vh] overflow-y-auto">

        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)] mb-6">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#edit-3"></use></svg>
                </div>
                <div>
                    <h3 class="text-base sm:text-lg font-bold uppercase tracking-wide text-[var(--color-text)]">
                        Edit Menu Dish
                    </h3>
                    <p class="text-[11px] text-[var(--color-text-muted)]">
                        Update pricing, ingredients, prep time, or availability status
                    </p>
                </div>
            </div>
            <button type="button" @@click="editDishModalOpen = false" class="p-1 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
            </button>
        </div>

        <!-- Edit Form (Standard MVC POST Form) -->
        @* TODO [Backend]: POST MenuManagementController.Edit(Dish model) *@
        <form method="post" asp-controller="MenuManagement" asp-action="Edit" class="space-y-6 text-xs">
            <input type="hidden" name="Id" :value="editingDish?.id || 1" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="edit-dish-name" class="block font-semibold mb-1 text-[var(--color-text)]">Dish Title (English)</label>
                    <input id="edit-dish-name" name="Name" type="text" required :value="editingDish?.name"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div>
                    <label for="edit-dish-name-ar" class="block font-semibold mb-1 text-[var(--color-text)]">Dish Title (Arabic)</label>
                    <input id="edit-dish-name-ar" name="NameAr" type="text" required :value="editingDish?.nameAr"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label for="edit-dish-cat" class="block font-semibold mb-1 text-[var(--color-text)]">Dish Category</label>
                    <select id="edit-dish-cat" name="CategoryId"
                            class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden">
                        <option value="1">Traditional Egyptian (أكلات مصرية أصيلة)</option>
                        <option value="2">Tagines &amp; Casseroles (طواجن فرن بلدي)</option>
                        <option value="3">Stuffed &amp; Mahshi (محاشي ومحمرات)</option>
                        <option value="4">Grills &amp; Poultry (مشويات وطيور)</option>
                        <option value="5">Bakery &amp; Desserts (فطير ومخبوزات وحلويات)</option>
                    </select>
                </div>
                <div>
                    <label for="edit-dish-price" class="block font-semibold mb-1 text-[var(--color-text)]">Base Price (EGP)</label>
                    <input id="edit-dish-price" name="Price" type="number" step="5" min="10" required :value="editingDish?.price || 240"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div>
                    <label for="edit-dish-avail" class="block font-semibold mb-1 text-[var(--color-text)]">Availability Status</label>
                    <select id="edit-dish-avail" name="IsAvailable"
                            class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden">
                        <option value="true">Available for Orders</option>
                        <option value="false">Marked Unavailable</option>
                    </select>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border)]">
                <button type="button" @@click="editDishModalOpen = false"
                        class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit"
                        class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                    Save Dish Changes
                </button>
            </div>
        </form>
    </div>
</div>
