@*
  Delete Menu Item Confirmation Dialog Partial
  Backlog Subtask: SCRUM-51 (Story SCRUM-48)
  Epic: SCRUM-31 Menu Management
  TODO [Backend]: Soft-delete dish (Dish.IsArchived = true) via MenuManagementController.Delete(int Id)
*@
<div x-cloak
     x-show="deleteDishConfirmOpen"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

    <div @@click.away="deleteDishConfirmOpen = false"
         class="relative w-full max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-7 shadow-2xl space-y-5">

        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-600 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#trash-2"></use></svg>
            </div>
            <div>
                <h3 class="text-base font-bold uppercase tracking-tight text-[var(--color-text)]">
                    Confirm Dish Deletion
                </h3>
                <span class="text-xs text-[var(--color-text-muted)] block" x-text="deletingDish?.name || 'Selected Dish'"></span>
            </div>
        </div>

        <div class="p-3.5 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/50 rounded-2xl text-xs space-y-1.5 text-amber-900 dark:text-amber-200">
            <p class="font-bold flex items-center gap-1.5">
                <svg class="w-4 h-4 shrink-0 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#alert-triangle"></use></svg>
                <span>Active Orders Policy Notice:</span>
            </p>
            <p class="leading-relaxed text-[11px]">
                Deleting this dish sets <code>Dish.IsArchived = true</code> and removes it from public marketplace browse. Any already-accepted active orders remain valid for preparation.
            </p>
        </div>

        <!-- Action Buttons (Standard MVC POST Form) -->
        <form method="post" asp-controller="MenuManagement" asp-action="Index" class="flex items-center justify-end gap-3 pt-2">
            <input type="hidden" name="DeleteDishId" :value="deletingDish?.id || 1" />
            <button type="button" @@click="deleteDishConfirmOpen = false"
                    class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] text-xs font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                Cancel
            </button>
            <button type="submit"
                    class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                Yes, Delete Dish
            </button>
        </form>
    </div>
</div>
