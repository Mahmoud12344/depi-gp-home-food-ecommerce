@*
  Reject Order Modal Dialog Partial
  Backlog Subtask: SCRUM-81 (Story SCRUM-78)
  Epic: SCRUM-32 Chef Orders & Dashboard
  TODO [Backend]: Bind to ChefDashboardController.Orders(int OrderId, string NextStatus = "Rejected", string CancellationReason)
*@
<div x-cloak
     x-show="rejectOrderModalOpen"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

    <div @@click.away="rejectOrderModalOpen = false"
         class="relative w-full max-w-lg bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-7 shadow-2xl space-y-5">

        <div class="flex items-center gap-3 pb-3 border-b border-[var(--color-border-light)]">
            <div class="w-10 h-10 rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-600 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x-circle"></use></svg>
            </div>
            <div>
                <h3 class="text-base font-bold uppercase tracking-tight text-[var(--color-text)]">
                    Reject Order Request
                </h3>
                <p class="text-xs text-[var(--color-text-muted)]"
                   x-text="`Order #${rejectingOrder?.orderNumber || 'HC-2026-9042'} · ${rejectingOrder?.customerName || 'Nour El-Din'}`"></p>
            </div>
        </div>

        <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
            Select a verified reason to notify the customer immediately and trigger card authorization release:
        </p>

        <!-- Reject Form (Standard MVC POST Form) -->
        @* TODO [Backend]: Updates depiR5gp.Models.Orders.Order (Status = "Rejected", CancellationReason) *@
        <form method="post" asp-controller="ChefDashboard" asp-action="Orders" class="space-y-4 text-xs">
            <input type="hidden" name="OrderId" :value="rejectingOrder?.id || 102" />
            <input type="hidden" name="NextStatus" value="Rejected" />

            <div class="space-y-2.5">
                <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] cursor-pointer">
                    <input type="radio" name="CancellationReason" value="Kitchen at maximum capacity for this time slot" checked class="accent-[var(--color-primary)]" />
                    <span class="text-[var(--color-text)] font-medium">
                        Kitchen at maximum capacity for this time slot
                    </span>
                </label>

                <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] cursor-pointer">
                    <input type="radio" name="CancellationReason" value="Fresh baladi ingredients out of stock for today" class="accent-[var(--color-primary)]" />
                    <span class="text-[var(--color-text)] font-medium">
                        Fresh baladi ingredients out of stock for today
                    </span>
                </label>

                <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] cursor-pointer">
                    <input type="radio" name="CancellationReason" value="Kitchen counter closed early today" class="accent-[var(--color-primary)]" />
                    <span class="text-[var(--color-text)] font-medium">
                        Kitchen counter closed early today
                    </span>
                </label>

                <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] cursor-pointer">
                    <input type="radio" name="CancellationReason" value="Special customer instructions cannot be accommodated" class="accent-[var(--color-primary)]" />
                    <span class="text-[var(--color-text)] font-medium">
                        Special customer instructions cannot be accommodated
                    </span>
                </label>
            </div>

            <div>
                <label for="reject-courtesy-note" class="block font-semibold mb-1 text-[var(--color-text)]">Optional Customer Courtesy Note</label>
                <textarea id="reject-courtesy-note" name="CourtesyNote" rows="2" placeholder="e.g. Apologies, our freshly slaughtered duck order was fully reserved for tonight..."
                          class="w-full p-2.5 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-xl text-xs text-[var(--color-text)] focus:border-[var(--color-primary)] focus:outline-hidden"></textarea>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-[var(--color-border)]">
                <button type="button" @@click="rejectOrderModalOpen = false"
                        class="px-5 py-2 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] text-xs font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit"
                        class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold uppercase tracking-wider px-6 py-2 rounded-full transition-all shadow-xs cursor-pointer">
                    Confirm Rejection
                </button>
            </div>
        </form>
    </div>
</div>
