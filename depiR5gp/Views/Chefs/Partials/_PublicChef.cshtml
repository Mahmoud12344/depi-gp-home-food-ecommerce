                            <span x-text="$store.app.language === 'ar' ? 'المطبخ يستقبل الطلبات الآن' : 'Kitchen Accepting Orders'">Kitchen Accepting Orders</span>
                        </span>
                    </div>

                    <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed"
                       x-text="$store.app.language === 'ar' ? chef.bioAr : chef.bio"></p>

