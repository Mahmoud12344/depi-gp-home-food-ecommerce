                            <p class="text-sm text-[var(--color-primary)] font-semibold mt-0.5"
                               x-text="$store.app.language === 'ar' ? chef.chefNameAr : chef.chefName"></p>
                        </div>

                        <div class="flex items-center gap-2">
                            <button type="button"
                                    @@click="$store.app.toggleFavorite(chef.id)"
                                    class="p-2.5 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-text)] hover:text-rose-500 transition-colors cursor-pointer"
                                    title="Favorite chef">
                                <svg class="w-4 h-4" :class="$store.app.isFavorite(chef.id) ? 'fill-rose-500 text-rose-500' : 'stroke-current'" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#heart"></use></svg>
                            </button>
                            <a href="#messages"
                               class="inline-flex items-center gap-1.5 bg-transparent border-2 border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#message-circle"></use></svg>
                                <span x-text="$store.app.language === 'ar' ? 'محادثة الشيف' : 'Chat with Chef'">Chat with Chef</span>
                            </a>
                        </div>
                    </div>

                    <!-- Badges / Rating -->
                    <div class="flex flex-wrap items-center gap-4 text-xs">
                        <div class="flex items-center gap-1 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 px-3 py-1 rounded-full">
                            <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            <span class="font-bold text-amber-900 dark:text-amber-300">4.9</span>
                            <span class="text-amber-700 dark:text-amber-400">(124 <span x-text="$store.app.language === 'ar' ? 'تقييم' : 'reviews'">reviews</span>)</span>
                        </div>
                        <span class="inline-flex items-center gap-1.5 font-medium bg-emerald-100 text-emerald-900 dark:bg-emerald-950/50 dark:text-emerald-300 px-3 py-1 rounded-full">
