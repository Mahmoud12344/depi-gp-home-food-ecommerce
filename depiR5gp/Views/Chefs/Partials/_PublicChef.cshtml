                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-3 border-t border-[var(--color-border-light)] text-xs text-[var(--color-text)]">
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-[var(--color-primary)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#map-pin"></use></svg>
                            <div>
                                <span class="font-bold block text-[10px] uppercase text-[var(--color-text-muted)]"
                                      x-text="$store.app.language === 'ar' ? 'عنوان استلام الطلبات' : 'Kitchen Pickup Counter'">Kitchen Pickup Counter</span>
                                <span class="font-medium" x-text="chef.address">Villa 14, Road 9, Degla, Maadi, Cairo</span>
                            </div>
                        </div>
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-neutral-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#clock"></use></svg>
                            <div>
                                <span class="font-bold block text-[10px] uppercase text-[var(--color-text-muted)]"
                                      x-text="$store.app.language === 'ar' ? 'مواعيد العمل والاستلام' : 'Operating & Pickup Hours'">Operating & Pickup Hours</span>
                                <span class="font-medium" x-text="$store.app.language === 'ar' ? chef.workingHoursAr : chef.workingHours">12:00 PM - 9:00 PM (Sat - Thu)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex border-b border-[var(--color-border)] gap-6">
            <button type="button"
