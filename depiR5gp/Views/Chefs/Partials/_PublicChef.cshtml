                <span x-text="$store.app.language === 'ar' ? 'قائمة أطباق المطبخ' : 'Kitchen Menu'">Kitchen Menu</span> (2)
            </button>
            <button type="button"
                    @@click="activeTab = 'reviews'"
                    :class="activeTab === 'reviews' ? 'border-[var(--color-primary)] text-[var(--color-primary)]' : 'border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                    class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 cursor-pointer">
                <span x-text="$store.app.language === 'ar' ? 'تقييمات الزبائن' : 'Customer Reviews'">Customer Reviews</span> (1)
            </button>
            <button type="button"
                    @@click="activeTab = 'about'"
