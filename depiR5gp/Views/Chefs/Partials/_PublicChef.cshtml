        <!-- TODO [Backend]: Loop through Chef's published dishes (Model.ChefDishes or /api/chefs/{id}/dishes); render _DishCard for each dish -->
        <div x-show="activeTab === 'menu'">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <partial name="Partials/_DishCard" />
            </div>
        </div>

        <!-- Tab 2: Reviews -->
        <!-- TODO [Backend]: Loop through Chef.Reviews; bind ReviewerName, Rating, CommentText, CreatedAt, and VerifiedOrder flag -->
        <div x-show="activeTab === 'reviews'" class="space-y-4 max-w-3xl">
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-2xs space-y-2">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-xs text-[var(--color-text)]">Karim El-Gohary</span>
                    <div class="flex items-center text-[var(--color-star)]">
                        <template x-for="i in 5" :key="i">
                            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                        </template>
                    </div>
                </div>
                <p class="text-xs text-[var(--color-text)] leading-relaxed italic">
                    “The Molokhia with duck was outstanding. Truly authentic grandmother style recipe with generous portions and hot pickup ready on the minute.”
                </p>
                <span class="text-[10px] text-[var(--color-text-muted)] block" x-text="$store.app.language === 'ar' ? 'طلب موثق ومكتمل' : 'Verified Completed Order'">Verified Completed Order</span>
            </div>
        </div>

        <!-- Tab 3: About -->
        <!-- TODO [Backend]: Bind Chef.HygieneCertificates, domestic inspection summary, and culinary heritage narrative -->
        <div x-show="activeTab === 'about'" class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-6 sm:p-8 space-y-4 max-w-3xl">
            <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]"
                x-text="$store.app.language === 'ar' ? 'معايير الجودة وسلامة الغذاء' : 'Culinary Hygiene & Pure Ingredients'">
                Culinary Hygiene & Pure Ingredients
            </h3>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed"
               x-text="$store.app.language === 'ar' ? 'يلتزم هذا المطبخ المنزلي بجميع المعايير الصحية المعتمدة من المنصة. يتم استخدام اللحوم الطازجة المذبوحة محلياً، والسمن البلدي الفلاحي النقي بنسبة 100%، بدون أي دهون مهدرجة أو نكهات صناعية. جميع الوجبات يتم طهيها في أواني فخارية وأفران معقمة يومياً.' : 'This domestic kitchen complies with platform health inspection standards. Meals are cooked using only 100% baladi ghee, fresh butcher meats, and organic produce without artificial preservatives. Cookware is sanitized between every preparation.'">
                This domestic kitchen complies with platform health inspection standards. Meals are cooked using only 100% baladi ghee, fresh butcher meats, and organic produce without artificial preservatives. Cookware is sanitized between every preparation.
            </p>
        </div>
    </div>
</div>

