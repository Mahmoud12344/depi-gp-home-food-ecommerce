        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-sm overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <!-- Kitchen Photo -->
                <div class="lg:col-span-4 relative h-64 sm:h-72 w-full rounded-2xl overflow-hidden shadow-md">
                    <img :src="chef.photoUrl"
                         :alt="chef.kitchenName"
