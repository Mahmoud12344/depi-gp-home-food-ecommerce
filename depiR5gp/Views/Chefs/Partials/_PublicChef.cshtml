                    <div class="absolute top-3.5 start-3.5 bg-white/95 dark:bg-neutral-900/90 backdrop-blur-xs text-[var(--color-text)] text-[11px] font-semibold px-3 py-1 rounded-full flex items-center gap-1.5 shadow-sm">
                        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check-circle-2"></use></svg>
                        <span x-text="$store.app.language === 'ar' ? 'مطبخ منزلي معتمد' : 'Verified Domestic Kitchen'">Verified Domestic Kitchen</span>
                    </div>
                </div>

                <!-- Details -->
                <div class="lg:col-span-8 space-y-5">
