<!-- TODO [Backend]: Bind public chef profile, published dishes menu, customer reviews, and hygiene credentials -->

<div x-data="{
    activeTab: 'menu',
    chef: {
        id: 'chef-1',
        kitchenName: 'Amina\'s Heritage Kitchen',
        kitchenNameAr: 'مطبخ أمينة التراثي',
        chefName: 'Chef Amina Mansour',
        chefNameAr: 'الشيف أمينة منصور',
        rating: 4.9,
        reviewCount: 124,
        bio: 'Family heirloom recipes prepared in an inspected domestic kitchen using 100% baladi ghee, fresh butchery and organic farm herbs.',
        bioAr: 'وصفات متوارثة من الأجداد تُحضر في مطبخ منزلي مرخص ومعتمد، باستخدام السمن البلدي الطبيعي بنسبة 100% واللحوم الطازجة والأعشاب العضوية.',
        pickupArea: 'Maadi, Cairo',
        pickupAreaAr: 'المعادي، القاهرة',
        address: 'Villa 14, Road 9, Degla, Maadi, Cairo',
        workingHours: '12:00 PM - 9:00 PM (Sat - Thu)',
        workingHoursAr: '12:00 م - 9:00 م (السبت - الخميس)',
        isAvailable: true,
        photoUrl: 'https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=800&auto=format&fit=crop&q=80'
    }
}"
