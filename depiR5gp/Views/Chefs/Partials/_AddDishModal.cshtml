@*
  Add Menu Item Modal Partial
  Backlog Subtasks: SCRUM-36 (Story SCRUM-33), SCRUM-61 (Story SCRUM-58)
  Epic: SCRUM-31 Menu Management
  TODO [Backend]: Bind to MenuManagementController.Create(Dish dish, List<DishOption> DishOptions)
*@
<div x-cloak
     x-show="addDishModalOpen"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

    <div @@click.away="addDishModalOpen = false"
         class="relative w-full max-w-3xl bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-2xl max-h-[90vh] overflow-y-auto">

        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)] mb-6">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
                </div>
                <div>
                    <h3 class="text-base sm:text-lg font-bold uppercase tracking-wide text-[var(--color-text)]">
                        Add New Dish to Kitchen Menu
                    </h3>
                    <p class="text-[11px] text-[var(--color-text-muted)]">
                        Configure dish titles, pricing, baladi ingredients, and preset customization options
                    </p>
                </div>
            </div>
            <button type="button" @@click="addDishModalOpen = false" class="p-1 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
            </button>
        </div>

        <!-- Add Dish Form (Standard MVC POST Form) -->
        @* TODO [Backend]: Maps to depiR5gp.Models.Menu.Dish (Name, Description, CategoryId, CuisineId, Price, ImageUrl, IsAvailable) and DishOptions *@
        <form method="post" asp-controller="MenuManagement" asp-action="Create" class="space-y-6 text-xs">
            <!-- Names -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="add-dish-name" class="block font-semibold mb-1 text-[var(--color-text)]">Dish Title (English)</label>
                    <input id="add-dish-name" name="Name" type="text" required placeholder="e.g. Stuffed Pigeon with Spiced Freekeh"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div>
                    <label for="add-dish-name-ar" class="block font-semibold mb-1 text-[var(--color-text)]">Dish Title (Arabic)</label>
                    <input id="add-dish-name-ar" name="NameAr" type="text" required placeholder="مثال: حمام محشي بالفريك البلدي المحمر"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
            </div>

            <!-- Descriptions -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="add-dish-desc" class="block font-semibold mb-1 text-[var(--color-text)]">Description &amp; Heritage Spices (English)</label>
                    <textarea id="add-dish-desc" name="Description" rows="2" required placeholder="Slow-roasted domestic pigeon seasoned with coriander..."
                              class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden"></textarea>
                </div>
                <div>
                    <label for="add-dish-desc-ar" class="block font-semibold mb-1 text-[var(--color-text)]">Description &amp; Heritage Spices (Arabic)</label>
                    <textarea id="add-dish-desc-ar" name="DescriptionAr" rows="2" required placeholder="حمام بلدي محشو بالفريك المفلفل مع سمن بلدي..."
                              class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden"></textarea>
                </div>
            </div>

            <!-- Category, Price, Prep Time -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label for="add-dish-category" class="block font-semibold mb-1 text-[var(--color-text)]">Dish Category</label>
                    <select id="add-dish-category" name="CategoryId"
                            class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden">
                        <option value="1">Traditional Egyptian (أكلات مصرية أصيلة)</option>
                        <option value="2">Tagines &amp; Casseroles (طواجن فرن بلدي)</option>
                        <option value="3">Stuffed &amp; Mahshi (محاشي ومحمرات)</option>
                        <option value="4">Grills &amp; Poultry (مشويات وطيور)</option>
                        <option value="5">Bakery &amp; Desserts (فطير ومخبوزات وحلويات)</option>
                    </select>
                </div>
                <div>
                    <label for="add-dish-price" class="block font-semibold mb-1 text-[var(--color-text)]">Base Price (EGP)</label>
                    <input id="add-dish-price" name="Price" type="number" step="5" min="10" value="180" required
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div>
                    <label for="add-dish-prep" class="block font-semibold mb-1 text-[var(--color-text)]">Prep Time (Minutes)</label>
                    <input id="add-dish-prep" name="PrepTimeMinutes" type="number" step="5" min="15" max="300" value="45" required
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
            </div>

            <!-- Image URL & Initial Availability -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
                <div class="sm:col-span-8">
                    <label for="add-dish-image" class="block font-semibold mb-1 text-[var(--color-text)]">Dish Photo URL</label>
                    <input id="add-dish-image" name="ImageUrl" type="url" required value="https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div class="sm:col-span-4 flex items-center gap-3 sm:pt-6">
                    <input id="add-dish-avail" name="IsAvailable" type="checkbox" value="true" checked class="w-4 h-4 rounded accent-[var(--color-primary)] cursor-pointer" />
                    <label for="add-dish-avail" class="font-bold text-xs text-emerald-600 cursor-pointer">Available Immediately</label>
                </div>
            </div>

            <!-- Preset Customization Options Builder (Alpine strictly used for dynamic row addition/removal) -->
            <div class="space-y-4 pt-4 border-t border-[var(--color-border-light)]">
                <div class="flex items-center justify-between">
                    <div>
                        <h4 class="font-bold uppercase tracking-wider text-[var(--color-text)] flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#sliders"></use></svg>
                            <span>Customization &amp; Preset Option Groups</span>
                        </h4>
                        <p class="text-[11px] text-[var(--color-text-muted)]">
                            Add single-choice or multi-choice groups with optional price surcharges
                        </p>
                    </div>
                    <button type="button" @@click="addOptionGroup()"
                            class="px-3.5 py-1.5 bg-[var(--color-primary-light)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white rounded-full font-bold uppercase text-[11px] transition-colors cursor-pointer">
                        + Add Option Group
                    </button>
                </div>

                <template x-for="(group, gIdx) in dishForm.optionGroups" :key="gIdx">
                    <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)] space-y-3">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-2">
                                <input type="text" required x-model="group.title" :name="`OptionGroups[${gIdx}].GroupName`" placeholder="Group Title (e.g. Rice Selection)"
                                       class="p-2 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg font-bold text-xs" />
                                <div class="flex items-center gap-2">
                                    <select x-model="group.type" :name="`OptionGroups[${gIdx}].SelectionType`" class="p-2 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs font-medium">
                                        <option value="radio">Single Choice (Radio)</option>
                                        <option value="checkbox">Multi Choice (Checkboxes)</option>
                                    </select>
                                    <label class="flex items-center gap-1.5 text-[11px] cursor-pointer whitespace-nowrap">
                                        <input type="checkbox" x-model="group.required" :name="`OptionGroups[${gIdx}].IsRequired`" value="true" class="rounded accent-[var(--color-primary)]" />
                                        <span>Required</span>
                                    </label>
                                </div>
                            </div>
                            <button type="button" @@click="removeOptionGroup(gIdx)" class="text-rose-600 hover:text-rose-800 text-[11px] font-bold cursor-pointer self-end sm:self-center">
                                Delete Group
                            </button>
                        </div>

                        <div class="space-y-2 pt-2 border-t border-[var(--color-border-light)]/60">
                            <template x-for="(opt, oIdx) in group.options" :key="oIdx">
                                <div class="flex items-center gap-2">
                                    <input type="text" required x-model="opt.name" :name="`OptionGroups[${gIdx}].Options[${oIdx}].Name`" placeholder="Option Name (e.g. Vermicelli Rice)"
                                           class="flex-1 p-1.5 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs" />
                                    <div class="flex items-center gap-1 w-32 shrink-0">
                                        <span class="text-[11px] text-[var(--color-text-muted)]">+EGP</span>
                                        <input type="number" step="5" min="0" x-model.number="opt.extraPrice" :name="`OptionGroups[${gIdx}].Options[${oIdx}].ExtraPrice`" placeholder="0"
                                               class="w-full p-1.5 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs font-bold" />
                                    </div>
                                    <button type="button" @@click="removeOptionItem(gIdx, oIdx)" class="p-1 text-neutral-400 hover:text-rose-600 cursor-pointer">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                                    </button>
                                </div>
                            </template>
                            <button type="button" @@click="addOptionItem(gIdx)" class="text-[var(--color-primary)] hover:underline font-bold text-[11px] pt-1 inline-flex items-center gap-1 cursor-pointer">
                                <span>+ Add Choice Item</span>
                            </button>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border)]">
                <button type="button" @@click="addDishModalOpen = false"
                        class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit"
                        class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                    Save &amp; Publish Dish
                </button>
            </div>
        </form>
    </div>
</div>
