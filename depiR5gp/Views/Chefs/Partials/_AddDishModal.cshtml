@*
  Add Menu Item Modal Partial
  Backlog Subtasks: SCRUM-36 (Story SCRUM-33), SCRUM-61 (Story SCRUM-58)
  Epic: SCRUM-31 Menu Management
*@
<div x-cloak
     x-show="addDishModalOpen"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

    <div @@click.away="addDishModalOpen = false"
         class="relative w-full max-w-3xl bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-2xl max-h-[90vh] overflow-y-auto">

        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)] mb-6">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
                </div>
                <div>
                    <h3 class="text-base sm:text-lg font-bold uppercase tracking-wide text-[var(--color-text)]"
                        x-text="$store.app.language === 'ar' ? 'إضافة طبق جديد لقائمة المطبخ' : 'Add New Dish to Kitchen Menu'">
                        Add New Dish to Kitchen Menu
                    </h3>
                    <p class="text-[11px] text-[var(--color-text-muted)]"
                       x-text="$store.app.language === 'ar' ? 'أدخل اسم الطبق، الوصف، السعر، وخيارات الإضافات والمكونات' : 'Configure dish titles, pricing, baladi ingredients, and preset customization options'">
                        Configure dish titles, pricing, baladi ingredients, and preset customization options
                    </p>
                </div>
            </div>
            <button type="button" @@click="addDishModalOpen = false" class="p-1 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
            </button>
        </div>

        <!-- Add Dish Form -->
        <!-- TODO [Backend]: POST /api/chef/dishes with CreateDishDto, handle image upload, store presets options in DishOptionGroups -->
        <form @@submit.prevent="saveNewDish()" class="space-y-6 text-xs">
            <!-- Names -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]"
                           x-text="$store.app.language === 'ar' ? 'اسم الطبق (بالإنجليزية)' : 'Dish Title (English)'">Dish Title (English)</label>
                    <input type="text" required x-model="dishForm.name" placeholder="e.g. Stuffed Pigeon with Spiced Freekeh"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]"
                           x-text="$store.app.language === 'ar' ? 'اسم الطبق (بالعربية)' : 'Dish Title (Arabic)'">Dish Title (Arabic)</label>
                    <input type="text" required x-model="dishForm.nameAr" placeholder="مثال: حمام محشي بالفريك البلدي المحمر"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
            </div>

            <!-- Descriptions -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]"
                           x-text="$store.app.language === 'ar' ? 'الوصف ومكونات الطبق (بالإنجليزية)' : 'Description & Heritage Spices (English)'">Description (English)</label>
                    <textarea rows="2" required x-model="dishForm.description" placeholder="Slow-roasted domestic pigeon seasoned with coriander..."
                              class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden"></textarea>
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]"
                           x-text="$store.app.language === 'ar' ? 'الوصف ومكونات الطبق (بالعربية)' : 'Description & Heritage Spices (Arabic)'">Description (Arabic)</label>
                    <textarea rows="2" required x-model="dishForm.descriptionAr" placeholder="حمام بلدي محشو بالفريك المفلفل مع سمن بلدي..."
                              class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden"></textarea>
                </div>
            </div>

            <!-- Category, Price, Prep Time -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]"
                           x-text="$store.app.language === 'ar' ? 'تصنيف المطبخ' : 'Dish Category'">Category</label>
                    <select x-model="dishForm.category"
                            class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden">
                        <option value="Traditional Egyptian">Traditional Egyptian (أكلات مصرية أصيلة)</option>
                        <option value="Tagines & Casseroles">Tagines &amp; Casseroles (طواجن فرن بلدي)</option>
                        <option value="Stuffed & Mahshi">Stuffed &amp; Mahshi (محاشي ومحمرات)</option>
                        <option value="Grills & Poultry">Grills &amp; Poultry (مشويات وطيور)</option>
                        <option value="Bakery & Desserts">Bakery &amp; Desserts (فطير ومخبوزات وحلويات)</option>
                    </select>
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]"
                           x-text="$store.app.language === 'ar' ? 'السعر الأساسي (ج.م)' : 'Base Price (EGP)'">Base Price (EGP)</label>
                    <input type="number" step="5" min="10" required x-model.number="dishForm.price"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]"
                           x-text="$store.app.language === 'ar' ? 'وقت الطهي المتوقع (دقائق)' : 'Prep Time (Minutes)'">Prep Time (Mins)</label>
                    <input type="number" step="5" min="15" max="300" required x-model.number="dishForm.prepTime" placeholder="45"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
            </div>

            <!-- Image URL & Initial Availability -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
                <div class="sm:col-span-8">
                    <label class="block font-semibold mb-1 text-[var(--color-text)]"
                           x-text="$store.app.language === 'ar' ? 'رابط صورة الطبق' : 'Dish Photo URL'">Dish Photo URL</label>
                    <input type="url" required x-model="dishForm.image" placeholder="https://images.unsplash.com/..."
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div class="sm:col-span-4 flex items-center justify-between sm:justify-start gap-3 sm:pt-6">
                    <button type="button"
                            @@click="dishForm.isAvailable = !dishForm.isAvailable"
                            class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors cursor-pointer"
                            :class="dishForm.isAvailable ? 'bg-emerald-500' : 'bg-neutral-300 dark:bg-neutral-700'">
                        <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-xs"
                              :class="dishForm.isAvailable ? ($store.app.language === 'ar' ? '-translate-x-6' : 'translate-x-6') : 'translate-x-1'"></span>
                    </button>
                    <span class="font-bold text-xs"
                          :class="dishForm.isAvailable ? 'text-emerald-600' : 'text-neutral-400'"
                          x-text="dishForm.isAvailable ? ($store.app.language === 'ar' ? 'متاح للطلب فوراً' : 'Available Immediately') : ($store.app.language === 'ar' ? 'غير متوفر حالياً' : 'Currently Unavailable')">
                    </span>
                </div>
            </div>

            <!-- Preset Customization Options Builder (SCRUM-61) -->
            <div class="space-y-4 pt-4 border-t border-[var(--color-border-light)]">
                <div class="flex items-center justify-between">
                    <div>
                        <h4 class="font-bold uppercase tracking-wider text-[var(--color-text)] flex items-center gap-1.5"
                            x-text="$store.app.language === 'ar' ? 'خيارات وتخصيصات الطبق (Presets)' : 'Customization & Preset Option Groups'">
                            <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#sliders"></use></svg>
                            <span>Customization &amp; Preset Option Groups</span>
                        </h4>
                        <p class="text-[11px] text-[var(--color-text-muted)]"
                           x-text="$store.app.language === 'ar' ? 'أضف مجموعات خيارات إجبارية أو اختيارية مع زيادة السعر' : 'Add single-choice or multi-choice groups with optional price surcharges'">
                            Add single-choice or multi-choice groups with optional price surcharges
                        </p>
                    </div>
                    <button type="button" @@click="addOptionGroup()"
                            class="px-3.5 py-1.5 bg-[var(--color-primary-light)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white rounded-full font-bold uppercase text-[11px] transition-colors cursor-pointer">
                        <span x-text="$store.app.language === 'ar' ? '+ إضافة مجموعة خيارات' : '+ Add Option Group'">+ Add Option Group</span>
                    </button>
                </div>

                <!-- Option Groups List -->
                <template x-for="(group, gIdx) in dishForm.optionGroups" :key="gIdx">
                    <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)] space-y-3">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-2">
                                <input type="text" required x-model="group.title" placeholder="Group Title (e.g. Rice Selection)"
                                       class="p-2 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg font-bold text-xs" />
                                <div class="flex items-center gap-2">
                                    <select x-model="group.type" class="p-2 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs font-medium">
                                        <option value="radio">Single Choice (Choose One - Radio)</option>
                                        <option value="checkbox">Multi Choice (Choose Many - Checkboxes)</option>
                                    </select>
                                    <label class="flex items-center gap-1.5 text-[11px] cursor-pointer whitespace-nowrap">
                                        <input type="checkbox" x-model="group.required" class="rounded accent-[var(--color-primary)]" />
                                        <span x-text="$store.app.language === 'ar' ? 'إجباري' : 'Required'">Required</span>
                                    </label>
                                </div>
                            </div>
                            <button type="button" @@click="removeOptionGroup(gIdx)" class="text-rose-600 hover:text-rose-800 text-[11px] font-bold cursor-pointer self-end sm:self-center">
                                <span x-text="$store.app.language === 'ar' ? 'حذف المجموعة' : 'Delete Group'">Delete Group</span>
                            </button>
                        </div>

                        <!-- Option Items in this Group -->
                        <div class="space-y-2 pt-2 border-t border-[var(--color-border-light)]/60">
                            <template x-for="(opt, oIdx) in group.options" :key="oIdx">
                                <div class="flex items-center gap-2">
                                    <input type="text" required x-model="opt.name" placeholder="Option Name (e.g. Vermicelli Rice)"
                                           class="flex-1 p-1.5 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs" />
                                    <div class="flex items-center gap-1 w-32 shrink-0">
                                        <span class="text-[11px] text-[var(--color-text-muted)]">+EGP</span>
                                        <input type="number" step="5" min="0" x-model.number="opt.extraPrice" placeholder="0"
                                               class="w-full p-1.5 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs font-bold" />
                                    </div>
                                    <button type="button" @@click="removeOptionItem(gIdx, oIdx)" class="p-1 text-neutral-400 hover:text-rose-600 cursor-pointer">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                                    </button>
                                </div>
                            </template>
                            <button type="button" @@click="addOptionItem(gIdx)" class="text-[var(--color-primary)] hover:underline font-bold text-[11px] pt-1 inline-flex items-center gap-1 cursor-pointer">
                                <span>+ Add Choice Item</span>
                            </button>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border)]">
                <button type="button" @@click="addDishModalOpen = false"
                        class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                    <span x-text="$store.app.language === 'ar' ? 'إلغاء' : 'Cancel'">Cancel</span>
                </button>
                <button type="submit"
                        class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                    <span x-text="$store.app.language === 'ar' ? 'حفظ الطبق ونشره' : 'Save & Publish Dish'">Save &amp; Publish Dish</span>
                </button>
            </div>
        </form>
    </div>
</div>

