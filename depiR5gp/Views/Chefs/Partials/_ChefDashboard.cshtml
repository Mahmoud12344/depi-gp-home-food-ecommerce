    updateOrderStatus(orderId, nextStatus) {
        const ord = this.orders.find(o => o.id === orderId);
        if (ord) {
            ord.status = nextStatus;
            $store.app.showToast('success', 'Order status updated to ' + nextStatus + '. Customer notified.');
        }
    },

    saveChefProfile() {
        this.editProfileOpen = false;
        $store.app.showToast('success', $store.app.language === 'ar' ? 'تم تحديث بيانات المطبخ ومواعيد العمل بنجاح!' : 'Kitchen profile and operating hours updated successfully!');
    },

    saveNewDish() {
        const newId = 'd-' + (this.dishes.length + 1);
        this.dishes.push({
            id: newId,
            name: this.dishForm.name,
            nameAr: this.dishForm.nameAr,
            price: Number(this.dishForm.price),
            category: this.dishForm.category,
            isAvailable: this.dishForm.isAvailable
        });
        this.addDishModalOpen = false;
        $store.app.showToast('success', $store.app.language === 'ar' ? 'تمت إضافة الطبق الجديد لقائمة المطبخ!' : 'New dish published to your kitchen menu!');
    },

    openEditDish(dish) {
        this.editingDish = JSON.parse(JSON.stringify(dish));
        this.editDishModalOpen = true;
    },

    saveEditedDish() {
        if (!this.editingDish) return;
        const idx = this.dishes.findIndex(d => d.id === this.editingDish.id);
        if (idx !== -1) {
            this.dishes[idx] = JSON.parse(JSON.stringify(this.editingDish));
        }
        this.editDishModalOpen = false;
        $store.app.showToast('success', $store.app.language === 'ar' ? 'تم تحديث الطبق بنجاح!' : 'Dish updated successfully!');
    },

    openDeleteDish(dish) {
        this.deletingDish = dish;
        this.deleteDishConfirmOpen = true;
    },

    confirmDeleteDish() {
        if (!this.deletingDish) return;
        this.dishes = this.dishes.filter(d => d.id !== this.deletingDish.id);
        this.deleteDishConfirmOpen = false;
        $store.app.showToast('info', $store.app.language === 'ar' ? 'تم حذف الطبق من قائمة العرض.' : 'Dish removed from kitchen menu.');
    },

    openRejectOrder(ord) {
        this.rejectingOrder = ord;
        this.rejectOrderModalOpen = true;
    },

    confirmRejectOrder() {
        if (!this.rejectingOrder) return;
        this.rejectingOrder.status = 'Rejected';
        this.orderHistory.unshift({
            id: 'h-' + Date.now(),
            orderNumber: this.rejectingOrder.orderNumber,
            customerName: this.rejectingOrder.customerName,
            dishTitle: this.rejectingOrder.dishTitle,
            status: 'Rejected',
            totalPrice: this.rejectingOrder.totalPrice,
            completedAt: 'Just now'
        });
        this.orders = this.orders.filter(o => o.id !== this.rejectingOrder.id);
        this.rejectOrderModalOpen = false;
        $store.app.showToast('info', $store.app.language === 'ar' ? 'تم الاعتذار عن الطلب وإشعار الزبون.' : 'Order rejected. Customer notified and card authorization released.');
    },

    addOptionGroup() {
        this.dishForm.optionGroups.push({
            title: '',
            type: 'radio',
            required: false,
            options: [{ name: '', extraPrice: 0 }]
        });
    },

    removeOptionGroup(idx) {
        this.dishForm.optionGroups.splice(idx, 1);
    },

    addOptionItem(gIdx) {
        this.dishForm.optionGroups[gIdx].options.push({ name: '', extraPrice: 0 });
    },

    removeOptionItem(gIdx, oIdx) {
        this.dishForm.optionGroups[gIdx].options.splice(oIdx, 1);
    }
}"
