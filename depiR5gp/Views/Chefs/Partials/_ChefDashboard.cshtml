<!-- Views/Chefs/Partials/_ChefDashboard.cshtml -->
<!-- Source: home_chef/src/pages/ChefDashboardPage.tsx -->
<!-- TODO [Backend]: Connect to Chef Orders and Menu Web API endpoints -->

<div x-data="{
    activeTab: 'orders',
    isKitchenAvailable: true,
    orders: [
        {
            id: 'ord-101',
            orderNumber: 'HC-2026-9041',
            customerName: 'Tamer Zaki',
            dishTitle: 'Baladi Duck Molokhia with Vermicelli Rice (x1)',
            status: 'Preparing',
            totalPrice: 240,
            specialNote: 'Extra crispy duck skin please',
            pickupTime: '15:45 - 16:15'
        },
        {
            id: 'ord-102',
            orderNumber: 'HC-2026-9042',
            customerName: 'Nour El-Din',
            dishTitle: 'Oxtail Tagine with Baby Caramelized Onions (x1)',
            status: 'Pending',
            totalPrice: 310,
            specialNote: 'Mild garlic, extra bread',
            pickupTime: '16:30 - 17:00'
        }
    ],
    dishes: [
        { id: 'd-1', name: 'Baladi Duck Molokhia with Vermicelli Rice', nameAr: 'ملوخية بالبط البلدي مع أرز بالشعرية', price: 240, isAvailable: true, category: 'Traditional Egyptian' },
        { id: 'd-2', name: 'Pigeon Stuffed with Spiced Freekeh', nameAr: 'حمام محشي بالفريك البلدي المحمر', price: 270, isAvailable: true, category: 'Traditional Egyptian' }
    ],
    updateOrderStatus(orderId, nextStatus) {
        const ord = this.orders.find(o => o.id === orderId);
        if (ord) {
            ord.status = nextStatus;
            $store.app.showToast('success', 'Order status updated to ' + nextStatus + '. Customer notified.');
        }
    }
}"
     class="w-full pb-24">

    <!-- Breadcrumb banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="#home" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span x-text="$store.app.language === 'ar' ? 'الرئيسية' : 'Home'">Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" :class="$store.app.language === 'ar' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
                <span class="text-[var(--color-text)] font-semibold" x-text="$store.app.language === 'ar' ? 'لوحة تحكم الشيف' : 'Chef Portal'">Chef Portal</span>
            </nav>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]"
                        x-text="$store.app.language === 'ar' ? 'لوحة إدارة المطبخ والطلبات' : 'Kitchen Management Hub'">
                        Kitchen Management Hub
                    </h1>
                    <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 leading-relaxed"
                       x-text="$store.app.language === 'ar' ? 'مطبخ أمينة التراثي · المعادي، القاهرة' : 'Amina\'s Heritage Kitchen · Maadi, Cairo'">
                        Amina's Heritage Kitchen · Maadi, Cairo
                    </p>
                </div>

                <!-- Kitchen Availability Switch -->
                <div class="flex items-center gap-3 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-full px-4 py-2 shadow-2xs">
                    <span class="text-xs font-bold uppercase"
                          :class="isKitchenAvailable ? 'text-emerald-600' : 'text-rose-600'"
                          x-text="isKitchenAvailable ? ($store.app.language === 'ar' ? 'المطبخ يستقبل الطلبات' : 'Kitchen Open') : ($store.app.language === 'ar' ? 'المطبخ مغلق مؤقتاً' : 'Kitchen Paused')">
                        Kitchen Open
                    </span>
                    <button type="button"
                            @@click="isKitchenAvailable = !isKitchenAvailable; $store.app.showToast('info', isKitchenAvailable ? 'Kitchen is now taking orders.' : 'Kitchen orders paused.');"
                            class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors cursor-pointer"
                            :class="isKitchenAvailable ? 'bg-emerald-500' : 'bg-neutral-300 dark:bg-neutral-700'">
                        <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-xs"
                              :class="isKitchenAvailable ? ($store.app.language === 'ar' ? '-translate-x-6' : 'translate-x-6') : 'translate-x-1'"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <!-- 4 Metric Cards -->
        <!-- TODO [Backend]: Bind metric counts (Pending, Preparing, Ready, Net Wallet Earnings) from Chef repository/service -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1" x-text="$store.app.language === 'ar' ? 'طلبات بانتظار القبول' : 'Pending Acceptance'">Pending Acceptance</span>
                <span class="text-2xl sm:text-3xl font-bold text-amber-600">1</span>
            </div>
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1" x-text="$store.app.language === 'ar' ? 'قيد الطهي في الفرن' : 'In Preparation'">In Preparation</span>
                <span class="text-2xl sm:text-3xl font-bold text-purple-600">1</span>
            </div>
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1" x-text="$store.app.language === 'ar' ? 'جاهز للاستلام الفوري' : 'Ready for Pickup'">Ready for Pickup</span>
                <span class="text-2xl sm:text-3xl font-bold text-teal-600">0</span>
            </div>
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1" x-text="$store.app.language === 'ar' ? 'رصيد المحفظة الصافي' : 'Net Wallet Earnings'">Net Wallet Earnings</span>
                <span class="text-2xl sm:text-3xl font-bold text-[var(--color-primary)]">4,820.00 EGP</span>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex border-b border-[var(--color-border)] gap-6">
            <button type="button"
                    @@click="activeTab = 'orders'"
                    :class="activeTab === 'orders' ? 'border-[var(--color-primary)] text-[var(--color-primary)]' : 'border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                    class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 cursor-pointer">
                <span x-text="$store.app.language === 'ar' ? 'إدارة الطلبات الحية' : 'Live Kitchen Orders'">Live Kitchen Orders</span> (2)
            </button>
            <button type="button"
                    @@click="activeTab = 'menu'"
                    :class="activeTab === 'menu' ? 'border-[var(--color-primary)] text-[var(--color-primary)]' : 'border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                    class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 cursor-pointer">
                <span x-text="$store.app.language === 'ar' ? 'قائمة الأطباق والتوافر' : 'Menu & Dishes'">Menu & Dishes</span> (2)
            </button>
            <button type="button"
                    @@click="activeTab = 'wallet'"
                    :class="activeTab === 'wallet' ? 'border-[var(--color-primary)] text-[var(--color-primary)]' : 'border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                    class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 cursor-pointer">
                <span x-text="$store.app.language === 'ar' ? 'المحفظة والأرباح' : 'Wallet & Payouts'">Wallet & Payouts</span>
            </button>
        </div>

        <!-- Tab 1: Orders -->
        <!-- TODO [Backend]: Loop through active chef kitchen orders; bind OrderNumber, CustomerName, DishTitle, PickupTimeSlot, TotalPrice, SpecialNote, and Status -->
        <div x-show="activeTab === 'orders'" class="space-y-4">
            <template x-for="ord in orders" :key="ord.id">
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-6 shadow-xs flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
                    <div class="space-y-2">
                        <div class="flex items-center gap-3">
                            <span class="font-bold text-sm text-[var(--color-primary)]" x-text="'#' + ord.orderNumber"></span>
                            <span :class="{
                                'bg-amber-100 text-amber-900 border-amber-300 dark:bg-amber-950 dark:text-amber-100': ord.status === 'Pending',
                                'bg-purple-100 text-purple-900 border-purple-300 dark:bg-purple-950 dark:text-purple-100': ord.status === 'Preparing',
                                'bg-teal-100 text-teal-900 border-teal-300 dark:bg-teal-950 dark:text-teal-100': ord.status === 'Ready',
                                'bg-emerald-100 text-emerald-900 border-emerald-300 dark:bg-emerald-950 dark:text-emerald-100': ord.status === 'Completed'
                            }" class="text-xs px-2.5 py-1 rounded-full font-bold border" x-text="ord.status"></span>
                        </div>
                        <h4 class="font-bold text-base text-[var(--color-text)]" x-text="ord.dishTitle"></h4>
                        <div class="flex flex-wrap items-center gap-4 text-xs text-[var(--color-text-muted)]">
                            <span><strong class="text-[var(--color-text)]">Customer:</strong> <span x-text="ord.customerName"></span></span>
                            <span>·</span>
                            <span><strong class="text-[var(--color-text)]">Pickup Slot:</strong> <span x-text="ord.pickupTime"></span></span>
                            <span>·</span>
                            <span class="font-bold text-[var(--color-primary)]" x-text="ord.totalPrice.toFixed(2) + ' EGP'"></span>
                        </div>
                        <template x-if="ord.specialNote">
                            <p class="text-xs bg-[var(--color-surface-subtle)] p-2.5 rounded-xl border border-[var(--color-border-light)] text-[var(--color-text-muted)]">
                                <strong>Instructions:</strong> <span x-text="ord.specialNote"></span>
                            </p>
                        </template>
                    </div>

                    <!-- Action Transition Buttons -->
                    <!-- TODO [Backend]: POST /api/chef/orders/{id}/status to update OrderStatus in database and push live SignalR notification -->
                    <div class="flex flex-wrap items-center gap-2 w-full lg:w-auto">
                        <template x-if="ord.status === 'Pending'">
                            <button type="button"
                                    @@click="updateOrderStatus(ord.id, 'Preparing')"
                                    class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase px-4 py-2.5 rounded-full transition-all cursor-pointer">
                                <span x-text="$store.app.language === 'ar' ? 'قبول وبدء الطهي' : 'Accept & Start Cooking'">Accept & Start Cooking</span>
                            </button>
                        </template>
                        <template x-if="ord.status === 'Preparing'">
                            <button type="button"
                                    @@click="updateOrderStatus(ord.id, 'Ready')"
                                    class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold uppercase px-4 py-2.5 rounded-full transition-all cursor-pointer">
                                <span x-text="$store.app.language === 'ar' ? 'جاهز على الشباك للاستلام' : 'Mark Ready for Pickup'">Mark Ready for Pickup</span>
                            </button>
                        </template>
                        <template x-if="ord.status === 'Ready'">
                            <button type="button"
                                    @@click="updateOrderStatus(ord.id, 'Completed')"
                                    class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase px-4 py-2.5 rounded-full transition-all cursor-pointer">
                                <span x-text="$store.app.language === 'ar' ? 'تم تسليم الطلب' : 'Complete Handover'">Complete Handover</span>
                            </button>
                        </template>
                        <a href="#messages" class="border border-[var(--color-border)] hover:border-[var(--color-primary)] text-xs font-bold uppercase px-4 py-2.5 rounded-full transition-all">
                            <span x-text="$store.app.language === 'ar' ? 'محادثة الزبون' : 'Chat Customer'">Chat Customer</span>
                        </a>
                    </div>
                </div>
            </template>
        </div>

        <!-- Tab 2: Menu Items -->
        <!-- TODO [Backend]: Loop through Chef.Dishes; bind DishId, Name, Price, Category, and Availability toggle -->
        <div x-show="activeTab === 'menu'" class="space-y-4">
            <div class="flex items-center justify-between pb-2">
                <h3 class="text-base font-bold uppercase text-[var(--color-text)]"
                    x-text="$store.app.language === 'ar' ? 'أطباق المطبخ المعروضة' : 'Listed Kitchen Dishes'">
                    Listed Kitchen Dishes
                </h3>
                <button type="button"
                        @@click="$store.app.showToast('info', 'Dish creator modal simulation')"
                        class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase px-4 py-2 rounded-full cursor-pointer">
                    <span x-text="$store.app.language === 'ar' ? '+ إضافة طبق جديد' : '+ Add New Dish'">+ Add New Dish</span>
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <template x-for="d in dishes" :key="d.id">
                    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs flex items-center justify-between">
                        <div>
                            <h4 class="font-bold text-sm text-[var(--color-text)]" x-text="$store.app.language === 'ar' ? d.nameAr : d.name"></h4>
                            <span class="text-xs text-[var(--color-primary)] font-bold block mt-1" x-text="d.price.toFixed(2) + ' EGP'"></span>
                            <span class="text-[11px] text-[var(--color-text-muted)]" x-text="d.category"></span>
                        </div>
                        <button type="button"
                                @@click="d.isAvailable = !d.isAvailable; $store.app.showToast('info', d.isAvailable ? 'Dish is now available' : 'Dish marked unavailable')"
                                class="text-xs px-3 py-1.5 rounded-full font-bold border transition-colors cursor-pointer"
                                :class="d.isAvailable ? 'bg-emerald-50 text-emerald-800 border-emerald-300 dark:bg-emerald-950 dark:text-emerald-100' : 'bg-neutral-100 text-neutral-500 border-neutral-300 dark:bg-neutral-800 dark:text-neutral-400'"
                                x-text="d.isAvailable ? ($store.app.language === 'ar' ? 'متاح للطلب' : 'Available') : ($store.app.language === 'ar' ? 'غير متوفر' : 'Unavailable')">
                        </button>
                    </div>
                </template>
            </div>
        </div>

        <!-- Tab 3: Wallet -->
        <!-- TODO [Backend]: Bind Chef wallet balance, platform commission ledger, and instant payout processing endpoint -->
        <div x-show="activeTab === 'wallet'" class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-6 sm:p-8 space-y-6 max-w-2xl">
            <h3 class="text-lg font-bold uppercase text-[var(--color-text)]"
                x-text="$store.app.language === 'ar' ? 'سجل الأرباح والتحويلات البنكية' : 'Earnings & Direct Bank Payouts'">
                Earnings & Direct Bank Payouts
            </h3>
            <div class="p-4 bg-[var(--color-surface-subtle)] rounded-xl border border-[var(--color-border-light)] space-y-2 text-xs">
                <div class="flex justify-between">
                    <span>Available Balance:</span>
                    <strong class="text-base text-[var(--color-primary)]">4,820.00 EGP</strong>
                </div>
                <div class="flex justify-between text-[var(--color-text-muted)]">
                    <span>Platform Commission:</span>
                    <span>15% automatically deducted</span>
                </div>
                <div class="flex justify-between text-[var(--color-text-muted)]">
                    <span>IBAN / InstaPay:</span>
                    <span>EG890002000100000000012345678</span>
                </div>
            </div>
            <button type="button"
                    @@click="$store.app.showToast('success', 'Instant payout request of 4,820.00 EGP dispatched via InstaPay (Simulated).')"
                    class="w-full inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] active:scale-[0.98]">
                <span x-text="$store.app.language === 'ar' ? 'طلب تحويل فوري عبر إنستاباي' : 'Request Instant InstaPay Payout'">Request Instant InstaPay Payout</span>
            </button>
        </div>
    </div>
</div>

