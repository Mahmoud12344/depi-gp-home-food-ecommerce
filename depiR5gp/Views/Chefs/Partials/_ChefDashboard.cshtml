            </template>
        </div>

        <!-- TAB 2: Menu Items (SCRUM-36, SCRUM-41, SCRUM-46, SCRUM-51, SCRUM-56, SCRUM-61) -->
        <div x-show="activeTab === 'menu'" class="space-y-4">
            <div class="flex items-center justify-between pb-2">
                <h3 class="text-base font-bold uppercase text-[var(--color-text)]"
                    x-text="$store.app.language === 'ar' ? 'أطباق المطبخ المعروضة' : 'Listed Kitchen Dishes'">
                    Listed Kitchen Dishes
                </h3>
                <button type="button"
                        @@click="addDishModalOpen = true"
                        class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase px-4 py-2 rounded-full cursor-pointer transition-all shadow-xs flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#plus"></use></svg>
                    <span x-text="$store.app.language === 'ar' ? '+ إضافة طبق جديد' : '+ Add New Dish'">+ Add New Dish</span>
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <template x-for="d in dishes" :key="d.id">
                    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs flex flex-col justify-between gap-4">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <h4 class="font-bold text-sm text-[var(--color-text)]" x-text="$store.app.language === 'ar' ? d.nameAr : d.name"></h4>
                                <span class="text-xs text-[var(--color-primary)] font-bold block mt-1" x-text="d.price.toFixed(2) + ' EGP'"></span>
                                <span class="text-[11px] text-[var(--color-text-muted)]" x-text="d.category"></span>
                            </div>
                            <button type="button"
                                    @@click="d.isAvailable = !d.isAvailable; $store.app.showToast('info', d.isAvailable ? 'Dish is now available' : 'Dish marked unavailable')"
                                    class="text-xs px-3 py-1.5 rounded-full font-bold border transition-colors cursor-pointer shrink-0"
                                    :class="d.isAvailable ? 'bg-emerald-50 text-emerald-800 border-emerald-300 dark:bg-emerald-950 dark:text-emerald-100' : 'bg-neutral-100 text-neutral-500 border-neutral-300 dark:bg-neutral-800 dark:text-neutral-400'"
                                    x-text="d.isAvailable ? ($store.app.language === 'ar' ? 'متاح للطلب' : 'Available') : ($store.app.language === 'ar' ? 'غير متوفر' : 'Unavailable')">
                            </button>
                        </div>

                        <!-- Edit & Delete Row Actions (SCRUM-46, SCRUM-51) -->
                        <div class="flex items-center justify-end gap-2 pt-2 border-t border-[var(--color-border-light)]">
                            <button type="button" @@click="openEditDish(d)"
                                    class="px-3 py-1.5 text-xs text-[var(--color-text-muted)] hover:text-[var(--color-primary)] font-semibold rounded-lg hover:bg-[var(--color-surface-subtle)] transition-colors flex items-center gap-1 cursor-pointer">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#edit-3"></use></svg>
                                <span x-text="$store.app.language === 'ar' ? 'تعديل' : 'Edit'">Edit</span>
                            </button>
                            <button type="button" @@click="openDeleteDish(d)"
                                    class="px-3 py-1.5 text-xs text-rose-600 hover:text-rose-800 font-semibold rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors flex items-center gap-1 cursor-pointer">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#trash-2"></use></svg>
                                <span x-text="$store.app.language === 'ar' ? 'حذف' : 'Delete'">Delete</span>
                            </button>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <!-- TAB 3: Order History (SCRUM-96) -->
        <div x-show="activeTab === 'history'" class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2">
                <h3 class="text-base font-bold uppercase text-[var(--color-text)]"
                    x-text="$store.app.language === 'ar' ? 'سجل الطلبات المكتملة والملغاة' : 'Historical Order Records'">
                    Historical Order Records
                </h3>
                <div class="flex items-center gap-2">
                    <select x-model="historyStatusFilter" class="p-2 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-xl text-xs font-semibold">
                        <option value="all">All Historical Statuses</option>
                        <option value="Completed">Completed Only</option>
                        <option value="Cancelled">Cancelled Only</option>
                        <option value="Rejected">Rejected Only</option>
                    </select>
                </div>
            </div>

            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-xs">
                <div class="divide-y divide-[var(--color-border-light)] text-xs">
                    <template x-for="h in orderHistory.filter(o => historyStatusFilter === 'all' || o.status === historyStatusFilter)" :key="h.id">
                        <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-sm text-[var(--color-primary)]" x-text="'#' + h.orderNumber"></span>
                                    <span :class="{
                                        'bg-emerald-100 text-emerald-900 border-emerald-300 dark:bg-emerald-950 dark:text-emerald-100': h.status === 'Completed',
                                        'bg-neutral-100 text-neutral-800 border-neutral-300 dark:bg-neutral-800 dark:text-neutral-200': h.status === 'Cancelled',
                                        'bg-rose-100 text-rose-900 border-rose-300 dark:bg-rose-950 dark:text-rose-100': h.status === 'Rejected'
                                    }" class="text-[10px] px-2 py-0.5 rounded-full font-bold border" x-text="h.status"></span>
                                </div>
                                <h5 class="font-semibold text-xs text-[var(--color-text)]" x-text="h.dishTitle"></h5>
                                <p class="text-[11px] text-[var(--color-text-muted)]" x-text="`Customer: ${h.customerName} · Date: ${h.completedAt}`"></p>
                            </div>
                            <div class="text-end">
                                <span class="font-bold text-sm text-[var(--color-text)] block" x-text="h.totalPrice.toFixed(2) + ' EGP'"></span>
                                <span class="text-[10px] text-emerald-600 font-semibold" x-text="'Net: ' + (h.totalPrice * 0.85).toFixed(2) + ' EGP'"></span>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <!-- TAB 4: Customer Reviews (SCRUM-556) -->
        <div x-show="activeTab === 'reviews'" class="space-y-4">
            <div class="bg-[var(--color-surface-subtle)] border border-[var(--color-border-light)] p-4 rounded-2xl flex items-center justify-between text-xs">
                <div>
                    <h3 class="font-bold uppercase text-[var(--color-text)]"
                        x-text="$store.app.language === 'ar' ? 'تقييمات وآراء زبائن المطبخ' : 'Verified Kitchen Customer Feedback'">
                        Verified Kitchen Customer Feedback
                    </h3>
                    <p class="text-[11px] text-[var(--color-text-muted)] mt-0.5">
                        Rating average: <strong class="text-[var(--color-primary)]">4.9 / 5.0</strong> from 24 orders.
                    </p>
                </div>
                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-neutral-200 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
                    Read-Only (Platform Policy)
                </span>
            </div>

            <div class="space-y-3">
                <template x-for="r in reviews" :key="r.id">
                    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs space-y-2 text-xs">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-[var(--color-text)]" x-text="r.customerName"></span>
                                <span class="text-[var(--color-text-muted)]">·</span>
                                <span class="text-[11px] text-[var(--color-primary)] font-semibold" x-text="r.dishName"></span>
                            </div>
                            <span class="text-[11px] text-[var(--color-text-muted)]" x-text="r.date"></span>
                        </div>
                        <div class="flex items-center gap-1 text-amber-500">
                            <template x-for="star in r.rating" :key="star">
                                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            </template>
                        </div>
                        <p class="text-[var(--color-text)] leading-relaxed italic" x-text="`“${r.comment}”`"></p>
                    </div>
                </template>
            </div>
        </div>

        <!-- TAB 5: Wallet & Payout Ledger (SCRUM-106, SCRUM-511) -->
        <div x-show="activeTab === 'wallet'" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                    <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block">Available Balance</span>
                    <strong class="text-2xl text-[var(--color-primary)] block mt-1">4,820.00 EGP</strong>
                    <span class="text-[11px] text-emerald-600 font-semibold mt-1 block">Ready for Instant InstaPay Payout</span>
                </div>
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                    <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block">Commission Deducted (15%)</span>
                    <strong class="text-2xl text-[var(--color-text)] block mt-1">850.50 EGP</strong>
                    <span class="text-[11px] text-[var(--color-text-muted)] mt-1 block">Current month platform operations</span>
                </div>
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                    <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block">Registered IBAN / InstaPay</span>
                    <strong class="text-sm text-[var(--color-text)] block mt-2 font-mono">EG890002000100000000012345678</strong>
                    <span class="text-[11px] text-[var(--color-text-muted)] mt-1 block">Verified Domestic Account</span>
                </div>
            </div>

            <!-- Instant Payout Trigger -->
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
                <div>
                    <h4 class="font-bold uppercase text-[var(--color-text)] text-sm">Request Balance Payout</h4>
                    <p class="text-xs text-[var(--color-text-muted)] mt-0.5">Dispatches instant electronic transfer via InstaPay (0 fees).</p>
                </div>
                <button type="button"
                        @@click="$store.app.showToast('success', 'Payout request of 4,820.00 EGP dispatched via InstaPay (Simulated).')"
                        class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                    <span x-text="$store.app.language === 'ar' ? 'تحويل الرصيد الآن' : 'Transfer Balance Now'">Transfer Balance Now</span>
                </button>
            </div>

            <!-- Financial Transaction Ledger Table (SCRUM-511) -->
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 shadow-xs space-y-4">
                <h4 class="font-bold uppercase text-[var(--color-text)] text-sm"
                    x-text="$store.app.language === 'ar' ? 'سجل الحركات المالية الموثقة' : 'Financial Transaction Ledger'">
                    Financial Transaction Ledger
                </h4>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-start">
                        <thead>
                            <tr class="border-b border-[var(--color-border)] text-[var(--color-text-muted)] font-bold uppercase text-[10px]">
                                <th class="pb-3 text-start">Date &amp; Time</th>
                                <th class="pb-3 text-start">Reference #</th>
                                <th class="pb-3 text-start">Type</th>
                                <th class="pb-3 text-end">Gross (EGP)</th>
                                <th class="pb-3 text-end">Commission (15%)</th>
                                <th class="pb-3 text-end">Net (EGP)</th>
                                <th class="pb-3 text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--color-border-light)] font-medium">
                            <template x-for="item in walletLedger" :key="item.id">
                                <tr class="hover:bg-[var(--color-surface-subtle)] transition-colors">
                                    <td class="py-3 text-[var(--color-text-muted)]" x-text="item.date"></td>
                                    <td class="py-3 font-bold text-[var(--color-primary)]" x-text="item.refNumber"></td>
                                    <td class="py-3 text-[var(--color-text)]" x-text="item.type"></td>
                                    <td class="py-3 text-end" x-text="item.gross ? item.gross.toFixed(2) : '—'"></td>
                                    <td class="py-3 text-end text-neutral-400" x-text="item.fee ? '-' + item.fee.toFixed(2) : '—'"></td>
                                    <td class="py-3 text-end font-bold"
                                        :class="item.net > 0 ? 'text-emerald-600' : 'text-rose-600'"
                                        x-text="(item.net > 0 ? '+' : '') + item.net.toFixed(2)"></td>
                                    <td class="py-3 text-end font-bold text-[var(--color-text)]" x-text="item.balance.toFixed(2) + ' EGP'"></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modals Inclusion -->
    <partial name="~/Views/Chefs/Partials/_EditChefProfileModal.cshtml" />
    <partial name="~/Views/Chefs/Partials/_AddDishModal.cshtml" />
    <partial name="~/Views/Chefs/Partials/_EditDishModal.cshtml" />
    <partial name="~/Views/Chefs/Partials/_DeleteDishConfirmDialog.cshtml" />
    <partial name="~/Views/Chefs/Partials/_RejectOrderDialog.cshtml" />
</div>
