@model depiR5gp.Models.Chefs.EditChefProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Edit Chef Profile</h4>
                </div>
                <div class="card-body">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- قسم الصورة الشخصية -->
                        <div class="text-center mb-4">
                            @if (!string.IsNullOrEmpty(Model.ExistingPhotoUrl))
                            {
                                <img src="@Model.ExistingPhotoUrl" alt="Profile Photo" class="img-thumbnail rounded-circle mb-2" style="width: 150px; height: 150px; object-fit: cover;" />
                            }
                            else
                            {
                                <!-- صورة افتراضية في حال لم يرفع الشيف صورة من قبل -->
                                <div class="bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 150px; height: 150px; font-size: 3rem;">
                                    <i class="bi bi-person"></i>
                                </div>
                            }

                            <div class="mt-2">
                                <label asp-for="PhotoFile" class="form-label fw-bold">Upload New Photo</label>
                                <input asp-for="PhotoFile" type="file" class="form-control form-control-sm w-50 mx-auto" accept="image/*" />
                                <span asp-validation-for="PhotoFile" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- اسم المطبخ / الشيف -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Kitchen / Chef Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter your kitchen name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- النبذة (Bio) -->
                        <div class="mb-3">
                            <label asp-for="Bio" class="form-label fw-bold">Bio</label>
                            <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell customers about your experience and cooking style..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger"></span>
                        </div>

                        <!-- العنوان (Address) -->
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">Pickup Address</label>
                            <input asp-for="Address" class="form-control" placeholder="Detailed address for order pickups" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <!-- حالة استقبال الطلبات -->
                        <div class="mb-4 form-check form-switch">
                            <input asp-for="IsAcceptingOrders" class="form-check-input" type="checkbox" role="switch" id="acceptingOrdersSwitch">
                            <label class="form-check-label fw-bold" for="acceptingOrdersSwitch">Accepting New Orders</label>
                            <small class="d-block text-muted">Turn this off if you are temporarily unavailable.</small>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}