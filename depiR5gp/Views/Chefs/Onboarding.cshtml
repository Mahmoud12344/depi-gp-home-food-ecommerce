@* TODO [Backend]: @model depiR5gp.Models.Chefs.ChefProfile *@
@{
    ViewData["Title"] = "Chef Onboarding - Join HomeChef";
}

<!-- Chef Onboarding Page -->
<main>
    <div x-data="{ step: 'form' }" class="w-full pb-24">

        <!-- Breadcrumb banner -->
        <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                    <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                        <span x-text="$store.app.language === 'ar' ? 'الرئيسية' : 'Home'">Home</span>
                    </a>
                    <svg class="w-4 h-4 text-neutral-400 shrink-0" :class="$store.app.language === 'ar' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
                    <span class="text-[var(--color-text)] font-semibold" x-text="$store.app.language === 'ar' ? 'انضم كشيف' : 'Chef Onboarding'">Chef Onboarding</span>
                </nav>
                <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]"
                    x-text="$store.app.language === 'ar' ? 'انضم كشيف منزلي معتمد' : 'Become a Certified Home Chef'">
                    Become a Certified Home Chef
                </h1>
                <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 max-w-2xl leading-relaxed"
                   x-text="$store.app.language === 'ar' ? 'ابدأ في بيع وجباتك المطهوة بالسمن البلدي لجيرانك والذواقة مباشرة من مطبخك' : 'Turn your domestic kitchen into an approved culinary hub with direct customer pickup'">
                    Turn your domestic kitchen into an approved culinary hub with direct customer pickup
                </p>
            </div>
        </div>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
            <!-- Application Status Tracker -->
            @* TODO [Backend]: Query ApplicationUser.ChefApplication status; display current verification stage (PendingReview, Approved, NeedsRevision) *@
            <div x-show="step === 'status'" class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-8 sm:p-12 shadow-sm text-center space-y-6">
                <div class="w-16 h-16 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center mx-auto">
                    <svg class="w-8 h-8 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#clock"></use></svg>
                </div>
                <div class="space-y-1">
                    <span class="text-xs font-bold uppercase tracking-widest text-amber-700">Application Status: Under Review</span>
                    <h2 class="text-2xl font-bold uppercase tracking-tight text-[var(--color-text)]">Amina's Heritage Kitchen</h2>
                    <p class="text-xs sm:text-sm text-[var(--color-text-muted)] max-w-md mx-auto pt-1 leading-relaxed">
                        Your government ID, domestic kitchen photos, and food safety credentials have been dispatched to platform compliance. Approval takes under 24 hours.
                    </p>
                </div>
                <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)] text-xs text-start max-w-md mx-auto space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-[var(--color-text)]">Platform Commission Agreement:</span>
                        <span class="font-semibold text-emerald-600">15% Agreed</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-[var(--color-text)]">Inspection Status:</span>
                        <span class="font-semibold text-amber-600">Document Verification Pending</span>
                    </div>
                </div>
                <div class="pt-4 flex justify-center gap-3">
                    <a href="/ChefDashboard"
                       class="inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)]">
                        Go to Kitchen Dashboard (Preview)
                    </a>
                </div>
            </div>

            <!-- Application Form -->
            @* TODO [Backend]: POST ChefsController.Onboarding(ChefOnboardingDto dto) to create ChefProfile entity, attach National ID, verify pickup address, and trigger platform admin verification workflow *@
            <form x-show="step === 'form'" method="post" enctype="multipart/form-data" asp-controller="Chefs" asp-action="Onboarding" class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-8 sm:p-10 shadow-sm space-y-8">
                <div class="border-b border-[var(--color-border-light)] pb-4 flex items-center justify-between gap-4 flex-wrap">
                    <div>
                        <h2 class="text-xl font-bold uppercase tracking-tight text-[var(--color-text)]"
                            x-text="$store.app.language === 'ar' ? 'بيانات المطبخ المنزلي والتراخيص' : 'Kitchen Credentials & Culinary Hygiene'">
                            Kitchen Credentials & Culinary Hygiene
                        </h2>
                        <p class="text-xs text-[var(--color-text-muted)] mt-1"
                           x-text="$store.app.language === 'ar' ? 'يخضع كل طاهٍ للتحقق من الهوية الوطنية واشتراطات النظافة الصحية قبل قبول أي طلبات.' : 'Every domestic kitchen must submit identity documents and food hygiene proof.'">
                            Every domestic kitchen must submit identity documents and food hygiene proof.
                        </p>
                    </div>
                    <button type="button" @@click="step = 'status'" class="text-[11px] font-semibold underline text-[var(--color-primary)] cursor-pointer">
                        Preview Under Review State
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-xs">
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]"
                               x-text="$store.app.language === 'ar' ? 'اسم المطبخ التجاري' : 'Kitchen Brand Name'">Kitchen Brand Name</label>
                        <input type="text"
                               name="KitchenName"
                               required
                               placeholder="e.g. Grandma's Maadi Oven"
                               class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                    </div>

                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]"
                               x-text="$store.app.language === 'ar' ? 'اسم الشيف المسؤول' : 'Head Cook Full Name'">Head Cook Full Name</label>
                        <input type="text"
                               name="ChefName"
                               required
                               placeholder="e.g. Amina Mansour"
                               class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                    </div>

                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]"
                               x-text="$store.app.language === 'ar' ? 'المنطقة (للاستلام)' : 'Neighborhood Area'">Neighborhood Area</label>
                        <select name="Area"
                                class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium cursor-pointer">
                            <option value="maadi">Maadi, Cairo</option>
                            <option value="zamalek">Zamalek, Cairo</option>
                            <option value="new_cairo">New Cairo (5th Settlement)</option>
                            <option value="heliopolis">Heliopolis, Cairo</option>
                            <option value="dokki">Dokki, Giza</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]"
                               x-text="$store.app.language === 'ar' ? 'الرقم القومي (14 رقم)' : 'Egyptian National ID (14 Digits)'">Egyptian National ID</label>
                        <input type="text"
                               name="NationalId"
                               required
                               maxlength="14"
                               placeholder="29000000000000"
                               class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                    </div>
                </div>

                <div class="text-xs">
                    <label class="block font-semibold mb-1 text-[var(--color-text)]"
                           x-text="$store.app.language === 'ar' ? 'عنوان بوابة الاستلام الدقيق' : 'Exact Pickup Counter Address'">Exact Pickup Counter Address</label>
                    <input type="text"
                           name="Address"
                           required
                           placeholder="e.g. Building 24, Road 200, Ground Floor, Degla, Maadi"
                           class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                </div>

                <!-- Agreement Checkbox -->
                <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)] text-xs space-y-2">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="checkbox"
                               name="HasAcceptedTerms"
                               value="true"
                               required
                               class="mt-1 w-4 h-4 rounded text-[var(--color-primary)] focus:ring-[var(--color-primary)] border-neutral-300" />
                        <span class="text-[var(--color-text)] leading-relaxed">
                            <strong class="block" x-text="$store.app.language === 'ar' ? 'الموافقة على عمولة المنصة (15%) والتفتيش الصحي' : 'Agree to 15% Platform Commission & Domestic Hygiene Terms'">Agree to 15% Platform Commission & Domestic Hygiene Terms</strong>
                            <span class="text-[var(--color-text-muted)] text-[11px]"
                                  x-text="$store.app.language === 'ar' ? 'أقر بأن جميع الوجبات تُحضر في بيئة نظيفة وباستخدام السمن الطبيعي واللحوم الصالحة، مع الالتزام بمواعيد الاستلام المحددة.' : 'I certify that meals are prepared using pure butter and fresh ingredients in a sanitized kitchen, with timely customer handover.'">
                                I certify that meals are prepared using pure butter and fresh ingredients in a sanitized kitchen, with timely customer handover.
                            </span>
                        </span>
                    </label>
                </div>

                <button type="submit"
                        class="w-full inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer rounded-full text-xs md:text-sm px-8 py-3.5 gap-2.5 shadow-md bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] active:scale-[0.98]">
                    <span x-text="$store.app.language === 'ar' ? 'إرسال طلب الانضمام للتحقق' : 'Submit Kitchen for Verification'">Submit Kitchen for Verification</span>
                </button>
            </form>
        </div>
    </div>
</main>
