@model depiR5gp.ViewModels.CustomerOrdersVM
@{
    ViewData["Title"] = "Order History";
    ViewData["CustomerActivePage"] = "MyOrders";
}

<div class="w-full pb-24">
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 mb-2">
                <a asp-controller="Home" asp-action="Index" class="hover:text-[var(--color-primary)] font-medium">Home</a>
                <span aria-hidden="true">/</span>
                <span class="text-[var(--color-text)] font-semibold">Order History</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">My Account &amp; Activity</h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5">Track orders, loyalty balance, and favorite kitchens</p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <partial name="~/Views/Customer/Partials/_CustomerNav.cshtml" model="Model.Profile" />
        <div class="space-y-3">
            @if (Model.Orders.Count == 0)
            {
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-8 text-center text-sm text-[var(--color-text-muted)]">You have not placed any orders yet.</div>
            }
            else
            {
                foreach (var order in Model.Orders)
                {
                    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                        <div class="space-y-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="font-bold text-sm uppercase text-[var(--color-text)]">#@order.Reference</span>
                                <span class="text-[10px] px-2.5 py-0.5 rounded-full font-bold border bg-[var(--color-surface-subtle)] text-[var(--color-text)]">@order.Status</span>
                                <span class="text-xs text-[var(--color-text-muted)]">· @order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                            </div>
                            <h4 class="text-xs font-bold text-[var(--color-text)]">@(order.Items.Count == 0 ? "Order details unavailable" : string.Join(", ", order.Items.Select(item => $"{item.DishName} × {item.Quantity}")))</h4>
                            <p class="text-xs text-[var(--color-text-muted)]">@order.ChefName · <span class="font-bold text-[var(--color-primary)]">@order.Total.ToString("0.00") EGP</span></p>
                        </div>
                        <a asp-controller="Orders" asp-action="Track" asp-route-id="@order.Id" class="px-4 py-2 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-xs font-bold uppercase tracking-wider text-[var(--color-text)] hover:text-[var(--color-primary)]">Track Order</a>
                    </div>
                }
            }
        </div>
    </div>
</div>
