@{
    ViewData["Title"] = "Order History";
    ViewData["CustomerActivePage"] = "MyOrders";
}
<!-- Views/Customer/MyOrders.cshtml -->
<!-- Ported from Views/Customer/Partials/_CustomerProfile.cshtml (Tab 1: Orders) on main -->
<!-- TODO(backend): Loop through Customer.PastOrders; bind OrderNumber, Status, KitchenName, TotalAmount, and Date -->

<div x-data="{ orderStatusFilter: 'all' }" class="w-full pb-24">
    <!-- Breadcrumb banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span>Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
                <span class="text-[var(--color-text)] font-semibold">Order History</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                My Account &amp; Activity
            </h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 leading-relaxed">
                Track orders, loyalty balance, and favorite kitchens
            </p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <partial name="~/Views/Customer/Partials/_CustomerNav.cshtml" />

        <!-- Tab 1: Orders (SCRUM-226) -->
        <div class="space-y-4">
            <!-- Filter chips -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1">
                <button type="button"
                        @@click="orderStatusFilter = 'all'"
                        :class="orderStatusFilter === 'all' ? 'bg-[var(--color-primary)] text-white' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800'"
                        class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer whitespace-nowrap">
                    All Orders
                </button>
                <button type="button"
                        @@click="orderStatusFilter = 'Active'"
                        :class="orderStatusFilter === 'Active' ? 'bg-[var(--color-primary)] text-white' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800'"
                        class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer whitespace-nowrap">
                    Active
                </button>
                <button type="button"
                        @@click="orderStatusFilter = 'Completed'"
                        :class="orderStatusFilter === 'Completed' ? 'bg-[var(--color-primary)] text-white' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800'"
                        class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer whitespace-nowrap">
                    Completed
                </button>
                <button type="button"
                        @@click="orderStatusFilter = 'Cancelled'"
                        :class="orderStatusFilter === 'Cancelled' ? 'bg-[var(--color-primary)] text-white' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800'"
                        class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer whitespace-nowrap">
                    Cancelled
                </button>
            </div>

            <!-- Orders List -->
            <div class="space-y-3">
                <!-- BEGIN SAMPLE: Unrolled 4 pastOrders from main _CustomerProfile.cshtml -->
                <!-- Order 1: Pending -->
                <div x-show="orderStatusFilter === 'all' || orderStatusFilter === 'Active'"
                     class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-bold text-sm uppercase text-[var(--color-text)]">#HC-2026-9150</span>
                            <span class="text-[10px] px-2.5 py-0.5 rounded-full font-bold border bg-amber-100 text-amber-900 border-amber-300 dark:bg-amber-950 dark:text-amber-200">Pending</span>
                            <span class="text-xs text-[var(--color-text-muted)]">· Today, 15:10</span>
                        </div>
                        <h4 class="text-xs font-bold text-[var(--color-text)]">Stuffed Pigeon with Spiced Freekeh</h4>
                        <p class="text-xs text-[var(--color-text-muted)]">
                            <span>Amina's Heritage Kitchen</span> ·
                            <span class="font-bold text-[var(--color-primary)]">285.00 EGP</span>
                        </p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <a href="/Orders/Track/1"
                           class="px-4 py-2 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-xs font-bold uppercase tracking-wider text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors cursor-pointer">
                            <span>Track Order</span>
                        </a>
                        <form method="post" action="/Cart/Add" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="dishId" value="5" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit"
                                    class="px-4 py-2 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer">
                                <span>Re-order</span>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Order 2: Preparing -->
                <div x-show="orderStatusFilter === 'all' || orderStatusFilter === 'Active'"
                     class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-bold text-sm uppercase text-[var(--color-text)]">#HC-2026-9041</span>
                            <span class="text-[10px] px-2.5 py-0.5 rounded-full font-bold border bg-purple-100 text-purple-900 border-purple-300 dark:bg-purple-950 dark:text-purple-200">Preparing</span>
                            <span class="text-xs text-[var(--color-text-muted)]">· Today, 14:30</span>
                        </div>
                        <h4 class="text-xs font-bold text-[var(--color-text)]">Baladi Duck Molokhia with Vermicelli Rice</h4>
                        <p class="text-xs text-[var(--color-text-muted)]">
                            <span>Amina's Heritage Kitchen</span> ·
                            <span class="font-bold text-[var(--color-primary)]">240.00 EGP</span>
                        </p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <a href="/Orders/Track/2"
                           class="px-4 py-2 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-xs font-bold uppercase tracking-wider text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors cursor-pointer">
                            <span>Track Order</span>
                        </a>
                        <form method="post" action="/Cart/Add" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="dishId" value="1" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit"
                                    class="px-4 py-2 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer">
                                <span>Re-order</span>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Order 3: Completed -->
                <div x-show="orderStatusFilter === 'all' || orderStatusFilter === 'Completed'"
                     class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-bold text-sm uppercase text-[var(--color-text)]">#HC-2026-8890</span>
                            <span class="text-[10px] px-2.5 py-0.5 rounded-full font-bold border bg-emerald-100 text-emerald-900 border-emerald-300 dark:bg-emerald-950 dark:text-emerald-200">Completed</span>
                            <span class="text-xs text-[var(--color-text-muted)]">· Yesterday</span>
                        </div>
                        <h4 class="text-xs font-bold text-[var(--color-text)]">Oxtail Tagine with Baby Caramelized Onions</h4>
                        <p class="text-xs text-[var(--color-text-muted)]">
                            <span>Om Nabil Casseroles</span> ·
                            <span class="font-bold text-[var(--color-primary)]">310.00 EGP</span>
                        </p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <a href="/Reviews/Create"
                           class="px-4 py-2 rounded-full border border-amber-300 bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/60 text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-200 transition-colors cursor-pointer">
                            <span>Rate Order</span>
                        </a>
                        <a href="/Orders/Track/3"
                           class="px-4 py-2 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-xs font-bold uppercase tracking-wider text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors cursor-pointer">
                            <span>Track Order</span>
                        </a>
                        <form method="post" action="/Cart/Add" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="dishId" value="2" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit"
                                    class="px-4 py-2 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer">
                                <span>Re-order</span>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Order 4: Cancelled -->
                <div x-show="orderStatusFilter === 'all' || orderStatusFilter === 'Cancelled'"
                     class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-bold text-sm uppercase text-[var(--color-text)]">#HC-2026-8420</span>
                            <span class="text-[10px] px-2.5 py-0.5 rounded-full font-bold border bg-rose-100 text-rose-900 border-rose-300 dark:bg-rose-950 dark:text-rose-200">Cancelled</span>
                            <span class="text-xs text-[var(--color-text-muted)]">· Oct 18, 2026</span>
                        </div>
                        <h4 class="text-xs font-bold text-[var(--color-text)]">Feteer Meshaltet with Black Honey &amp; Eshgedda</h4>
                        <p class="text-xs text-[var(--color-text-muted)]">
                            <span>Aunt Fatima Bakery</span> ·
                            <span class="font-bold text-[var(--color-primary)]">165.00 EGP</span>
                        </p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <a href="/Orders/Track/4"
                           class="px-4 py-2 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-xs font-bold uppercase tracking-wider text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors cursor-pointer">
                            <span>Track Order</span>
                        </a>
                        <form method="post" action="/Cart/Add" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="dishId" value="4" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit"
                                    class="px-4 py-2 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer">
                                <span>Re-order</span>
                            </button>
                        </form>
                    </div>
                </div>
                <!-- END SAMPLE -->
            </div>
        </div>
    </div>
</div>
