@{
    ViewData["Title"] = "Saved Favorites";
    ViewData["CustomerActivePage"] = "Favorites";
}
<!-- Views/Customer/Favorites.cshtml -->
<!-- Ported from Views/Customer/Partials/_CustomerProfile.cshtml (Tab 3: Favorites) on main -->
<!-- TODO(backend): Loop through Customer.Favorites (Dishes and Chefs saved by user); bind DishCard / ChefCard -->

<div x-data="{ favoriteTab: 'dishes' }" class="w-full pb-24">
    <!-- Breadcrumb banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span>Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
                <span class="text-[var(--color-text)] font-semibold">Saved Favorites</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                My Account &amp; Activity
            </h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 leading-relaxed">
                Track orders, loyalty balance, and favorite kitchens
            </p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <partial name="~/Views/Customer/Partials/_CustomerNav.cshtml" />

        <!-- Tab 3: Favorites (SCRUM-249) -->
        <div class="space-y-6">
            <!-- Sub-tabs: Dishes vs Chefs -->
            <div class="flex items-center gap-2 border-b border-[var(--color-border-light)] pb-3">
                <button type="button"
                        @@click="favoriteTab = 'dishes'"
                        :class="favoriteTab === 'dishes' ? 'bg-[var(--color-primary)] text-white' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800'"
                        class="px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer">
                    <span>Favorite Dishes (3)</span>
                </button>
                <button type="button"
                        @@click="favoriteTab = 'chefs'"
                        :class="favoriteTab === 'chefs' ? 'bg-[var(--color-primary)] text-white' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800'"
                        class="px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer">
                    <span>Favorite Chefs (2)</span>
                </button>
            </div>

            <!-- Sub-tab 1: Dishes -->
            <div x-show="favoriteTab === 'dishes'">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- BEGIN SAMPLE: 3 Favorite Dishes -->
                    <partial name="~/Views/Shared/Partials/_DishCard.cshtml" />

                    <!-- Dish 2 -->
                    <div onclick="window.location.href='/Dishes/Details/2'"
                         class="group relative bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-4 transition-all duration-300 hover:shadow-xl hover:shadow-[var(--color-primary)]/5 cursor-pointer flex flex-col justify-between overflow-hidden hover:-translate-y-1">
                        <div class="relative w-full aspect-square bg-neutral-100 dark:bg-neutral-800 overflow-hidden rounded-xl mb-3.5">
                            <img src="https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=600&auto=format&fit=crop&q=80"
                                 alt="Oxtail Tagine with Baby Caramelized Onions"
                                 class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
                                 loading="lazy" />

                            <div class="absolute bottom-3 inset-x-0 flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-3 group-hover:translate-y-0 z-20"
                                 x-data="{ fav: true }">
                                <button type="button"
                                        @@click.stop="fav = !fav"
                                        class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                                    <svg class="w-4 h-4" :class="fav ? 'fill-rose-500 text-rose-500' : 'stroke-current'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#heart"></use>
                                    </svg>
                                </button>
                                <button type="button"
                                        @@click.stop="$dispatch('open-options-modal', { id: 'dish-2', name: 'Oxtail Tagine with Baby Caramelized Onions', price: 310, kitchenName: 'Om Nabil Casseroles' })"
                                        class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#shopping-bag"></use>
                                    </svg>
                                </button>
                                <button type="button"
                                        @@click.stop="$dispatch('open-quick-view', { id: 'dish-2', name: 'Oxtail Tagine with Baby Caramelized Onions', price: 310, rating: 5.0, reviewCount: 36, prepTimeMinutes: 60, kitchenName: 'Om Nabil Casseroles', category: 'Clay Tagines & Casseroles', pickupArea: 'Zamalek, Cairo', isAvailable: true, isSale: false, image: 'https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=600&auto=format&fit=crop&q=80' })"
                                        class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#eye"></use>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div>
                            <div class="text-[11px] text-[var(--color-text-muted)] truncate mb-1">
                                <span>Clay Tagines &amp; Casseroles</span>
                                <span class="mx-1.5 opacity-60">·</span>
                                <span class="text-[var(--color-primary)] font-semibold">Om Nabil Casseroles</span>
                            </div>
                            <h3 class="text-sm sm:text-base font-bold uppercase tracking-tight text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors line-clamp-1 mb-1.5">
                                Oxtail Tagine with Baby Caramelized Onions
                            </h3>
                            <div class="flex items-baseline gap-2 mb-2">
                                <span class="text-base font-bold text-[var(--color-primary)]">310.00 EGP</span>
                            </div>
                            <div class="flex items-center justify-between text-xs text-[var(--color-text-muted)] pt-2 border-t border-[var(--color-border-light)]">
                                <div class="flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24"><use href="#star"></use></svg>
                                    <span class="text-[11px] font-bold">5.0</span>
                                    <span class="text-[10px]">(36)</span>
                                </div>
                                <span class="text-[11px]">60m</span>
                            </div>
                        </div>
                    </div>

                    <!-- Dish 3 -->
                    <div onclick="window.location.href='/Dishes/Details/4'"
                         class="group relative bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-4 transition-all duration-300 hover:shadow-xl hover:shadow-[var(--color-primary)]/5 cursor-pointer flex flex-col justify-between overflow-hidden hover:-translate-y-1">
                        <div class="relative w-full aspect-square bg-neutral-100 dark:bg-neutral-800 overflow-hidden rounded-xl mb-3.5">
                            <img src="https://images.unsplash.com/photo-1509440159596-0249088772ff?w=600&auto=format&fit=crop&q=80"
                                 alt="Authentic Baladi Meshaltet Feteer (Large)"
                                 class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
                                 loading="lazy" />

                            <div class="absolute bottom-3 inset-x-0 flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-3 group-hover:translate-y-0 z-20"
                                 x-data="{ fav: true }">
                                <button type="button"
                                        @@click.stop="fav = !fav"
                                        class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                                    <svg class="w-4 h-4" :class="fav ? 'fill-rose-500 text-rose-500' : 'stroke-current'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#heart"></use>
                                    </svg>
                                </button>
                                <button type="button"
                                        @@click.stop="$dispatch('open-options-modal', { id: 'dish-4', name: 'Authentic Baladi Meshaltet Feteer (Large)', price: 180, kitchenName: 'Hajjah Fatma Bakery' })"
                                        class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#shopping-bag"></use>
                                    </svg>
                                </button>
                                <button type="button"
                                        @@click.stop="$dispatch('open-quick-view', { id: 'dish-4', name: 'Authentic Baladi Meshaltet Feteer (Large)', price: 180, rating: 4.9, reviewCount: 52, prepTimeMinutes: 35, kitchenName: 'Hajjah Fatma Bakery', category: 'Home Artisan Bakery', pickupArea: 'Heliopolis, Cairo', isAvailable: true, isSale: false, image: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?w=600&auto=format&fit=crop&q=80' })"
                                        class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#eye"></use>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div>
                            <div class="text-[11px] text-[var(--color-text-muted)] truncate mb-1">
                                <span>Home Artisan Bakery</span>
                                <span class="mx-1.5 opacity-60">·</span>
                                <span class="text-[var(--color-primary)] font-semibold">Hajjah Fatma Bakery</span>
                            </div>
                            <h3 class="text-sm sm:text-base font-bold uppercase tracking-tight text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors line-clamp-1 mb-1.5">
                                Authentic Baladi Meshaltet Feteer (Large)
                            </h3>
                            <div class="flex items-baseline gap-2 mb-2">
                                <span class="text-base font-bold text-[var(--color-primary)]">180.00 EGP</span>
                            </div>
                            <div class="flex items-center justify-between text-xs text-[var(--color-text-muted)] pt-2 border-t border-[var(--color-border-light)]">
                                <div class="flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24"><use href="#star"></use></svg>
                                    <span class="text-[11px] font-bold">4.9</span>
                                    <span class="text-[10px]">(52)</span>
                                </div>
                                <span class="text-[11px]">35m</span>
                            </div>
                        </div>
                    </div>
                    <!-- END SAMPLE -->
                </div>
            </div>

            <!-- Sub-tab 2: Chefs -->
            <div x-show="favoriteTab === 'chefs'" x-cloak>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- BEGIN SAMPLE: 2 Favorite Chefs -->
                    <!-- Chef Card 1 -->
                    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl overflow-hidden p-4 space-y-4 hover:shadow-md transition-shadow">
                        <div class="relative h-44 rounded-xl overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=800&auto=format&fit=crop&q=80"
                                 alt="Amina's Heritage Kitchen"
                                 class="w-full h-full object-cover" />
                            <button type="button"
                                    class="absolute top-2.5 end-2.5 p-2 rounded-full bg-white/90 dark:bg-neutral-900/90 text-rose-500 shadow-xs cursor-pointer">
                                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><use href="#heart"></use></svg>
                            </button>
                            <span class="absolute bottom-2.5 start-2.5 bg-neutral-950/80 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
                                Maadi, Cairo
                            </span>
                        </div>
                        <div>
                            <h3 class="font-bold text-base text-[var(--color-text)]">Amina's Heritage Kitchen</h3>
                            <p class="text-xs text-[var(--color-primary)] font-semibold">Chef Amina Mansour</p>
                            <div class="flex items-center gap-1 text-xs text-amber-500 font-bold mt-1">
                                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                                <span>4.9</span>
                                <span class="text-[var(--color-text-muted)] font-normal">(124 reviews)</span>
                            </div>
                        </div>
                        <a href="/Chefs/Details/1"
                           class="block text-center w-full py-2 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer">
                            <span>View Kitchen Menu</span>
                        </a>
                    </div>

                    <!-- Chef Card 2 -->
                    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl overflow-hidden p-4 space-y-4 hover:shadow-md transition-shadow">
                        <div class="relative h-44 rounded-xl overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=800&auto=format&fit=crop&q=80"
                                 alt="Om Nabil Casseroles"
                                 class="w-full h-full object-cover" />
                            <button type="button"
                                    class="absolute top-2.5 end-2.5 p-2 rounded-full bg-white/90 dark:bg-neutral-900/90 text-rose-500 shadow-xs cursor-pointer">
                                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><use href="#heart"></use></svg>
                            </button>
                            <span class="absolute bottom-2.5 start-2.5 bg-neutral-950/80 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
                                Zamalek, Cairo
                            </span>
                        </div>
                        <div>
                            <h3 class="font-bold text-base text-[var(--color-text)]">Om Nabil Casseroles</h3>
                            <p class="text-xs text-[var(--color-primary)] font-semibold">Om Nabil</p>
                            <div class="flex items-center gap-1 text-xs text-amber-500 font-bold mt-1">
                                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                                <span>5.0</span>
                                <span class="text-[var(--color-text-muted)] font-normal">(98 reviews)</span>
                            </div>
                        </div>
                        <a href="/Chefs/Details/2"
                           class="block text-center w-full py-2 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer">
                            <span>View Kitchen Menu</span>
                        </a>
                    </div>
                    <!-- END SAMPLE -->
                </div>
            </div>
        </div>
    </div>
</div>
