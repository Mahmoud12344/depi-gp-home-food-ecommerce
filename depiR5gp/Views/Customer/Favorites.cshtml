@model depiR5gp.ViewModels.CustomerFavoritesVM
@{
    ViewData["Title"] = "Saved Favorites";
    ViewData["CustomerActivePage"] = "Favorites";
}

<div class="w-full pb-24">
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 mb-2">
                <a asp-controller="Home" asp-action="Index" class="hover:text-[var(--color-primary)] font-medium">Home</a>
                <span aria-hidden="true">/</span>
                <span class="text-[var(--color-text)] font-semibold">Saved Favorites</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">My Account &amp; Activity</h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5">Track orders, loyalty balance, and favorite kitchens</p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <partial name="~/Views/Customer/Partials/_CustomerNav.cshtml" model="Model.Profile" />
        <div class="space-y-4">
            <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">Favorite Chefs (@Model.Favorites.Count)</h2>
            @if (Model.Favorites.Count == 0)
            {
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-8 text-center text-sm text-[var(--color-text-muted)]">You have not saved any favorite chefs yet.</div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var favorite in Model.Favorites)
                    {
                        var photo = string.IsNullOrWhiteSpace(favorite.PhotoUrl) ? "/icons/chibi-chef.png" : favorite.PhotoUrl;
                        <a asp-controller="Chefs" asp-action="Details" asp-route-id="@favorite.ChefProfileId" class="group bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-4 hover:-translate-y-1 hover:shadow-xl transition-all">
                            <img src="@photo" alt="@favorite.KitchenName" class="w-full aspect-[4/3] object-cover rounded-xl mb-4" />
                            <h3 class="font-bold text-[var(--color-text)]">@favorite.KitchenName</h3>
                            <p class="text-xs text-[var(--color-text-muted)] mt-1">@(string.IsNullOrWhiteSpace(favorite.Address) ? "Address not provided" : favorite.Address)</p>
                            @if (!string.IsNullOrWhiteSpace(favorite.Bio))
                            {
                                <p class="text-xs text-[var(--color-text-muted)] mt-3 line-clamp-2">@favorite.Bio</p>
                            }
                            <span class="inline-block mt-4 text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">View chef profile</span>
                        </a>
                    }
                </div>
            }
            <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">Favorite Dishes (@Model.DishFavorites.Count)</h2>
            @if (Model.DishFavorites.Count == 0)
            {
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-8 text-center text-sm text-[var(--color-text-muted)]">You have not saved any favorite dishes yet.</div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var favorite in Model.DishFavorites)
                    {
                        var photo = string.IsNullOrWhiteSpace(favorite.ImageUrl) ? "/icons/chibi-chef.png" : favorite.ImageUrl;
                        <a asp-controller="Dishes" asp-action="Details" asp-route-id="@favorite.DishId" class="group bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-4 hover:-translate-y-1 hover:shadow-xl transition-all">
                            <img src="@photo" alt="@favorite.Name" class="w-full aspect-[4/3] object-cover rounded-xl mb-4" />
                            <h3 class="font-bold text-[var(--color-text)]">@favorite.Name</h3>
                            <p class="text-xs text-[var(--color-text-muted)] mt-1">@favorite.KitchenName · @favorite.Price.ToString("N2") EGP</p>
                            @if (!string.IsNullOrWhiteSpace(favorite.Description))
                            {
                                <p class="text-xs text-[var(--color-text-muted)] mt-3 line-clamp-2">@favorite.Description</p>
                            }
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
