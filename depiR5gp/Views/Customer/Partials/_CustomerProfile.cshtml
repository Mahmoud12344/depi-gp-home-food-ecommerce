        {
            id: 'ord-101',
            orderNumber: 'HC-2026-9041',
            kitchenName: 'Amina\'s Heritage Kitchen',
            kitchenNameAr: 'مطبخ أمينة التراثي',
            dishTitle: 'Baladi Duck Molokhia with Vermicelli Rice',
            totalPrice: 240.00,
            status: 'Preparing',
            date: 'Today, 14:30'
        },
        {
            id: 'ord-102',
            orderNumber: 'HC-2026-8890',
            kitchenName: 'Om Nabil Casseroles',
            kitchenNameAr: 'طواجن أم نبيل',
            dishTitle: 'Oxtail Tagine with Baby Caramelized Onions',
            totalPrice: 310.00,
            status: 'Completed',
            date: 'Yesterday'
        },
        {
            id: 'ord-103',
            orderNumber: 'HC-2026-8420',
            kitchenName: 'Aunt Fatima Bakery',
            kitchenNameAr: 'مخبوزات خالتي فاطمة',
            dishTitle: 'Feteer Meshaltet with Black Honey & Eshgedda',
            totalPrice: 165.00,
            status: 'Cancelled',
            date: 'Oct 18, 2026'
        }
    ],
    get filteredOrders() {
        if (this.orderStatusFilter === 'all') return this.pastOrders;
        if (this.orderStatusFilter === 'Active') return this.pastOrders.filter(o => o.status === 'Pending' || o.status === 'Preparing' || o.status === 'Ready');
        return this.pastOrders.filter(o => o.status === this.orderStatusFilter);
    }
}"
