<!-- Views/Customer/Partials/_CustomerProfile.cshtml -->
<!-- Source: home_chef/src/pages/CustomerProfilePage.tsx -->
<!-- TODO [Backend]: Load customer profile, loyalty balance, and past orders from backend session -->

<div x-data="{
    activeTab: 'orders',
    favoriteTab: 'dishes'
}"
     class="w-full pb-24">

    <!-- Breadcrumb banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="#home" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span x-text="$store.app.language === 'ar' ? 'الرئيسية' : 'Home'">Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" :class="$store.app.language === 'ar' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
                <span class="text-[var(--color-text)] font-semibold" x-text="$store.app.language === 'ar' ? 'الملف الشخصي' : 'Profile'">Profile</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]"
                x-text="$store.app.language === 'ar' ? 'حسابي ولوحة التحكم' : 'My Account & Activity'">
                My Account & Activity
            </h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 leading-relaxed"
               x-text="$store.app.language === 'ar' ? 'إدارة الطلبات، نقاط الولاء، والمفضلة' : 'Track orders, loyalty balance, and favorite kitchens'">
                Track orders, loyalty balance, and favorite kitchens
            </p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <!-- Profile Card Header -->
        <!-- TODO [Backend]: Bind Customer identity (Name, Email, Phone, AvatarUrl) from User Claims / Session -->
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-4 text-center sm:text-start">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80"
                     alt="Tamer Zaki"
                     class="w-18 h-18 sm:w-20 sm:h-20 rounded-full object-cover border-2 border-[var(--color-primary)] shadow-sm" />
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                        Tamer Zaki (تامر زكي)
                    </h2>
                    <p class="text-xs text-[var(--color-text-muted)] mt-0.5">tamer.zaki@example.com</p>
                    <p class="text-xs text-[var(--color-text-muted)]">+20 100 234 5678</p>
                </div>
            </div>

            <!-- Loyalty Balance Badge -->
            <!-- TODO [Backend]: Bind Customer.LoyaltyPoints balance and calculate equivalent discount value (EGP) -->
            <div class="bg-amber-100 dark:bg-amber-950/80 border border-amber-300 dark:border-amber-700 rounded-2xl p-4 text-center sm:text-end shrink-0 shadow-2xs">
                <span class="text-[10px] font-bold uppercase tracking-wider text-amber-950 dark:text-amber-100 block"
                      x-text="$store.app.language === 'ar' ? 'رصيد نقاط الولاء' : 'Loyalty Points'">Loyalty Points</span>
                <span class="text-2xl font-black text-amber-900 dark:text-amber-200">340 pts</span>
                <span class="text-[10px] font-semibold text-amber-800 dark:text-amber-300 block mt-0.5"
                      x-text="$store.app.language === 'ar' ? '= 68 ج.م خصم متاح' : '= 68 EGP discount available'">= 68 EGP discount available</span>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex border-b border-[var(--color-border)] gap-2 sm:gap-6 overflow-x-auto pb-1">
            <button type="button"
                    @@click="activeTab = 'orders'"
                    :class="activeTab === 'orders' ? 'border-[var(--color-primary)] text-[var(--color-primary)]' : 'border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                    class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer">
                <span x-text="$store.app.language === 'ar' ? 'سجل الطلبات' : 'Order History'">Order History</span> (2)
            </button>
            <button type="button"
                    @@click="activeTab = 'loyalty'"
                    :class="activeTab === 'loyalty' ? 'border-[var(--color-primary)] text-[var(--color-primary)]' : 'border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                    class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer">
                <span x-text="$store.app.language === 'ar' ? 'نقاط الولاء والخصومات' : 'Loyalty Ledger'">Loyalty Ledger</span>
            </button>
            <button type="button"
                    @@click="activeTab = 'favorites'"
                    :class="activeTab === 'favorites' ? 'border-[var(--color-primary)] text-[var(--color-primary)]' : 'border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                    class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer">
                <span x-text="$store.app.language === 'ar' ? 'المفضلة' : 'Saved Favorites'">Saved Favorites</span> (<span x-text="$store.app.favorites.length"></span>)
            </button>
        </div>

        <!-- Tab 1: Orders -->
        <!-- TODO [Backend]: Loop through Customer.PastOrders; bind OrderNumber, Status, KitchenName, TotalAmount, and Date -->
        <div x-show="activeTab === 'orders'" class="space-y-4">
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-sm uppercase text-[var(--color-text)]">HC-2026-9041</span>
                        <span class="bg-purple-100 text-purple-900 border-purple-300 dark:bg-purple-950 dark:text-purple-100 text-[11px] px-2 py-0.5 rounded-full font-bold border">Preparing</span>
                    </div>
                    <p class="text-xs text-[var(--color-text-muted)]">Amina's Heritage Kitchen · 240.00 EGP</p>
                </div>
                <a href="#orders" class="text-xs font-semibold text-[var(--color-primary)] hover:underline flex items-center gap-1">
                    <span x-text="$store.app.language === 'ar' ? 'متابعة الطلب' : 'Track Order'">Track Order</span> →
                </a>
            </div>
        </div>

        <!-- Tab 2: Loyalty -->
        <!-- TODO [Backend]: Loop through Customer.LoyaltyLedger transactions; bind Description, PointsEarnedOrRedeemed, and Timestamp -->
        <div x-show="activeTab === 'loyalty'" class="space-y-4">
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-6 shadow-xs space-y-4 max-w-xl">
                <h3 class="text-sm font-bold uppercase text-[var(--color-text)]" x-text="$store.app.language === 'ar' ? 'سجل حركات النقاط' : 'Loyalty Transaction Ledger'">Loyalty Transaction Ledger</h3>
                <div class="space-y-2 text-xs">
                    <div class="flex justify-between p-2.5 bg-[var(--color-surface-subtle)] rounded-xl">
                        <span>Completed Order #HC-2026-7810</span>
                        <strong class="text-emerald-600">+45 pts</strong>
                    </div>
                    <div class="flex justify-between p-2.5 bg-[var(--color-surface-subtle)] rounded-xl">
                        <span>Checkout Discount Applied</span>
                        <strong class="text-rose-600">-60 pts</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 3: Favorites -->
        <!-- TODO [Backend]: Loop through Customer.Favorites (Dishes and Chefs saved by user); bind DishCard / ChefCard -->
        <div x-show="activeTab === 'favorites'" class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <partial name="Partials/_DishCard" />
            </div>
        </div>
    </div>
</div>

