@* Views/Customer/Partials/_CustomerNav.cshtml *@
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Profile";
}

<!-- Breadcrumb banner -->
<div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
            <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                <span x-text="$store.app.language === 'ar' ? 'الرئيسية' : 'Home'">Home</span>
            </a>
            <svg class="w-4 h-4 text-neutral-400 shrink-0" :class="$store.app.language === 'ar' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
            <span class="text-[var(--color-text)] font-semibold" x-text="$store.app.language === 'ar' ? 'الملف الشخصي' : 'Customer Account'">Customer Account</span>
        </nav>
        <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]"
            x-text="$store.app.language === 'ar' ? 'حسابي ولوحة التحكم' : 'My Account & Activity'">
            My Account &amp; Activity
        </h1>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 leading-relaxed"
           x-text="$store.app.language === 'ar' ? 'إدارة الطلبات، نقاط الولاء، والمفضلة' : 'Track orders, loyalty balance, and favorite kitchens'">
            Track orders, loyalty balance, and favorite kitchens
        </p>
    </div>
</div>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-6">
    <!-- Profile Card Header -->
    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-start">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80"
                 alt="Tamer Zaki"
                 class="w-18 h-18 sm:w-20 sm:h-20 rounded-full object-cover border-2 border-[var(--color-primary)] shadow-sm" />
            <div>
                <h2 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                    Tamer Zaki (تامر زكي)
                </h2>
                <p class="text-xs text-[var(--color-text-muted)] mt-0.5">tamer.zaki@example.com · +20 100 234 5678</p>
                <p class="text-xs text-[var(--color-text-muted)] mt-0.5">Villa 12, Road 250, Degla, Maadi, Cairo</p>
            </div>
        </div>

        <!-- Loyalty Points Badge -->
        <a href="/Customer/Points" class="bg-amber-100 dark:bg-amber-950/80 border border-amber-300 dark:border-amber-700 rounded-2xl p-4 text-center sm:text-end shrink-0 shadow-2xs hover:scale-102 transition-transform cursor-pointer">
            <span class="text-[10px] font-bold uppercase tracking-wider text-amber-950 dark:text-amber-100 block"
                  x-text="$store.app.language === 'ar' ? 'رصيد نقاط الولاء' : 'Loyalty Points'">Loyalty Points</span>
            <span class="text-2xl font-black text-amber-900 dark:text-amber-200">340 pts</span>
            <span class="text-[10px] font-semibold text-amber-800 dark:text-amber-300 block mt-0.5"
                  x-text="$store.app.language === 'ar' ? '= 68 ج.م خصم متاح' : '= 68 EGP discount available'">= 68 EGP discount available</span>
        </a>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-[var(--color-border)] gap-2 sm:gap-6 overflow-x-auto pb-1">
        <a href="/Customer/MyOrders"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(currentAction == "MyOrders" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            Order History
        </a>
        <a href="/Customer/Points"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(currentAction == "Points" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            Loyalty Ledger &amp; Rewards
        </a>
        <a href="/Customer/Favorites"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(currentAction == "Favorites" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            Saved Favorites
        </a>
        <a href="/Customer/Profile"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(currentAction == "Profile" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            Profile Settings
        </a>
    </div>
</div>

