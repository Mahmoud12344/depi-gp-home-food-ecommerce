@model depiR5gp.ViewModels.CustomerProfileVM
@{
    var activePage = ViewData["CustomerActivePage"] as string ?? "Profile";
    var avatarPath = string.IsNullOrWhiteSpace(Model.ProfileImagePath) ? "/icons/chibi-chef.png" : Model.ProfileImagePath;
}

<div class="space-y-8">
    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-start">
            <img src="@avatarPath" alt="Profile picture for @Model.FullName" class="w-18 h-18 sm:w-20 sm:h-20 rounded-full object-cover border-2 border-[var(--color-primary)] shadow-sm" />
            <div>
                <h2 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-[var(--color-text)]">@Model.FullName</h2>
                <p class="text-xs text-[var(--color-text-muted)] mt-0.5">@Model.Email</p>
                <p class="text-xs text-[var(--color-text-muted)]">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "No phone number added" : Model.PhoneNumber)</p>
                <a href="@Url.Action("Profile", "Customer")#profile-form" data-profile-edit-trigger class="inline-flex items-center gap-1.5 mt-2 text-xs font-semibold text-[var(--color-primary)] hover:underline">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#edit"></use></svg>
                    <span>Edit Profile &amp; Addresses</span>
                </a>
            </div>
        </div>

        <div class="bg-amber-100 dark:bg-amber-950/80 border border-amber-300 dark:border-amber-700 rounded-2xl p-4 text-center sm:text-end shrink-0 shadow-2xs">
            <span class="text-[10px] font-bold uppercase tracking-wider text-amber-950 dark:text-amber-100 block">Loyalty Points</span>
            <span class="text-2xl font-black text-amber-900 dark:text-amber-200">@Model.PointsBalance pts</span>
            <span class="text-[10px] font-semibold text-amber-800 dark:text-amber-300 block mt-0.5">= @Model.PointsDiscount.ToString("0.##") EGP discount available</span>
        </div>
    </div>

    <div class="flex border-b border-[var(--color-border)] gap-2 sm:gap-6 overflow-x-auto pb-1" aria-label="Customer account navigation">
        <a asp-controller="Customer" asp-action="MyOrders" class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap @(activePage == "MyOrders" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">Order History</a>
        <a asp-controller="Customer" asp-action="Points" class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap @(activePage == "Points" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">Loyalty Ledger</a>
        <a asp-controller="Customer" asp-action="Favorites" class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap @(activePage == "Favorites" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">Saved Favorites</a>
        <a asp-controller="Customer" asp-action="Profile" class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap @(activePage == "Profile" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">Profile &amp; Addresses</a>
    </div>
</div>