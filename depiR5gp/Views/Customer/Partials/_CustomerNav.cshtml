@{
    var activePage = ViewData["CustomerActivePage"] as string ?? "Profile";
}
<!-- Views/Customer/Partials/_CustomerNav.cshtml -->
<!-- Shared Customer Profile Header Card, Navigation Bar, and Edit Profile Modal ported from _CustomerProfile.cshtml & _EditCustomerProfileModal.cshtml on main -->

<div x-data="{ showEditModal: false }" class="space-y-8">
    <!-- Profile Card Header -->
    <!-- TODO(backend): Bind Customer identity (Name, Email, Phone, AvatarUrl) from User Claims / Session -->
    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-start">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80"
                 alt="Tamer Zaki"
                 class="w-18 h-18 sm:w-20 sm:h-20 rounded-full object-cover border-2 border-[var(--color-primary)] shadow-sm" />
            <div>
                <h2 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                    Tamer Zaki
                </h2>
                <p class="text-xs text-[var(--color-text-muted)] mt-0.5">tamer.zaki@example.com</p>
                <p class="text-xs text-[var(--color-text-muted)]">+20 100 234 5678</p>
                <button type="button"
                        @@click="showEditModal = true"
                        class="inline-flex items-center gap-1.5 mt-2 text-xs font-semibold text-[var(--color-primary)] hover:underline cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#edit"></use></svg>
                    <span>Edit Profile &amp; Addresses</span>
                </button>
            </div>
        </div>

        <!-- Loyalty Balance Badge -->
        <!-- TODO(backend): Bind Customer.LoyaltyPoints balance and calculate equivalent discount value (EGP) -->
        <div class="bg-amber-100 dark:bg-amber-950/80 border border-amber-300 dark:border-amber-700 rounded-2xl p-4 text-center sm:text-end shrink-0 shadow-2xs">
            <span class="text-[10px] font-bold uppercase tracking-wider text-amber-950 dark:text-amber-100 block">Loyalty Points</span>
            <span class="text-2xl font-black text-amber-900 dark:text-amber-200">340 pts</span>
            <span class="text-[10px] font-semibold text-amber-800 dark:text-amber-300 block mt-0.5">= 68 EGP discount available</span>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-[var(--color-border)] gap-2 sm:gap-6 overflow-x-auto pb-1">
        <a href="/Customer/MyOrders"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activePage == "MyOrders" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Order History</span> (4)
        </a>
        <a href="/Customer/Points"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activePage == "Points" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Loyalty Ledger</span>
        </a>
        <a href="/Customer/Favorites"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activePage == "Favorites" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Saved Favorites</span> (5)
        </a>
        <a href="/Customer/Profile"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activePage == "Profile" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Profile &amp; Addresses</span>
        </a>
    </div>

    <!-- Edit Customer Profile Modal (SCRUM-325) -->
    <div x-show="showEditModal"
         x-cloak
         x-transition.opacity.duration.200ms
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/60 backdrop-blur-xs"
         role="dialog"
         aria-modal="true"
         x-data="{
             name: 'Tamer Zaki',
             email: 'tamer.zaki@example.com',
             phone: '+20 100 234 5678',
             area: 'Maadi, Cairo',
             address: 'Villa 14, Road 9, Degla, Maadi, Cairo',
             dietaryNotes: 'No artificial preservatives, prefer baladi ghee and mild spices'
         }">

        <div @@click.away="showEditModal = false"
             x-show="showEditModal"
             x-transition.scale.origin.center.duration.200ms
             class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl space-y-6">

            <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#user"></use></svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-[var(--color-text)]">
                            Edit Customer Profile
                        </h3>
                        <p class="text-xs text-[var(--color-text-muted)]">Update your contact details, default address, and dietary notes</p>
                    </div>
                </div>
                <button type="button"
                        @@click="showEditModal = false"
                        class="p-2 rounded-full text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                </button>
            </div>

            <!-- TODO(backend): POST /Customer/UpdateProfile -->
            <form method="post" action="/Customer/UpdateProfile" class="space-y-4 text-xs">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Full Name
                        </label>
                        <input type="text"
                               name="name"
                               x-model="name"
                               required
                               class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                    </div>

                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Phone Number
                        </label>
                        <input type="tel"
                               name="phone"
                               x-model="phone"
                               required
                               placeholder="+20 100 000 0000"
                               class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                    </div>
                </div>

                <div>
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                        Email Address
                    </label>
                    <input type="email"
                           x-model="email"
                           disabled
                           class="w-full bg-neutral-100 dark:bg-neutral-800 border border-[var(--color-border-light)] rounded-xl px-3.5 py-2 text-[var(--color-text-muted)] cursor-not-allowed opacity-80" />
                    <span class="text-[10px] text-[var(--color-text-muted)] mt-1 block">To modify your login email, contact customer support.</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="sm:col-span-1">
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Primary Area
                        </label>
                        <select name="area" x-model="area" class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-2.5 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]">
                            <option value="Maadi, Cairo">Maadi</option>
                            <option value="Zamalek, Cairo">Zamalek</option>
                            <option value="Nasr City, Cairo">Nasr City</option>
                            <option value="Heliopolis, Cairo">Heliopolis</option>
                            <option value="Dokki & Mohandessin">Dokki</option>
                            <option value="New Cairo / 5th Settlement">New Cairo</option>
                        </select>
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Street &amp; Building Details
                        </label>
                        <input type="text"
                               name="address"
                               x-model="address"
                               required
                               class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                    </div>
                </div>

                <div>
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                        Dietary Preferences &amp; Allergies
                    </label>
                    <textarea name="dietaryNotes"
                              rows="2"
                              x-model="dietaryNotes"
                              placeholder="e.g. Vegetarian, nut allergy, prefer less salt..."
                              class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl p-3 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]"></textarea>
                </div>

                <div class="flex items-center justify-end gap-3 pt-3 border-t border-[var(--color-border-light)]">
                    <button type="button"
                            @@click="showEditModal = false"
                            class="px-4 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-neutral-100 dark:hover:bg-neutral-800 text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer text-[var(--color-text)]">
                        Cancel
                    </button>
                    <button type="submit"
                            class="px-5 py-2.5 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-sm">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
