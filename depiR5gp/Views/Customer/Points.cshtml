@model depiR5gp.ViewModels.CustomerPointsVM
@{
    ViewData["Title"] = "Loyalty Ledger";
    ViewData["CustomerActivePage"] = "Points";
}

<div class="w-full pb-24">
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 mb-2">
                <a asp-controller="Home" asp-action="Index" class="hover:text-[var(--color-primary)] font-medium">Home</a>
                <span aria-hidden="true">/</span>
                <span class="text-[var(--color-text)] font-semibold">Loyalty Ledger</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">My Account &amp; Activity</h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5">Track orders, loyalty balance, and favorite kitchens</p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <partial name="~/Views/Customer/Partials/_CustomerNav.cshtml" model="Model.Profile" />
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-6 shadow-xs space-y-4 max-w-xl">
            <div class="flex items-center justify-between gap-4">
                <h3 class="text-sm font-bold uppercase text-[var(--color-text)]">Loyalty Transaction Ledger</h3>
                <span class="text-sm font-black text-amber-900 dark:text-amber-200">@Model.Profile.PointsBalance pts</span>
            </div>
            <p class="text-xs text-[var(--color-text-muted)]">Every 5 points equals 1 EGP in available discount.</p>
            <div class="space-y-2 text-xs">
                @if (Model.Transactions.Count == 0)
                {
                    <p class="p-2.5 bg-[var(--color-surface-subtle)] rounded-xl text-[var(--color-text-muted)]">No loyalty transactions yet.</p>
                }
                else
                {
                    foreach (var transaction in Model.Transactions)
                    {
                        <div class="flex justify-between gap-4 p-2.5 bg-[var(--color-surface-subtle)] rounded-xl">
                            <span>@transaction.Type@(transaction.OrderReference is null ? "" : $" · Order #{transaction.OrderReference}") · @transaction.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                            <strong class="@(transaction.Points >= 0 ? "text-emerald-600" : "text-rose-600")">@(transaction.Points >= 0 ? "+" : "")@transaction.Points pts</strong>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
