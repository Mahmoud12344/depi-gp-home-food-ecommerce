@{
    ViewData["Title"] = "Loyalty Points & Rewards - HomeChef";
}
@* TODO [Backend]:
    @model IEnumerable<depiR5gp.Models.ReviewsLoyalty.PointsLedger>
    @foreach (var entry in Model)
    {
        ... render entry.Reason, entry.DeltaPoints, entry.CreatedAt ...
    }
