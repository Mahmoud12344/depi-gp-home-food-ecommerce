@model depiR5gp.ViewModels.AdminDashboard.AdminOrdersSettlementPageVM
@using System.Globalization
@{
    ViewData["Title"] = "Order Financial Settlements - Admin Portal";
    ViewData["ActiveAdminTab"] = "orders";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var inv = CultureInfo.InvariantCulture;
    var firstOrder = Model.Orders.FirstOrDefault();
}

<script type="application/json" id="orders-settlement-ledger-json">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Orders.Select(o => new {
    id = o.OrderId,
    reference = o.Reference,
    kitchenName = o.KitchenName,
    customerName = o.CustomerName,
    gross = o.GrossAmount.ToString("N2", inv),
    commissionRate = o.CommissionRatePercent.ToString("0.##", inv),
    commission = o.CommissionAmount.ToString("N2", inv),
    net = o.NetChefPayable.ToString("N2", inv),
    channel = o.PaymentChannelLabel,
    statusLabel = o.SettlementStatusLabel
})))
</script>

<div x-data="{
    orders: JSON.parse(document.getElementById('orders-settlement-ledger-json')?.textContent || '[]'),
    selectedIndex: 0,
    get current() {
        return this.orders[this.selectedIndex] || null;
    }
}" class="w-full pb-24">

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <!-- Featured Settlement Breakdown Card -->
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#file-text"></use></svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-[var(--color-text)]">
                            Order Financial Settlement Breakdown
                        </h3>
                        <p class="text-xs text-[var(--color-text-muted)]"
                           x-text="current ? `Order #${current.reference} · ${current.kitchenName} · Customer: ${current.customerName}` : 'No orders available'">
                            @(firstOrder != null ? $"Order #{firstOrder.Reference} · {firstOrder.KitchenName} · Customer: {firstOrder.CustomerName}" : "No orders available")
                        </p>
                    </div>
                </div>
                <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 text-xs font-bold uppercase"
                      x-text="current ? current.statusLabel : 'N/A'">
                    @(firstOrder?.SettlementStatusLabel ?? "N/A")
                </span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <!-- Financial Itemization Breakdown Table -->
                <div class="lg:col-span-7 space-y-3 bg-[var(--color-surface-subtle)] p-5 rounded-2xl border border-[var(--color-border-light)] text-xs">
                    <div class="flex justify-between items-center text-[var(--color-text-muted)]">
                        <span>Customer Paid (Gross GMV):</span>
                        <span class="font-bold text-[var(--color-text)] text-sm" x-text="current ? `${current.gross} EGP` : '0.00 EGP'">@(firstOrder?.GrossAmount.ToString("N2", inv) ?? "0.00") EGP</span>
                    </div>
                    <div class="flex justify-between items-center text-rose-600 dark:text-rose-400">
                        <span>Platform Commission (<span x-text="current ? `${current.commissionRate}%` : '@Model.EffectiveCommissionPercent.ToString("0.##", inv)%'">@Model.EffectiveCommissionPercent.ToString("0.##", inv)%</span>):</span>
                        <span class="font-bold" x-text="current ? `-${current.commission} EGP` : '-0.00 EGP'">-@(firstOrder?.CommissionAmount.ToString("N2", inv) ?? "0.00") EGP</span>
                    </div>
                    <div class="flex justify-between items-center text-[var(--color-text-muted)]">
                        <span>Payment Gateway Processing (0% promo):</span>
                        <span class="font-semibold">0.00 EGP</span>
                    </div>
                    <div class="flex justify-between items-center pt-2 border-t border-[var(--color-border)] text-sm font-bold">
                        <span class="text-[var(--color-text)]">Net Chef Earnings Payable:</span>
                        <span class="text-emerald-600 dark:text-emerald-400 text-base" x-text="current ? `${current.net} EGP` : '0.00 EGP'">@(firstOrder?.NetChefPayable.ToString("N2", inv) ?? "0.00") EGP</span>
                    </div>
                </div>

                <!-- Meta coordinates -->
                <div class="lg:col-span-5 grid grid-cols-1 gap-3 text-xs">
                    <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                        <span class="text-[10px] uppercase font-bold text-[var(--color-text-muted)] block">Payment Channel</span>
                        <span class="font-semibold text-[var(--color-text)]" x-text="current ? current.channel : 'N/A'">@(firstOrder?.PaymentChannelLabel ?? "N/A")</span>
                    </div>
                    <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                        <span class="text-[10px] uppercase font-bold text-[var(--color-text-muted)] block">Settlement Status</span>
                        <span class="font-bold text-emerald-600" x-text="current ? current.statusLabel : 'N/A'">@(firstOrder?.SettlementStatusLabel ?? "N/A")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Settlements Ledger Table -->
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">
                    Platform Order Settlements Ledger (@Model.Orders.Count Orders)
                </h3>
                <span class="text-xs font-bold text-[var(--color-primary)]">
                    Total Net Payable: @Model.TotalNetPayable.ToString("N2", inv) EGP
                </span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-start">
                    <thead>
                        <tr class="border-b border-[var(--color-border)] text-[var(--color-text-muted)] font-bold uppercase text-[10px]">
                            <th class="pb-3 text-start">Order #</th>
                            <th class="pb-3 text-start">Kitchen</th>
                            <th class="pb-3 text-start">Customer</th>
                            <th class="pb-3 text-start">Status</th>
                            <th class="pb-3 text-end">Gross GMV</th>
                            <th class="pb-3 text-end">Commission</th>
                            <th class="pb-3 text-end">Net Payable</th>
                            <th class="pb-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--color-border-light)] font-medium">
                        @if (!Model.Orders.Any())
                        {
                            <tr>
                                <td colspan="8" class="py-6 text-center text-[var(--color-text-muted)]">No order settlements found in the database.</td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < Model.Orders.Count; i++)
                            {
                                var ord = Model.Orders[i];
                                <tr class="hover:bg-[var(--color-surface-subtle)] transition-colors"
                                    :class="selectedIndex === @i ? 'bg-[var(--color-primary-light)]/40' : ''">
                                    <td class="py-3 font-bold text-[var(--color-primary)]">#@ord.Reference</td>
                                    <td class="py-3 text-[var(--color-text)]">@ord.KitchenName</td>
                                    <td class="py-3 text-[var(--color-text-muted)]">@ord.CustomerName</td>
                                    <td class="py-3">
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(ord.Status == "Completed" ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" : "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300")">@ord.Status</span>
                                    </td>
                                    <td class="py-3 text-end">@ord.GrossAmount.ToString("N2", inv) EGP</td>
                                    <td class="py-3 text-end text-rose-600">-@ord.CommissionAmount.ToString("N2", inv) EGP</td>
                                    <td class="py-3 text-end font-bold text-emerald-600">@ord.NetChefPayable.ToString("N2", inv) EGP</td>
                                    <td class="py-3 text-end">
                                        <button type="button"
                                                @@click="selectedIndex = @i; window.scrollTo({ top: 0, behavior: 'smooth' })"
                                                class="text-xs font-bold text-[var(--color-primary)] hover:underline cursor-pointer">
                                            Inspect
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
