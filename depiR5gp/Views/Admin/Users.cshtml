@model depiR5gp.ViewModels.AdminUsers.UserListVM
@using depiR5gp.Models.Users
@{
    ViewData["Title"] = "User Accounts - Admin Portal";
    ViewData["ActiveAdminTab"] = "users";

    var filter = Model.Filter;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    string PageUrl(int page) =>
        $"/Admin/Users?page={page}&q={Uri.EscapeDataString(filter.Query ?? "")}&role={filter.Role}&status={filter.Status}";

    string BadgeClass(UserStatus status) => status switch
    {
        UserStatus.Active => "bg-emerald-100 dark:bg-emerald-950 text-emerald-950 dark:text-emerald-100 border-emerald-300 dark:border-emerald-700",
        UserStatus.Suspended => "bg-amber-100 dark:bg-amber-950 text-amber-950 dark:text-amber-100 border-amber-300 dark:border-amber-700",
        _ => "bg-neutral-200 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border-neutral-300 dark:border-neutral-600"
    };

    string StatusLabel(UserStatus status) => status switch
    {
        UserStatus.Active => "Active",
        UserStatus.Suspended => "Suspended",
        _ => "Deactivated"
    };
}
