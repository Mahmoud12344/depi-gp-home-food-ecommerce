                    <p class="text-xs text-[var(--color-text-muted)] mt-0.5">Search, filter roles, and manage account statuses</p>
                </div>

                <!-- Plain GET Search and Role filter -->
                <form method="get" action="/Admin/Users" class="flex flex-wrap items-center gap-2">
                    <input type="text"
                           name="q"
                           placeholder="Search by name or email..."
                           class="text-xs px-3 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-subtle)] text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                    <select name="role" onchange="this.form.submit()"
                            class="text-xs font-semibold px-3 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-subtle)] text-[var(--color-text)] focus:outline-hidden cursor-pointer">
                        <option value="all">All Roles</option>
                        <option value="customer">Customers</option>
                        <option value="chef">Chefs</option>
                        <option value="support">Support Agents</option>
                    </select>
                </form>
            </div>

