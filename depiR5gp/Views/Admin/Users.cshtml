<!-- Backlog Subtask: SCRUM-361 (bound to AdminUsersController / IUserManagementService) -->

<div x-data="{
    showSuspendModal: false,
    userToSuspendName: '',
    userToSuspendId: 0,
    newStatus: 'Suspended',
    suspendReason: 'Food hygiene or food safety compliance breach'
}" class="w-full pb-24">

    <div class="max-w-7xl mx-auto px-0 sm:px-2 lg:px-4 pt-2 space-y-5">
        <!-- TAB 3: User Accounts (SCRUM-361) -->
        <section class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-5 sm:p-6 shadow-xs">
            <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-5">
                <div class="max-w-xl">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--color-primary)]">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#users"></use></svg>
                        Account management
                    </div>
                    <h1 class="mt-2 text-xl sm:text-2xl font-bold text-[var(--color-text)]">Registered user accounts</h1>
                    <p class="mt-1 text-sm text-[var(--color-text-muted)]">Search accounts, review their role and order activity, and manage sign-in access.</p>
                </div>

                <form method="get" action="/Admin/Users" class="grid w-full xl:w-auto grid-cols-1 sm:grid-cols-2 xl:grid-cols-[minmax(250px,1fr)_auto_auto_auto] gap-2">
                    <div class="relative min-w-0">
                        <span class="absolute inset-y-0 left-3 flex items-center text-[var(--color-text-muted)] pointer-events-none">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </span>
                        <input type="text"
                               name="q"
                               value="@filter.Query"
                               placeholder="Search name, email, or kitchen"
                               class="w-full h-10 text-sm pl-9 pr-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-subtle)] text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                    </div>

                    <select name="role"
                            class="h-10 text-sm font-semibold px-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-subtle)] text-[var(--color-text)] focus:outline-hidden cursor-pointer">
                        <option value="all" selected="@(filter.Role.Equals("all", StringComparison.OrdinalIgnoreCase))">All Roles</option>
                        <option value="customer" selected="@(filter.Role.Equals("customer", StringComparison.OrdinalIgnoreCase))">Customers</option>
                        <option value="chef" selected="@(filter.Role.Equals("chef", StringComparison.OrdinalIgnoreCase))">Chefs</option>
                    </select>

                    <select name="status"
                            class="h-10 text-sm font-semibold px-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-subtle)] text-[var(--color-text)] focus:outline-hidden cursor-pointer">
                        <option value="all" selected="@(filter.Status.Equals("all", StringComparison.OrdinalIgnoreCase))">All Statuses</option>
                        <option value="active" selected="@(filter.Status.Equals("active", StringComparison.OrdinalIgnoreCase))">Active</option>
                        <option value="suspended" selected="@(filter.Status.Equals("suspended", StringComparison.OrdinalIgnoreCase))">Suspended</option>
                        <option value="deactivated" selected="@(filter.Status.Equals("deactivated", StringComparison.OrdinalIgnoreCase))">Deactivated</option>
                    </select>

                    <div class="flex items-center gap-2 shrink-0">
                        <button type="submit"
                                class="h-10 flex-1 sm:flex-none bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase tracking-wider px-4 rounded-xl transition-colors cursor-pointer shadow-xs">
                            Apply
                        </button>

                        @if (!string.IsNullOrWhiteSpace(filter.Query) || !filter.Role.Equals("all", StringComparison.OrdinalIgnoreCase) || !filter.Status.Equals("all", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="/Admin/Users" 
                               class="h-10 inline-flex items-center justify-center px-3 border border-[var(--color-border)] hover:border-[var(--color-primary)] bg-[var(--color-surface)] text-xs font-semibold uppercase tracking-wider rounded-xl transition-colors cursor-pointer text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
                               title="Reset all filters">
                                Reset
                            </a>
                        }
                    </div>
                </form>
            </div>
        </section>

        <section class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-xs">
            <div class="px-5 sm:px-6 py-3.5 border-b border-[var(--color-border)] flex items-center justify-between gap-3">
                <p class="text-sm font-semibold text-[var(--color-text)]">Accounts</p>
                <p class="text-xs text-[var(--color-text-muted)]">@Model.TotalCount total</p>
            </div>
            <div class="divide-y divide-[var(--color-border-light)]">
                @if (!Model.Items.Any())
                {
                    <div class="p-10 text-center text-sm text-[var(--color-text-muted)]">
                        No accounts match your filters.
                    </div>
                }

                @foreach (var u in Model.Items)
                {
                    <article class="p-4 sm:p-5 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] gap-4 lg:items-center hover:bg-[var(--color-surface-subtle)]/50 transition-colors">
                        <div class="min-w-0 flex items-start gap-3.5">
                            <div class="w-10 h-10 shrink-0 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] border border-[var(--color-border)] flex items-center justify-center text-xs font-bold">
                                @Initials(u.FullName)
                            </div>
                            <div class="min-w-0">
                                <h2 class="font-semibold text-[var(--color-text)] truncate">@u.FullName</h2>
                                <p class="mt-0.5 text-xs text-[var(--color-text-muted)] truncate" title="@u.Email">@u.Email</p>
                                <div class="mt-2 flex flex-wrap items-center gap-1.5 text-[11px]">
                                    <span class="inline-flex items-center rounded-md bg-[var(--color-surface-subtle)] border border-[var(--color-border)] px-2 py-1 text-[var(--color-text-muted)]">@u.Role</span>
                                    <span class="inline-flex items-center rounded-md bg-[var(--color-surface-subtle)] border border-[var(--color-border)] px-2 py-1 text-[var(--color-text-muted)]">@u.OrdersCount @(u.OrdersCount == 1 ? "order" : "orders")</span>
                                </div>
                            @if (u.Status != UserStatus.Active && !string.IsNullOrWhiteSpace(u.LastReason))
                            {
                                <p class="mt-2 text-xs leading-5 text-[var(--color-text-muted)] break-words"><span class="font-medium text-[var(--color-text)]">Access note:</span> @u.LastReason@(u.LastChangedAt.HasValue ? $" · {u.LastChangedAt.Value:dd MMM yyyy, HH:mm} UTC" : "")</p>
                            }
                        </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 lg:justify-end lg:max-w-[310px]">
                            <span class="text-[10px] font-bold px-2.5 py-1 rounded-full uppercase border @BadgeClass(u.Status)">
                                @StatusLabel(u.Status)
                            </span>

                            @if (u.Status != UserStatus.Active)
                            {
                                <form method="post" action="/Admin/Users/ChangeStatus" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <input type="hidden" name="newStatus" value="Active" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit"
                                            class="inline-flex items-center justify-center min-h-8 px-3 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-xs font-semibold text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-950 cursor-pointer transition-colors">
                                        Reactivate account
                                    </button>
                                </form>
                            }

                            @if (u.Status != UserStatus.Deleted)
                            {
                                <button type="button"
                                        @@click='userToSuspendId = @u.Id; userToSuspendName = @Json.Serialize(u.FullName); newStatus = "@(u.Status == UserStatus.Active ? "Suspended" : "Deleted")"; showSuspendModal = true'
                                        class="inline-flex items-center justify-center min-h-8 px-3 rounded-lg bg-rose-50 dark:bg-rose-950/40 text-xs font-semibold text-rose-700 dark:text-rose-300 hover:bg-rose-100 dark:hover:bg-rose-950 cursor-pointer transition-colors">
                                    @(u.Status == UserStatus.Active ? "Suspend account" : "Deactivate account")
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>

            <!-- Pagination -->
            <div class="p-4 border-t border-[var(--color-border)] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
                <span class="text-[var(--color-text-muted)]">
                    Showing @Model.FirstItemNumber–@Model.LastItemNumber of @Model.TotalCount accounts
                </span>
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Pagination" class="flex items-center gap-1">
                        @if (Model.Page > 1)
                        {
                            <a href="@PageUrl(Model.Page - 1)"
                               class="px-3 py-1.5 rounded-full border border-[var(--color-border)] font-semibold hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] cursor-pointer">Prev</a>
                        }
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <a href="@PageUrl(p)"
                               class="px-3 py-1.5 rounded-full border font-semibold cursor-pointer @(p == Model.Page ? "bg-[var(--color-primary)] text-white border-[var(--color-primary)]" : "border-[var(--color-border)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]")">@p</a>
                        }
                        @if (Model.Page < Model.TotalPages)
                        {
                            <a href="@PageUrl(Model.Page + 1)"
                               class="px-3 py-1.5 rounded-full border border-[var(--color-border)] font-semibold hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] cursor-pointer">Next</a>
                        }
                    </nav>
                }
            </div>
        </section>
    </div>

    <!-- User Suspension Reason Dialog (SCRUM-361) -->
    <div x-show="showSuspendModal"
         x-transition.opacity
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/60 backdrop-blur-xs"
         style="display: none;"
         role="dialog"
         aria-modal="true">
        <div @@click.away="showSuspendModal = false"
             class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-5">
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-2xl bg-rose-100 dark:bg-rose-950 text-rose-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#alert-triangle"></use></svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-[var(--color-text)]" x-text="newStatus === 'Deleted' ? 'Confirm Account Deactivation' : 'Confirm Account Suspension'">Confirm Account Suspension</h3>
                    <p class="text-xs text-[var(--color-text-muted)]" x-text="'User: ' + userToSuspendName"></p>
                </div>
            </div>

            <form method="post" action="/Admin/Users/ChangeStatus" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" :value="userToSuspendId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="space-y-3 text-xs">
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Action</label>
                    <select name="newStatus" x-model="newStatus" class="w-full p-2.5 bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl text-[var(--color-text)]">
                        <option value="Suspended">Suspend (temporary, can be reactivated)</option>
                        <option value="Deleted">Deactivate (account can no longer sign in)</option>
                    </select>

                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Official Justification</label>
                    <select name="reason" x-model="suspendReason" class="w-full p-2.5 bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl text-[var(--color-text)]">
                        <option value="Food hygiene or food safety compliance breach">Food hygiene or food safety compliance breach</option>
                        <option value="Excessive unfulfilled or cancelled orders">Excessive unfulfilled or cancelled orders</option>
                        <option value="Unresolved customer payment/counter charge dispute">Unresolved customer payment/counter charge dispute</option>
                        <option value="Abusive customer communications or terms breach">Abusive customer communications or terms breach</option>
                    </select>

                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Additional Note (optional)</label>
                    <textarea name="note" rows="2" maxlength="90"
                              class="w-full p-2.5 bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl text-[var(--color-text)]"></textarea>
                </div>

                <div class="flex justify-end gap-2 pt-2">
                    <button type="button"
                            @@click="showSuspendModal = false"
                            class="px-4 py-2 rounded-full border border-[var(--color-border)] text-xs font-bold uppercase tracking-wider cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit"
                            class="px-4 py-2 rounded-full bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold uppercase tracking-wider cursor-pointer"
                            x-text="newStatus === 'Deleted' ? 'Confirm Deactivation' : 'Confirm Suspension'">
                        Confirm Suspension
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
