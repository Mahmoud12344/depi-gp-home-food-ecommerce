                                </td>
                            </tr>
                            <tr>
                                <td class="p-2.5 text-[var(--color-text-muted)]">Oct 14, 2026</td>
                                <td class="p-2.5 font-semibold text-[var(--color-text)]">Om Nabil Casseroles</td>
                                <td class="p-2.5 text-end font-bold text-emerald-600">3,800.00 EGP</td>
                                <td class="p-2.5">Bank Wire (CIB)</td>
                                <td class="p-2.5 text-center">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Completed</span>
                                </td>
                            </tr>
