                        <p class="text-lg font-bold text-emerald-600 mt-1">41,582.00 EGP</p>
                    </div>
                </div>
            </div>

            <!-- SVG KPI Trend Charts (SCRUM-366) -->
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 space-y-4 shadow-xs">
                <div class="flex items-center justify-between">
                    <div>
