@model depiR5gp.ViewModels.AdminDashboard.AdminDashboardVM
@using System.Globalization
@{
    ViewData["Title"] = "Platform KPIs & Balances - Admin Portal";
    ViewData["ActiveAdminTab"] = "kpis";

    var inv = CultureInfo.InvariantCulture;

    string RangePillClass(string key) =>
        string.Equals(Model.DateRangeKey, key, StringComparison.OrdinalIgnoreCase)
            ? "bg-[var(--color-primary)] text-white shadow-xs"
            : "bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800";

    string FormatMoney(decimal amount) => $"{amount.ToString("N2", inv)} EGP";
}

<div x-data="{
    showCashModal: false,
    showPayoutModal: false,
    showSettlementModal: false
}" class="w-full pb-24">

    <partial name="~/Views/Admin/Partials/_AdminNav.cshtml" />

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        
        <!-- ROW 1: Date Range Filter Bar & Primary Revenue / Order Summary Cards -->
        <div class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[var(--color-border)] pb-4">
                <div>
                    <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">
                        Performance Overview · @Model.DateRangeLabel
                    </h2>
                    <p class="text-xs text-[var(--color-text-muted)]">
                        Real-time platform metrics and revenue velocity for the selected period
                    </p>
                </div>

                <div class="flex items-center gap-2 flex-wrap" role="group" aria-label="Date range filter">
                    <a href="/Admin?range=7d" class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer @RangePillClass("7d")">Last 7 Days</a>
                    <a href="/Admin?range=month" class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer @RangePillClass("month")">This Month</a>
                    <a href="/Admin?range=ytd" class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer @RangePillClass("ytd")">Year-to-Date</a>
                    <a href="/Admin?range=all" class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer @RangePillClass("all")">All Time</a>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Gross Revenue (@Model.DateRangeLabel)</span>
                    <p class="text-2xl font-bold text-[var(--color-text)] mt-1">@FormatMoney(Model.GrossRevenue)</p>
                    <p class="text-[11px] text-[var(--color-primary)] font-semibold mt-1">Commission: @FormatMoney(Model.PlatformCommission)</p>
                </div>
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Total Orders (@Model.DateRangeLabel)</span>
                    <p class="text-2xl font-bold text-[var(--color-primary)] mt-1">@Model.TotalOrders</p>
                    <p class="text-[11px] text-[var(--color-text-muted)] mt-1">@Model.DeliveredOrdersCount delivered · @Model.PendingOrdersCount pending</p>
                </div>
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">All-Time Platform GMV</span>
                    <p class="text-2xl font-bold text-[var(--color-text)] mt-1">@FormatMoney(Model.AllTimeRevenue)</p>
                    <p class="text-[11px] text-emerald-600 font-semibold mt-1">Cumulative volume</p>
                </div>
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">All-Time Cumulative Orders</span>
                    <p class="text-2xl font-bold text-[var(--color-text)] mt-1">@Model.AllTimeOrdersCount</p>
                    <p class="text-[11px] text-[var(--color-text-muted)] mt-1">Platform-wide orders</p>
                </div>
            </div>
        </div>

        <!-- ROW 2: Platform Health KPI Badges with Accent Borders and Icons -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] border-l-4 border-l-amber-500 rounded-2xl p-4 shadow-xs flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)] block">Pending Orders</span>
                    <p class="text-2xl font-bold text-amber-600 mt-0.5">@Model.PendingOrdersCount</p>
                    <span class="text-[10px] text-[var(--color-text-muted)]">Awaiting fulfillment</span>
                </div>
                <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#clock"></use></svg>
                </div>
            </div>

            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] border-l-4 border-l-blue-500 rounded-2xl p-4 shadow-xs flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)] block">Total Users</span>
                    <p class="text-2xl font-bold text-blue-600 mt-0.5">@Model.TotalUsers</p>
                    <span class="text-[10px] text-[var(--color-text-muted)]">Registered accounts</span>
                </div>
                <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950/60 text-blue-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#users"></use></svg>
                </div>
            </div>

            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] border-l-4 border-l-emerald-500 rounded-2xl p-4 shadow-xs flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)] block">Active Kitchens</span>
                    <p class="text-2xl font-bold text-emerald-600 mt-0.5">@Model.ActiveKitchensCount</p>
                    <span class="text-[10px] text-[var(--color-text-muted)]">@Model.PendingApplicationsCount pending apps</span>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chef-hat"></use></svg>
                </div>
            </div>

            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] border-l-4 border-l-[var(--color-primary)] rounded-2xl p-4 shadow-xs flex items-center justify-between">
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)] block">Total Menu Dishes</span>
                    <p class="text-2xl font-bold text-[var(--color-primary)] mt-0.5">@Model.TotalDishesCount</p>
                    <span class="text-[10px] text-[var(--color-text-muted)]">Active listings</span>
                </div>
                <div class="w-10 h-10 rounded-xl bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
                </div>
            </div>
        </div>

        <!-- ROW 3: Chart.js Analytics (Top Performing Kitchens & Order Fulfillment Ratio) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">Top Performing Kitchens</h3>
                        <p class="text-xs text-[var(--color-text-muted)]">Ranked by gross revenue for @Model.DateRangeLabel</p>
                    </div>
                </div>
                <div class="h-64 w-full relative">
                    <canvas id="topKitchensChart"></canvas>
                </div>
            </div>

            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 shadow-xs flex flex-col justify-between">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">Order Fulfillment Ratio</h3>
                        <p class="text-xs text-[var(--color-text-muted)]">Delivered vs Pending orders for @Model.DateRangeLabel</p>
                    </div>
                    <span class="text-xs font-bold text-[var(--color-text-muted)]">@Model.TotalOrders total</span>
                </div>
                <div class="h-64 w-full relative">
                    <canvas id="fulfillmentDoughnutChart"></canvas>
                </div>
            </div>
        </div>

        <!-- ROW 4: Revenue Velocity Trend (Smooth Area Line Chart) -->
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 space-y-4 shadow-xs">
            <div class="flex items-center justify-between flex-wrap gap-2">
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">Revenue Velocity Trend</h3>
                    <p class="text-xs text-[var(--color-text-muted)]">Progression of gross platform volume across @Model.DateRangeLabel</p>
                </div>
                <span class="text-xs font-bold text-[var(--color-primary)] bg-[var(--color-primary-light)] px-3 py-1 rounded-full">
                    @FormatMoney(Model.GrossRevenue) Total
                </span>
            </div>
            <div class="h-72 w-full relative pt-2">
                <canvas id="revenueTrendChart"></canvas>
            </div>
        </div>

        <!-- ROW 5: Preserved Financial Position Summary & Modals -->
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 space-y-6 shadow-xs">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">
                    Platform Financial Position &amp; Actions (@Model.DateRangeLabel)
                </h3>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" @@click="showCashModal = true"
                            class="px-3.5 py-1.5 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#wallet"></use></svg>
                        <span>Reconcile Cash</span>
                    </button>
                    <button type="button" @@click="showPayoutModal = true"
                            class="px-3.5 py-1.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#credit-card"></use></svg>
                        <span>Disburse Payout</span>
                    </button>
                    <button type="button" @@click="showSettlementModal = true"
                            class="px-3.5 py-1.5 rounded-full border border-[var(--color-border)] hover:bg-neutral-100 dark:hover:bg-neutral-800 text-[var(--color-text)] text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#file-text"></use></svg>
                        <span>Inspect Settlement</span>
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
                <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="font-bold text-[var(--color-text-muted)] block">Card Payments (Stripe Test):</span>
                    <p class="text-lg font-bold text-[var(--color-text)] mt-1">@FormatMoney(Model.CardPaymentsTotal)</p>
                </div>
                <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="font-bold text-[var(--color-text-muted)] block">Cash on Pickup Collections:</span>
                    <p class="text-lg font-bold text-[var(--color-text)] mt-1">@FormatMoney(Model.CashCollectionsTotal)</p>
                </div>
                <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="font-bold text-[var(--color-text-muted)] block">Total Chef Payout Liabilities:</span>
                    <p class="text-lg font-bold text-emerald-600 mt-1">@FormatMoney(Model.ChefPayoutLiabilities)</p>
                </div>
            </div>
        </div>

    </div>

    <!-- Modal 1: Cash Collections Reconciliation Modal -->
    <div x-show="showCashModal"
         x-transition.opacity.duration.200ms
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/60 backdrop-blur-xs"
         style="display: none;"
         role="dialog"
         aria-modal="true">

        <div @@click.away="showCashModal = false"
             x-show="showCashModal"
             x-transition.scale.origin.center.duration.200ms
             class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl space-y-6">

            <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#wallet"></use></svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-[var(--color-text)]">
                            Cash Collections &amp; Commission Reconciliation
                        </h3>
                        <p class="text-xs text-[var(--color-text-muted)]">
                            Reconcile cash collected by chefs against the 15% platform commission owed
                        </p>
                    </div>
                </div>
                <button type="button"
                        @@click="showCashModal = false"
                        class="p-2 rounded-full text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                </button>
            </div>

            <!-- Summary Banner -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                <div class="p-3.5 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] font-bold uppercase text-[var(--color-text-muted)] block">Total Cash Collected</span>
                    <span class="text-base font-bold text-[var(--color-text)]">@FormatMoney(Model.CashCollectionsTotal)</span>
                </div>
                <div class="p-3.5 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] font-bold uppercase text-[var(--color-text-muted)] block">Platform Commission (15%)</span>
                    <span class="text-base font-bold text-[var(--color-primary)]">@FormatMoney(Model.CashCollectionsTotal * 0.15m)</span>
                </div>
                <div class="p-3.5 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] font-bold uppercase text-[var(--color-text-muted)] block">Pending Cash Offset</span>
                    <span class="text-base font-bold text-amber-600">@FormatMoney(Model.CashCollectionsTotal * 0.15m)</span>
                </div>
            </div>

            <!-- Chef Collections Ledger Table -->
            <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden text-xs">
                <table class="w-full text-start">
                    <thead class="bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] font-bold text-[10px] uppercase text-[var(--color-text-muted)]">
                        <tr>
                            <th class="p-3 text-start">Kitchen / Chef</th>
                            <th class="p-3 text-end">Cash Taken</th>
                            <th class="p-3 text-end">Commission (15%)</th>
                            <th class="p-3 text-center">Status</th>
                            <th class="p-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--color-border-light)]">
                        <tr>
                            <td class="p-3 font-semibold text-[var(--color-text)]">Amina's Heritage Kitchen</td>
                            <td class="p-3 text-end font-medium">6,800.00 EGP</td>
                            <td class="p-3 text-end text-[var(--color-primary)] font-bold">1,020.00 EGP</td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Offset Settled</span>
                            </td>
                            <td class="p-3 text-end">
                                <span class="text-xs text-[var(--color-text-muted)]">Audited</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-[var(--color-text)]">Om Nabil Casseroles</td>
                            <td class="p-3 text-end font-medium">3,450.00 EGP</td>
                            <td class="p-3 text-end text-[var(--color-primary)] font-bold">517.50 EGP</td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Offset Settled</span>
                            </td>
                            <td class="p-3 text-end">
                                <span class="text-xs text-[var(--color-text-muted)]">Audited</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-[var(--color-text)]">Hany's Gourmet Grills</td>
                            <td class="p-3 text-end font-medium">2,270.00 EGP</td>
                            <td class="p-3 text-end text-[var(--color-primary)] font-bold">340.50 EGP</td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">Awaiting Offset</span>
                            </td>
                            <td class="p-3 text-end">
                                <form method="post" action="/Admin/Payouts" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="chefId" value="chef-3" />
                                    <button type="submit"
                                            class="px-3 py-1 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white font-bold text-[11px] cursor-pointer">
                                        Reconcile
                                    </button>
                                </form>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="flex items-center justify-between text-xs text-[var(--color-text-muted)] pt-3 border-t border-[var(--color-border-light)]">
                <span>Platform policy: Cash order commissions are automatically deducted from digital card order payouts.</span>
                <button type="button"
                        @@click="showCashModal = false"
                        class="px-4 py-2 rounded-full border border-[var(--color-border)] hover:bg-neutral-100 dark:hover:bg-neutral-800 font-bold uppercase tracking-wider text-[var(--color-text)]">
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- Modal 2: Admin Payout Modal -->
    <div x-show="showPayoutModal"
         x-transition.opacity.duration.200ms
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/60 backdrop-blur-xs"
         style="display: none;"
         role="dialog"
         aria-modal="true">

        <div @@click.away="showPayoutModal = false"
             x-show="showPayoutModal"
             x-transition.scale.origin.center.duration.200ms
             class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">

            <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#credit-card"></use></svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-[var(--color-text)]">
                            Disburse Chef Earnings &amp; Payouts
                        </h3>
                        <p class="text-xs text-[var(--color-text-muted)]">
                            Authorize and execute net earnings transfers via InstaPay GPA or bank wire
                        </p>
                    </div>
                </div>
                <button type="button"
                        @@click="showPayoutModal = false"
                        class="p-2 rounded-full text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                </button>
            </div>

            <!-- Disbursement Form -->
            <form method="post" action="/Admin/Payouts" class="space-y-4 text-xs">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Select Kitchen / Chef
                        </label>
                        <select name="chefId" required class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]">
                            <option value="chef-1">Amina's Heritage Kitchen (Eligible: 8,420.00 EGP)</option>
                            <option value="chef-2">Om Nabil Casseroles (Eligible: 4,120.00 EGP)</option>
                            <option value="chef-3">Hany's Gourmet Grills (Eligible: 1,930.00 EGP)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Transfer Channel
                        </label>
                        <select name="paymentMethod" required class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]">
                            <option value="instapay">InstaPay GPA Instant Transfer (Egypt)</option>
                            <option value="bank">Domestic Bank Wire (IBAN)</option>
                            <option value="vodafone_cash">Smart Mobile Wallet (Vodafone Cash)</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Payout Amount (EGP)
                        </label>
                        <input type="number" name="amount" step="0.01" value="8420.00" required
                               class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-bold text-sm" />
                    </div>

                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Batch Code / Reference
                        </label>
                        <input type="text" name="referenceNote" value="BATCH-2026-W42-PAYOUT" required
                               class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-mono text-xs" />
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button type="submit"
                            class="px-5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-sm">
                        Authorize &amp; Disburse Payout
                    </button>
                </div>
            </form>

            <!-- Payout History Log Table -->
            <div class="space-y-2 pt-2 border-t border-[var(--color-border-light)] text-xs">
                <h4 class="font-bold uppercase text-[var(--color-text)] text-xs">
                    Recent Payout Disbursement Log
                </h4>
                <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden">
                    <table class="w-full text-start">
                        <thead class="bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] font-bold text-[10px] uppercase text-[var(--color-text-muted)]">
                            <tr>
                                <th class="p-2.5 text-start">Date</th>
                                <th class="p-2.5 text-start">Kitchen</th>
                                <th class="p-2.5 text-end">Amount</th>
                                <th class="p-2.5 text-start">Channel</th>
                                <th class="p-2.5 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--color-border-light)] text-[11px]">
                            <tr>
                                <td class="p-2.5 text-[var(--color-text-muted)]">Oct 20, 2026</td>
                                <td class="p-2.5 font-semibold text-[var(--color-text)]">Amina's Heritage Kitchen</td>
                                <td class="p-2.5 text-end font-bold text-emerald-600">6,500.00 EGP</td>
                                <td class="p-2.5">InstaPay GPA</td>
                                <td class="p-2.5 text-center">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Completed</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="p-2.5 text-[var(--color-text-muted)]">Oct 14, 2026</td>
                                <td class="p-2.5 font-semibold text-[var(--color-text)]">Om Nabil Casseroles</td>
                                <td class="p-2.5 text-end font-bold text-emerald-600">3,800.00 EGP</td>
                                <td class="p-2.5">Bank Wire (CIB)</td>
                                <td class="p-2.5 text-center">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Completed</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 3: Order Settlement Modal -->
    <div x-show="showSettlementModal"
         x-transition.opacity.duration.200ms
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/60 backdrop-blur-xs"
         style="display: none;"
         role="dialog"
         aria-modal="true">

        <div @@click.away="showSettlementModal = false"
             x-show="showSettlementModal"
             x-transition.scale.origin.center.duration.200ms
             class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl space-y-6">

            <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#file-text"></use></svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-[var(--color-text)]">
                            Order Financial Settlement Breakdown
                        </h3>
                        <p class="text-xs text-[var(--color-text-muted)]">Order #HC-2026-9041 · Amina's Heritage Kitchen</p>
                    </div>
                </div>
                <button type="button"
                        @@click="showSettlementModal = false"
                        class="p-2 rounded-full text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                </button>
            </div>

            <div class="space-y-3 bg-[var(--color-surface-subtle)] p-4 rounded-2xl border border-[var(--color-border-light)] text-xs">
                <div class="flex justify-between items-center text-[var(--color-text-muted)]">
                    <span>Customer Paid (Gross GMV):</span>
                    <span class="font-bold text-[var(--color-text)] text-sm">240.00 EGP</span>
                </div>
                <div class="flex justify-between items-center text-rose-600 dark:text-rose-400">
                    <span>Platform Commission (15%):</span>
                    <span class="font-bold">-36.00 EGP</span>
                </div>
                <div class="flex justify-between items-center text-[var(--color-text-muted)]">
                    <span>Payment Gateway Processing (0% promo):</span>
                    <span class="font-semibold">0.00 EGP</span>
                </div>
                <div class="flex justify-between items-center pt-2 border-t border-[var(--color-border)] text-sm font-bold">
                    <span class="text-[var(--color-text)]">Net Chef Earnings Payable:</span>
                    <span class="text-emerald-600 dark:text-emerald-400 text-base">204.00 EGP</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="p-3 bg-[var(--color-surface-subtle)] rounded-xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] uppercase font-bold text-[var(--color-text-muted)] block">Payment Channel</span>
                    <span class="font-semibold text-[var(--color-text)]">Stripe Card (Visa ···· 4242)</span>
                </div>
                <div class="p-3 bg-[var(--color-surface-subtle)] rounded-xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] uppercase font-bold text-[var(--color-text-muted)] block">Settlement Status</span>
                    <span class="font-bold text-emerald-600">Settled to Chef Wallet</span>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-[var(--color-border-light)]">
                <button type="button"
                        @@click="showSettlementModal = false"
                        class="px-5 py-2.5 rounded-full bg-[var(--color-primary)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof Chart === 'undefined') {
                console.warn('Chart.js failed to load or is unavailable.');
                return;
            }

            try {
                const revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueLabels));
                const revenueValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueValues));
                const topKitchenNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopKitchenNames));
                const topKitchenRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopKitchenRevenues));
                const deliveredCount = @Model.DeliveredOrdersCount;
                const pendingCount = @Model.PendingOrdersCount;

                // 1. Top Kitchens (Horizontal Bar Chart)
                const kitchenCanvas = document.getElementById('topKitchensChart');
                if (kitchenCanvas) {
                    new Chart(kitchenCanvas, {
                        type: 'bar',
                        data: {
                            labels: topKitchenNames.length ? topKitchenNames : ['No Kitchens'],
                            datasets: [{
                                label: 'Revenue (EGP)',
                                data: topKitchenRevenues.length ? topKitchenRevenues : [0],
                                backgroundColor: 'rgba(235, 94, 40, 0.85)',
                                borderColor: 'rgba(235, 94, 40, 1)',
                                borderWidth: 1,
                                borderRadius: 6
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: (ctx) => ' ' + Number(ctx.raw).toLocaleString('en-US') + ' EGP'
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { color: 'rgba(156, 163, 175, 0.15)' },
                                    ticks: {
                                        callback: (val) => Number(val).toLocaleString() + ' EGP',
                                        font: { size: 10 }
                                    }
                                },
                                y: {
                                    grid: { display: false },
                                    ticks: { font: { size: 11, weight: 'bold' } }
                                }
                            }
                        }
                    });
                }

                // 2. Order Fulfillment Ratio (Doughnut Chart)
                const fulfillmentCanvas = document.getElementById('fulfillmentDoughnutChart');
                if (fulfillmentCanvas) {
                    const totalFulfillment = deliveredCount + pendingCount;
                    new Chart(fulfillmentCanvas, {
                        type: 'doughnut',
                        data: {
                            labels: totalFulfillment > 0 ? ['Delivered Orders', 'Pending / In Progress'] : ['No Orders Recorded'],
                            datasets: [{
                                data: totalFulfillment > 0 ? [deliveredCount, pendingCount] : [1],
                                backgroundColor: totalFulfillment > 0 ? ['#10b981', '#f59e0b'] : ['#e5e7eb'],
                                borderWidth: 2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '68%',
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        boxWidth: 12,
                                        padding: 16,
                                        font: { size: 11, weight: 'bold' }
                                    }
                                },
                                tooltip: {
                                    enabled: totalFulfillment > 0,
                                    callbacks: {
                                        label: (ctx) => {
                                            const val = ctx.raw;
                                            const pct = totalFulfillment > 0 ? Math.round((val / totalFulfillment) * 100) : 0;
                                            return ` ${ctx.label}: ${val} (${pct}%)`;
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                // 3. Revenue Velocity Trend (Area Line Chart)
                const trendCanvas = document.getElementById('revenueTrendChart');
                if (trendCanvas) {
                    const ctx2d = trendCanvas.getContext('2d');
                    let fillGradient = 'rgba(235, 94, 40, 0.15)';
                    if (ctx2d) {
                        const grad = ctx2d.createLinearGradient(0, 0, 0, 260);
                        grad.addColorStop(0, 'rgba(235, 94, 40, 0.35)');
                        grad.addColorStop(1, 'rgba(235, 94, 40, 0.0)');
                        fillGradient = grad;
                    }

                    new Chart(trendCanvas, {
                        type: 'line',
                        data: {
                            labels: revenueLabels.length ? revenueLabels : ['No Data'],
                            datasets: [{
                                label: 'Gross Revenue',
                                data: revenueValues.length ? revenueValues : [0],
                                borderColor: '#eb5e28',
                                backgroundColor: fillGradient,
                                borderWidth: 3,
                                tension: 0.4,
                                fill: true,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                pointBackgroundColor: '#eb5e28',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: (ctx) => ' Revenue: ' + Number(ctx.raw).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' EGP'
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { font: { size: 11 } }
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: 'rgba(156, 163, 175, 0.15)' },
                                    ticks: {
                                        font: { size: 10 },
                                        callback: (val) => Number(val).toLocaleString() + ' EGP'
                                    }
                                }
                            }
                        }
                    });
                }
            } catch (err) {
                console.error('Error initializing Admin Dashboard Chart.js charts:', err);
            }
        });
    </script>
}
