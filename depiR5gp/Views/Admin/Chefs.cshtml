                    </div>
                    <h3 class="text-sm font-bold uppercase text-[var(--color-text)]">Amina's Heritage Kitchen</h3>
                    <p class="text-[var(--color-text-muted)]">Chef Amina Mansour &middot; Maadi, Cairo</p>
