                </div>
                <div class="pt-3 border-t border-[var(--color-border-light)] flex items-center justify-between">
                    <a href="/Chefs/Details/2" class="text-[var(--color-primary)] font-bold hover:underline">View Public Storefront &rarr;</a>
                    <form method="post" asp-controller="Admin" asp-action="RejectChef" class="inline">
                        <input type="hidden" name="ChefProfileId" value="2" />
                        <input type="hidden" name="RejectionReason" value="Administrative compliance review" />
                        <button type="submit" class="text-rose-600 hover:underline font-semibold cursor-pointer">Revoke Badge</button>
                    </form>
                </div>
            </div>

            <!-- Verified Chef 3 -->
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-5 shadow-xs flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                            Verified &middot; Active
                        </span>
                        <span class="font-bold text-amber-600">4.9 &#9733; (51 orders)</span>
                    </div>
                    <h3 class="text-sm font-bold uppercase text-[var(--color-text)]">Om Nabil Casseroles</h3>
                    <p class="text-[var(--color-text-muted)]">Chef Samira Nabil &middot; Dokki, Giza</p>
