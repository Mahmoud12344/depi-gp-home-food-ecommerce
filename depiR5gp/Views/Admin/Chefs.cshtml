                </div>
                <div class="pt-3 border-t border-[var(--color-border-light)] flex items-center justify-between">
                    <a href="/Chefs/Details/1" class="text-[var(--color-primary)] font-bold hover:underline">View Public Storefront &rarr;</a>
                    <form method="post" asp-controller="Admin" asp-action="RejectChef" class="inline">
                        <input type="hidden" name="ChefProfileId" value="1" />
                        <input type="hidden" name="RejectionReason" value="Administrative compliance review" />
                        <button type="submit" class="text-rose-600 hover:underline font-semibold cursor-pointer">Revoke Badge</button>
                    </form>
