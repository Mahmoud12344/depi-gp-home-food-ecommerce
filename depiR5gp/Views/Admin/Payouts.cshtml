@* Views/Admin/Payouts.cshtml *@
@* TODO [Backend]: @model IEnumerable<depiR5gp.Models.Payments.Payout> *@
@{
    ViewData["Title"] = "Chef Payouts & Financial Ledger - Admin Portal";
}

<partial name="~/Views/Admin/Partials/_AdminNav.cshtml" />

<main x-data="{ showPayoutModal: false }" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-24 space-y-8">

    <!-- Top Summary Cards & Modal Trigger -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">
                Eligible Chef Payout Liabilities
            </span>
            <p class="text-2xl font-bold text-emerald-600 mt-1">14,470.00 EGP</p>
            <p class="text-[11px] text-[var(--color-text-muted)] mt-1">Across 3 verified kitchens</p>
        </div>

        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">
                Disbursed This Month (October)
            </span>
            <p class="text-2xl font-bold text-[var(--color-text)] mt-1">27,112.00 EGP</p>
            <p class="text-[11px] text-[var(--color-text-muted)] mt-1">Via InstaPay GPA &amp; Bank Wire</p>
        </div>

        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs flex flex-col justify-between">
            <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">
                    Batch Disbursement Action
                </span>
                <p class="text-xs text-[var(--color-text-muted)] mt-1">Authorize instant transfer or open batch payout modal.</p>
            </div>
            <button type="button"
                    @@click="showPayoutModal = true"
                    class="mt-3 w-full py-2 px-4 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs flex items-center justify-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#credit-card"></use></svg>
                <span>Open Disbursement Modal</span>
            </button>
        </div>
    </div>

    <!-- Quick Process Payout Form (Standard MVC POST) -->
    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-4">
        <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">
                Direct Chef Payout Disbursement
            </h2>
            <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
                Execute an immediate payout transfer and record a double-entry ledger debit against the kitchen's wallet balance.
            </p>
        </div>

        <form method="post" asp-controller="Admin" asp-action="ProcessPayout" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end text-xs">
            <div class="lg:col-span-2">
                <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Kitchen / Chef</label>
                <select name="ChefProfileId" required class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2.5 text-[var(--color-text)] font-medium">
                    <option value="1">Amina's Heritage Kitchen (Eligible: 8,420.00 EGP)</option>
                    <option value="3">Om Nabil Casseroles (Eligible: 4,120.00 EGP)</option>
                    <option value="2">Hany's Gourmet Grills (Eligible: 1,930.00 EGP)</option>
                </select>
            </div>
            <div>
                <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Amount (EGP)</label>
                <input type="number"
                       name="Amount"
                       step="0.01"
                       min="100"
                       value="8420.00"
                       required
                       class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2.5 text-[var(--color-text)] font-bold" />
            </div>
            <div>
                <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">Transfer Channel</label>
                <select name="PaymentMethod" required class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2.5 text-[var(--color-text)] font-medium">
                    <option value="InstaPay">InstaPay GPA</option>
                    <option value="BankWire">Bank Wire (IBAN)</option>
                    <option value="VodafoneCash">Vodafone Cash</option>
                </select>
                <input type="hidden" name="ReferenceNote" value="BATCH-2026-W43-PAYOUT" />
            </div>
            <div>
                <button type="submit"
                        class="w-full py-2.5 px-4 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs">
                    Process Payout
                </button>
            </div>
        </form>
    </div>

    <!-- Chef Payouts History Table -->
    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-xs">
        <div class="p-6 border-b border-[var(--color-border)]">
            <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">
                Chef Payouts Schedule &amp; History
            </h2>
            <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
                Completed and pending payout batches across all verified domestic kitchens.
            </p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-start text-xs">
                <thead class="bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] font-bold text-[10px] uppercase tracking-wider text-[var(--color-text-muted)]">
                    <tr>
                        <th class="p-4 text-start">Reference Code</th>
                        <th class="p-4 text-start">Kitchen / Chef</th>
                        <th class="p-4 text-start">Date</th>
                        <th class="p-4 text-start">Transfer Channel</th>
                        <th class="p-4 text-end">Net Disbursed</th>
                        <th class="p-4 text-center">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--color-border-light)]">
                    @* TODO [Backend]: @foreach (var payout in Model) — depiR5gp.Models.Payments.Payout *@

                    <tr class="hover:bg-[var(--color-surface-subtle)]/40 transition-colors">
                        <td class="p-4 font-mono font-bold text-[var(--color-primary)]">BATCH-2026-W43-01</td>
                        <td class="p-4 font-bold text-[var(--color-text)]">Hany's Gourmet Grills</td>
                        <td class="p-4 text-[var(--color-text-muted)]">Oct 26, 2026</td>
                        <td class="p-4">InstaPay GPA</td>
                        <td class="p-4 text-end font-bold text-amber-600">1,930.00 EGP</td>
                        <td class="p-4 text-center">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200 border border-amber-300 dark:border-amber-800">
                                Pending Approval
                            </span>
                        </td>
                    </tr>

                    <tr class="hover:bg-[var(--color-surface-subtle)]/40 transition-colors">
                        <td class="p-4 font-mono font-bold text-[var(--color-primary)]">BATCH-2026-W42-09</td>
                        <td class="p-4 font-bold text-[var(--color-text)]">Amina's Heritage Kitchen</td>
                        <td class="p-4 text-[var(--color-text-muted)]">Oct 20, 2026</td>
                        <td class="p-4">InstaPay GPA</td>
                        <td class="p-4 text-end font-bold text-emerald-600">6,500.00 EGP</td>
                        <td class="p-4 text-center">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
                                Completed
                            </span>
                        </td>
                    </tr>

                    <tr class="hover:bg-[var(--color-surface-subtle)]/40 transition-colors">
                        <td class="p-4 font-mono font-bold text-[var(--color-primary)]">BATCH-2026-W41-04</td>
                        <td class="p-4 font-bold text-[var(--color-text)]">Om Nabil Casseroles</td>
                        <td class="p-4 text-[var(--color-text-muted)]">Oct 14, 2026</td>
                        <td class="p-4">Bank Wire (CIB)</td>
                        <td class="p-4 text-end font-bold text-emerald-600">3,800.00 EGP</td>
                        <td class="p-4 text-center">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
                                Completed
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Platform Double-Entry Financial Ledger Table -->
    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-xs">
        <div class="p-6 border-b border-[var(--color-border)]">
            <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">
                Platform Financial Ledger Entries
            </h2>
            <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
                Immutable audit trail of order credits, 15% commission deductions, cash offsets, and payout debits.
            </p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-start text-xs">
                <thead class="bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] font-bold text-[10px] uppercase tracking-wider text-[var(--color-text-muted)]">
                    <tr>
                        <th class="p-4 text-start">Ledger Entry ID</th>
                        <th class="p-4 text-start">Timestamp</th>
                        <th class="p-4 text-start">Kitchen / Account</th>
                        <th class="p-4 text-start">Entry Type &amp; Description</th>
                        <th class="p-4 text-end">Amount</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--color-border-light)]">
                    @* TODO [Backend]: @foreach (var entry in ViewBag.LedgerEntries) — depiR5gp.Models.Payments.LedgerEntry *@

                    <tr>
                        <td class="p-4 font-mono text-[var(--color-text-muted)]">LED-2026-8812</td>
                        <td class="p-4 text-[var(--color-text-muted)]">Oct 26, 2026 12:18</td>
                        <td class="p-4 font-semibold text-[var(--color-text)]">Amina's Heritage Kitchen</td>
                        <td class="p-4">Order #HC-2026-9041 Net Chef Credit (85% of 240.00 EGP)</td>
                        <td class="p-4 text-end font-bold text-emerald-600">+204.00 EGP</td>
                    </tr>

                    <tr>
                        <td class="p-4 font-mono text-[var(--color-text-muted)]">LED-2026-8811</td>
                        <td class="p-4 text-[var(--color-text-muted)]">Oct 26, 2026 12:18</td>
                        <td class="p-4 font-semibold text-[var(--color-primary)]">Platform Commission Account</td>
                        <td class="p-4">Order #HC-2026-9041 Platform Fee (15% Commission)</td>
                        <td class="p-4 text-end font-bold text-[var(--color-primary)]">+36.00 EGP</td>
                    </tr>

                    <tr>
                        <td class="p-4 font-mono text-[var(--color-text-muted)]">LED-2026-8790</td>
                        <td class="p-4 text-[var(--color-text-muted)]">Oct 20, 2026 16:05</td>
                        <td class="p-4 font-semibold text-[var(--color-text)]">Amina's Heritage Kitchen</td>
                        <td class="p-4">Payout Disbursement via InstaPay GPA (BATCH-2026-W42-09)</td>
                        <td class="p-4 text-end font-bold text-rose-600">-6,500.00 EGP</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Payout Modal -->
    <partial name="~/Views/Admin/Partials/_AdminPayoutModal.cshtml" />
</main>
