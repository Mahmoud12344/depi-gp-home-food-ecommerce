@{
    ViewData["Title"] = "Cash & Payouts - Admin Portal";
    ViewData["ActiveAdminTab"] = "payouts";
}
<!-- Views/Admin/Payouts.cshtml -->
<!-- Source: Views/Admin/Partials/_CashReconciliationModal.cshtml & _AdminPayoutModal.cshtml (SCRUM-519 & SCRUM-523) -->
<!-- TODO(backend): Bind CashCollections, EligiblePayouts, and PayoutHistoryLog; handle POST /Admin/Payouts -->

<div class="w-full pb-24">
    <partial name="~/Views/Admin/Partials/_AdminNav.cshtml" />

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <!-- Section 1: Cash Collections & Commission Reconciliation (from _CashReconciliationModal.cshtml) -->
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#wallet"></use></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[var(--color-text)]">
                        Cash Collections &amp; Commission Reconciliation
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]">
                        Reconcile cash collected by chefs against the 15% platform commission owed
                    </p>
                </div>
            </div>

            <!-- Summary Banner -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                <div class="p-3.5 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] font-bold uppercase text-[var(--color-text-muted)] block">Total Cash Collected</span>
                    <span class="text-base font-bold text-[var(--color-text)]">12,520.00 EGP</span>
                </div>
                <div class="p-3.5 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] font-bold uppercase text-[var(--color-text-muted)] block">Platform Commission (15%)</span>
                    <span class="text-base font-bold text-[var(--color-primary)]">1,878.00 EGP</span>
                </div>
                <div class="p-3.5 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] font-bold uppercase text-[var(--color-text-muted)] block">Pending Cash Offset</span>
                    <span class="text-base font-bold text-amber-600">340.00 EGP</span>
                </div>
            </div>

            <!-- Chef Collections Ledger Table -->
            <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden text-xs">
                <table class="w-full text-start">
                    <thead class="bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] font-bold text-[10px] uppercase text-[var(--color-text-muted)]">
                        <tr>
                            <th class="p-3 text-start">Kitchen / Chef</th>
                            <th class="p-3 text-end">Cash Taken</th>
                            <th class="p-3 text-end">Commission (15%)</th>
                            <th class="p-3 text-center">Status</th>
                            <th class="p-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--color-border-light)]">
                        <!-- BEGIN SAMPLE: Unrolled 3 Cash Collection Rows from _CashReconciliationModal.cshtml -->
                        <tr>
                            <td class="p-3 font-semibold text-[var(--color-text)]">Amina's Heritage Kitchen</td>
                            <td class="p-3 text-end font-medium">6,800.00 EGP</td>
                            <td class="p-3 text-end text-[var(--color-primary)] font-bold">1,020.00 EGP</td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Offset Settled</span>
                            </td>
                            <td class="p-3 text-end">
                                <span class="text-xs text-[var(--color-text-muted)]">Audited</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-[var(--color-text)]">Om Nabil Casseroles</td>
                            <td class="p-3 text-end font-medium">3,450.00 EGP</td>
                            <td class="p-3 text-end text-[var(--color-primary)] font-bold">517.50 EGP</td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Offset Settled</span>
                            </td>
                            <td class="p-3 text-end">
                                <span class="text-xs text-[var(--color-text-muted)]">Audited</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-[var(--color-text)]">Hany's Gourmet Grills</td>
                            <td class="p-3 text-end font-medium">2,270.00 EGP</td>
                            <td class="p-3 text-end text-[var(--color-primary)] font-bold">340.50 EGP</td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">Awaiting Offset</span>
                            </td>
                            <td class="p-3 text-end">
                                <!-- TODO(backend): POST /Admin/Payouts (action=ReconcileCash, chefId=chef-3) -->
                                <form method="post" action="/Admin/Payouts" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="chefId" value="chef-3" />
                                    <input type="hidden" name="actionType" value="ReconcileCash" />
                                    <button type="submit"
                                            class="px-3 py-1 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white font-bold text-[11px] cursor-pointer">
                                        Reconcile
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <!-- END SAMPLE -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section 2: Disburse Chef Earnings & Payouts (from _AdminPayoutModal.cshtml) -->
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#credit-card"></use></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[var(--color-text)]">
                        Disburse Chef Earnings &amp; Payouts
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]">
                        Authorize and execute net earnings transfers via InstaPay GPA or bank wire
                    </p>
                </div>
            </div>

            <!-- TODO(backend): POST /Admin/Payouts with chefId, amount, paymentMethod, and referenceNote -->
            <form method="post" action="/Admin/Payouts" class="space-y-4 text-xs">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Select Kitchen / Chef
                        </label>
                        <select name="chefId" required class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]">
                            <option value="chef-1">Amina's Heritage Kitchen (Eligible: 8,420.00 EGP)</option>
                            <option value="chef-2">Om Nabil Casseroles (Eligible: 4,120.00 EGP)</option>
                            <option value="chef-3">Hany's Gourmet Grills (Eligible: 1,930.00 EGP)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Transfer Channel
                        </label>
                        <select name="paymentMethod" required class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]">
                            <option value="instapay">InstaPay GPA Instant Transfer (Egypt)</option>
                            <option value="bank">Domestic Bank Wire (IBAN)</option>
                            <option value="vodafone_cash">Smart Mobile Wallet (Vodafone Cash)</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Payout Amount (EGP)
                        </label>
                        <input type="number" name="amount" step="0.01" value="8420.00" required
                               class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-bold text-sm" />
                    </div>

                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Batch Code / Reference
                        </label>
                        <input type="text" name="referenceNote" value="BATCH-2026-W42-PAYOUT" required
                               class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-mono text-xs" />
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button type="submit"
                            class="px-5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-sm">
                        Authorize &amp; Disburse Payout
                    </button>
                </div>
            </form>

            <!-- Payout History Log Table -->
            <div class="space-y-2 pt-2 border-t border-[var(--color-border-light)] text-xs">
                <h4 class="font-bold uppercase text-[var(--color-text)] text-xs">
                    Recent Payout Disbursement Log
                </h4>
                <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden">
                    <table class="w-full text-start">
                        <thead class="bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] font-bold text-[10px] uppercase text-[var(--color-text-muted)]">
                            <tr>
                                <th class="p-2.5 text-start">Date</th>
                                <th class="p-2.5 text-start">Kitchen</th>
                                <th class="p-2.5 text-end">Amount</th>
                                <th class="p-2.5 text-start">Channel</th>
                                <th class="p-2.5 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--color-border-light)] text-[11px]">
                            <tr>
                                <td class="p-2.5 text-[var(--color-text-muted)]">Oct 20, 2026</td>
                                <td class="p-2.5 font-semibold text-[var(--color-text)]">Amina's Heritage Kitchen</td>
                                <td class="p-2.5 text-end font-bold text-emerald-600">6,500.00 EGP</td>
                                <td class="p-2.5">InstaPay GPA</td>
                                <td class="p-2.5 text-center">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Completed</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="p-2.5 text-[var(--color-text-muted)]">Oct 14, 2026</td>
                                <td class="p-2.5 font-semibold text-[var(--color-text)]">Om Nabil Casseroles</td>
                                <td class="p-2.5 text-end font-bold text-emerald-600">3,800.00 EGP</td>
                                <td class="p-2.5">Bank Wire (CIB)</td>
                                <td class="p-2.5 text-center">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Completed</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
