@model depiR5gp.ViewModels.AdminDashboard.AdminPayoutsPageVM
@using System.Globalization
@{
    ViewData["Title"] = "Cash & Payouts - Admin Portal";
    ViewData["ActiveAdminTab"] = "payouts";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var inv = CultureInfo.InvariantCulture;
    string CommissionPercentLabel() => Model.EffectiveCommissionPercent.ToString("0.##", inv) + "%";
    string FormatMoney(decimal amount) => $"{amount.ToString("N2", inv)} EGP";
    var firstChefOption = Model.ChefPayoutOptions.FirstOrDefault();
    var defaultPayoutAmount = (firstChefOption?.EligibleBalance ?? 0m).ToString("0.00", inv);
}

<script type="application/json" id="payouts-page-chefs-json">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChefPayoutOptions.ToDictionary(c => c.ChefProfileId.ToString(inv), c => c.EligibleBalance.ToString("0.00", inv))))
</script>

<div x-data="{
    payoutBalances: JSON.parse(document.getElementById('payouts-page-chefs-json')?.textContent || '{}'),
    selectedChefId: '@(firstChefOption?.ChefProfileId.ToString(inv) ?? "")',
    payoutAmount: '@defaultPayoutAmount'
}" class="w-full pb-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <!-- Section 1: Cash Collections & Commission Reconciliation -->
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#wallet"></use></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[var(--color-text)]">
                        Cash Collections &amp; Commission Reconciliation
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]">
                        Reconcile cash collected by chefs against the @CommissionPercentLabel() platform commission owed
                    </p>
                </div>
            </div>

            <!-- Summary Banner -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                <div class="p-3.5 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] font-bold uppercase text-[var(--color-text-muted)] block">Total Cash Collected</span>
                    <span class="text-base font-bold text-[var(--color-text)]">@FormatMoney(Model.TotalCashCollected)</span>
                </div>
                <div class="p-3.5 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] font-bold uppercase text-[var(--color-text-muted)] block">Platform Commission (@CommissionPercentLabel())</span>
                    <span class="text-base font-bold text-[var(--color-primary)]">@FormatMoney(Model.TotalCashCommission)</span>
                </div>
                <div class="p-3.5 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)]">
                    <span class="text-[10px] font-bold uppercase text-[var(--color-text-muted)] block">Pending Cash Offset</span>
                    <span class="text-base font-bold text-amber-600">@FormatMoney(Model.PendingCashOffset)</span>
                </div>
            </div>

            <!-- Chef Collections Ledger Table -->
            <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden text-xs">
                <table class="w-full text-start">
                    <thead class="bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] font-bold text-[10px] uppercase text-[var(--color-text-muted)]">
                        <tr>
                            <th class="p-3 text-start">Kitchen / Chef</th>
                            <th class="p-3 text-end">Cash Taken</th>
                            <th class="p-3 text-end">Commission</th>
                            <th class="p-3 text-center">Status</th>
                            <th class="p-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--color-border-light)]">
                        @if (!Model.CashRows.Any())
                        {
                            <tr>
                                <td colspan="5" class="p-4 text-center text-[var(--color-text-muted)]">No completed cash orders found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var row in Model.CashRows)
                            {
                                <tr>
                                    <td class="p-3 font-semibold text-[var(--color-text)]">@row.KitchenName</td>
                                    <td class="p-3 text-end font-medium">@FormatMoney(row.CashCollected)</td>
                                    <td class="p-3 text-end text-[var(--color-primary)] font-bold">@FormatMoney(row.TotalCommissionOwed)</td>
                                    <td class="p-3 text-center">
                                        @if (row.IsSettled)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Offset Settled</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">Awaiting Offset (@FormatMoney(row.PendingCommissionOffset))</span>
                                        }
                                    </td>
                                    <td class="p-3 text-end">
                                        @if (row.IsSettled)
                                        {
                                            <span class="text-xs text-[var(--color-text-muted)]">Audited</span>
                                        }
                                        else
                                        {
                                            <form method="post" action="/Admin/Payouts" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="chefId" value="@row.ChefProfileId" />
                                                <input type="hidden" name="actionType" value="ReconcileCash" />
                                                <button type="submit"
                                                        class="px-3 py-1 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white font-bold text-[11px] cursor-pointer">
                                                    Reconcile
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Section 2: Disburse Chef Earnings & Payouts -->
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#credit-card"></use></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[var(--color-text)]">
                        Disburse Chef Earnings &amp; Payouts
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]">
                        Authorize and execute net earnings transfers via InstaPay GPA or bank wire
                    </p>
                </div>
            </div>

            <form method="post" action="/Admin/Payouts" class="space-y-4 text-xs">
                @Html.AntiForgeryToken()
                <input type="hidden" name="actionType" value="DisbursePayout" />
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Select Kitchen / Chef
                        </label>
                        <select name="chefId"
                                x-model="selectedChefId"
                                @@change="payoutAmount = payoutBalances[selectedChefId] || '0.00'"
                                required
                                class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]">
                            @foreach (var chefOpt in Model.ChefPayoutOptions)
                            {
                                <option value="@chefOpt.ChefProfileId">@chefOpt.KitchenName (Eligible: @FormatMoney(chefOpt.EligibleBalance))</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Transfer Channel
                        </label>
                        <select name="paymentMethod" required class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]">
                            <option value="instapay">InstaPay GPA Instant Transfer (Egypt)</option>
                            <option value="bank">Domestic Bank Wire (IBAN)</option>
                            <option value="vodafone_cash">Smart Mobile Wallet (Vodafone Cash)</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Payout Amount (EGP)
                        </label>
                        <input type="number" name="amount" step="0.01" min="0.01" x-model="payoutAmount" required
                               class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-bold text-sm" />
                    </div>

                    <div>
                        <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                            Batch Code / Reference
                        </label>
                        <input type="text" name="referenceNote" value="BATCH-@DateTime.UtcNow.ToString("yyyyMMdd")-PAYOUT" required
                               class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-mono text-xs" />
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button type="submit"
                            class="px-5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-sm">
                        Authorize &amp; Disburse Payout
                    </button>
                </div>
            </form>

            <!-- Payout History Log Table -->
            <div class="space-y-2 pt-2 border-t border-[var(--color-border-light)] text-xs">
                <h4 class="font-bold uppercase text-[var(--color-text)] text-xs">
                    Recent Payout Disbursement Log
                </h4>
                <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden">
                    <table class="w-full text-start">
                        <thead class="bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] font-bold text-[10px] uppercase text-[var(--color-text-muted)]">
                            <tr>
                                <th class="p-2.5 text-start">Date</th>
                                <th class="p-2.5 text-start">Kitchen</th>
                                <th class="p-2.5 text-end">Amount</th>
                                <th class="p-2.5 text-start">Channel &amp; Ref</th>
                                <th class="p-2.5 text-center">Status</th>
                                <th class="p-2.5 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--color-border-light)] text-[11px]">
                            @if (!Model.PayoutHistory.Any())
                            {
                                <tr>
                                    <td colspan="6" class="p-4 text-center text-[var(--color-text-muted)]">No payout disbursements or chef payout requests recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var p in Model.PayoutHistory)
                                {
                                    <tr>
                                        <td class="p-2.5 text-[var(--color-text-muted)]">@p.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy", inv)</td>
                                        <td class="p-2.5 font-semibold text-[var(--color-text)]">@p.KitchenName</td>
                                        <td class="p-2.5 text-end font-bold text-emerald-600">@FormatMoney(p.Amount)</td>
                                        <td class="p-2.5">@p.ChannelLabel · <span class="font-mono text-[10px] text-[var(--color-text-muted)]">@p.ReferenceNote</span></td>
                                        <td class="p-2.5 text-center">
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(p.Status == "Completed" ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" : "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300")">@p.Status</span>
                                        </td>
                                        <td class="p-2.5 text-end">
                                            @if (p.Status == "Pending")
                                            {
                                                <form method="post" action="/Admin/Payouts" class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="actionType" value="DisbursePayout" />
                                                    <input type="hidden" name="chefId" value="@p.ChefProfileId" />
                                                    <input type="hidden" name="payoutId" value="@p.PayoutId" />
                                                    <input type="hidden" name="amount" value="@p.Amount.ToString("0.00", inv)" />
                                                    <input type="hidden" name="paymentMethod" value="instapay" />
                                                    <input type="hidden" name="referenceNote" value="@p.ReferenceNote" />
                                                    <button type="submit"
                                                            class="px-2.5 py-1 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[10px] cursor-pointer">
                                                        Approve &amp; Disburse
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-[var(--color-text-muted)]">Disbursed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
