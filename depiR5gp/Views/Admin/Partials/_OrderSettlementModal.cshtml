<!-- Views/Admin/Partials/_OrderSettlementModal.cshtml -->
<!-- Subtasks SCRUM-507 & SCRUM-515: Admin Order Financial Drill-Down & Settlement Modal -->
<!-- TODO [Backend]: GET /api/admin/orders/{id}/settlement returning GMV, commission itemization, net payout, and settlement status -->

<div x-show="showSettlementModal"
     x-transition.opacity.duration.200ms
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/60 backdrop-blur-xs"
     style="display: none;"
     role="dialog"
     aria-modal="true">

    <div @@click.away="showSettlementModal = false"
         x-show="showSettlementModal"
         x-transition.scale.origin.center.duration.200ms
         class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl space-y-6">

        <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#file-text"></use></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[var(--color-text)]"
                        x-text="$store.app.language === 'ar' ? 'تفاصيل التسوية المالية للطلب' : 'Order Financial Settlement Breakdown'">
                        Order Financial Settlement Breakdown
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]">Order #HC-2026-9041 · Amina's Heritage Kitchen</p>
                </div>
            </div>
            <button type="button"
                    @@click="showSettlementModal = false"
                    class="p-2 rounded-full text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
            </button>
        </div>

        <!-- Financial Itemization Breakdown Table -->
        <div class="space-y-3 bg-[var(--color-surface-subtle)] p-4 rounded-2xl border border-[var(--color-border-light)] text-xs">
            <div class="flex justify-between items-center text-[var(--color-text-muted)]">
                <span>Customer Paid (Gross GMV):</span>
                <span class="font-bold text-[var(--color-text)] text-sm">240.00 EGP</span>
            </div>
            <div class="flex justify-between items-center text-rose-600 dark:text-rose-400">
                <span>Platform Commission (15%):</span>
                <span class="font-bold">-36.00 EGP</span>
            </div>
            <div class="flex justify-between items-center text-[var(--color-text-muted)]">
                <span>Payment Gateway Processing (0% promo):</span>
                <span class="font-semibold">0.00 EGP</span>
            </div>
            <div class="flex justify-between items-center pt-2 border-t border-[var(--color-border)] text-sm font-bold">
                <span class="text-[var(--color-text)]">Net Chef Earnings Payable:</span>
                <span class="text-emerald-600 dark:text-emerald-400 text-base">204.00 EGP</span>
            </div>
        </div>

        <!-- Meta coordinates -->
        <div class="grid grid-cols-2 gap-3 text-xs">
            <div class="p-3 bg-[var(--color-surface-subtle)] rounded-xl border border-[var(--color-border-light)]">
                <span class="text-[10px] uppercase font-bold text-[var(--color-text-muted)] block">Payment Channel</span>
                <span class="font-semibold text-[var(--color-text)]">Stripe Card (Visa ···· 4242)</span>
            </div>
            <div class="p-3 bg-[var(--color-surface-subtle)] rounded-xl border border-[var(--color-border-light)]">
                <span class="text-[10px] uppercase font-bold text-[var(--color-text-muted)] block">Settlement Status</span>
                <span class="font-bold text-emerald-600">Settled to Chef Wallet</span>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-3 border-t border-[var(--color-border-light)]">
            <button type="button"
                    @@click="$store.app.showToast('info', 'Settlement receipt PDF export initiated.'); showSettlementModal = false;"
                    class="px-4 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-neutral-100 dark:hover:bg-neutral-800 text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer text-[var(--color-text)]">
                Export Receipt
            </button>
            <button type="button"
                    @@click="showSettlementModal = false"
                    class="px-5 py-2.5 rounded-full bg-[var(--color-primary)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer">
                Close
            </button>
        </div>
    </div>
</div>

