<!-- Views/Admin/Partials/_AdminPayoutModal.cshtml -->
<!-- Subtask SCRUM-523: Admin Chef Payout Disbursement and History Log Modal -->
<!-- TODO [Backend]: POST /api/admin/payouts with chefId, amount, paymentMethod, and referenceNote -->

<div x-show="showPayoutModal"
     x-transition.opacity.duration.200ms
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/60 backdrop-blur-xs"
     style="display: none;"
     role="dialog"
     aria-modal="true">

    <div @@click.away="showPayoutModal = false"
         x-show="showPayoutModal"
         x-transition.scale.origin.center.duration.200ms
         class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">

        <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#credit-card"></use></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[var(--color-text)]"
                        x-text="$store.app.language === 'ar' ? 'صرف مستحقات وأرباح الطهاة' : 'Disburse Chef Earnings & Payouts'">
                        Disburse Chef Earnings & Payouts
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]"
                       x-text="$store.app.language === 'ar' ? 'تحويل الأرباح المستحقة عبر شبكة المدفوعات اللحظية إنستاباي أو التحويل البنكي' : 'Authorize and execute net earnings transfers via InstaPay GPA or bank wire'"></p>
                </div>
            </div>
            <button type="button"
                    @@click="showPayoutModal = false"
                    class="p-2 rounded-full text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
            </button>
        </div>

        <!-- Disbursement Form -->
        <form @@submit.prevent="
            showPayoutModal = false;
            $store.app.addNotification({
                title: $store.app.language === 'ar' ? 'تم تحويل المستحقات بنجاح' : 'Payout Disbursed',
                message: $store.app.language === 'ar' ? 'تم إرسال حوالة إنستاباي بنجاح إلى حساب الشيف وتم تحديث دفتر الأستاذ.' : 'InstaPay transfer executed successfully and ledger balance updated.',
                type: 'success'
            });
        " class="space-y-4 text-xs">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Kitchen Selection -->
                <div>
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5"
                           x-text="$store.app.language === 'ar' ? 'اختر المطبخ / الشيف' : 'Select Kitchen / Chef'">
                        Select Kitchen / Chef
                    </label>
                    <select required class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]">
                        <option value="chef-1">Amina's Heritage Kitchen (Eligible: 8,420.00 EGP)</option>
                        <option value="chef-2">Om Nabil Casseroles (Eligible: 4,120.00 EGP)</option>
                        <option value="chef-3">Hany's Gourmet Grills (Eligible: 1,930.00 EGP)</option>
                    </select>
                </div>

                <!-- Transfer Method -->
                <div>
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5"
                           x-text="$store.app.language === 'ar' ? 'طريقة التحويل' : 'Transfer Channel'">
                        Transfer Channel
                    </label>
                    <select required class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]">
                        <option value="instapay">InstaPay GPA Instant Transfer (Egypt)</option>
                        <option value="bank">Domestic Bank Wire (IBAN)</option>
                        <option value="vodafone_cash">Smart Mobile Wallet (Vodafone Cash)</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Amount -->
                <div>
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5"
                           x-text="$store.app.language === 'ar' ? 'المبلغ المراد صرفه (ج.م)' : 'Payout Amount (EGP)'">
                        Payout Amount (EGP)
                    </label>
                    <input type="number"
                           step="0.01"
                           value="8420.00"
                           required
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-bold text-sm" />
                </div>

                <!-- Reference / Batch Code -->
                <div>
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5"
                           x-text="$store.app.language === 'ar' ? 'رمز أو ملاحظة الدفعة' : 'Batch Code / Reference'">
                        Batch Code / Reference
                    </label>
                    <input type="text"
                           value="BATCH-2026-W42-PAYOUT"
                           required
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3 py-2 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-mono text-xs" />
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <button type="submit"
                        class="px-5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-sm">
                    Authorize & Disburse Payout
                </button>
            </div>
        </form>

        <!-- Payout History Log Table -->
        <div class="space-y-2 pt-2 border-t border-[var(--color-border-light)] text-xs">
            <h4 class="font-bold uppercase text-[var(--color-text)] text-xs"
                x-text="$store.app.language === 'ar' ? 'سجل التحويلات السابقة' : 'Recent Payout Disbursement Log'">
                Recent Payout Disbursement Log
            </h4>
            <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden">
                <table class="w-full text-start">
                    <thead class="bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] font-bold text-[10px] uppercase text-[var(--color-text-muted)]">
                        <tr>
                            <th class="p-2.5 text-start">Date</th>
                            <th class="p-2.5 text-start">Kitchen</th>
                            <th class="p-2.5 text-end">Amount</th>
                            <th class="p-2.5 text-start">Channel</th>
                            <th class="p-2.5 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--color-border-light)] text-[11px]">
                        <tr>
                            <td class="p-2.5 text-[var(--color-text-muted)]">Oct 20, 2026</td>
                            <td class="p-2.5 font-semibold text-[var(--color-text)]">Amina's Heritage Kitchen</td>
                            <td class="p-2.5 text-end font-bold text-emerald-600">6,500.00 EGP</td>
                            <td class="p-2.5">InstaPay GPA</td>
                            <td class="p-2.5 text-center">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Completed</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="p-2.5 text-[var(--color-text-muted)]">Oct 14, 2026</td>
                            <td class="p-2.5 font-semibold text-[var(--color-text)]">Om Nabil Casseroles</td>
                            <td class="p-2.5 text-end font-bold text-emerald-600">3,800.00 EGP</td>
                            <td class="p-2.5">Bank Wire (CIB)</td>
                            <td class="p-2.5 text-center">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Completed</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

