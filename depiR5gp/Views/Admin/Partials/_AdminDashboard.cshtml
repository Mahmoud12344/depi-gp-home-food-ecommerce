                    </div>
                </template>
                <template x-if="filteredUsers.length === 0">
                    <div class="p-8 text-center text-xs text-[var(--color-text-muted)]">
                        No user accounts found matching your query.
                    </div>
                </template>
            </div>
        </div>

        <!-- TAB 4: Review Moderation (SCRUM-552) -->
        <!-- TODO [Backend]: Loop through CustomerReviews; bind Reviewer, Chef, Stars, Comment, and wire Approve/Reject moderation workflow -->
        <div x-show="activeTab === 'reviews'" class="space-y-4">
            <!-- Review status filter sub-tabs -->
            <div class="flex items-center gap-2 border-b border-[var(--color-border)] pb-3">
                <template x-for="rf in ['all', 'Pending', 'Approved', 'Rejected']" :key="rf">
                    <button type="button"
                            @@click="reviewStatusFilter = rf"
                            :class="reviewStatusFilter === rf ? 'bg-[var(--color-primary)] text-white' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800'"
                            class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer"
                            x-text="rf === 'all' ? 'All Reviews' : rf">
                    </button>
                </template>
            </div>

            <div class="space-y-3">
                <template x-for="r in filteredReviews" :key="r.id">
                    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs">
                        <div class="space-y-1.5">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="font-bold text-[var(--color-text)]" x-text="r.customerName"></span>
                                <span class="text-[var(--color-primary)] font-semibold" x-text="`→ ${r.chefName}`"></span>
                                <span class="text-[10px] text-amber-600 font-bold" x-text="`(${r.rating} Stars)`"></span>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full uppercase"
                                      :class="{
                                          'bg-amber-100 text-amber-900 border border-amber-300 dark:bg-amber-950 dark:text-amber-200': r.status === 'Pending',
                                          'bg-emerald-100 text-emerald-900 border border-emerald-300 dark:bg-emerald-950 dark:text-emerald-200': r.status === 'Approved',
                                          'bg-rose-100 text-rose-900 border border-rose-300 dark:bg-rose-950 dark:text-rose-200': r.status === 'Rejected'
                                      }"
                                      x-text="r.status"></span>
                            </div>
                            <p class="text-[var(--color-text-muted)] italic" x-text="`“${r.comment}”`"></p>
                        </div>

                        <div class="flex items-center gap-2 shrink-0">
                            <template x-if="r.status === 'Pending'">
                                <div class="flex items-center gap-2">
                                    <button @@click="handleRejectReview(r.id)"
                                            class="px-3 py-1.5 rounded-full border border-rose-300 dark:border-rose-800 text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950 text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer">
                                        Reject
                                    </button>
                                    <button @@click="handleApproveReview(r.id)"
                                            class="px-3 py-1.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs">
                                        Approve
                                    </button>
                                </div>
                            </template>
                            <button @@click="handleDeleteReview(r.id)"
                                    class="p-2 text-neutral-400 hover:text-rose-600 transition-colors cursor-pointer"
                                    title="Delete review">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#trash-2"></use></svg>
                            </button>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <!-- TAB 5: Platform Settings -->
        <!-- TODO [Backend]: Bind PlatformSettings.CommissionRate and wire Save Rate form submission endpoint -->
        <div x-show="activeTab === 'settings'" class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 max-w-xl shadow-xs space-y-6">
            <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">
                Global Platform Parameters
            </h3>

            <div class="space-y-2 text-xs">
                <label class="block font-semibold">Standard Platform Commission Rate (%)</label>
                <div class="flex items-center gap-3">
                    <input type="number"
                           min="5"
                           max="35"
                           x-model="commissionRate"
                           class="w-24 p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold" />
                    <button @@click="$store.app.showToast('success', `Commission rate updated to ${commissionRate}%. Applies to new orders.`)"
                            class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-full transition-colors cursor-pointer">
                        Save Rate
                    </button>
                </div>
                <p class="text-[11px] text-[var(--color-text-muted)] mt-1">
                    Agreed baseline for verified home kitchen orders across Cairo & Giza.
                </p>
            </div>
        </div>

        <!-- TAB 6: AI Assistant FAQs (SCRUM-493) -->
        <div x-show="activeTab === 'faq'" class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs">
            <partial name="~/Views/Admin/Partials/_AIFaqManagement.cshtml" />
        </div>
    </div>

    <!-- User Suspension Reason Dialog (SCRUM-361) -->
    <div x-show="showSuspendModal"
         x-transition.opacity
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/60 backdrop-blur-xs"
         style="display: none;"
         role="dialog"
         aria-modal="true">
        <div @@click.away="showSuspendModal = false"
             class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-5">
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-2xl bg-rose-100 dark:bg-rose-950 text-rose-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#alert-triangle"></use></svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-[var(--color-text)]">Confirm Account Suspension</h3>
                    <p class="text-xs text-[var(--color-text-muted)]" x-text="'User: ' + (userToSuspend ? userToSuspend.name : '')"></p>
                </div>
            </div>

            <div class="space-y-3 text-xs">
                <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Official Justification</label>
                <select x-model="suspendReason" class="w-full p-2.5 bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl text-[var(--color-text)]">
                    <option value="hygiene">Food hygiene or food safety compliance breach</option>
                    <option value="cancellations">Excessive unfulfilled or cancelled orders</option>
                    <option value="dispute">Unresolved customer payment/counter charge dispute</option>
                    <option value="abusive">Abusive customer communications or terms breach</option>
                </select>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button"
                        @@click="showSuspendModal = false"
                        class="px-4 py-2 rounded-full border border-[var(--color-border)] text-xs font-bold uppercase tracking-wider">
                    Cancel
                </button>
                <button type="button"
                        @@click="confirmSuspendUser()"
                        class="px-4 py-2 rounded-full bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold uppercase tracking-wider">
                    Confirm Suspension
                </button>
            </div>
        </div>
    </div>

    <!-- Admin Operational Modals (Phase 4) -->
    <partial name="~/Views/Admin/Partials/_CashReconciliationModal.cshtml" />
    <partial name="~/Views/Admin/Partials/_AdminPayoutModal.cshtml" />
    <partial name="~/Views/Admin/Partials/_OrderSettlementModal.cshtml" />
</div>

