<!-- TODO [Backend]: Bind live platform KPIs, chef applications, registered users, and review moderation lists -->

<div x-data="{
    activeTab: 'kpis',
    commissionRate: 15,
    pendingChefs: [
        {
            id: 'chef-4',
            kitchenName: 'Kareem\'s Alexandria Seafood',
            chefName: 'Chef Kareem Nour',
            address: 'Building 12, Abbas El-Akkad, Nasr City, Cairo',
            pickupArea: 'Nasr City',
            documents: {
                idNumber: 'EGY-2930411-NAT',
                foodSafetyCert: 'FS-CAIRO-2026-992'
            }
        }
    ],
    usersList: [
        { id: 'u-1', name: 'Tamer Zaki', email: 'tamer.zaki@example.com', role: 'Customer', status: 'Active', ordersCount: 14 },
        { id: 'u-2', name: 'Chef Amina Mansour', email: 'amina.chef@example.com', role: 'Chef', status: 'Active', ordersCount: 84 },
        { id: 'u-3', name: 'Chef Hany El-Sayed', email: 'hany.chef@example.com', role: 'Chef', status: 'Active', ordersCount: 62 },
        { id: 'u-4', name: 'Ahmed Badawi', email: 'ahmed.b@example.com', role: 'Customer', status: 'Active', ordersCount: 2 }
    ],
    reviews: [
        { id: 'rev-1', customerName: 'Youssef Nabil', chefName: 'Amina\'s Heritage Kitchen', rating: 5, comment: 'The duck was browned to perfection and the molokhia was piping hot. Best homemade dinner in Maadi!' },
        { id: 'rev-2', customerName: 'Salma Fathy', chefName: 'Hany\'s Gourmet Grills', rating: 5, comment: 'Braised oxtail was incredibly tender and the caramelized shallots gave it deep sweetness.' },
        { id: 'rev-3', customerName: 'Karim Gad', chefName: 'Amina\'s Heritage Kitchen', rating: 4, comment: 'Authentic baladi ghee flavor in the feteer. Portion was generous for 4 people.' }
    ],
    handleApproveChef(chefId) {
        this.pendingChefs = this.pendingChefs.filter(c => c.id !== chefId);
        $store.app.showToast('success', 'Chef kitchen approved! Published to marketplace browse.');
    },
    handleRejectChef(chefId) {
        this.pendingChefs = this.pendingChefs.filter(c => c.id !== chefId);
        $store.app.showToast('info', 'Chef application rejected with feedback notes.');
    },
    handleSuspendUser(userId) {
        this.usersList = this.usersList.map(u => u.id === userId ? { ...u, status: u.status === 'Suspended' ? 'Active' : 'Suspended' } : u);
        $store.app.showToast('info', 'User status updated successfully.');
    },
    handleDeleteReview(reviewId) {
        this.reviews = this.reviews.filter(r => r.id !== reviewId);
        $store.app.showToast('info', 'Inappropriate review deleted. Kitchen ratings recalculated.');
    }
}" class="w-full pb-24">

