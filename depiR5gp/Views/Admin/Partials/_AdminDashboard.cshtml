        { id: 'u-2', name: 'Chef Amina Mansour', email: 'amina.chef@example.com', role: 'Chef', status: 'Active', ordersCount: 84 },
        { id: 'u-3', name: 'Chef Hany El-Sayed', email: 'hany.chef@example.com', role: 'Chef', status: 'Active', ordersCount: 62 },
        { id: 'u-4', name: 'Ahmed Badawi', email: 'ahmed.b@example.com', role: 'Customer', status: 'Active', ordersCount: 2 },
        { id: 'u-5', name: 'Layla Sherif', email: 'layla.support@example.com', role: 'Support', status: 'Active', ordersCount: 0 }
    ],
    reviews: [
        { id: 'rev-1', customerName: 'Youssef Nabil', chefName: 'Amina\'s Heritage Kitchen', rating: 5, comment: 'The duck was browned to perfection and the molokhia was piping hot. Best homemade dinner in Maadi!', status: 'Approved' },
        { id: 'rev-2', customerName: 'Salma Fathy', chefName: 'Hany\'s Gourmet Grills', rating: 5, comment: 'Braised oxtail was incredibly tender and the caramelized shallots gave it deep sweetness.', status: 'Approved' },
        { id: 'rev-3', customerName: 'Karim Gad', chefName: 'Amina\'s Heritage Kitchen', rating: 4, comment: 'Authentic baladi ghee flavor in the feteer. Portion was generous for 4 people.', status: 'Approved' },
        { id: 'rev-4', customerName: 'Nouran Samir', chefName: 'Om Nabil Casseroles', rating: 5, comment: 'Superb okra with lamb meat tagine! Packaged perfectly hot and sealed.', status: 'Pending' }
    ],
    get filteredUsers() {
        return this.usersList.filter(u => {
            const matchesRole = this.userRoleFilter === 'all' || u.role.toLowerCase() === this.userRoleFilter.toLowerCase();
            const matchesSearch = !this.userSearchQuery.trim() || u.name.toLowerCase().includes(this.userSearchQuery.toLowerCase()) || u.email.toLowerCase().includes(this.userSearchQuery.toLowerCase());
            return matchesRole && matchesSearch;
        });
    },
    get filteredReviews() {
        if (this.reviewStatusFilter === 'all') return this.reviews;
        return this.reviews.filter(r => r.status.toLowerCase() === this.reviewStatusFilter.toLowerCase());
    },
    handleApproveChef(chefId) {
        this.pendingChefs = this.pendingChefs.filter(c => c.id !== chefId);
        $store.app.showToast('success', 'Chef kitchen approved! Published to marketplace browse.');
    },
    handleRejectChef(chefId) {
        this.pendingChefs = this.pendingChefs.filter(c => c.id !== chefId);
        $store.app.showToast('info', 'Chef application rejected with feedback notes.');
    },
    promptSuspendUser(user) {
        this.userToSuspend = user;
        this.showSuspendModal = true;
    },
    confirmSuspendUser() {
        if (!this.userToSuspend) return;
        this.usersList = this.usersList.map(u => u.id === this.userToSuspend.id ? { ...u, status: u.status === 'Suspended' ? 'Active' : 'Suspended' } : u);
        this.showSuspendModal = false;
        $store.app.showToast('info', 'Account status updated for ' + this.userToSuspend.name);
        this.userToSuspend = null;
    },
    handleApproveReview(revId) {
        this.reviews = this.reviews.map(r => r.id === revId ? { ...r, status: 'Approved' } : r);
        $store.app.showToast('success', 'Review approved and published.');
    },
    handleRejectReview(revId) {
        this.reviews = this.reviews.map(r => r.id === revId ? { ...r, status: 'Rejected' } : r);
        $store.app.showToast('info', 'Review rejected and hidden from public display.');
    },
    handleDeleteReview(reviewId) {
        this.reviews = this.reviews.filter(r => r.id !== reviewId);
        $store.app.showToast('info', 'Inappropriate review deleted. Kitchen ratings recalculated.');
    }
