@model IEnumerable<depiR5gp.Models.ReviewsLoyalty.Review>
@{
    ViewData["Title"] = "Review Moderation - Admin Portal";
    ViewData["ActiveAdminTab"] = "reviews";

    var currentStatus = ViewBag.CurrentStatus as string ?? "all";

    string TabClass(string tab) =>
        string.Equals(currentStatus, tab, StringComparison.OrdinalIgnoreCase)
            ? "bg-[var(--color-primary)] text-white"
            : "bg-[var(--color-surface-subtle)] text-[var(--color-text)] hover:bg-neutral-200 dark:hover:bg-neutral-800";

    string BadgeClass(string status) => status switch
    {
        "Approved" => "bg-emerald-100 text-emerald-900 border border-emerald-300 dark:bg-emerald-950 dark:text-emerald-200",
        "Rejected" => "bg-rose-100 text-rose-900 border border-rose-300 dark:bg-rose-950 dark:text-rose-200",
        _ => "bg-amber-100 text-amber-900 border border-amber-300 dark:bg-amber-950 dark:text-amber-200"
    };
}
