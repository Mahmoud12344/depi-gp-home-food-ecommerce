<!-- Backlog Subtask: SCRUM-552 -->

<div class="w-full pb-24">
    <partial name="~/Views/Admin/Partials/_AdminNav.cshtml" />

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
        <!-- TAB 4: Review Moderation (SCRUM-552) -->
        <div class="space-y-4">
            <!-- Review status filter sub-tabs (plain GET links) -->
            <div class="flex items-center gap-2 border-b border-[var(--color-border)] pb-3">
                <a href="/Admin/Reviews?status=all"
                   class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer @TabClass("all")">
                    All Reviews
                </a>
                <a href="/Admin/Reviews?status=Pending"
                   class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer @TabClass("Pending")">
                    Pending
                </a>
                <a href="/Admin/Reviews?status=Approved"
                   class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer @TabClass("Approved")">
                    Approved
                </a>
                <a href="/Admin/Reviews?status=Rejected"
                   class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all cursor-pointer @TabClass("Rejected")">
                    Rejected
                </a>
            </div>

            <div class="space-y-3">
                @if (!Model.Any())
                {
                    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-8 text-center text-xs text-[var(--color-text-muted)]">
                        No reviews found for this filter.
                    </div>
                }
                else
                {
                    foreach (var review in Model)
                    {
                        var customerName = review.User is not null
                            ? $"{review.User.FirstName} {review.User.LastName}".Trim()
                            : $"User #{review.UserId}";
                        var chefName = review.ChefProfile?.KitchenName ?? $"Chef #{review.ChefProfileId}";

                        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs">
                            <div class="space-y-1.5">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="font-bold text-[var(--color-text)]">@customerName</span>
                                    <span class="text-[var(--color-primary)] font-semibold">→ @chefName</span>
                                    <div class="inline-flex items-center gap-0.5" aria-label="@review.Rating out of 5 stars" title="@review.Rating / 5 Stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <svg class="w-3.5 h-3.5 fill-current @(i <= review.Rating ? "text-[var(--color-star)]" : "text-neutral-300 dark:text-neutral-700")" viewBox="0 0 24 24">
                                                <use href="#star"></use>
                                            </svg>
                                        }
                                    </div>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full uppercase @BadgeClass(review.ModerationStatus)">
                                        @review.ModerationStatus
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(review.Comment))
                                {
                                    <p class="text-[var(--color-text-muted)] italic">“@review.Comment”</p>
                                }
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                                @if (review.ModerationStatus == "Pending")
                                {
                                    <div class="flex items-center gap-2">
                                        <form method="post" action="/Admin/Reviews" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="reviewId" value="@review.Id" />
                                            <input type="hidden" name="moderationAction" value="Reject" />
                                            <input type="hidden" name="status" value="@currentStatus" />
                                            <button type="submit"
                                                    class="px-3 py-1.5 rounded-full border border-rose-300 dark:border-rose-800 text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950 text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer">
                                                Reject
                                            </button>
                                        </form>
                                        <form method="post" action="/Admin/Reviews" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="reviewId" value="@review.Id" />
                                            <input type="hidden" name="moderationAction" value="Approve" />
                                            <input type="hidden" name="status" value="@currentStatus" />
                                            <button type="submit"
                                                    class="px-3 py-1.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs">
                                                Approve
                                            </button>
                                        </form>
                                    </div>
                                }
                                <form method="post" action="/Admin/Reviews" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reviewId" value="@review.Id" />
                                    <input type="hidden" name="moderationAction" value="Delete" />
                                    <input type="hidden" name="status" value="@currentStatus" />
                                    <button type="submit"
                                            class="p-2 text-neutral-400 hover:text-rose-600 transition-colors cursor-pointer"
                                            title="Delete review">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#trash-2"></use></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>


