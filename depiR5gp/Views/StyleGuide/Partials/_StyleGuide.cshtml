                            <span>Completed</span>
                        </span>
                        <span class="inline-flex items-center gap-1.5 font-bold uppercase tracking-wider rounded-full border bg-rose-100 text-rose-950 border-rose-300 dark:bg-rose-950/80 dark:text-rose-100 dark:border-rose-700 px-3 py-1 text-xs">
                            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                            <span>Cancelled</span>
                        </span>
                        <span class="inline-flex items-center gap-1.5 font-bold uppercase tracking-wider rounded-full border bg-rose-100 text-rose-950 border-rose-300 dark:bg-rose-950/80 dark:text-rose-100 dark:border-rose-700 px-3 py-1 text-xs">
                            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                            <span>Rejected</span>
                        </span>
                    </div>
                </div>

                <div class="border-t border-[var(--color-border-light)] pt-6">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-3">
                        Commercial Badges & Discount Stamps
                    </h3>
                    <div class="flex flex-wrap items-center gap-4">
                        <span class="bg-[var(--color-sale)] text-white text-[11px] font-bold px-3 py-1 uppercase tracking-wider rounded-xs">
                            SALE TAG
                        </span>

                        <div class="discount-burst w-12 h-12 flex items-center justify-center text-center shadow-xs select-none">
                            <span class="text-[11px] font-bold leading-tight">
                                38%<br />OFF
                            </span>
                        </div>

                        <div class="discount-burst w-12 h-12 flex items-center justify-center text-center shadow-xs select-none">
                            <span class="text-[11px] font-bold leading-tight">
                                20%<br />OFF
                            </span>
                        </div>

                        <span class="inline-flex items-center gap-1.5 text-xs font-medium bg-emerald-100 text-emerald-900 border border-emerald-300 px-3 py-1 rounded-full">
                            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check-circle-2"></use></svg>
                            <span>Verified Domestic Kitchen</span>
                        </span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. Product & Chef Components Showcase -->
        <section class="space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-b border-[var(--color-border)] pb-3 gap-2">
                <div>
                    <span class="text-[11px] font-bold text-[var(--color-primary)] uppercase tracking-widest">
                        Section 05
                    </span>
                    <h2 class="text-lg sm:text-xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                        Core Marketplace Components
                    </h2>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-[var(--color-text-muted)]">View layout:</span>
                    <button @@click="dishCardViewMode = 'grid'"
                            class="text-xs px-2.5 py-1 rounded-xs uppercase font-semibold cursor-pointer"
                            :class="dishCardViewMode === 'grid' ? 'bg-[var(--color-primary)] text-white' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)]'">
                        Grid (4 Col)
                    </button>
                    <button @@click="dishCardViewMode = 'list'"
                            class="text-xs px-2.5 py-1 rounded-xs uppercase font-semibold cursor-pointer"
                            :class="dishCardViewMode === 'list' ? 'bg-[var(--color-primary)] text-white' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)]'">
                        List View
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Dish Card: Available & On Sale -->
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] block mb-2">
                        Dish Card (Available & Sale Tag)
                    </span>
                    @await Html.PartialAsync("~/Views/Shared/Partials/_DishCard.cshtml")
                </div>

                <!-- Dish Card: Unavailable -->
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] block mb-2">
                        Dish Card (Unavailable & Greyed Out - SCRUM-127)
                    </span>
                    <div class="opacity-60 grayscale pointer-events-none">
                        @await Html.PartialAsync("~/Views/Shared/Partials/_DishCard.cshtml")
                    </div>
                </div>

                <!-- Chef Card -->
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] block mb-2">
                        Chef Profile Card (SCRUM-116)
                    </span>
                    @await Html.PartialAsync("~/Views/Shared/Partials/_ChefCard.cshtml")
                </div>
            </div>
        </section>

        <!-- 6. Interactive Modal & Drawer Triggers -->
        <section class="space-y-6">
            <div class="flex items-baseline justify-between border-b border-[var(--color-border)] pb-3">
                <div>
                    <span class="text-[11px] font-bold text-[var(--color-primary)] uppercase tracking-widest">
                        Section 06
                    </span>
                    <h2 class="text-lg sm:text-xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                        Interactive Modals & Drawers
                    </h2>
                </div>
                <span class="text-xs text-[var(--color-text-muted)]">
                    Click to preview live overlays
                </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Trigger 1: Filter Drawer -->
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] p-4 rounded-sm flex flex-col justify-between">
                    <div>
                        <svg class="w-6 h-6 text-[var(--color-primary)] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#sliders"></use></svg>
                        <h3 class="text-xs font-bold uppercase text-[var(--color-text)]">
                            Filter Slide-In Drawer
                        </h3>
                        <p class="text-[11px] text-[var(--color-text-muted)] mt-1 mb-4">
                            Cuisines, area filters, and min/max price slider.
                        </p>
                    </div>
                    <button @@click="$store.app.setFilterDrawerOpen(true)"
                            class="px-4 py-2 border border-[var(--color-border)] hover:border-[var(--color-primary)] bg-[var(--color-surface)] text-xs font-semibold uppercase tracking-wider rounded-xs transition-colors cursor-pointer">
                        Open Filter Drawer
                    </button>
                </div>

                <!-- Trigger 2: Options Dialog -->
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] p-4 rounded-sm flex flex-col justify-between">
                    <div>
                        <svg class="w-6 h-6 text-[var(--color-primary)] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#flame"></use></svg>
                        <h3 class="text-xs font-bold uppercase text-[var(--color-text)]">
                            Presets & Options Dialog
                        </h3>
                        <p class="text-[11px] text-[var(--color-text-muted)] mt-1 mb-4">
                            Radio/checkbox presets, live pricing, and 0/200 note counter.
                        </p>
                    </div>
                    <button @@click="$store.app.setOptionsModalDish(sampleAvailableDish)"
                            class="px-4 py-2 border border-[var(--color-border)] hover:border-[var(--color-primary)] bg-[var(--color-surface)] text-xs font-semibold uppercase tracking-wider rounded-xs transition-colors cursor-pointer">
                        Open Options Dialog
                    </button>
                </div>

                <!-- Trigger 3: Login Modal -->
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] p-4 rounded-sm flex flex-col justify-between">
                    <div>
                        <svg class="w-6 h-6 text-[var(--color-primary)] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#toggle-left"></use></svg>
                        <h3 class="text-xs font-bold uppercase text-[var(--color-text)]">
                            Login & Register Modal
                        </h3>
                        <p class="text-[11px] text-[var(--color-text-muted)] mt-1 mb-4">
                            Tabs for Login / Register with inline validation.
                        </p>
                    </div>
                    <button @@click="$store.app.setLoginModalOpen(true)"
                            class="px-4 py-2 border border-[var(--color-border)] hover:border-[var(--color-primary)] bg-[var(--color-surface)] text-xs font-semibold uppercase tracking-wider rounded-xs transition-colors cursor-pointer">
                        Open Auth Modal
                    </button>
                </div>

                <!-- Trigger 4: Cart Conflict Simulation -->
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] p-4 rounded-sm flex flex-col justify-between">
                    <div>
                        <svg class="w-6 h-6 text-amber-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#alert-triangle"></use></svg>
                        <h3 class="text-xs font-bold uppercase text-[var(--color-text)]">
                            One-Chef Cart Conflict
                        </h3>
                        <p class="text-[11px] text-[var(--color-text-muted)] mt-1 mb-4">
                            Attempting to add a dish from Chef Hany when cart has Chef Amina.
                        </p>
                    </div>
                    <button @@click="$store.app.addToCart(sampleUnavailableDish, 1, [], '')"
                            class="px-4 py-2 border border-[var(--color-border)] hover:border-[var(--color-primary)] bg-[var(--color-surface)] text-xs font-semibold uppercase tracking-wider rounded-xs transition-colors cursor-pointer">
                        Trigger Cart Conflict
                    </button>
                </div>
            </div>

            <!-- Toast Triggers -->
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] p-5 rounded-sm">
                <h3 class="text-xs font-bold uppercase text-[var(--color-text)] mb-2">
                    System Toast Feedback Triggers
                </h3>
                <div class="flex flex-wrap items-center gap-2">
                    <button @@click="$store.app.showToast('success', 'Your order was accepted by the kitchen!')"
                            class="px-4 py-2 border border-[var(--color-border)] hover:border-[var(--color-primary)] bg-[var(--color-surface)] text-xs font-semibold uppercase tracking-wider rounded-xs transition-colors cursor-pointer">
                        Success Toast
                    </button>
                    <button @@click="$store.app.showToast('error', 'Card payment simulation declined.')"
                            class="px-4 py-2 border border-[var(--color-border)] hover:border-[var(--color-primary)] bg-[var(--color-surface)] text-xs font-semibold uppercase tracking-wider rounded-xs transition-colors cursor-pointer">
                        Error Toast
                    </button>
                    <button @@click="$store.app.showToast('warning', 'Order preparation begins in 10 minutes.')"
                            class="px-4 py-2 border border-[var(--color-border)] hover:border-[var(--color-primary)] bg-[var(--color-surface)] text-xs font-semibold uppercase tracking-wider rounded-xs transition-colors cursor-pointer">
                        Warning Toast
                    </button>
                    <button @@click="$store.app.showToast('info', 'Customer Support replied to Case #CASE-7701.')"
                            class="px-4 py-2 border border-[var(--color-border)] hover:border-[var(--color-primary)] bg-[var(--color-surface)] text-xs font-semibold uppercase tracking-wider rounded-xs transition-colors cursor-pointer">
                        Info Toast
                    </button>
                </div>
            </div>
        </section>

        <!-- 7. ASP.NET Core MVC Razor Compatibility Notes -->
        <section class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-sm p-6 sm:p-8 space-y-4">
            <div class="flex items-center gap-2 text-[var(--color-primary)]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check-circle-2"></use></svg>
                <h3 class="text-sm font-bold uppercase tracking-wider">
                    ASP.NET Core MVC Razor Views Implementation Mapping
                </h3>
            </div>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
                All HTML markup in this prototype follows semantic, clean element structures designed for direct mapping to Razor Views:
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono text-[var(--color-text)]">
                <div class="p-3 bg-[var(--color-surface-subtle)] rounded-xs border border-[var(--color-border-light)]">
                    <span class="font-bold text-[var(--color-primary)]">Layout & Partials:</span>
                    <ul class="mt-1 space-y-0.5 text-[11px] text-[var(--color-text-muted)]">
                        <li>• `Views/Shared/_Layout.cshtml` → Header, Footer, Marquee, PrototypeBar</li>
                        <li>• `Views/Shared/_DishCard.cshtml` → Reusable dish component</li>
                        <li>• `Views/Shared/_ChefCard.cshtml` → Reusable chef card</li>
                        <li>• `Views/Shared/_StatusBadge.cshtml` → Tag helper for OrderStatus</li>
                    </ul>
                </div>
                <div class="p-3 bg-[var(--color-surface-subtle)] rounded-xs border border-[var(--color-border-light)]">
                    <span class="font-bold text-[var(--color-primary)]">CSS Architecture:</span>
                    <ul class="mt-1 space-y-0.5 text-[11px] text-[var(--color-text-muted)]">
                        <li>• Variables in `:root` and `[data-theme="dark"]` for instant ASP.NET bundle reuse</li>
                        <li>• Logical CSS properties (`margin-inline-start`, `padding-inline`) for zero-duplication Arabic RTL</li>
                        <li>• Standard forms with clean client-side validation attributes</li>
                    </ul>
                </div>
            </div>
        </section>
    </div>
</div>

