            <!-- TODO [Backend]: Loop through open SupportTickets; bind TicketId, CaseNumber, RequesterName, Subject, and AwaitingSupport flag -->
            <div class="lg:col-span-5 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-4 shadow-xs space-y-2">
