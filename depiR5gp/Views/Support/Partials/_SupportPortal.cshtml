            status: 'Open',
            awaitingSupport: true,
            createdAt: '12:40 PM',
            messages: [
                { id: 'm-1', authorId: 'user-1', authorName: 'Tamer Zaki', authorRole: 'customer', text: 'I arrived at Degla villa at 2:00 PM as scheduled, but had to wait 15 extra minutes on the patio.', timestamp: '12:40 PM' },
                { id: 'm-2', authorId: 'user-supp-1', authorName: 'Layla Sherif (Support Agent)', authorRole: 'support', text: 'We reached out to Chef Amina. She added complimentary hot feteer portions as a courtesy apology.', timestamp: '12:45 PM' }
            ]
        },
        {
            id: 'case-2',
            caseNumber: 'CASE-7702',
            orderId: 'order-2',
            orderNumber: 'HC-2026-8812',
            requesterId: 'user-2',
            requesterName: 'Dina Magdy',
            requesterRole: 'Customer',
            subject: 'Missing side tahini and baladi bread',
            description: 'Trio hawawshi box was missing one container of garlic tahini sauce.',
            status: 'Open',
            awaitingSupport: false,
            createdAt: 'Yesterday',
            messages: [
                { id: 'm-3', authorId: 'user-2', authorName: 'Dina Magdy', authorRole: 'customer', text: 'Package arrived warm but missing tahini sauces.', timestamp: 'Yesterday' }
            ]
        }
    ],
    refunds: [
        {
            id: 'ref-1',
            requestNumber: 'REF-2026-104',
            orderId: 'order-1',
            orderNumber: 'HC-2026-9041',
            customerId: 'user-1',
            customerName: 'Tamer Zaki',
            chefId: 'chef-1',
            chefName: 'Amina\'s Heritage Kitchen',
            amount: 240.00,
            reason: 'Pickup delay exceeded 20 minutes without prior WhatsApp notice.',
            status: 'Pending',
            requestedBy: 'support',
            sourceCaseId: 'case-1',
            createdAt: '2026-10-22'
        },
        {
            id: 'ref-2',
            requestNumber: 'REF-2026-098',
            orderId: 'order-3',
            orderNumber: 'HC-2026-7740',
            customerId: 'user-3',
            customerName: 'Ahmed Badawi',
            chefId: 'chef-2',
            chefName: 'Hany\'s Gourmet Grills',
            amount: 275.00,
            reason: 'Order cancelled before kitchen preparation started.',
            status: 'Approved',
            requestedBy: 'customer',
            createdAt: '2026-10-20'
        }
    ],
    get currentCase() {
        return this.cases.find(c => c.id === this.selectedCaseId) || this.cases[0];
    },
    handleSendReply() {
        if (!this.replyText.trim()) return;
        const c = this.currentCase;
        c.awaitingSupport = false;
        c.messages.push({
            id: `msg-${Date.now()}`,
            authorId: 'user-supp-1',
            authorName: 'Layla Sherif (Support Agent)',
            authorRole: 'support',
            text: this.replyText.trim(),
            timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
        });
        $store.app.showToast('success', 'Reply sent to requester. In-app notification dispatched.');
        this.replyText = '';
    },
    handleCreateRefundFromCase() {
        const c = this.currentCase;
        if (!c.orderId) return;
        const newRef = {
            id: `ref-${Date.now()}`,
            requestNumber: `REF-2026-${Math.floor(100 + Math.random() * 900)}`,
            orderId: c.orderId,
            orderNumber: c.orderNumber || 'HC-2026-9041',
            customerId: c.requesterId,
            customerName: c.requesterName,
            chefId: 'chef-1',
            chefName: 'Amina\'s Heritage Kitchen',
            amount: 240.00,
            reason: c.description,
            status: 'Pending',
            requestedBy: 'support',
            sourceCaseId: c.id,
            createdAt: new Date().toISOString()
        };
        this.refunds.unshift(newRef);
        $store.app.showToast('info', 'Refund request created and forwarded to refund queue.');
        this.activeTab = 'refunds';
    },
    handleApproveRefund(refId) {
        this.refunds = this.refunds.map(r => r.id === refId ? { ...r, status: 'Approved', decidedAt: new Date().toISOString() } : r);
        $store.app.showToast('success', 'Refund approved! 100% full reversal dispatched via Stripe test mode.');
    },
    handleConfirmRejectRefund() {
        if (!this.rejectRefundModal) return;
        this.refunds = this.refunds.map(r => r.id === this.rejectRefundModal.id ? { ...r, status: 'Rejected', adminNotes: this.rejectReason, decidedAt: new Date().toISOString() } : r);
        $store.app.showToast('info', 'Refund request rejected with justification notes.');
        this.rejectRefundModal = null;
    }
}" class="w-full pb-24">

    <!-- Breadcrumb Banner -->
    <div class="relative bg-gradient-to-r from-[var(--color-primary-light)] via-[var(--color-bg)] to-[var(--color-primary-light)] dark:from-neutral-900 dark:via-neutral-800 dark:to-neutral-900 border-b border-[var(--color-border)] py-8 sm:py-12 px-4 sm:px-6 lg:px-8">
