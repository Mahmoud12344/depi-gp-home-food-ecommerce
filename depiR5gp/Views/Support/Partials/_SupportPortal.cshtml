<div x-data="{
    activeTab: 'cases',
    selectedCaseId: 'case-1',
    replyText: '',
    rejectRefundModal: null,
    rejectReason: 'Order pickup delay was verified as resolved with customer.',
    cases: [
        {
            id: 'case-1',
            caseNumber: 'CASE-7701',
            orderId: 'order-1',
            orderNumber: 'HC-2026-9041',
            requesterId: 'user-1',
