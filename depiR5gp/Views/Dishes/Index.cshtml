@{
    ViewData["Title"] = "Browse Dishes";
}
<!-- Views/Dishes/Index.cshtml -->

<div x-data="{
    viewMode: 'grid',
    activeSearch: '',
    activeCuisine: 'all'
    }"
     class="w-full pb-24">

    @Html.AntiForgeryToken()

    <!-- Breadcrumb banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span>Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#chevron-right"></use>
                </svg>
                <span class="text-[var(--color-text)] font-semibold">Dishes</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                All Handcrafted Dishes
            </h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 max-w-2xl leading-relaxed">
                Freshly prepared meals from certified home kitchens with direct pickup
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-6">

        <!-- Top Control Bar -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-4 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl shadow-xs">

            <div class="flex items-center gap-3">
                <button type="button"
                    @@click="$dispatch('open-filter-drawer')"
                        class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] text-xs font-semibold uppercase px-5 py-2.5 rounded-full shadow-xs cursor-pointer transition-all">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#sliders-horizontal"></use></svg>
                    <span>Filter Menu</span>
                </button>

                <div class="h-6 w-px bg-[var(--color-border)] mx-1"></div>

                <div class="flex items-center bg-[var(--color-surface-subtle)] p-1 rounded-full border border-[var(--color-border)]">
                    <button type="button"
                        @@click="viewMode = 'grid'"
                            title="Grid View"
                            :class="viewMode === 'grid' ? 'bg-white dark:bg-neutral-800 text-[var(--color-primary)] shadow-xs' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                            class="p-1.5 rounded-full transition-colors cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#layout-grid"></use></svg>
                    </button>
                    <button type="button"
                        @@click="viewMode = 'list'"
                            title="List View"
                            :class="viewMode === 'list' ? 'bg-white dark:bg-neutral-800 text-[var(--color-primary)] shadow-xs' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                            class="p-1.5 rounded-full transition-colors cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#list"></use></svg>
                    </button>
                </div>

                <span class="text-xs text-[var(--color-text-muted)] font-medium">
                    <span>6</span> <span>Dishes</span>
                </span>
            </div>

            <form method="get" action="/Dishes" class="flex items-center gap-2">
                <label for="sort-dishes" class="text-xs text-[var(--color-text-muted)] font-medium whitespace-nowrap">
                    Sort by:
                </label>
                <select id="sort-dishes"
                        name="sort"
                        onchange="this.form.submit()"
                        class="text-xs p-2 ps-3 pe-8 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-full focus:border-[var(--color-primary)] focus:outline-hidden cursor-pointer font-semibold shadow-2xs">
                    <option value="featured">Featured</option>
                    <option value="price_asc">Price: Low to High</option>
                    <option value="price_desc">Price: High to Low</option>
                    <option value="rating">Highest Rated</option>
                </select>
            </form>
        </div>

        <!-- Active Filter Chips Row -->
        <div x-show="activeCuisine !== 'all' || activeSearch"
             x-cloak
             class="flex items-center gap-2 flex-wrap text-xs">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">
                Active Filters:
            </span>

            <span x-show="activeSearch" class="inline-flex items-center gap-1.5 bg-[var(--color-primary-light)] text-[var(--color-primary)] px-3 py-1 rounded-full font-medium">
                <span x-text="'“' + activeSearch + '”'"></span>
                <a href="/Dishes" class="hover:opacity-75 cursor-pointer">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                </a>
            </span>

            <span x-show="activeCuisine !== 'all'" class="inline-flex items-center gap-1.5 bg-[var(--color-primary-light)] text-[var(--color-primary)] px-3 py-1 rounded-full font-medium">
                <span x-text="activeCuisine"></span>
                <a href="/Dishes" class="hover:opacity-75 cursor-pointer">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                </a>
            </span>

            <a href="/Dishes"
               class="text-xs font-semibold text-[var(--color-primary)] hover:underline ms-2 cursor-pointer">
                Clear All
            </a>
        </div>

        <!-- Product Grid / List -->
        <div>

            <!-- ==================== GRID VIEW ==================== -->
            <div x-show="viewMode === 'grid'" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

                <!-- Dish 1 -->
                <div onclick="window.location.href='/Dishes/Details/1'"
                     class="group relative bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-4 transition-all duration-300 hover:shadow-xl hover:shadow-[var(--color-primary)]/5 cursor-pointer flex flex-col justify-between overflow-hidden hover:-translate-y-1">

                    <div class="relative w-full aspect-square bg-neutral-100 dark:bg-neutral-800 overflow-hidden rounded-xl mb-3.5">
                        <img src="https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80"
                             alt="Baladi Duck Molokhia with Vermicelli Rice"
                             class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
                             loading="lazy" />

                        <span class="absolute top-3 start-3 bg-[var(--color-sale)] text-white text-[10px] font-bold px-2.5 py-0.5 uppercase tracking-wider rounded-full shadow-sm z-10">SALE</span>

                        <div class="absolute top-2.5 end-2.5 discount-burst w-12 h-12 flex items-center justify-center text-center shadow-md z-10 select-none">
                            <span class="text-[10px] font-bold leading-tight">15%<br />OFF</span>
                        </div>

                        <div class="absolute bottom-3 inset-x-0 flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-3 group-hover:translate-y-0 z-20">

                            <button type="button"
                                    data-favorite-dish-id="1"
                                    data-favorite-active="false"
                                @@click.stop="window.toggleDishFavorite($el)"
                                    aria-label="Add to favorites"
                                    aria-pressed="false"
                                    class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                                <svg class="w-4 h-4 stroke-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <use href="#heart"></use>
                                </svg>
                            </button>

                            <button type="button"
                                @@click.stop="$dispatch('open-options-modal', { id: 'dish-1', name: 'Baladi Duck Molokhia with Vermicelli Rice', price: 240, kitchenName: 'Amina\'s Heritage Kitchen' })"
