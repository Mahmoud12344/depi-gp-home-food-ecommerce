@model depiR5gp.Models.Menu.DishCatalogViewModel
@{
    ViewData["Title"] = "Browse Dishes";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div x-data="{ viewMode: 'grid' }" class="w-full pb-24">
    @Html.AntiForgeryToken()
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 mb-2">
                <a href="/" class="hover:text-[var(--color-primary)]">Home</a>
                <span>/</span>
                <span class="text-[var(--color-text)] font-semibold">Dishes</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">All Handcrafted Dishes</h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5">Freshly prepared meals from certified home kitchens with direct pickup</p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-4 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl shadow-xs">
            <div class="flex items-center gap-3">
                <button type="button" @@click="$dispatch('open-filter-drawer')" class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white text-xs font-semibold uppercase px-5 py-2.5 rounded-full cursor-pointer">Filter Menu</button>
                <div class="h-6 w-px bg-[var(--color-border)]"></div>
                <button type="button" @@click="viewMode = 'grid'" class="p-2 rounded-full cursor-pointer">Grid</button>
                <button type="button" @@click="viewMode = 'list'" class="p-2 rounded-full cursor-pointer">List</button>
                <span class="text-xs text-[var(--color-text-muted)]">@Model.Dishes.Count Dishes</span>
            </div>
            <form method="get" action="/Dishes" class="flex items-center gap-2">
                @if (Model.Filter.Search != null) { <input type="hidden" name="search" value="@Model.Filter.Search" /> }
                @if (Model.Filter.CuisineId != null) { <input type="hidden" name="category" value="@Model.Filter.CuisineId" /> }
                @if (Model.Filter.Area != null) { <input type="hidden" name="area" value="@Model.Filter.Area" /> }
                @if (Model.Filter.MinPrice != null) { <input type="hidden" name="minPrice" value="@(Model.Filter.MinPrice?.ToString(inv))" /> }
                @if (Model.Filter.MaxPrice != null) { <input type="hidden" name="maxPrice" value="@(Model.Filter.MaxPrice?.ToString(inv))" /> }
                <label for="sort-dishes" class="text-xs text-[var(--color-text-muted)]">Sort by:</label>
                <select id="sort-dishes" name="sort" onchange="this.form.submit()" class="text-xs p-2 rounded-full border border-[var(--color-border)] cursor-pointer">
                    <option value="featured" selected="@(Model.Filter.Sort == "featured")">Featured</option>
                    <option value="price_asc" selected="@(Model.Filter.Sort == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.Filter.Sort == "price_desc")">Price: High to Low</option>
                    <option value="rating" selected="@(Model.Filter.Sort == "rating")">Highest Rated</option>
                </select>
            </form>
        </div>

        @if (Model.Filter.HasActiveFilters)
        {
            <div class="flex items-center gap-2 flex-wrap text-xs">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Active Filters:</span>
                @if (Model.Filter.Search != null) { <a href="@Model.Filter.BuildUrl("search")" class="px-3 py-1 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)]">“@Model.Filter.Search” ×</a> }
                @if (Model.SelectedCuisineName != null) { <a href="@Model.Filter.BuildUrl("category")" class="px-3 py-1 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)]">@Model.SelectedCuisineName ×</a> }
                @if (Model.SelectedAreaName != null) { <a href="@Model.Filter.BuildUrl("area")" class="px-3 py-1 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)]">@Model.SelectedAreaName ×</a> }
                @if (Model.Filter.MinPrice != null || Model.Filter.MaxPrice != null) { <a href="@Model.Filter.BuildUrl("price")" class="px-3 py-1 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)]">@(Model.Filter.MinPrice?.ToString("0.##", inv) ?? "0") – @(Model.Filter.MaxPrice?.ToString("0.##", inv) ?? "∞") EGP ×</a> }
                <a href="/Dishes" class="text-[var(--color-primary)] font-semibold">Clear All</a>
            </div>
        }

        <div x-show="viewMode === 'grid'" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var d in Model.Dishes)
            {
                <article class="group bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-4 flex flex-col gap-3">
                    <a href="/Dishes/Details/@d.Id" class="relative aspect-square rounded-xl overflow-hidden bg-neutral-100 dark:bg-neutral-800">
                        @if (!string.IsNullOrEmpty(d.ImageUrl)) { <img src="@d.ImageUrl" alt="@d.Name" class="w-full h-full object-cover" loading="lazy" /> }
                    </a>
                    <div class="text-[11px] text-[var(--color-text-muted)]">@d.CuisineName · <span class="text-[var(--color-primary)]">@d.KitchenName</span></div>
                    <a href="/Dishes/Details/@d.Id" class="text-sm font-bold uppercase text-[var(--color-text)]">@d.Name</a>
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-[var(--color-primary)]">@d.Price.ToString("0.00", inv) EGP</span>
                        <span class="text-xs">★ @d.Rating.ToString("0.0", inv) (@d.ReviewCount)</span>
                    </div>
                    <div class="flex gap-2">
                        <button type="button" data-favorite-dish-id="@d.Id" data-favorite-active="false" @@click="window.toggleDishFavorite($el)" class="dish-list-icon-btn" aria-label="Add to favorites">♡</button>
                        <button type="button" @@click="$dispatch('open-options-modal', @Html.Raw(d.OptionsJson))" class="dish-list-btn-cart">Add to Cart</button>
                    </div>
                </article>
            }
        </div>

        <div x-show="viewMode === 'list'" x-cloak class="space-y-3">
            @foreach (var d in Model.Dishes)
            {
                <article class="dish-list-item" x-data="{ favorited: false }">
                    <a href="/Dishes/Details/@d.Id" class="dish-list-thumb">@if (!string.IsNullOrEmpty(d.ImageUrl)) { <img src="@d.ImageUrl" alt="@d.Name" loading="lazy" /> }</a>
                    <div class="dish-list-body">
                        <div class="dish-list-meta-top">@d.CuisineName · <span class="dish-list-kitchen">@d.KitchenName</span></div>
                        <a href="/Dishes/Details/@d.Id" class="dish-list-title">@d.Name</a>
                        <div class="dish-list-price-row"><span class="dish-list-price">@d.Price.ToString("0.00", inv) EGP</span></div>
                        <div class="dish-list-meta-bottom"><span>★ @d.Rating.ToString("0.0", inv) (@d.ReviewCount)</span><span>@d.AreaName</span></div>
                    </div>
                    <div class="dish-list-actions">
                        <button type="button" @@click.stop="window.toggleDishFavorite($el)" data-favorite-dish-id="@d.Id" class="dish-list-icon-btn" title="Wishlist">♡</button>
                        <button type="button" @@click.stop="$dispatch('open-options-modal', @Html.Raw(d.OptionsJson))" class="dish-list-btn-cart">Add to Cart</button>
                    </div>
                </article>
            }
        </div>

        @if (!Model.Dishes.Any())
        {
            <div class="border border-[var(--color-border)] rounded-2xl p-12 text-center space-y-4">
                <h3 class="text-lg font-bold uppercase">No Matching Dishes Found</h3>
                <p class="text-xs text-[var(--color-text-muted)]">Try adjusting your filters or clearing your search keywords.</p>
                <a href="/Dishes" class="text-[var(--color-primary)] font-semibold">Reset All Filters</a>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Partials/_FilterDrawer.cshtml", Model)
