@model depiR5gp.Models.Menu.DishCatalogViewModel
@{
    ViewData["Title"] = "Browse Dishes";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<!-- Views/Dishes/Index.cshtml -->
<!-- Ported from Views/Dishes/Partials/_BrowseDishes.cshtml on main -->
<!-- TODO(backend): Filter and sort dishes server-side via DishesController.Index(string? search, string? cuisine, string? category, decimal? minPrice, decimal? maxPrice, string? sort) -->

<div x-data="{
    viewMode: 'grid',
    activeSearch: '',
    activeCuisine: 'all'
}"
     class="w-full pb-24">

    <!-- Breadcrumb banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span>Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#chevron-right"></use>
                </svg>
                <span class="text-[var(--color-text)] font-semibold">Dishes</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                All Handcrafted Dishes
            </h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 max-w-2xl leading-relaxed">
                Freshly prepared meals from certified home kitchens with direct pickup
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-6">
        <!-- Top Control Bar -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-4 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl shadow-xs">
            <!-- Left: Filter Drawer Trigger & Layout Toggle -->
            <div class="flex items-center gap-3">
                <button type="button"
                        @@click="$dispatch('open-filter-drawer')"
                        class="inline-flex items-center gap-2 bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] text-xs font-semibold uppercase px-5 py-2.5 rounded-full shadow-xs cursor-pointer transition-all">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#sliders-horizontal"></use></svg>
                    <span>Filter Menu</span>
                </button>

                <div class="h-6 w-px bg-[var(--color-border)] mx-1"></div>

                <div class="flex items-center bg-[var(--color-surface-subtle)] p-1 rounded-full border border-[var(--color-border)]">
                    <button type="button"
                            @@click="viewMode = 'grid'"
                            title="Grid View"
                            :class="viewMode === 'grid' ? 'bg-white dark:bg-neutral-800 text-[var(--color-primary)] shadow-xs' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                            class="p-1.5 rounded-full transition-colors cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#layout-grid"></use></svg>
                    </button>
                    <button type="button"
                            @@click="viewMode = 'list'"
                            title="List View"
                            :class="viewMode === 'list' ? 'bg-white dark:bg-neutral-800 text-[var(--color-primary)] shadow-xs' : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]'"
                            class="p-1.5 rounded-full transition-colors cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#list"></use></svg>
                    </button>
                </div>

                <!-- TODO(backend): Bind total count from Model.Dishes.Count -->
                <span class="text-xs text-[var(--color-text-muted)] font-medium">
                    <span>@Model.Dishes.Count</span> <span>Dishes</span>
                </span>
            </div>

            <!-- Right: Sort By Dropdown (Plain GET Form) -->
            <form method="get" action="/Dishes" class="flex items-center gap-2">
                @if (Model.Filter.Search != null) { <input type="hidden" name="search" value="@Model.Filter.Search" /> }
                @if (Model.Filter.CuisineId != null) { <input type="hidden" name="category" value="@Model.Filter.CuisineId" /> }
                @if (Model.Filter.Area != null) { <input type="hidden" name="area" value="@Model.Filter.Area" /> }
                @if (Model.Filter.MinPrice != null) { <input type="hidden" name="minPrice" value="@(Model.Filter.MinPrice?.ToString(inv))" /> }
                @if (Model.Filter.MaxPrice != null) { <input type="hidden" name="maxPrice" value="@(Model.Filter.MaxPrice?.ToString(inv))" /> }

                <label for="sort-dishes" class="text-xs text-[var(--color-text-muted)] font-medium whitespace-nowrap">
                    Sort by:
                </label>
                <select id="sort-dishes"
                        name="sort"
                        onchange="this.form.submit()"
                        class="text-xs p-2 ps-3 pe-8 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-full focus:border-[var(--color-primary)] focus:outline-hidden cursor-pointer font-semibold shadow-2xs">
                    <option value="featured" selected="@(Model.Filter.Sort == "featured")">Featured</option>
                    <option value="price_asc" selected="@(Model.Filter.Sort == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.Filter.Sort == "price_desc")">Price: High to Low</option>
                    <option value="rating" selected="@(Model.Filter.Sort == "rating")">Highest Rated</option>
                </select>
            </form>
        </div>

        <!-- Active Filter Chips Row -->
        <!-- TODO(backend): Render active filter chips when query parameters (search, cuisine, minPrice, maxPrice) are present -->
        @if (Model.Filter.HasActiveFilters)
        {
            <div class="flex items-center gap-2 flex-wrap text-xs">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">
                    Active Filters:
                </span>

                @if (Model.Filter.Search != null)
                {
                    <span class="inline-flex items-center gap-1.5 bg-[var(--color-primary-light)] text-[var(--color-primary)] px-3 py-1 rounded-full font-medium">
                        <span>“@Model.Filter.Search”</span>
                        <a href="@Model.Filter.BuildUrl("search")" class="hover:opacity-75 cursor-pointer">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                        </a>
                    </span>
                }

                @if (Model.SelectedCuisineName != null)
                {
                    <span class="inline-flex items-center gap-1.5 bg-[var(--color-primary-light)] text-[var(--color-primary)] px-3 py-1 rounded-full font-medium">
                        <span>@Model.SelectedCuisineName</span>
                        <a href="@Model.Filter.BuildUrl("category")" class="hover:opacity-75 cursor-pointer">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                        </a>
                    </span>
                }

                @if (Model.SelectedAreaName != null)
                {
                    <span class="inline-flex items-center gap-1.5 bg-[var(--color-primary-light)] text-[var(--color-primary)] px-3 py-1 rounded-full font-medium">
                        <span>@Model.SelectedAreaName</span>
                        <a href="@Model.Filter.BuildUrl("area")" class="hover:opacity-75 cursor-pointer">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                        </a>
                    </span>
                }

                @if (Model.Filter.MinPrice != null || Model.Filter.MaxPrice != null)
                {
                    <span class="inline-flex items-center gap-1.5 bg-[var(--color-primary-light)] text-[var(--color-primary)] px-3 py-1 rounded-full font-medium">
                        <span>@(Model.Filter.MinPrice?.ToString("0.##", inv) ?? "0") – @(Model.Filter.MaxPrice?.ToString("0.##", inv) ?? "∞") EGP</span>
                        <a href="@Model.Filter.BuildUrl("price")" class="hover:opacity-75 cursor-pointer">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                        </a>
                    </span>
                }

                <a href="/Dishes"
                   class="text-xs font-semibold text-[var(--color-primary)] hover:underline ms-2 cursor-pointer">
                    Clear All
                </a>
            </div>
        }

        <!-- Product Grid / List -->
        <!-- TODO(backend): Loop through catalog query results (Model.Dishes); bind DishId, Name, Price, OriginalPrice, KitchenName, Rating, PrepTimeMinutes, ImageUrl, and Availability -->
        <div>
            <!-- Grid View -->
            <div x-show="viewMode === 'grid'" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var d in Model.Dishes)
                {
                    <div onclick="window.location.href='/Dishes/Details/@d.Id'"
                         class="group relative bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-4 transition-all duration-300 hover:shadow-xl hover:shadow-[var(--color-primary)]/5 cursor-pointer flex flex-col justify-between overflow-hidden hover:-translate-y-1">
                        <div class="relative w-full aspect-square bg-neutral-100 dark:bg-neutral-800 overflow-hidden rounded-xl mb-3.5">
                            @if (!string.IsNullOrEmpty(d.ImageUrl))
                            {
                                <img src="@d.ImageUrl"
                                     alt="@d.Name"
                                     class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
                                     loading="lazy" />
                            }

                            <span class="absolute top-3 start-3 bg-[var(--color-sale)] text-white text-[10px] font-bold px-2.5 py-0.5 uppercase tracking-wider rounded-full shadow-sm z-10">
                                SALE
                            </span>

                            <div class="absolute top-2.5 end-2.5 discount-burst w-12 h-12 flex items-center justify-center text-center shadow-md z-10 select-none">
                                <span class="text-[10px] font-bold leading-tight">15%<br />OFF</span>
                            </div>

                            <!-- Floating Action Buttons on Hover -->
                            <div class="absolute bottom-3 inset-x-0 flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-3 group-hover:translate-y-0 z-20"
                                 x-data="{ favorited: false }">
                                <button type="button"
                                        @@click.stop="favorited = !favorited"
                                        class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                                    <svg class="w-4 h-4" :class="favorited ? 'fill-rose-500 text-rose-500' : 'stroke-current'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#heart"></use>
                                    </svg>
                                </button>
                                <button type="button"
                                        @@click.stop="$dispatch('open-options-modal', @d.OptionsJson)"
                                        class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#shopping-bag"></use>
                                    </svg>
                                </button>
                                <button type="button"
                                        @@click.stop="$dispatch('open-quick-view', @d.QuickViewJson)"
                                        class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#eye"></use>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div>
                            <div class="text-[11px] text-[var(--color-text-muted)] truncate mb-1">
                                <span>@d.CuisineName</span>
                                <span class="mx-1.5 opacity-60">·</span>
                                <span class="text-[var(--color-primary)] font-semibold">@d.KitchenName</span>
                            </div>
                            <h3 class="text-sm sm:text-base font-bold uppercase tracking-tight text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors line-clamp-1 mb-1.5">
                                @d.Name
                            </h3>
                            <div class="flex items-baseline gap-2 mb-2">
                                <span class="text-base font-bold text-[var(--color-primary)]">@d.Price.ToString("0.00", inv) EGP</span>
                                <span class="text-xs text-[var(--color-text-muted)] line-through">280.00 EGP</span>
                            </div>
                            <div class="flex items-center justify-between text-xs text-[var(--color-text-muted)] pt-2 border-t border-[var(--color-border-light)]">
                                <div class="flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24"><use href="#star"></use></svg>
                                    <span class="text-[11px] font-bold">@d.Rating.ToString("0.0", inv)</span>
                                    <span class="text-[10px]">(@d.ReviewCount)</span>
                                </div>
                                <span class="text-[11px]">45m</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- List View -->
            <div x-show="viewMode === 'list'" x-cloak class="dish-list-container">
                @foreach (var d in Model.Dishes)
                {
                    <div onclick="window.location.href='/Dishes/Details/@d.Id'" class="dish-list-item" x-data="{ favorited: false }">
                        <div class="dish-list-thumb">
                            @if (!string.IsNullOrEmpty(d.ImageUrl))
                            {
                                <img src="@d.ImageUrl"
                                     alt="@d.Name"
                                     loading="lazy" />
                            }
                            <span class="dish-list-badge-sale">SALE</span>
                        </div>

                        <div class="dish-list-body">
                            <div class="dish-list-meta-top">
                                <span>@d.CuisineName</span>
                                <span class="opacity-50">·</span>
                                <span class="dish-list-kitchen">@d.KitchenName</span>
                            </div>

                            <h3 class="dish-list-title">@d.Name</h3>

                            <div class="dish-list-price-row">
                                <span class="dish-list-price">@d.Price.ToString("0.00", inv) EGP</span>
                                <span class="dish-list-original-price">280.00 EGP</span>
                            </div>

                            <div class="dish-list-meta-bottom">
                                <div class="dish-list-rating">
                                    <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24"><use href="#star"></use></svg>
                                    <span>@d.Rating.ToString("0.0", inv)</span>
                                    <span class="opacity-75">(@d.ReviewCount)</span>
                                </div>

                                <div class="dish-list-meta-item">
                                    <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#clock"></use></svg>
                                    <span>45 mins prep</span>
                                </div>

                                @if (d.Area != null)
                                {
                                    <div class="dish-list-meta-item">
                                        <svg class="w-3.5 h-3.5 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#map-pin"></use></svg>
                                        <span>@d.AreaName</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="dish-list-actions">
                            <div class="dish-list-action-icons">
                                <button type="button"
                                        @@click.stop="favorited = !favorited"
                                        class="dish-list-icon-btn"
                                        :class="favorited ? 'active' : ''"
                                        title="Wishlist">
                                    <svg class="w-4 h-4" :class="favorited ? 'fill-rose-500 text-rose-500' : 'stroke-current'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#heart"></use>
                                    </svg>
                                </button>
                                <button type="button"
                                        @@click.stop="$dispatch('open-quick-view', @d.QuickViewJson)"
                                        class="dish-list-icon-btn"
                                        title="Quick View">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#eye"></use>
                                    </svg>
                                </button>
                            </div>

                            <button type="button"
                                    @@click.stop="$dispatch('open-options-modal', @d.OptionsJson)"
                                    class="dish-list-btn-cart">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <use href="#shopping-bag"></use>
                                </svg>
                                <span>Add to Cart</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Empty State (shown by backend when Model.Dishes.Count == 0) -->
        <!-- TODO(backend): Show when !Model.Dishes.Any() -->
        @if (!Model.Dishes.Any())
        {
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-12 text-center space-y-4 max-w-lg mx-auto">
                <div class="w-16 h-16 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center mx-auto">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chef-hat"></use></svg>
                </div>
                <h3 class="text-lg font-bold uppercase text-[var(--color-text)]">
                    No Matching Dishes Found
                </h3>
                <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
                    Try adjusting your cuisine filters, widening your price range, or clearing your search keywords.
                </p>
                <a href="/Dishes"
                   class="inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] active:scale-[0.98] focus-visible:outline-[var(--color-primary)] hover:shadow-lg hover:shadow-[var(--color-primary)]/20">
                    <span>Reset All Filters</span>
                </a>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Partials/_FilterDrawer.cshtml", Model)