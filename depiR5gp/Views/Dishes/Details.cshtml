@* TODO [Backend]: @model depiR5gp.Models.Menu.Dish — Bind Model.Name, Model.Price, Model.Description, Model.DishOptions, Model.ChefProfile *@

<div x-data="{
    dishId: '@(ViewContext.RouteData.Values["id"]?.ToString() ?? "dish-1")',
    activeImageIndex: 0,
    lightboxOpen: false,
    isZoomed: false,
    openLightbox() {
        this.lightboxOpen = true;
        this.isZoomed = false;
    },
    closeLightbox() {
        this.lightboxOpen = false;
        this.isZoomed = false;
    },
    quantity: 1,
    selectedOptions: {
        'Duck Portion': [{ groupName: 'Duck Portion', valueName: 'Duck Thigh & Drumstick (ورك بط)', priceModifier: 0 }]
    },
    note: '',
    activeAccordion: 'description',
    dish: {
        id: 'dish-1',
        name: 'Baladi Duck Molokhia with Vermicelli Rice',
        nameAr: 'ملوخية بالبط البلدي مع أرز بالشعرية',
        price: 240,
        originalPrice: 280,
        rating: 4.9,
        reviewCount: 48,
        prepTimeMinutes: 45,
        kitchenName: 'Amina\'s Heritage Kitchen',
        kitchenNameAr: 'مطبخ أمينة التراثي',
        category: 'Traditional Egyptian',
        categoryAr: 'أكلات مصرية تقليدية',
        pickupArea: 'Maadi, Cairo',
        pickupAreaAr: 'المعادي، القاهرة',
        address: 'Villa 14, Road 9, Degla, Maadi, Cairo',
        isAvailable: true,
        isSale: true,
        discountPercentage: 15,
        image: 'https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80',
        images: [
            'https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=1000&auto=format&fit=crop&q=80',
            'https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=1000&auto=format&fit=crop&q=80',
            'https://images.unsplash.com/photo-1544025162-d76694265947?w=1000&auto=format&fit=crop&q=80',
            'https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1000&auto=format&fit=crop&q=80',
            'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=1000&auto=format&fit=crop&q=80'
        ],
        description: 'Minced fresh molokhia leaves whipped with golden baladi garlic and coriander ta\'sheya, paired with roasted heritage duck and Egyptian vermicelli rice.',
        descriptionAr: 'ملوخية خضراء طازجة مخروطة يدوياً مع طشة الثوم البلدي والكزبرة الجافة، تقدم مع نصف بطة محمرة في الفرن وأرز مصري بالشعرية.'
    },
    get allSelected() {
        return Object.values(this.selectedOptions).flat();
    },
    get optionsExtra() {
        return this.allSelected.reduce((sum, opt) => sum + (opt.priceModifier || 0), 0);
    },
    get unitPrice() {
        return this.dish.price + this.optionsExtra;
    },
    get totalPrice() {
        return this.unitPrice * this.quantity;
    },
    handleAddToCart() {
        if (!this.dish.isAvailable) return;
        $store.app.addToCart(this.dish, this.quantity, this.allSelected, this.note.trim());
    },
    handleBuyItNow() {
        if (!this.dish.isAvailable) return;
        const added = $store.app.addToCart(this.dish, this.quantity, this.allSelected, this.note.trim());
        if (added) {
            window.location.href = '/Checkout';
        }
    }
}"
     class="w-full pb-36">

    <!-- 1. Single 56px Breadcrumb Line -->
