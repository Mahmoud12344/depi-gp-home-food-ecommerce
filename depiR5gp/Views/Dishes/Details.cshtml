    <!-- Main Product Showcase Grid -->
    <div class="w-full mx-auto pt-6 space-y-16 max-w-[1600px]"
         style="padding-left: 8px; padding-right: 8px; margin-left: auto; margin-right: auto;">

        <!-- Active Layout matching exact user specifications:
             Gallery Column: 36.5%
             Details Column: 63.5% (Ratio 1 : 1.74)
             Gallery Frame Height: 690px
             Photo Card Dimensions: 420px × 520px (Ratio 1 : 1.24)
             Column Gap: 64px
             Page Side Margins (Left/Right): 8px -->
        <div class="dish-detail-grid items-start" style="gap: 64px;">
            <!-- Left Column: Gallery Frame (36.5%) -->
            <div class="lg:sticky lg:top-24 self-start space-y-4 w-full">
                <div class="dish-gallery-frame-690 relative w-full flex items-center justify-center overflow-hidden bg-[var(--color-surface)] rounded-[24px] border border-[var(--color-border)] select-none shadow-sm"
                     style="height: 690px;"
                     x-data="{
                         isDragging: false,
                         startY: 0,
                         navigate(dir) {
                             if (dir > 0) {
                                 activeImageIndex = (activeImageIndex + 1) % dish.images.length;
                             } else {
                                 activeImageIndex = (activeImageIndex - 1 + dish.images.length) % dish.images.length;
                             }
                         },
                         getCardStyle(idx) {
                             const total = dish.images.length;
                             let diff = idx - activeImageIndex;
                             if (diff > total / 2) diff -= total;
                             if (diff < -total / 2) diff += total;

                             const stepY = 125;
                             const step2Y = Math.round(stepY * 1.8);

                             if (diff === 0) {
                                 return { y: 0, scale: 1, opacity: 1, zIndex: 5, rotateX: 0, visible: true };
                             } else if (diff === -1) {
                                 return { y: -stepY, scale: 0.88, opacity: 0.7, zIndex: 4, rotateX: 6, visible: true };
                             } else if (diff === -2) {
                                 return { y: -step2Y, scale: 0.76, opacity: 0.35, zIndex: 3, rotateX: 12, visible: true };
                             } else if (diff === 1) {
                                 return { y: stepY, scale: 0.88, opacity: 0.7, zIndex: 4, rotateX: -6, visible: true };
                             } else if (diff === 2) {
                                 return { y: step2Y, scale: 0.76, opacity: 0.35, zIndex: 3, rotateX: -12, visible: true };
                             } else {
                                 return { y: diff > 0 ? 400 : -400, scale: 0.65, opacity: 0, zIndex: 0, rotateX: diff > 0 ? -16 : 16, visible: false };
                             }
                         }
                     }"
                     @@pointerdown="if ($event.target.closest('button')) return; isDragging = true; startY = $event.clientY; $el.setPointerCapture($event.pointerId)"
                     @@pointerup="if (!isDragging) return; isDragging = false; const dy = $event.clientY - startY; if (dy < -35) navigate(1); else if (dy > 35) navigate(-1);"
                     @@wheel.passive="const now = Date.now(); if (now - ($el._lastWheel || 0) > 350) { $el._lastWheel = now; if ($event.deltaY > 0) navigate(1); else if ($event.deltaY < 0) navigate(-1); }">

                    <!-- Ambient Glow -->
                    <div class="pointer-events-none absolute inset-0">
                        <div class="absolute left-1/2 top-1/2 h-[560px] w-[560px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-primary)]/8 blur-3xl"></div>
                    </div>

                    <!-- 3D Card Stack Container (Holds 420px × 520px Photo Cards) -->
                    <div class="relative flex items-center justify-center w-full"
                         style="perspective: 1200px; width: 420px; max-width: 100%; height: 600px;">
                        
                        <template x-for="(imgSrc, idx) in dish.images" :key="idx">
                            <div class="absolute cursor-grab active:cursor-grabbing transition-all duration-400 ease-out"
                                 :style="(() => {
                                     const s = getCardStyle(idx);
                                     return `transform: translate3d(0, ${s.y}px, 0) scale(${s.scale}) rotateX(${s.rotateX}deg); opacity: ${s.opacity}; z-index: ${s.zIndex}; visibility: ${s.visible ? 'visible' : 'hidden'}; pointer-events: ${s.zIndex === 5 ? 'auto' : 'none'}; transform-style: preserve-3d;`;
                                 })()">
                                <div class="dish-photo-card-420-520 relative overflow-hidden rounded-[24px] bg-[var(--color-card-bg)] border border-[var(--color-border)] shadow-xl"
                                     style="width: 420px; height: 520px; max-width: 100%; max-height: 100%;">
                                    <div class="absolute inset-0 z-10 rounded-[24px] bg-gradient-to-b from-white/10 via-transparent to-black/25 pointer-events-none"></div>
                                    <img :src="imgSrc"
                                         :alt="dish.name + ' Photo ' + (idx + 1)"
                                         class="object-cover w-full h-full pointer-events-none select-none" />
                                </div>
                            </div>
                        </template>
                    </div>

                    <!-- Navigation Dots -->
                    <div class="absolute end-4 sm:end-6 top-1/2 flex -translate-y-1/2 flex-col gap-2 z-20">
