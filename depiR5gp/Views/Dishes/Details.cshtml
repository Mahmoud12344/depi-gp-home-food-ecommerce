@using System.Text.Json
@using depiR5gp.Models.Chefs
@model depiR5gp.ViewModels.DishDetailsVM
@{
    ViewData["Title"] = Model.Dish.Name;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var gallery = Model.GalleryImages.Count > 0
        ? Model.GalleryImages
        : new List<string> { string.IsNullOrWhiteSpace(Model.Dish.ImageUrl) ? "/icons/chibi-chef.png" : Model.Dish.ImageUrl };
    var galleryJson = JsonSerializer.Serialize(gallery);
    var kitchenName = Model.Dish.ChefProfile?.KitchenName ?? "HomeChef Kitchen";
    var chefAddress = Model.Dish.ChefProfile?.Address ?? "Direct kitchen pickup";
    var areaName = !string.IsNullOrWhiteSpace(Model.Dish.ChefProfile?.Area)
        ? PickupAreas.NameOf(Model.Dish.ChefProfile.Area)
        : chefAddress;
    var cuisineName = Model.Dish.Cuisine?.Name ?? Model.Dish.Category?.Name ?? "Homemade";
    var optionGroups = Model.Dish.DishOptions
        .GroupBy(o => o.GroupName)
        .OrderByDescending(g => g.Any(o => o.IsRequired))
        .ThenBy(g => g.Key)
        .ToList();
    var defaultSelectedIds = optionGroups
        .Where(g => g.Any(o => o.IsRequired))
        .Select(g => g.OrderBy(o => o.ExtraPrice).First())
        .ToList();
    var defaultSelectedIdsJson = JsonSerializer.Serialize(defaultSelectedIds.Select(o => o.Id).ToList());
    var optionPricesJson = JsonSerializer.Serialize(Model.Dish.DishOptions.ToDictionary(o => o.Id.ToString(), o => o.ExtraPrice));
    var requiredGroupMapJson = JsonSerializer.Serialize(
        optionGroups.Where(g => g.Any(o => o.IsRequired))
            .ToDictionary(g => g.Key, g => g.Select(o => o.Id).ToList()));
}

<div x-data='{
    activeImageIndex: 0,
    lightboxOpen: false,
    isZoomed: false,
    images: @Html.Raw(galleryJson),
    openLightbox() {
        this.lightboxOpen = true;
        this.isZoomed = false;
    },
    closeLightbox() {
        this.lightboxOpen = false;
        this.isZoomed = false;
    },
    quantity: 1,
    dishAvailable: @Model.Dish.IsAvailable.ToString().ToLowerInvariant(),
    basePrice: @Model.Dish.Price.ToString("0.00", inv),
    selectedOptionIds: @Html.Raw(defaultSelectedIdsJson),
    optionPrices: @Html.Raw(optionPricesJson),
    requiredGroups: @Html.Raw(requiredGroupMapJson),
    note: "",
    favorited: @Model.IsFavorite.ToString().ToLowerInvariant(),
    activeAccordion: "description",
    toggleOption(id, groupName, isRequired) {
        if (isRequired) {
            const groupIds = this.requiredGroups[groupName] || [];
            this.selectedOptionIds = this.selectedOptionIds.filter(x => !groupIds.includes(x));
            this.selectedOptionIds.push(id);
        } else {
            if (this.selectedOptionIds.includes(id)) {
                this.selectedOptionIds = this.selectedOptionIds.filter(x => x !== id);
            } else {
                this.selectedOptionIds.push(id);
            }
        }
    },
    get extraPrice() {
        return this.selectedOptionIds.reduce((sum, id) => sum + (Number(this.optionPrices[String(id)]) || 0), 0);
    },
    get unitPrice() {
        return Number(this.basePrice) + this.extraPrice;
    },
    get totalPrice() {
        return this.unitPrice * this.quantity;
    }
}'
     class="w-full pb-36">

    <!-- 1. Breadcrumb Line -->
    <div class="w-full h-14 min-h-[56px] bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] flex items-center">
        <div class="max-w-[1600px] mx-auto px-[8px] w-full">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap">
                <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span>Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
                <a href="/Dishes" class="hover:text-[var(--color-primary)] transition-colors cursor-pointer font-medium">Dishes</a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
                <span class="text-[var(--color-text)] font-semibold truncate max-w-[260px] sm:max-w-md">
                    @Model.Dish.Name
                </span>
            </nav>
        </div>
    </div>

    <!-- Main Product Showcase Grid -->
    <div class="w-full mx-auto pt-6 space-y-16 max-w-[1600px]"
         style="padding-left: 8px; padding-right: 8px; margin-left: auto; margin-right: auto;">

        <div class="dish-detail-grid items-start" style="gap: 64px;">
            <!-- Left Column: Dynamic 3D Vertical Stack Gallery -->
            <div class="lg:sticky lg:top-24 self-start space-y-4 w-full">
                <div class="dish-gallery-frame-690 relative w-full flex items-center justify-center overflow-hidden bg-[var(--color-surface)] rounded-[24px] border border-[var(--color-border)] select-none shadow-sm"
                     style="height: 690px;"
                     x-data="{
                         isDragging: false,
                         startY: 0,
                         navigate(dir) {
                             const total = images.length;
                             if (total <= 1) return;
                             activeImageIndex = dir > 0
                                 ? (activeImageIndex + 1) % total
                                 : (activeImageIndex - 1 + total) % total;
                         },
                         getCardStyle(idx) {
                             const total = images.length;
                             if (total === 1) {
                                 return { y: 0, scale: 1, opacity: 1, zIndex: 5, rotateX: 0, visible: true };
                             }
                             let diff = idx - activeImageIndex;
                             if (diff > total / 2) diff -= total;
                             if (diff < -total / 2) diff += total;

                             const stepY = 125;
                             const step2Y = Math.round(stepY * 1.8);

                             if (diff === 0) return { y: 0, scale: 1, opacity: 1, zIndex: 5, rotateX: 0, visible: true };
                             if (diff === -1) return { y: -stepY, scale: 0.88, opacity: 0.7, zIndex: 4, rotateX: 6, visible: true };
                             if (diff === -2) return { y: -step2Y, scale: 0.76, opacity: 0.35, zIndex: 3, rotateX: 12, visible: true };
                             if (diff === 1) return { y: stepY, scale: 0.88, opacity: 0.7, zIndex: 4, rotateX: -6, visible: true };
                             if (diff === 2) return { y: step2Y, scale: 0.76, opacity: 0.35, zIndex: 3, rotateX: -12, visible: true };
                             return { y: diff > 0 ? 400 : -400, scale: 0.65, opacity: 0, zIndex: 0, rotateX: diff > 0 ? -16 : 16, visible: false };
                         }
                     }"
                     @@pointerdown="if ($event.target.closest('button')) return; isDragging = true; startY = $event.clientY; $el.setPointerCapture($event.pointerId)"
                     @@pointerup="if (!isDragging) return; isDragging = false; const dy = $event.clientY - startY; if (dy < -35) navigate(1); else if (dy > 35) navigate(-1);"
                     @@wheel.passive="if (images.length <= 1) return; const now = Date.now(); if (now - ($el._lastWheel || 0) > 350) { $el._lastWheel = now; if ($event.deltaY > 0) navigate(1); else if ($event.deltaY < 0) navigate(-1); }">

                    <!-- Ambient Glow -->
                    <div class="pointer-events-none absolute inset-0">
                        <div class="absolute left-1/2 top-1/2 h-[560px] w-[560px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-primary)]/8 blur-3xl"></div>
                    </div>

                    <!-- Dynamic 3D Photo Cards -->
                    <div class="relative flex items-center justify-center w-full"
                         style="perspective: 1200px; width: 420px; max-width: 100%; height: 600px;">
                        @for (int i = 0; i < gallery.Count; i++)
                        {
                            <div class="absolute cursor-grab active:cursor-grabbing transition-all duration-400 ease-out"
                                 :style="(() => { const s = getCardStyle(@i); return `transform: translate3d(0, ${s.y}px, 0) scale(${s.scale}) rotateX(${s.rotateX}deg); opacity: ${s.opacity}; z-index: ${s.zIndex}; visibility: ${s.visible ? 'visible' : 'hidden'}; pointer-events: ${s.zIndex === 5 ? 'auto' : 'none'}; transform-style: preserve-3d;`; })()">
                                <div class="dish-photo-card-420-520 relative overflow-hidden rounded-[24px] bg-[var(--color-card-bg)] border border-[var(--color-border)] shadow-xl"
                                     style="width: 420px; height: 520px; max-width: 100%; max-height: 100%;">
                                    <div class="absolute inset-0 z-10 rounded-[24px] bg-gradient-to-b from-white/10 via-transparent to-black/25 pointer-events-none"></div>
                                    <img src="@gallery[i]"
                                         alt="@Model.Dish.Name Photo @(i + 1)"
                                         class="object-cover w-full h-full pointer-events-none select-none" />
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Navigation Dots -->
                    @if (gallery.Count > 1)
                    {
                        <div class="absolute end-4 sm:end-6 top-1/2 flex -translate-y-1/2 flex-col gap-2 z-20">
                            @for (int i = 0; i < gallery.Count; i++)
                            {
                                <button type="button"
                                        @@click="activeImageIndex = @i"
                                        aria-label="View photo @(i + 1)"
                                        class="w-2.5 h-2.5 rounded-full transition-all cursor-pointer"
                                        :class="activeImageIndex === @i ? 'bg-[var(--color-primary)] scale-125' : 'bg-neutral-400/40 hover:bg-neutral-400'"></button>
                            }
                        </div>
                    }

                    @if (!Model.Dish.IsAvailable)
                    {
                        <span class="absolute top-4 start-4 bg-neutral-900/90 text-white text-[12px] font-bold px-3 py-1 uppercase tracking-wider rounded-full shadow-md z-30 pointer-events-none">
                            Currently Unavailable
                        </span>
                    }

                    <!-- Top-Right Zoom In Icon -->
                    <button type="button"
                            @@pointerdown.stop
                            @@pointerup.stop
                            @@click.stop="openLightbox()"
                            class="absolute top-4 end-4 p-2.5 rounded-full bg-black/60 hover:bg-black/85 text-white backdrop-blur-xs transition-colors cursor-pointer z-40 shadow-md hover:scale-110 active:scale-95"
                            aria-label="Zoom in"
                            title="Zoom in">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            <line x1="11" y1="8" x2="11" y2="14"></line>
                            <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                    </button>
                </div>

                <!-- Dynamic Thumbnail Row -->
                @if (gallery.Count > 1)
                {
                    <div class="flex items-center gap-3 overflow-x-auto py-1 px-0.5 no-scrollbar">
                        @for (int i = 0; i < gallery.Count; i++)
                        {
                            <button type="button"
                                    @@click="activeImageIndex = @i"
                                    :class="activeImageIndex === @i ? 'border-[var(--color-primary)] ring-2 ring-[var(--color-primary)]/30 scale-102 shadow-sm' : 'border-[var(--color-border)] opacity-70 hover:opacity-100 hover:border-neutral-400'"
                                    class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden border-2 transition-all cursor-pointer">
                                <img src="@gallery[i]" alt="@Model.Dish.Name Thumbnail @(i + 1)" class="w-full h-full object-cover" />
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Right Column: Dynamic Customization & Details -->
            <div class="space-y-6 w-full">
                <div>
                    <!-- Cuisine & Chef Kitchen Kicker -->
                    <div class="flex items-center gap-2 text-[13px] text-[var(--color-text-muted)] mb-2 font-medium flex-wrap">
                        <span>@cuisineName</span>
                        @if (Model.Dish.Category != null && Model.Dish.Category.Name != cuisineName)
                        {
                            <span>·</span>
                            <span>@Model.Dish.Category.Name</span>
                        }
                        <span>·</span>
                        <a href="/Chefs/Details/@Model.Dish.ChefProfileId"
                           class="text-[var(--color-primary)] font-bold hover:underline cursor-pointer">
                            @kitchenName
                        </a>
                    </div>

                    <!-- Dynamic Title -->
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold uppercase tracking-tight text-[var(--color-text)] [text-wrap:balance]">
                        @Model.Dish.Name
                    </h1>

                    <!-- Dynamic Star Rating -->
                    <div class="flex items-center gap-2.5 mt-3">
                        <div class="flex items-center text-[var(--color-star)]">
                            @for (int s = 1; s <= 5; s++)
                            {
                                var filled = Model.ReviewCount == 0 || s <= Math.Round(Model.AverageRating);
                                <svg class="w-4 h-4 @(filled ? "fill-current" : "stroke-current opacity-35")" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            }
                        </div>
                        <span class="text-[13px] text-[var(--color-text-muted)] font-semibold">
                            @if (Model.ReviewCount > 0)
                            {
                                <span>@Model.AverageRating.ToString("0.0", inv) (@Model.ReviewCount review@(Model.ReviewCount == 1 ? "" : "s"))</span>
                            }
                            else
                            {
                                <span>New Dish · Be the first to review</span>
                            }
                        </span>
                    </div>

                    <!-- Dynamic Price Display -->
                    <div class="flex items-baseline gap-3 my-4">
                        <span class="text-2xl sm:text-3xl font-bold text-[var(--color-primary)]"
                              x-text="unitPrice.toFixed(2) + ' EGP'">@Model.Dish.Price.ToString("0.00", inv) EGP</span>
                        <span class="text-xs font-bold uppercase px-2.5 py-0.5 rounded-full @(Model.Dish.IsAvailable ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-200" : "bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-200")">
                            @(Model.Dish.IsAvailable ? "Available Now" : "Sold Out / Unavailable")
                        </span>
                    </div>

                    <!-- Area & Prep Info -->
                    <div class="flex flex-wrap items-center gap-4 text-[13px] text-[var(--color-text-muted)] pb-4 border-b border-[var(--color-border)]">
                        <span class="flex items-center gap-1.5 font-medium">
                            <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#map-pin"></use></svg>
                            <span>@areaName</span>
                        </span>
                        <span>·</span>
                        <span class="flex items-center gap-1.5 font-medium">
                            <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#clock"></use></svg>
                            <span>Freshly prepared to order</span>
                        </span>
                    </div>
                </div>

                <!-- Dynamic Add to Cart Form -->
                <form method="post" action="/Cart/Add" class="space-y-6 pt-1" data-dish-name="@Model.Dish.Name">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="dishId" value="@Model.Dish.Id" />
                    <input type="hidden" name="quantity" :value="quantity" />

                    <template x-for="optId in selectedOptionIds" :key="optId">
                        <input type="hidden" name="selectedOptionIds" :value="optId" />
                    </template>

                    <!-- Dynamic Option Groups from Database -->
                    @if (optionGroups.Any())
                    {
                        <div class="space-y-5">
                            @foreach (var group in optionGroups)
                            {
                                var isReq = group.Any(o => o.IsRequired);
                                var groupKeyJson = JsonSerializer.Serialize(group.Key);
                                <div class="space-y-2.5">
                                    <div class="flex items-center justify-between text-[13px]">
                                        <span class="font-bold uppercase tracking-wider text-[var(--color-text)]">@group.Key</span>
                                        <span class="text-[11px] font-bold uppercase px-2 py-0.5 rounded-full @(isReq ? "bg-[var(--color-primary-light)] text-[var(--color-primary)]" : "bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)]")">
                                            @(isReq ? "Required" : "Optional")
                                        </span>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        @foreach (var opt in group.OrderBy(o => o.ExtraPrice).ThenBy(o => o.Name))
                                        {
                                            <button type="button"
                                                    @@click="toggleOption(@opt.Id, @Html.Raw(groupKeyJson), @isReq.ToString().ToLowerInvariant())"
                                                    :class="selectedOptionIds.includes(@opt.Id) ? 'border-[var(--color-primary)] bg-[var(--color-primary-light)]/40 shadow-xs font-semibold' : 'border-[var(--color-border)] bg-[var(--color-card-bg)] font-medium'"
                                                    class="w-full flex items-center justify-between p-3.5 rounded-xl text-[13px] border text-[var(--color-text)] cursor-pointer transition-all">
                                                <div class="flex items-center gap-3">
                                                    <span class="w-5 h-5 @(isReq ? "rounded-full" : "rounded-md") border flex items-center justify-center"
                                                          :class="selectedOptionIds.includes(@opt.Id) ? 'border-[var(--color-primary)] bg-[var(--color-primary)] text-white' : 'border-[var(--color-border)] bg-transparent'">
                                                        <svg x-show="selectedOptionIds.includes(@opt.Id)" class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check"></use></svg>
                                                    </span>
                                                    <span>@opt.Name</span>
                                                </div>
                                                <span class="text-[13px] @(opt.ExtraPrice > 0 ? "text-[var(--color-primary)] font-semibold" : "text-[var(--color-text-muted)]")">
                                                    @(opt.ExtraPrice > 0 ? $"+{opt.ExtraPrice.ToString("0.00", inv)} EGP" : "Included")
                                                </span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Special Instructions Note -->
                    <div class="space-y-1.5 pt-2">
                        <div class="flex items-center justify-between text-[13px]">
                            <label for="chef-special-note" class="font-bold uppercase tracking-wider text-[var(--color-text)]">
                                Special Kitchen Instructions
                            </label>
                            <span class="font-mono text-[13px] text-[var(--color-text-muted)]" x-text="note.length + '/200'">0/200</span>
                        </div>
                        <textarea id="chef-special-note"
                                  name="notes"
                                  rows="2"
                                  maxlength="200"
                                  x-model="note"
                                  placeholder="e.g. Mild spice, extra garlic, hot packing for pickup..."
                                  class="w-full text-[13px] p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-2xl focus:border-[var(--color-primary)] focus:outline-hidden resize-none font-medium"></textarea>
                    </div>

                    <!-- Quantity Stepper, Add to Cart & Favorite Buttons -->
                    <div class="space-y-3 pt-3">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center border border-[var(--color-border)] rounded-full bg-white dark:bg-neutral-800 p-1">
                                <button type="button" @@click="quantity = Math.max(1, quantity - 1)" class="w-8 h-8 rounded-full flex items-center justify-center font-bold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer text-[14px]">−</button>
                                <span class="w-10 text-center font-bold text-[13px]" x-text="quantity">1</span>
                                <button type="button" @@click="quantity = quantity + 1" class="w-8 h-8 rounded-full flex items-center justify-center font-bold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer text-[14px]">+</button>
                            </div>

                            <button type="submit"
                                    :disabled="!dishAvailable"
                                    class="flex-1 inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed rounded-full text-[13px] px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#shopping-bag"></use></svg>
                                <span><span x-text="dishAvailable ? 'Add to Cart' : 'Unavailable'">Add to Cart</span> · <span x-text="totalPrice.toFixed(2) + ' EGP'">@Model.Dish.Price.ToString("0.00", inv) EGP</span></span>
                            </button>

                            <button type="button"
                                    data-favorite-dish-id="@Model.Dish.Id"
                                    data-favorite-active="@Model.IsFavorite.ToString().ToLowerInvariant()"
                                    @@click.stop="window.toggleDishFavorite($el)"
                                    aria-label="@(Model.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                                    aria-pressed="@Model.IsFavorite.ToString().ToLowerInvariant()"
                                    class="p-3 border border-[var(--color-border)] hover:border-rose-400 rounded-full transition-colors cursor-pointer text-[var(--color-text)] hover:text-rose-500">
                                <svg class="w-5 h-5" :class="favorited ? 'fill-rose-500 text-rose-500' : 'stroke-current'" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#heart"></use></svg>
                            </button>
                        </div>

                        <a href="/Cart"
                           class="w-full inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 select-none cursor-pointer rounded-full text-[13px] px-6 py-3 gap-2 shadow-xs bg-[var(--color-secondary-btn)] text-white hover:bg-[var(--color-secondary-hover)] active:scale-[0.98] hover:shadow-md">
                            <span>View Cart &amp; Checkout</span>
                        </a>
                    </div>
                </form>

                <!-- Dynamic Chef Kitchen Info Box -->
                <div class="bg-[var(--color-surface-subtle)] border border-[var(--color-border-light)] rounded-2xl p-4 flex items-center justify-between gap-4 text-[13px]">
                    <div class="space-y-0.5">
                        <a href="/Chefs/Details/@Model.Dish.ChefProfileId" class="font-bold text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors">
                            @kitchenName
                        </a>
                        <p class="text-[12px] text-[var(--color-text-muted)]">@chefAddress</p>
                    </div>
                    <a href="/Chefs/Details/@Model.Dish.ChefProfileId"
                       class="text-[var(--color-primary)] hover:underline font-semibold flex items-center gap-1.5 cursor-pointer text-[13px] shrink-0">
                        <span>View Kitchen</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#arrow-right"></use></svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- Accordions -->
        <div class="border-t border-[var(--color-border)] pt-8 space-y-4 max-w-4xl mx-auto">
            <!-- Dynamic Description -->
            <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden">
                <button type="button"
                        @@click="activeAccordion = (activeAccordion === 'description' ? '' : 'description')"
                        class="w-full p-5 text-start font-bold uppercase tracking-wider text-[14px] flex items-center justify-between bg-[var(--color-card-bg)] cursor-pointer">
                    <span>Dish Description &amp; Details</span>
                    <svg class="w-4 h-4 transition-transform" :class="activeAccordion === 'description' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-down"></use></svg>
                </button>
                <div x-show="activeAccordion === 'description'" class="p-5 pt-0 text-[13px] sm:text-sm text-[var(--color-text-muted)] leading-relaxed bg-[var(--color-card-bg)] space-y-3">
                    <p>@(string.IsNullOrWhiteSpace(Model.Dish.Description) ? "Freshly cooked homemade meal prepared with care in a verified domestic kitchen." : Model.Dish.Description)</p>
                </div>
            </div>

            <!-- Kitchen Pickup Policies -->
            <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden">
                <button type="button"
                        @@click="activeAccordion = (activeAccordion === 'pickup' ? '' : 'pickup')"
                        class="w-full p-5 text-start font-bold uppercase tracking-wider text-[14px] flex items-center justify-between bg-[var(--color-card-bg)] cursor-pointer">
                    <span>Kitchen Pickup &amp; Food Safety Guarantee</span>
                    <svg class="w-4 h-4 transition-transform" :class="activeAccordion === 'pickup' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-down"></use></svg>
                </button>
                <div x-show="activeAccordion === 'pickup'" x-cloak class="p-5 pt-0 text-[13px] text-[var(--color-text-muted)] leading-relaxed bg-[var(--color-card-bg)] space-y-2">
                    <p>Direct counter pickup from <strong>@kitchenName</strong> (@chefAddress). You will receive updates as soon as your meal is packed hot.</p>
                    <p class="font-semibold text-[var(--color-primary)]">Verified hygiene certificate on file with HomeChef administration.</p>
                </div>
            </div>

            <!-- Dynamic Approved Reviews -->
            <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden">
                <button type="button"
                        @@click="activeAccordion = (activeAccordion === 'reviews' ? '' : 'reviews')"
                        class="w-full p-5 text-start font-bold uppercase tracking-wider text-[14px] flex items-center justify-between bg-[var(--color-card-bg)] cursor-pointer">
                    <span>Customer Love &amp; Reviews (@Model.ReviewCount)</span>
                    <svg class="w-4 h-4 transition-transform" :class="activeAccordion === 'reviews' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-down"></use></svg>
                </button>
                <div x-show="activeAccordion === 'reviews'" x-cloak class="p-5 pt-0 space-y-4 bg-[var(--color-card-bg)]">
                    @if (Model.Reviews.Any())
                    {
                        @foreach (var review in Model.Reviews)
                        {
                            var reviewerName = review.User != null
                                ? $"{review.User.FirstName} {review.User.LastName}".Trim()
                                : "Verified Customer";
                            <div class="border border-[var(--color-border-light)] p-4 rounded-xl space-y-1.5">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="font-bold text-[var(--color-text)]">@reviewerName</span>
                                    <span class="text-amber-500 font-bold">@(new string('★', review.Rating))@(new string('☆', Math.Max(0, 5 - review.Rating)))</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(review.Comment))
                                {
                                    <p class="text-xs text-[var(--color-text-muted)] italic leading-relaxed">“@review.Comment”</p>
                                }
                                <p class="text-[11px] text-[var(--color-text-muted)] opacity-75">@review.CreatedAt.ToString("MMM dd, yyyy")</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-[var(--color-text-muted)]">No verified reviews yet for this kitchen.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Dynamic Lightbox Zoom In Modal -->
    <template x-teleport="body">
        <div x-show="lightboxOpen"
             x-cloak
             role="dialog"
             aria-modal="true"
             class="fixed inset-0 z-[99999] flex items-center justify-center bg-black/92 backdrop-blur-md p-4 select-none"
             @@keydown.escape.window="closeLightbox()">

            <div class="absolute top-4 inset-x-4 sm:inset-x-6 flex items-center justify-between z-50 pointer-events-auto">
                <div class="flex items-center gap-3 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full text-white text-xs sm:text-sm font-semibold">
                    <span>@Model.Dish.Name</span>
                    <span class="opacity-40">·</span>
                    <span x-text="(activeImageIndex + 1) + ' / ' + images.length">1 / @gallery.Count</span>
                </div>

                <div class="flex items-center gap-2">
                    <button type="button"
                            @@click="isZoomed = !isZoomed"
                            class="p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer shadow-md flex items-center gap-1.5 px-3.5 text-xs font-semibold"
                            :title="isZoomed ? 'Zoom Out' : 'Zoom In'">
                        <span x-text="isZoomed ? 'Zoom Out' : 'Zoom In'">Zoom In</span>
                    </button>

                    <button type="button"
                            @@click="closeLightbox()"
                            class="p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors cursor-pointer shadow-md"
                            aria-label="Close zoom">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><use href="#x"></use></svg>
                    </button>
                </div>
            </div>

            <button type="button"
                    x-show="images.length > 1"
                    @@click="activeImageIndex = (activeImageIndex === 0 ? images.length - 1 : activeImageIndex - 1); isZoomed = false"
                    class="absolute start-4 top-1/2 -translate-y-1/2 p-3 rounded-full bg-white/10 hover:bg-white/25 text-white transition-all cursor-pointer z-50 shadow-lg"
                    aria-label="Previous photo">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-left"></use></svg>
            </button>

            <button type="button"
                    x-show="images.length > 1"
                    @@click="activeImageIndex = (activeImageIndex === images.length - 1 ? 0 : activeImageIndex + 1); isZoomed = false"
                    class="absolute end-4 top-1/2 -translate-y-1/2 p-3 rounded-full bg-white/10 hover:bg-white/25 text-white transition-all cursor-pointer z-50 shadow-lg"
                    aria-label="Next photo">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
            </button>

            <div class="relative max-w-5xl max-h-[82vh] overflow-auto flex items-center justify-center p-2"
                 @@click.self="closeLightbox()">
                <img :src="images[activeImageIndex]"
                     alt="@Model.Dish.Name Zoomed Photo"
                     @@click="isZoomed = !isZoomed"
                     class="max-h-[78vh] object-contain rounded-2xl shadow-2xl transition-all duration-300 select-none"
                     :class="isZoomed ? 'scale-150 sm:scale-175 cursor-zoom-out' : 'cursor-zoom-in hover:scale-102'" />
            </div>
        </div>
    </template>
</div>
