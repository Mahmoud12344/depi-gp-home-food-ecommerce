@model depiR5gp.ViewModels.DishDetailsVM
@{
    ViewData["Title"] = Model.Dish.Name;
}
<!-- Views/Dishes/Details.cshtml -->
<!-- Ported from Views/Dishes/Partials/_DishDetail.cshtml on main -->
<!-- TODO(backend): Bind dish model, dynamic reviews, and option groups from database -->

<div x-data="{
    activeImageIndex: 0,
    lightboxOpen: false,
    isZoomed: false,
    openLightbox() {
        this.lightboxOpen = true;
        this.isZoomed = false;
    },
    closeLightbox() {
        this.lightboxOpen = false;
        this.isZoomed = false;
    },
    quantity: 1,
    dishAvailable: @Model.Dish.IsAvailable.ToString().ToLowerInvariant(),
    selectedPortion: 'thigh',
    portionExtra: 0,
    note: '',
    favorited: @Model.IsFavorite.ToString().ToLowerInvariant(),
    activeAccordion: 'description',
    images: [
        'https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=1000&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=1000&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1544025162-d76694265947?w=1000&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1000&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=1000&auto=format&fit=crop&q=80'
    ]
}"
     class="w-full pb-36">

    <!-- 1. Single 56px Breadcrumb Line -->
    <div class="w-full h-14 min-h-[56px] bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] flex items-center">
        <div class="max-w-[1600px] mx-auto px-[8px] w-full">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap">
                <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span>Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#chevron-right"></use>
                </svg>
                <a href="/Dishes" class="hover:text-[var(--color-primary)] transition-colors cursor-pointer font-medium">Dishes</a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#chevron-right"></use>
                </svg>
                <span class="text-[var(--color-text)] font-semibold truncate max-w-[260px] sm:max-w-md">
                     @Model.Dish.Name
                </span>
            </nav>
        </div>
    </div>

    <!-- Main Product Showcase Grid -->
    <div class="w-full mx-auto pt-6 space-y-16 max-w-[1600px]"
         style="padding-left: 8px; padding-right: 8px; margin-left: auto; margin-right: auto;">

        <!-- Active Layout matching exact user specifications:
             Gallery Column: 36.5%
             Details Column: 63.5% (Ratio 1 : 1.74)
             Gallery Frame Height: 690px
             Photo Card Dimensions: 420px × 520px (Ratio 1 : 1.24)
             Column Gap: 64px
             Page Side Margins (Left/Right): 8px -->
        <div class="dish-detail-grid items-start" style="gap: 64px;">
            <!-- Left Column: Gallery Frame (36.5%) -->
            <div class="lg:sticky lg:top-24 self-start space-y-4 w-full">
                <div class="dish-gallery-frame-690 relative w-full flex items-center justify-center overflow-hidden bg-[var(--color-surface)] rounded-[24px] border border-[var(--color-border)] select-none shadow-sm"
                     style="height: 690px;"
                     x-data="{
                         isDragging: false,
                         startY: 0,
                         navigate(dir) {
                             if (dir > 0) {
                                 activeImageIndex = (activeImageIndex + 1) % 5;
                             } else {
                                 activeImageIndex = (activeImageIndex - 1 + 5) % 5;
                             }
                         },
                         getCardStyle(idx) {
                             const total = 5;
                             let diff = idx - activeImageIndex;
                             if (diff > total / 2) diff -= total;
                             if (diff < -total / 2) diff += total;

                             const stepY = 125;
                             const step2Y = Math.round(stepY * 1.8);

                             if (diff === 0) {
                                 return { y: 0, scale: 1, opacity: 1, zIndex: 5, rotateX: 0, visible: true };
                             } else if (diff === -1) {
                                 return { y: -stepY, scale: 0.88, opacity: 0.7, zIndex: 4, rotateX: 6, visible: true };
                             } else if (diff === -2) {
                                 return { y: -step2Y, scale: 0.76, opacity: 0.35, zIndex: 3, rotateX: 12, visible: true };
                             } else if (diff === 1) {
                                 return { y: stepY, scale: 0.88, opacity: 0.7, zIndex: 4, rotateX: -6, visible: true };
                             } else if (diff === 2) {
                                 return { y: step2Y, scale: 0.76, opacity: 0.35, zIndex: 3, rotateX: -12, visible: true };
                             } else {
                                 return { y: diff > 0 ? 400 : -400, scale: 0.65, opacity: 0, zIndex: 0, rotateX: diff > 0 ? -16 : 16, visible: false };
                             }
                         }
                     }"
                     @@pointerdown="if ($event.target.closest('button')) return; isDragging = true; startY = $event.clientY; $el.setPointerCapture($event.pointerId)"
                     @@pointerup="if (!isDragging) return; isDragging = false; const dy = $event.clientY - startY; if (dy < -35) navigate(1); else if (dy > 35) navigate(-1);"
                     @@wheel.passive="const now = Date.now(); if (now - ($el._lastWheel || 0) > 350) { $el._lastWheel = now; if ($event.deltaY > 0) navigate(1); else if ($event.deltaY < 0) navigate(-1); }">

                    <!-- Ambient Glow -->
                    <div class="pointer-events-none absolute inset-0">
                        <div class="absolute left-1/2 top-1/2 h-[560px] w-[560px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-primary)]/8 blur-3xl"></div>
                    </div>

                    <!-- 3D Card Stack Container (Holds 420px × 520px Photo Cards) -->
                    <div class="relative flex items-center justify-center w-full"
                         style="perspective: 1200px; width: 420px; max-width: 100%; height: 600px;">
                        <!-- BEGIN SAMPLE: Unrolled 5 photo cards from main _DishDetail.cshtml -->
                        <!-- Card 0 -->
                        <div class="absolute cursor-grab active:cursor-grabbing transition-all duration-400 ease-out"
                             :style="(() => { const s = getCardStyle(0); return `transform: translate3d(0, ${s.y}px, 0) scale(${s.scale}) rotateX(${s.rotateX}deg); opacity: ${s.opacity}; z-index: ${s.zIndex}; visibility: ${s.visible ? 'visible' : 'hidden'}; pointer-events: ${s.zIndex === 5 ? 'auto' : 'none'}; transform-style: preserve-3d;`; })()">
                            <div class="dish-photo-card-420-520 relative overflow-hidden rounded-[24px] bg-[var(--color-card-bg)] border border-[var(--color-border)] shadow-xl"
                                 style="width: 420px; height: 520px; max-width: 100%; max-height: 100%;">
                                <div class="absolute inset-0 z-10 rounded-[24px] bg-gradient-to-b from-white/10 via-transparent to-black/25 pointer-events-none"></div>
                                <img src="@(string.IsNullOrWhiteSpace(Model.Dish.ImageUrl) ? "/icons/chibi-chef.png" : Model.Dish.ImageUrl)"
                                     alt="@Model.Dish.Name Photo 1"
                                     class="object-cover w-full h-full pointer-events-none select-none" />
                            </div>
                        </div>

                        <!-- Card 1 -->
                        <div class="absolute cursor-grab active:cursor-grabbing transition-all duration-400 ease-out"
                             :style="(() => { const s = getCardStyle(1); return `transform: translate3d(0, ${s.y}px, 0) scale(${s.scale}) rotateX(${s.rotateX}deg); opacity: ${s.opacity}; z-index: ${s.zIndex}; visibility: ${s.visible ? 'visible' : 'hidden'}; pointer-events: ${s.zIndex === 5 ? 'auto' : 'none'}; transform-style: preserve-3d;`; })()">
                            <div class="dish-photo-card-420-520 relative overflow-hidden rounded-[24px] bg-[var(--color-card-bg)] border border-[var(--color-border)] shadow-xl"
                                 style="width: 420px; height: 520px; max-width: 100%; max-height: 100%;">
                                <div class="absolute inset-0 z-10 rounded-[24px] bg-gradient-to-b from-white/10 via-transparent to-black/25 pointer-events-none"></div>
                                <img src="https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=1000&auto=format&fit=crop&q=80"
                                     alt="Baladi Duck Molokhia with Vermicelli Rice Photo 2"
                                     class="object-cover w-full h-full pointer-events-none select-none" />
                            </div>
                        </div>

                        <!-- Card 2 -->
                        <div class="absolute cursor-grab active:cursor-grabbing transition-all duration-400 ease-out"
                             :style="(() => { const s = getCardStyle(2); return `transform: translate3d(0, ${s.y}px, 0) scale(${s.scale}) rotateX(${s.rotateX}deg); opacity: ${s.opacity}; z-index: ${s.zIndex}; visibility: ${s.visible ? 'visible' : 'hidden'}; pointer-events: ${s.zIndex === 5 ? 'auto' : 'none'}; transform-style: preserve-3d;`; })()">
                            <div class="dish-photo-card-420-520 relative overflow-hidden rounded-[24px] bg-[var(--color-card-bg)] border border-[var(--color-border)] shadow-xl"
                                 style="width: 420px; height: 520px; max-width: 100%; max-height: 100%;">
                                <div class="absolute inset-0 z-10 rounded-[24px] bg-gradient-to-b from-white/10 via-transparent to-black/25 pointer-events-none"></div>
                                <img src="https://images.unsplash.com/photo-1544025162-d76694265947?w=1000&auto=format&fit=crop&q=80"
                                     alt="Baladi Duck Molokhia with Vermicelli Rice Photo 3"
                                     class="object-cover w-full h-full pointer-events-none select-none" />
                            </div>
                        </div>

                        <!-- Card 3 -->
                        <div class="absolute cursor-grab active:cursor-grabbing transition-all duration-400 ease-out"
                             :style="(() => { const s = getCardStyle(3); return `transform: translate3d(0, ${s.y}px, 0) scale(${s.scale}) rotateX(${s.rotateX}deg); opacity: ${s.opacity}; z-index: ${s.zIndex}; visibility: ${s.visible ? 'visible' : 'hidden'}; pointer-events: ${s.zIndex === 5 ? 'auto' : 'none'}; transform-style: preserve-3d;`; })()">
                            <div class="dish-photo-card-420-520 relative overflow-hidden rounded-[24px] bg-[var(--color-card-bg)] border border-[var(--color-border)] shadow-xl"
                                 style="width: 420px; height: 520px; max-width: 100%; max-height: 100%;">
                                <div class="absolute inset-0 z-10 rounded-[24px] bg-gradient-to-b from-white/10 via-transparent to-black/25 pointer-events-none"></div>
                                <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1000&auto=format&fit=crop&q=80"
                                     alt="Baladi Duck Molokhia with Vermicelli Rice Photo 4"
                                     class="object-cover w-full h-full pointer-events-none select-none" />
                            </div>
                        </div>

                        <!-- Card 4 -->
                        <div class="absolute cursor-grab active:cursor-grabbing transition-all duration-400 ease-out"
                             :style="(() => { const s = getCardStyle(4); return `transform: translate3d(0, ${s.y}px, 0) scale(${s.scale}) rotateX(${s.rotateX}deg); opacity: ${s.opacity}; z-index: ${s.zIndex}; visibility: ${s.visible ? 'visible' : 'hidden'}; pointer-events: ${s.zIndex === 5 ? 'auto' : 'none'}; transform-style: preserve-3d;`; })()">
                            <div class="dish-photo-card-420-520 relative overflow-hidden rounded-[24px] bg-[var(--color-card-bg)] border border-[var(--color-border)] shadow-xl"
                                 style="width: 420px; height: 520px; max-width: 100%; max-height: 100%;">
                                <div class="absolute inset-0 z-10 rounded-[24px] bg-gradient-to-b from-white/10 via-transparent to-black/25 pointer-events-none"></div>
                                <img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=1000&auto=format&fit=crop&q=80"
                                     alt="Baladi Duck Molokhia with Vermicelli Rice Photo 5"
                                     class="object-cover w-full h-full pointer-events-none select-none" />
                            </div>
                        </div>
                        <!-- END SAMPLE -->
                    </div>

                    <!-- Navigation Dots -->
                    <div class="absolute end-4 sm:end-6 top-1/2 flex -translate-y-1/2 flex-col gap-2 z-20">
                        <button type="button" @@click="activeImageIndex = 0" class="w-2.5 h-2.5 rounded-full transition-all cursor-pointer" :class="activeImageIndex === 0 ? 'bg-[var(--color-primary)] scale-125' : 'bg-neutral-400/40 hover:bg-neutral-400'"></button>
                        <button type="button" @@click="activeImageIndex = 1" class="w-2.5 h-2.5 rounded-full transition-all cursor-pointer" :class="activeImageIndex === 1 ? 'bg-[var(--color-primary)] scale-125' : 'bg-neutral-400/40 hover:bg-neutral-400'"></button>
                        <button type="button" @@click="activeImageIndex = 2" class="w-2.5 h-2.5 rounded-full transition-all cursor-pointer" :class="activeImageIndex === 2 ? 'bg-[var(--color-primary)] scale-125' : 'bg-neutral-400/40 hover:bg-neutral-400'"></button>
                        <button type="button" @@click="activeImageIndex = 3" class="w-2.5 h-2.5 rounded-full transition-all cursor-pointer" :class="activeImageIndex === 3 ? 'bg-[var(--color-primary)] scale-125' : 'bg-neutral-400/40 hover:bg-neutral-400'"></button>
                        <button type="button" @@click="activeImageIndex = 4" class="w-2.5 h-2.5 rounded-full transition-all cursor-pointer" :class="activeImageIndex === 4 ? 'bg-[var(--color-primary)] scale-125' : 'bg-neutral-400/40 hover:bg-neutral-400'"></button>
                    </div>

                    <!-- SALE tag -->
                    <span class="absolute top-4 start-4 bg-[#dc2626] text-white text-[13px] font-bold px-3 py-1 uppercase tracking-wider rounded-full shadow-md z-30 pointer-events-none">
                        SALE
                    </span>

                    <!-- Discount stamp -->
                    <div class="absolute top-4 end-16 sm:end-20 discount-burst bg-[#f97316] text-white w-14 h-14 flex items-center justify-center text-center shadow-lg select-none z-30 pointer-events-none">
                        <span class="text-[13px] font-bold leading-tight">
                            <span>15%</span><br />OFF
                        </span>
                    </div>

                    <!-- Top-Right Zoom In Icon -->
                    <button type="button"
                            @@pointerdown.stop
                            @@pointerup.stop
                            @@click.stop="openLightbox()"
                            class="absolute top-4 end-4 p-2.5 rounded-full bg-black/60 hover:bg-black/85 text-white backdrop-blur-xs transition-colors cursor-pointer z-40 shadow-md hover:scale-110 active:scale-95"
                            aria-label="Zoom in"
                            title="Zoom in">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            <line x1="11" y1="8" x2="11" y2="14"></line>
                            <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                    </button>
                </div>

                <!-- 64px Thumbnail Row Below -->
                <div class="flex items-center gap-3 overflow-x-auto py-1 px-0.5 no-scrollbar">
                    <button type="button" @@click="activeImageIndex = 0" :class="activeImageIndex === 0 ? 'border-[var(--color-primary)] ring-2 ring-[var(--color-primary)]/30 scale-102 shadow-sm' : 'border-[var(--color-border)] opacity-70 hover:opacity-100 hover:border-neutral-400'" class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden border-2 transition-all cursor-pointer">
                        <img src="https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=1000&auto=format&fit=crop&q=80" alt="Thumbnail 1" class="w-full h-full object-cover" />
                    </button>
                    <button type="button" @@click="activeImageIndex = 1" :class="activeImageIndex === 1 ? 'border-[var(--color-primary)] ring-2 ring-[var(--color-primary)]/30 scale-102 shadow-sm' : 'border-[var(--color-border)] opacity-70 hover:opacity-100 hover:border-neutral-400'" class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden border-2 transition-all cursor-pointer">
                        <img src="https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=1000&auto=format&fit=crop&q=80" alt="Thumbnail 2" class="w-full h-full object-cover" />
                    </button>
                    <button type="button" @@click="activeImageIndex = 2" :class="activeImageIndex === 2 ? 'border-[var(--color-primary)] ring-2 ring-[var(--color-primary)]/30 scale-102 shadow-sm' : 'border-[var(--color-border)] opacity-70 hover:opacity-100 hover:border-neutral-400'" class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden border-2 transition-all cursor-pointer">
                        <img src="https://images.unsplash.com/photo-1544025162-d76694265947?w=1000&auto=format&fit=crop&q=80" alt="Thumbnail 3" class="w-full h-full object-cover" />
                    </button>
                    <button type="button" @@click="activeImageIndex = 3" :class="activeImageIndex === 3 ? 'border-[var(--color-primary)] ring-2 ring-[var(--color-primary)]/30 scale-102 shadow-sm' : 'border-[var(--color-border)] opacity-70 hover:opacity-100 hover:border-neutral-400'" class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden border-2 transition-all cursor-pointer">
                        <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1000&auto=format&fit=crop&q=80" alt="Thumbnail 4" class="w-full h-full object-cover" />
                    </button>
                    <button type="button" @@click="activeImageIndex = 4" :class="activeImageIndex === 4 ? 'border-[var(--color-primary)] ring-2 ring-[var(--color-primary)]/30 scale-102 shadow-sm' : 'border-[var(--color-border)] opacity-70 hover:opacity-100 hover:border-neutral-400'" class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden border-2 transition-all cursor-pointer">
                        <img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=1000&auto=format&fit=crop&q=80" alt="Thumbnail 5" class="w-full h-full object-cover" />
                    </button>
                </div>
            </div>

            <!-- Right Column: Customization & Details (63.5%) -->
            <div class="space-y-6 w-full">
                <div>
                    <!-- Category & Chef Kicker -->
                    <!-- TODO(backend): Bind Dish category and Chef Kitchen profile from database (Model.Dish) -->
                    <div class="flex items-center gap-2 text-[13px] text-[var(--color-text-muted)] mb-2 font-medium">
                        <span>Traditional Egyptian</span>
                        <span>·</span>
                        <a href="/Chefs/Details/1" class="text-[var(--color-primary)] font-bold hover:underline cursor-pointer">Amina's Heritage Kitchen</a>
                    </div>

                    <!-- Title -->
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold uppercase tracking-tight text-[var(--color-text)] [text-wrap:balance]">
                        Baladi Duck Molokhia with Vermicelli Rice
                    </h1>

                    <!-- Star Rating -->
                    <div class="flex items-center gap-2.5 mt-3">
                        <div class="flex items-center text-[var(--color-star)]">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                        </div>
                        <span class="text-[13px] text-[var(--color-text-muted)] font-semibold">
                            4.9 (48 <span>reviews</span>)
                        </span>
                    </div>

                    <!-- Price display -->
                    <div class="flex items-baseline gap-3 my-4">
                        <span class="text-2xl sm:text-3xl font-bold text-[var(--color-primary)]"
                              x-text="(@Model.Dish.Price + portionExtra).toFixed(2) + ' EGP'">@Model.Dish.Price.ToString("0.00") EGP</span>
                        <span class="text-[14px] text-[var(--color-text-muted)] line-through">280.00 EGP</span>
                    </div>

                    <!-- Availability & Prep Info -->
                    <div class="flex flex-wrap items-center gap-4 text-[13px] text-[var(--color-text-muted)] pb-4 border-b border-[var(--color-border)]">
                        <span class="flex items-center gap-1.5 font-medium">
                            <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#clock"></use></svg>
                            <span>45 <span>mins fresh cook time</span></span>
                        </span>
                        <span>·</span>
                        <span class="flex items-center gap-1.5 font-medium">
                            <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#map-pin"></use></svg>
                            <span>Maadi, Cairo</span>
                        </span>
                    </div>
                </div>

                <!-- Add to Cart Form -->
                <!-- TODO(backend): POST /Cart/Add(dishId, quantity, selectedOptionIds, notes) -->
                <form method="post" action="/Cart/Add" class="space-y-6 pt-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="dishId" value="@Model.Dish.Id" />
                    <input type="hidden" name="selectedPortion" :value="selectedPortion" />
                    <input type="hidden" name="quantity" :value="quantity" />

                    <!-- Option Groups Preset -->
                    <!-- TODO(backend): Iterate through Model.Dish.OptionGroups (portions, extra sides, spices) and bind price modifiers -->
                    <div class="space-y-2.5">
                        <div class="flex items-center justify-between text-[13px]">
                            <span class="font-bold uppercase tracking-wider text-[var(--color-text)]">Duck Portion:</span>
                            <span class="text-[13px] text-[var(--color-primary)] font-bold uppercase">Required</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <button type="button"
                                    @@click="selectedPortion = 'thigh'; portionExtra = 0"
                                    :class="selectedPortion === 'thigh' ? 'border-[var(--color-primary)] bg-[var(--color-primary-light)]/40 shadow-xs font-semibold' : 'border-[var(--color-border)] bg-[var(--color-card-bg)] font-medium'"
                                    class="w-full flex items-center justify-between p-3.5 rounded-xl text-[13px] border text-[var(--color-text)] cursor-pointer transition-all">
                                <div class="flex items-center gap-3">
                                    <span class="w-5 h-5 rounded-full border flex items-center justify-center"
                                          :class="selectedPortion === 'thigh' ? 'border-[var(--color-primary)] bg-[var(--color-primary)] text-white' : 'border-[var(--color-border)] bg-transparent'">
                                        <svg x-show="selectedPortion === 'thigh'" class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check"></use></svg>
                                    </span>
                                    <span>Duck Thigh &amp; Drumstick</span>
                                </div>
                                <span class="text-[var(--color-text-muted)] text-[13px]">Included</span>
                            </button>
                            <button type="button"
                                    @@click="selectedPortion = 'breast'; portionExtra = 35"
                                    :class="selectedPortion === 'breast' ? 'border-[var(--color-primary)] bg-[var(--color-primary-light)]/40 shadow-xs font-semibold' : 'border-[var(--color-border)] bg-[var(--color-card-bg)] font-medium'"
                                    class="w-full flex items-center justify-between p-3.5 rounded-xl text-[13px] border text-[var(--color-text)] cursor-pointer transition-all">
                                <div class="flex items-center gap-3">
                                    <span class="w-5 h-5 rounded-full border flex items-center justify-center"
                                          :class="selectedPortion === 'breast' ? 'border-[var(--color-primary)] bg-[var(--color-primary)] text-white' : 'border-[var(--color-border)] bg-transparent'">
                                        <svg x-show="selectedPortion === 'breast'" class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check"></use></svg>
                                    </span>
                                    <span>Whole Duck Breast</span>
                                </div>
                                <span class="text-[var(--color-primary)] font-semibold text-[13px]">+35.00 EGP</span>
                            </button>
                        </div>
                    </div>

                    <!-- Special Instructions Note -->
                    <div class="space-y-1.5 pt-2">
                        <div class="flex items-center justify-between text-[13px]">
                            <label for="chef-special-note" class="font-bold uppercase tracking-wider text-[var(--color-text)]">
                                Special Kitchen Instructions
                            </label>
                            <span class="font-mono text-[13px] text-[var(--color-text-muted)]" x-text="note.length + '/200'">0/200</span>
                        </div>
                        <textarea id="chef-special-note"
                                  name="notes"
                                  rows="2"
                                  maxlength="200"
                                  x-model="note"
                                  placeholder="e.g. Extra crispy duck skin, mild spice, hot packing for pickup..."
                                  class="w-full text-[13px] p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-2xl focus:border-[var(--color-primary)] focus:outline-hidden resize-none font-medium"></textarea>
                    </div>

                    <!-- Quantity Stepper & Buttons -->
                    <div class="space-y-3 pt-3">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center border border-[var(--color-border)] rounded-full bg-white dark:bg-neutral-800 p-1">
                                <button type="button" @@click="quantity = Math.max(1, quantity - 1)" class="w-8 h-8 rounded-full flex items-center justify-center font-bold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer text-[14px]">−</button>
                                <span class="w-10 text-center font-bold text-[13px]" x-text="quantity">1</span>
                                <button type="button" @@click="quantity = quantity + 1" class="w-8 h-8 rounded-full flex items-center justify-center font-bold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer text-[14px]">+</button>
                            </div>

                            <button type="submit"
                                    :disabled="!dishAvailable"
                                    class="flex-1 inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer rounded-full text-[13px] px-6 py-2.5 gap-2 shadow-xs bg-transparent border-2 border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white focus-visible:outline-[var(--color-primary)]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#shopping-bag"></use></svg>
                                <span><span x-text="dishAvailable ? 'Add to Cart' : 'Unavailable'">Add to Cart</span> · <span x-text="((@Model.Dish.Price + portionExtra) * quantity).toFixed(2) + ' EGP'">@Model.Dish.Price.ToString("0.00") EGP</span></span>
                            </button>

                             <button type="button" data-favorite-dish-id="@Model.Dish.Id"
                                     @@click.stop
                                    class="p-3 border border-[var(--color-border)] hover:border-rose-400 rounded-full transition-colors cursor-pointer text-[var(--color-text)] hover:text-rose-500">
                                <svg class="w-5 h-5" :class="favorited ? 'fill-rose-500 text-rose-500' : 'stroke-current'" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#heart"></use></svg>
                            </button>
                        </div>

                        <a href="/Checkout"
                           class="w-full inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer rounded-full text-[13px] px-6 py-3 gap-2 shadow-xs bg-[var(--color-secondary-btn)] text-white hover:bg-[var(--color-secondary-hover)] active:scale-[0.98] focus-visible:outline-neutral-700 hover:shadow-md">
                            <span>Buy It Now (Fast Checkout)</span>
                        </a>
                    </div>
                </form>

                <!-- Chef Kitchen Counter Info Box -->
                <div class="bg-[var(--color-surface-subtle)] border border-[var(--color-border-light)] rounded-2xl p-4 flex items-center justify-between text-[13px]">
                    <div class="space-y-0.5">
                        <span class="font-bold text-[var(--color-text)]">Amina's Heritage Kitchen</span>
                        <p class="text-[13px] text-[var(--color-text-muted)]">Villa 14, Road 9, Degla, Maadi, Cairo</p>
                    </div>
                    <a href="/Chat" class="text-[var(--color-primary)] hover:underline font-semibold flex items-center gap-1.5 cursor-pointer text-[13px]">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#message-circle"></use></svg>
                        <span>Chat</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Accordions -->
        <div class="border-t border-[var(--color-border)] pt-8 space-y-4 max-w-4xl mx-auto">
            <!-- Description -->
            <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden">
                <button type="button"
                        @@click="activeAccordion = (activeAccordion === 'description' ? '' : 'description')"
                        class="w-full p-5 text-start font-bold uppercase tracking-wider text-[14px] flex items-center justify-between bg-[var(--color-card-bg)] cursor-pointer">
                    <span>Dish Description &amp; Ingredients</span>
                    <svg class="w-4 h-4 transition-transform" :class="activeAccordion === 'description' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-down"></use></svg>
                </button>
                <div x-show="activeAccordion === 'description'" class="p-5 pt-0 text-[13px] sm:text-sm text-[var(--color-text-muted)] leading-relaxed bg-[var(--color-card-bg)] space-y-3">
                    <p>Minced fresh molokhia leaves whipped with golden baladi garlic and coriander ta'sheya, paired with roasted heritage duck and Egyptian vermicelli rice.</p>
                    <ul class="list-disc list-inside space-y-1 text-[13px] pt-2">
                        <li>100% pure Egyptian baladi ghee</li>
                        <li>Whole spices freshly toasted and ground in-house</li>
                        <li>Zero artificial flavor enhancers or preservatives</li>
                    </ul>
                </div>
            </div>

            <!-- Kitchen Pickup Policies -->
            <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden">
                <button type="button"
                        @@click="activeAccordion = (activeAccordion === 'pickup' ? '' : 'pickup')"
                        class="w-full p-5 text-start font-bold uppercase tracking-wider text-[14px] flex items-center justify-between bg-[var(--color-card-bg)] cursor-pointer">
                    <span>Kitchen Pickup &amp; Food Safety Guarantee</span>
                    <svg class="w-4 h-4 transition-transform" :class="activeAccordion === 'pickup' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-down"></use></svg>
                </button>
                <div x-show="activeAccordion === 'pickup'" x-cloak class="p-5 pt-0 text-[13px] text-[var(--color-text-muted)] leading-relaxed bg-[var(--color-card-bg)] space-y-2">
                    <p>Direct counter pickup from the chef domestic kitchen. You will receive real-time notifications as soon as your meal is packed hot.</p>
                    <p class="font-semibold text-[var(--color-primary)]">Customer-first refund policy supported by our customer service team.</p>
                </div>
            </div>

            <!-- Reviews -->
            <div class="border border-[var(--color-border)] rounded-2xl overflow-hidden">
                <button type="button"
                        @@click="activeAccordion = (activeAccordion === 'reviews' ? '' : 'reviews')"
                        class="w-full p-5 text-start font-bold uppercase tracking-wider text-[14px] flex items-center justify-between bg-[var(--color-card-bg)] cursor-pointer">
                    <span><span>Customer Love &amp; Reviews</span> (48)</span>
                    <svg class="w-4 h-4 transition-transform" :class="activeAccordion === 'reviews' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-down"></use></svg>
                </button>
                <div x-show="activeAccordion === 'reviews'" x-cloak class="p-5 pt-0 space-y-4 bg-[var(--color-card-bg)]">
                    <div class="border border-[var(--color-border-light)] p-4 rounded-xl space-y-1">
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-bold text-[var(--color-text)]">Karim El-Gohary</span>
                            <span class="text-amber-500 font-bold">★★★★★</span>
                        </div>
                        <p class="text-xs text-[var(--color-text-muted)] italic leading-relaxed">
                            “The Molokhia with duck was outstanding. Truly authentic grandmother style recipe with generous portions and hot pickup ready on the minute.”
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lightbox Zoom In Modal (Teleported to body for unclipped fullscreen overlay) -->
    <template x-teleport="body">
        <div x-show="lightboxOpen"
             x-cloak
             role="dialog"
             aria-modal="true"
             class="fixed inset-0 z-[99999] flex items-center justify-center bg-black/92 backdrop-blur-md p-4 select-none"
             @@keydown.escape.window="closeLightbox()">

            <!-- Top Action Bar -->
            <div class="absolute top-4 inset-x-4 sm:inset-x-6 flex items-center justify-between z-50 pointer-events-auto">
                <!-- Image Counter & Title -->
                <div class="flex items-center gap-3 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full text-white text-xs sm:text-sm font-semibold">
                    <span>Baladi Duck Molokhia with Vermicelli Rice</span>
                    <span class="opacity-40">·</span>
                    <span x-text="(activeImageIndex + 1) + ' / 5'">1 / 5</span>
                </div>

                <!-- Controls: Zoom Toggle & Close -->
                <div class="flex items-center gap-2">
                    <button type="button"
                            @@click="isZoomed = !isZoomed"
                            class="p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all cursor-pointer shadow-md flex items-center gap-1.5 px-3.5 text-xs font-semibold"
                            :title="isZoomed ? 'Zoom Out' : 'Zoom In'">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            <line x1="11" y1="8" x2="11" y2="14" x-show="!isZoomed"></line>
                            <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                        <span x-text="isZoomed ? 'Zoom Out' : 'Zoom In'">Zoom In</span>
                    </button>

                    <button type="button"
                            @@click="closeLightbox()"
                            class="p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors cursor-pointer shadow-md"
                            aria-label="Close zoom">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><use href="#x"></use></svg>
                    </button>
                </div>
            </div>

            <!-- Previous button -->
            <button type="button"
                    @@click="activeImageIndex = (activeImageIndex === 0 ? 4 : activeImageIndex - 1); isZoomed = false"
                    class="absolute start-4 top-1/2 -translate-y-1/2 p-3 rounded-full bg-white/10 hover:bg-white/25 text-white transition-all cursor-pointer z-50 shadow-lg"
                    aria-label="Previous photo">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-left"></use></svg>
            </button>

            <!-- Next button -->
            <button type="button"
                    @@click="activeImageIndex = (activeImageIndex === 4 ? 0 : activeImageIndex + 1); isZoomed = false"
                    class="absolute end-4 top-1/2 -translate-y-1/2 p-3 rounded-full bg-white/10 hover:bg-white/25 text-white transition-all cursor-pointer z-50 shadow-lg"
                    aria-label="Next photo">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
            </button>

            <!-- Enlarged Zoomed Image Container -->
            <div class="relative max-w-5xl max-h-[82vh] overflow-auto flex items-center justify-center p-2"
                 @@click.self="closeLightbox()">
                <img :src="images[activeImageIndex]"
                     alt="Baladi Duck Molokhia with Vermicelli Rice Zoomed Photo"
                     @@click="isZoomed = !isZoomed"
                     class="max-h-[78vh] object-contain rounded-2xl shadow-2xl transition-all duration-300 select-none"
                     :class="isZoomed ? 'scale-150 sm:scale-175 cursor-zoom-out' : 'cursor-zoom-in hover:scale-102'" />
            </div>
        </div>
    </template>
</div>
