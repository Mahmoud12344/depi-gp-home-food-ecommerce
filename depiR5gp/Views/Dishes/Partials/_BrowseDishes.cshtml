    get filteredDishes() {
        return this.allDishes.filter(dish => {
            if ($store.app.selectedCuisine !== 'all' && dish.cuisine !== $store.app.selectedCuisine) return false;
            if ($store.app.minPrice && dish.price < Number($store.app.minPrice)) return false;
            if ($store.app.maxPrice && dish.price > Number($store.app.maxPrice)) return false;
            if ($store.app.searchQuery && $store.app.searchQuery.trim()) {
                const q = $store.app.searchQuery.toLowerCase().trim();
                const matches = dish.name.toLowerCase().includes(q) ||
                                (dish.nameAr && dish.nameAr.includes(q)) ||
                                dish.kitchenName.toLowerCase().includes(q) ||
                                dish.category.toLowerCase().includes(q);
                if (!matches) return false;
            }
            return true;
        }).sort((a, b) => {
            if (this.sortBy === 'price_asc') return a.price - b.price;
            if (this.sortBy === 'price_desc') return b.price - a.price;
            if (this.sortBy === 'rating') return b.rating - a.rating;
            return 0;
        });
    }
}"
