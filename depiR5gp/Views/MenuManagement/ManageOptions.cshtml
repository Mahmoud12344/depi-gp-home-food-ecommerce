@using System.Text.Json
@model depiR5gp.ViewModels.ManageDishOptionsVM
@{
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
    ViewData["Title"] = $"Dish Options - {Model.DishName}";
    ViewData["ActiveChefTab"] = "menu";

    var serializedOptions = JsonSerializer.Serialize(Model.Options.Select(o => new
    {
        id = o.Id,
        groupName = o.GroupName,
        name = o.Name,
        extraPrice = o.ExtraPrice,
        isRequired = o.IsRequired
    }));
}

<div x-data="{
        options: @Html.Raw(serializedOptions),
        addOption(group = '') {
            this.options.push({
                id: 0,
                groupName: group,
                name: '',
                extraPrice: 0,
                isRequired: false
            });
        },
        removeOption(index) {
            this.options.splice(index, 1);
        }
    }" class="w-full space-y-8">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[var(--color-border)]">
        <div>
            <h1 class="text-2xl sm:text-3xl font-semibold text-[var(--color-text)] tracking-tight">Customization Options</h1>
            <p class="text-[15px] text-[var(--color-text-muted)] mt-1">
                Configure portion sizes, spice levels, or paid extras for <strong class="text-[var(--color-text)]">@Model.DishName</strong> (Base: @Model.BasePrice.ToString("N2") EGP).
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/MenuManagement/Edit/@Model.DishId"
               class="px-4 py-2.5 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-sm font-medium text-[var(--color-text)] transition-colors">
                Edit Dish
            </a>
            <a href="/MenuManagement"
               class="px-4 py-2.5 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-sm font-medium text-[var(--color-text)] transition-colors">
                Back to Menu
            </a>
        </div>
    </div>

    <!-- Quick Add Row -->
    <div class="flex flex-wrap items-center gap-2.5">
        <span class="text-sm font-medium text-[var(--color-text-muted)] me-1">Quick add:</span>
        <button type="button" @@click="addOption('Portion Size')"
                class="px-3.5 py-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] hover:border-[var(--color-primary)] text-sm font-medium text-[var(--color-text)] transition-colors cursor-pointer">
            + Portion Size
        </button>
        <button type="button" @@click="addOption('Spice Level')"
                class="px-3.5 py-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] hover:border-[var(--color-primary)] text-sm font-medium text-[var(--color-text)] transition-colors cursor-pointer">
            + Spice Level
        </button>
        <button type="button" @@click="addOption('Extras')"
                class="px-3.5 py-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] hover:border-[var(--color-primary)] text-sm font-medium text-[var(--color-text)] transition-colors cursor-pointer">
            + Paid Extra
        </button>
        <button type="button" @@click="addOption('')"
                class="px-3.5 py-2 rounded-xl bg-[var(--color-primary-light)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white text-sm font-medium transition-colors cursor-pointer">
            + Custom Option
        </button>
    </div>

    <form asp-controller="MenuManagement" asp-action="ManageOptions" asp-route-id="@Model.DishId" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" name="DishId" value="@Model.DishId" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"
                 class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-sm text-rose-700 dark:text-rose-300 font-medium"></div>
        }

        <!-- Empty State -->
        <template x-if="options.length === 0">
            <div class="p-12 rounded-2xl border border-dashed border-[var(--color-border)] bg-[var(--color-card-bg)] text-center space-y-2">
                <p class="text-base font-semibold text-[var(--color-text)]">No options configured yet</p>
                <p class="text-sm text-[var(--color-text-muted)]">
                    Use any quick-add button above to add portion sizes, spice levels, or paid extras.
                </p>
            </div>
        </template>

        <!-- Dynamic Option Rows -->
        <div class="space-y-4" x-show="options.length > 0">
            <template x-for="(opt, idx) in options" :key="idx">
                <div class="p-5 rounded-2xl bg-[var(--color-card-bg)] border border-[var(--color-border)] grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
                    <input type="hidden" :name="`Options[${idx}].Id`" :value="opt.id" />

                    <div class="md:col-span-3 space-y-1.5">
                        <label class="block text-sm font-medium text-[var(--color-text)]">Group Name</label>
                        <input type="text"
                               :name="`Options[${idx}].GroupName`"
                               x-model="opt.groupName"
                               placeholder="e.g., Portion Size"
                               required
                               class="w-full px-3.5 py-2.5 bg-[var(--color-bg)] text-[15px] text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>

                    <div class="md:col-span-4 space-y-1.5">
                        <label class="block text-sm font-medium text-[var(--color-text)]">Option Name</label>
                        <input type="text"
                               :name="`Options[${idx}].Name`"
                               x-model="opt.name"
                               placeholder="e.g., Large Family Tray"
                               required
                               class="w-full px-3.5 py-2.5 bg-[var(--color-bg)] text-[15px] text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>

                    <div class="md:col-span-2 space-y-1.5">
                        <label class="block text-sm font-medium text-[var(--color-text)]">Extra (EGP)</label>
                        <input type="number"
                               step="0.50"
                               min="0"
                               :name="`Options[${idx}].ExtraPrice`"
                               x-model="opt.extraPrice"
                               class="w-full px-3.5 py-2.5 bg-[var(--color-bg)] text-[15px] text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>

                    <div class="md:col-span-2 flex items-center gap-2.5 pb-2.5">
                        <input type="checkbox"
                               :name="`Options[${idx}].IsRequired`"
                               value="true"
                               x-model="opt.isRequired"
                               class="w-5 h-5 rounded accent-[var(--color-primary)] cursor-pointer" />
                        <input type="hidden" :name="`Options[${idx}].IsRequired`" value="false" />
                        <span class="text-sm font-medium text-[var(--color-text)]">Required</span>
                    </div>

                    <div class="md:col-span-1 flex justify-end pb-1.5">
                        <button type="button"
                                @@click="removeOption(idx)"
                                title="Remove option"
                                class="p-2.5 rounded-xl text-[var(--color-text-muted)] hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#trash-2"></use></svg>
                        </button>
                    </div>
                </div>
            </template>
        </div>

        <!-- Footer -->
        <div class="flex items-center justify-between gap-4 pt-5 border-t border-[var(--color-border)]">
            <span class="text-sm text-[var(--color-text-muted)]">
                <strong class="text-[var(--color-text)]" x-text="options.length"></strong> option(s) configured
            </span>
            <button type="submit"
                    class="px-6 py-2.5 rounded-xl bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-[15px] font-medium transition-colors cursor-pointer">
                Save Options
            </button>
        </div>
    </form>
</div>
