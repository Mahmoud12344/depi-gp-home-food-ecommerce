@{
    ViewData["Title"] = "Customization & Preset Option Groups - Menu Management";
    ViewData["ActiveChefTab"] = "menu";
}
<!-- Views/MenuManagement/ManageOptions.cshtml -->
<!-- Source: Views/Chefs/Partials/_AddDishModal.cshtml lines 127-192 (SCRUM-61) -->
<!-- TODO(backend): Bind DishOptionGroups for selected dish and persist via POST /MenuManagement/ManageOptions -->

<div x-data="{
    isKitchenAvailable: true,
    editProfileOpen: false,
    optionGroups: [
        {
            title: 'Rice Choice',
            type: 'radio',
            required: true,
            options: [
                { name: 'Vermicelli Rice (أرز بالشعرية)', extraPrice: 0 },
                { name: 'Egyptian White Rice (أرز مصري مفلفل)', extraPrice: 0 }
            ]
        },
        {
            title: 'Extra Sides & Bread',
            type: 'checkbox',
            required: false,
            options: [
                { name: 'Extra Garlic Ta\'sha Bowl', extraPrice: 20 },
                { name: 'Warm Baladi Bread Pack (4 loaves)', extraPrice: 15 }
            ]
        }
    ],
    addOptionGroup() {
        this.optionGroups.push({
            title: '',
            type: 'radio',
            required: false,
            options: [{ name: '', extraPrice: 0 }]
        });
    },
    removeOptionGroup(idx) {
        this.optionGroups.splice(idx, 1);
    },
    addOptionItem(gIdx) {
        this.optionGroups[gIdx].options.push({ name: '', extraPrice: 0 });
    },
    removeOptionItem(gIdx, oIdx) {
        this.optionGroups[gIdx].options.splice(oIdx, 1);
    }
}" class="w-full pb-24">

    <partial name="~/Views/ChefDashboard/Partials/_ChefNav.cshtml" />

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)]">
                <div>
                    <h3 class="text-base sm:text-lg font-bold uppercase tracking-wide text-[var(--color-text)] flex items-center gap-2">
                        <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#sliders"></use></svg>
                        <span>Customization &amp; Preset Option Groups</span>
                    </h3>
                    <p class="text-[11px] text-[var(--color-text-muted)] mt-0.5">
                        Dish: <strong>Baladi Duck Molokhia with Vermicelli Rice</strong> · Add single-choice or multi-choice groups with optional price surcharges
                    </p>
                </div>
                <a href="/MenuManagement" class="text-xs font-bold text-[var(--color-primary)] hover:underline">← Back to Menu</a>
            </div>

            <form method="post" action="/MenuManagement/ManageOptions" class="space-y-6 text-xs">
                @Html.AntiForgeryToken()
                <div class="flex items-center justify-end">
                    <button type="button" @@click="addOptionGroup()"
                            class="px-3.5 py-1.5 bg-[var(--color-primary-light)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white rounded-full font-bold uppercase text-[11px] transition-colors cursor-pointer">
                        <span>+ Add Option Group</span>
                    </button>
                </div>

                <!-- Option Groups List -->
                <div class="space-y-4">
                    <template x-for="(group, gIdx) in optionGroups" :key="gIdx">
                        <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)] space-y-3">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <input type="text" required x-model="group.title" placeholder="Group Title (e.g. Rice Selection)"
                                           class="p-2 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg font-bold text-xs" />
                                    <div class="flex items-center gap-2">
                                        <select x-model="group.type" class="p-2 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs font-medium">
                                            <option value="radio">Single Choice (Choose One - Radio)</option>
                                            <option value="checkbox">Multi Choice (Choose Many - Checkboxes)</option>
                                        </select>
                                        <label class="flex items-center gap-1.5 text-[11px] cursor-pointer whitespace-nowrap">
                                            <input type="checkbox" x-model="group.required" class="rounded accent-[var(--color-primary)]" />
                                            <span>Required</span>
                                        </label>
                                    </div>
                                </div>
                                <button type="button" @@click="removeOptionGroup(gIdx)" class="text-rose-600 hover:text-rose-800 text-[11px] font-bold cursor-pointer self-end sm:self-center">
                                    <span>Delete Group</span>
                                </button>
                            </div>

                            <!-- Option Items in this Group -->
                            <div class="space-y-2 pt-2 border-t border-[var(--color-border-light)]/60">
                                <template x-for="(opt, oIdx) in group.options" :key="oIdx">
                                    <div class="flex items-center gap-2">
                                        <input type="text" required x-model="opt.name" placeholder="Option Name (e.g. Vermicelli Rice)"
                                               class="flex-1 p-1.5 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs" />
                                        <div class="flex items-center gap-1 w-32 shrink-0">
                                            <span class="text-[11px] text-[var(--color-text-muted)]">+EGP</span>
                                            <input type="number" step="5" min="0" x-model.number="opt.extraPrice" placeholder="0"
                                                   class="w-full p-1.5 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs font-bold" />
                                        </div>
                                        <button type="button" @@click="removeOptionItem(gIdx, oIdx)" class="p-1 text-neutral-400 hover:text-rose-600 cursor-pointer">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                                        </button>
                                    </div>
                                </template>
                                <button type="button" @@click="addOptionItem(gIdx)" class="text-[var(--color-primary)] hover:underline font-bold text-[11px] pt-1 inline-flex items-center gap-1 cursor-pointer">
                                    <span>+ Add Choice Item</span>
                                </button>
                            </div>
                        </div>
                    </template>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border)]">
                    <a href="/MenuManagement"
                       class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                        <span>Cancel</span>
                    </a>
                    <button type="submit"
                            class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                        <span>Save Option Groups</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
