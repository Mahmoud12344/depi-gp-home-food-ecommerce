@using System.Text.Json
@model depiR5gp.ViewModels.ManageDishOptionsVM
@{
    ViewData["Title"] = $"Dish Options - {Model.DishName}";
    ViewData["ActiveChefTab"] = "menu";

    var serializedOptions = JsonSerializer.Serialize(Model.Options.Select(o => new
    {
        id = o.Id,
        groupName = o.GroupName,
        name = o.Name,
        extraPrice = o.ExtraPrice,
        isRequired = o.IsRequired
    }));
}

<div class="w-full pb-24">
    <partial name="~/Views/ChefDashboard/Partials/_ChefNav.cshtml" />

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
        <div x-data="{
                options: @Html.Raw(serializedOptions),
                addOption(group = '') {
                    this.options.push({
                        id: 0,
                        groupName: group,
                        name: '',
                        extraPrice: 0,
                        isRequired: false
                    });
                },
                removeOption(index) {
                    this.options.splice(index, 1);
                }
            }"
             class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">

            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[var(--color-border)]">
                <div>
                    <h2 class="text-lg font-bold uppercase tracking-tight text-[var(--color-text)]">
                        Customization Options &amp; Add-Ons
                    </h2>
                    <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
                        Configure sizes, spice levels, or paid extras for <strong class="text-[var(--color-text)]">@Model.DishName</strong> (Base price: @Model.BasePrice.ToString("N2") EGP)
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/MenuManagement/Edit/@Model.DishId"
                       class="px-4 py-2 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-xs font-bold text-[var(--color-text)] transition-colors">
                        Edit Dish
                    </a>
                    <a href="/MenuManagement"
                       class="px-4 py-2 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-xs font-bold text-[var(--color-text)] transition-colors">
                        Back to Menu
                    </a>
                </div>
            </div>

            <!-- Quick Add Presets -->
            <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="font-bold text-[var(--color-text-muted)] me-1">Quick Add:</span>
                <button type="button" @@click="addOption('Portion Size')"
                        class="px-3 py-1.5 rounded-full bg-[var(--color-surface-subtle)] hover:bg-[var(--color-primary-light)] hover:text-[var(--color-primary)] border border-[var(--color-border)] font-semibold transition-colors cursor-pointer">
                    + Portion Size
                </button>
                <button type="button" @@click="addOption('Spice Level')"
                        class="px-3 py-1.5 rounded-full bg-[var(--color-surface-subtle)] hover:bg-[var(--color-primary-light)] hover:text-[var(--color-primary)] border border-[var(--color-border)] font-semibold transition-colors cursor-pointer">
                    + Spice Level
                </button>
                <button type="button" @@click="addOption('Extras')"
                        class="px-3 py-1.5 rounded-full bg-[var(--color-surface-subtle)] hover:bg-[var(--color-primary-light)] hover:text-[var(--color-primary)] border border-[var(--color-border)] font-semibold transition-colors cursor-pointer">
                    + Paid Extra
                </button>
                <button type="button" @@click="addOption('')"
                        class="px-3 py-1.5 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white font-bold transition-colors cursor-pointer">
                    + Custom Option
                </button>
            </div>

            <form asp-controller="MenuManagement" asp-action="ManageOptions" asp-route-id="@Model.DishId" method="post" class="space-y-5 text-xs">
                @Html.AntiForgeryToken()
                <input type="hidden" name="DishId" value="@Model.DishId" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All"
                         class="p-3.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-600 dark:text-rose-300 font-medium"></div>
                }

                <!-- Empty State -->
                <template x-if="options.length === 0">
                    <div class="p-8 rounded-2xl border border-dashed border-[var(--color-border)] text-center space-y-2">
                        <p class="font-bold text-[var(--color-text)]">No customization options configured yet</p>
                        <p class="text-[var(--color-text-muted)]">
                            Click one of the quick-add buttons above to offer portion sizes, spice levels, or paid add-ons.
                        </p>
                    </div>
                </template>

                <!-- Dynamic Options List -->
                <div class="space-y-3" x-show="options.length > 0">
                    <template x-for="(opt, idx) in options" :key="idx">
                        <div class="p-4 rounded-2xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-light)] grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
                            <input type="hidden" :name="`Options[${idx}].Id`" :value="opt.id" />

                            <div class="sm:col-span-3 space-y-1">
                                <label class="block font-bold text-[var(--color-text)]">Group Name</label>
                                <input type="text"
                                       :name="`Options[${idx}].GroupName`"
                                       x-model="opt.groupName"
                                       placeholder="e.g., Portion Size"
                                       required
                                       class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                            </div>

                            <div class="sm:col-span-4 space-y-1">
                                <label class="block font-bold text-[var(--color-text)]">Option Name</label>
                                <input type="text"
                                       :name="`Options[${idx}].Name`"
                                       x-model="opt.name"
                                       placeholder="e.g., Large Family Tray"
                                       required
                                       class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                            </div>

                            <div class="sm:col-span-2 space-y-1">
                                <label class="block font-bold text-[var(--color-text)]">Extra (EGP)</label>
                                <input type="number"
                                       step="0.50"
                                       min="0"
                                       :name="`Options[${idx}].ExtraPrice`"
                                       x-model="opt.extraPrice"
                                       class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                            </div>

                            <div class="sm:col-span-2 flex items-center gap-2 pb-2">
                                <input type="checkbox"
                                       :name="`Options[${idx}].IsRequired`"
                                       value="true"
                                       x-model="opt.isRequired"
                                       class="w-4 h-4 rounded accent-[var(--color-primary)] cursor-pointer" />
                                <input type="hidden" :name="`Options[${idx}].IsRequired`" value="false" />
                                <span class="font-semibold text-[var(--color-text)]">Required</span>
                            </div>

                            <div class="sm:col-span-1 flex justify-end pb-1">
                                <button type="button"
                                        @@click="removeOption(idx)"
                                        title="Remove option"
                                        class="p-2 rounded-xl text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#trash-2"></use></svg>
                                </button>
                            </div>
                        </div>
                    </template>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-between gap-3 pt-4 border-t border-[var(--color-border)]">
                    <span class="text-[11px] text-[var(--color-text-muted)]">
                        <strong class="text-[var(--color-text)]" x-text="options.length"></strong> option(s) configured
                    </span>
                    <button type="submit"
                            class="px-6 py-2.5 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs">
                        Save Options
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
