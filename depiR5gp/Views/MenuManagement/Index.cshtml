@model depiR5gp.ViewModels.MenuIndexVM
@{
    ViewData["Title"] = "Menu & Dishes - Chef Portal";
    ViewData["ActiveChefTab"] = "menu";
}

<div x-data="{
        deleteModalOpen: false,
        deleteDishId: null,
        deleteDishName: '',
        openDelete(id, name) {
            this.deleteDishId = id;
            this.deleteDishName = name;
            this.deleteModalOpen = true;
        }
    }" class="w-full pb-24">

    <partial name="~/Views/ChefDashboard/Partials/_ChefNav.cshtml" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-6">
        <!-- Toolbar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h2 class="text-lg sm:text-xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                    Kitchen Menu Management
                </h2>
                <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
                    @Model.Dishes.Count dish@(Model.Dishes.Count == 1 ? "" : "es") total ·
                    <span class="text-emerald-600 font-semibold">@Model.AvailableCount available</span> ·
                    <span class="text-rose-600 font-semibold">@Model.SoldOutCount sold out</span>
                </p>
            </div>

            <a href="/MenuManagement/Create"
               class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase tracking-wider transition-all shadow-xs">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#plus"></use></svg>
                <span>Add New Dish</span>
            </a>
        </div>

        @if (Model.Dishes.Count == 0)
        {
            <!-- Empty State -->
            <div class="bg-[var(--color-card-bg)] border border-dashed border-[var(--color-border)] rounded-3xl p-12 text-center space-y-4">
                <div class="w-14 h-14 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] mx-auto flex items-center justify-center">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
                </div>
                <div class="space-y-1">
                    <h3 class="text-base font-bold text-[var(--color-text)]">Your kitchen menu is empty</h3>
                    <p class="text-xs text-[var(--color-text-muted)] max-w-md mx-auto">
                        Start adding your homemade signature dishes with photos, prices, and optional customization groups so customers can order from your kitchen.
                    </p>
                </div>
                <div class="pt-2">
                    <a href="/MenuManagement/Create"
                       class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#plus"></use></svg>
                        <span>Add Your First Dish</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Dishes Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var dish in Model.Dishes)
                {
                    <div x-data="{
                            available: @(dish.IsAvailable ? "true" : "false"),
                            busy: false,
                            async toggle() {
                                if (this.busy) return;
                                this.busy = true;
                                try {
                                    const token = this.$refs.tokenWrap.querySelector('input[name=__RequestVerificationToken]')?.value || '';
                                    const res = await fetch('/MenuManagement/ToggleAvailability/@dish.Id', {
                                        method: 'POST',
                                        headers: {
                                            'X-Requested-With': 'XMLHttpRequest',
                                            'RequestVerificationToken': token
                                        }
                                    });
                                    if (!res.ok) throw new Error('Toggle failed');
                                    const data = await res.json();
                                    if (data.success) {
                                        this.available = !!data.isAvailable;
                                        window.dispatchEvent(new CustomEvent('hc-toast', {
                                            detail: { type: this.available ? 'success' : 'info', message: data.message }
                                        }));
                                    }
                                } catch (e) {
                                    window.dispatchEvent(new CustomEvent('hc-toast', {
                                        detail: { type: 'error', message: 'Could not update dish availability.' }
                                    }));
                                } finally {
                                    this.busy = false;
                                }
                            }
                        }"
                         class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-xs flex flex-col justify-between transition-all hover:shadow-md">

                        <span x-ref="tokenWrap" class="hidden">@Html.AntiForgeryToken()</span>

                        <!-- Dish Image + Status Badge -->
                        <div>
                            <div class="relative h-48 bg-[var(--color-surface-subtle)] overflow-hidden">
                                @if (!string.IsNullOrWhiteSpace(dish.ImageUrl))
                                {
                                    <img src="@dish.ImageUrl" alt="@dish.Name"
                                         class="w-full h-full object-cover transition-transform duration-300"
                                         :class="available ? '' : 'grayscale opacity-70'" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex flex-col items-center justify-center text-[var(--color-text-muted)] gap-1.5">
                                        <svg class="w-9 h-9 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
                                        <span class="text-[11px] font-medium">No photo uploaded</span>
                                    </div>
                                }

                                <span class="absolute top-3 start-3 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase shadow-xs"
                                      :class="available ? 'bg-emerald-500 text-white' : 'bg-rose-600 text-white'"
                                      x-text="available ? 'Available' : 'Sold Out'">
                                    @(dish.IsAvailable ? "Available" : "Sold Out")
                                </span>

                                <span class="absolute top-3 end-3 px-2.5 py-1 rounded-full bg-black/65 text-white text-xs font-bold backdrop-blur-xs">
                                    @dish.Price.ToString("N2") EGP
                                </span>
                            </div>

                            <!-- Dish Details -->
                            <div class="p-5 space-y-2.5">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="px-2 py-0.5 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] text-[10px] font-bold uppercase">
                                        @dish.CategoryName
                                    </span>
                                    <span class="px-2 py-0.5 rounded-full bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] border border-[var(--color-border-light)] text-[10px] font-semibold">
                                        @dish.CuisineName
                                    </span>
                                    <span class="px-2 py-0.5 rounded-full bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] border border-[var(--color-border-light)] text-[10px] font-semibold">
                                        @dish.OptionsCount option@(dish.OptionsCount == 1 ? "" : "s")
                                    </span>
                                </div>

                                <h3 class="text-base font-bold text-[var(--color-text)] line-clamp-1">
                                    @dish.Name
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(dish.Description))
                                {
                                    <p class="text-xs text-[var(--color-text-muted)] line-clamp-2 leading-relaxed">
                                        @dish.Description
                                    </p>
                                }
                            </div>
                        </div>

                        <!-- Card Actions -->
                        <div class="px-5 pb-5 pt-3 border-t border-[var(--color-border-light)] space-y-3">
                            <!-- Availability Toggle -->
                            <div class="flex items-center justify-between text-xs">
                                <span class="font-semibold text-[var(--color-text-muted)]">In-Stock Status</span>
                                <button type="button"
                                        @@click="toggle()"
                                        :disabled="busy"
                                        class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors cursor-pointer disabled:opacity-60"
                                        :class="available ? 'bg-emerald-500' : 'bg-neutral-300 dark:bg-neutral-700'">
                                    <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-xs"
                                          :class="available ? 'translate-x-6' : 'translate-x-1'"></span>
                                </button>
                            </div>

                            <!-- Action Buttons -->
                            <div class="grid grid-cols-3 gap-2 text-xs">
                                <a href="/MenuManagement/Edit/@dish.Id"
                                   class="py-2 px-2 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] text-[var(--color-text)] font-bold text-center transition-colors">
                                    Edit
                                </a>
                                <a href="/MenuManagement/ManageOptions/@dish.Id"
                                   class="py-2 px-2 rounded-xl bg-[var(--color-primary-light)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white font-bold text-center transition-colors">
                                    Options
                                </a>
                                <button type="button"
                                        @@click="openDelete(@dish.Id, @System.Text.Json.JsonSerializer.Serialize(dish.Name))"
                                        class="py-2 px-2 rounded-xl border border-rose-200 dark:border-rose-900 text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 font-bold text-center transition-colors cursor-pointer">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Delete Confirmation Modal -->
    <div x-cloak
         x-show="deleteModalOpen"
         x-transition.opacity
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">
        <div @@click.away="deleteModalOpen = false"
             class="w-full max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 shadow-2xl space-y-5">
            <div class="space-y-1.5">
                <h3 class="text-base font-bold uppercase tracking-wide text-[var(--color-text)]">Remove Dish from Menu?</h3>
                <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
                    Are you sure you want to remove <strong class="text-[var(--color-text)]" x-text="deleteDishName"></strong>?
                    Dishes with active orders cannot be deleted.
                </p>
            </div>
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button"
                        @@click="deleteModalOpen = false"
                        class="px-5 py-2 rounded-full border border-[var(--color-border)] text-xs font-bold uppercase text-[var(--color-text-muted)] hover:text-[var(--color-text)] cursor-pointer">
                    Cancel
                </button>
                <form :action="'/MenuManagement/Delete/' + deleteDishId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="px-5 py-2 rounded-full bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold uppercase cursor-pointer shadow-xs">
                        Remove Dish
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
