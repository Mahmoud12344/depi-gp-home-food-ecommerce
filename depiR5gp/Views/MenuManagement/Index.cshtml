@model depiR5gp.ViewModels.Menu.MenuIndexVM

@{
    ViewData["Title"] = "Menu & Dishes";
    ViewData["Subtitle"] = "Manage the dishes you offer to customers.";

    // JSON-safe helpers — used to init Alpine x-data from server state
    // Safe: we only emit int/decimal/bool literals or JSON-encoded strings, never @Html.Raw on user data.
    var showAddJs  = Model.ShowAddModal  ? "true" : "false";
    var showEditJs = Model.ShowEditModal ? "true" : "false";

    // Pre-fill Add modal on validation error
    var addName        = Model.AddFormData?.Name        ?? "";
    var addDesc        = Model.AddFormData?.Description ?? "";
    var addPrice       = Model.AddFormData?.Price > 0   ? Model.AddFormData.Price.ToString("0.##") : "";
    var addCategoryId  = Model.AddFormData?.CategoryId  ?? 0;
    var addCuisineId   = Model.AddFormData?.CuisineId   ?? 0;
    var addIsAvailable = Model.AddFormData?.IsAvailable ?? true;

    // Pre-fill Edit modal on validation error
    var editId          = Model.EditFormData?.Id          ?? 0;
    var editName        = Model.EditFormData?.Name        ?? "";
    var editDesc        = Model.EditFormData?.Description ?? "";
    var editPrice       = Model.EditFormData?.Price > 0   ? Model.EditFormData.Price.ToString("0.##") : "";
    var editCategoryId  = Model.EditFormData?.CategoryId  ?? 0;
    var editCuisineId   = Model.EditFormData?.CuisineId   ?? 0;
    var editIsAvailable = Model.EditFormData?.IsAvailable ?? true;
    var editImgUrl      = Model.EditFormData?.ExistingImageUrl ?? "";
}

@* ── Breadcrumb / page-title banner ── *@
<partial name="Partials/_BreadcrumbBanner" />

@* ════════════════════════════════════════════════════════════
   ROOT Alpine.js component wrapping the ENTIRE page so all
   three modals (Add, Edit, Delete) share the same x-data scope.
   ════════════════════════════════════════════════════════════ *@
<div x-data="menuPage()" x-cloak>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

        @* ── TempData alerts (layout does NOT render them globally) ── *@
        @if (TempData["Success"] is string successMsg)
        {
            <div role="alert"
                 class="flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3
                        text-sm text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300">
                <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2"
                     viewBox="0 0 24 24" aria-hidden="true"><use href="#check-circle" /></svg>
                <span>@successMsg</span>
            </div>
        }
        @if (TempData["Error"] is string errorMsg)
        {
            <div role="alert"
                 class="flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3
                        text-sm text-red-700 dark:border-red-800 dark:bg-red-950/40 dark:text-red-300">
                <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2"
                     viewBox="0 0 24 24" aria-hidden="true"><use href="#alert-circle" /></svg>
                <span>@errorMsg</span>
            </div>
        }

        @* ── Add-modal validation errors (shown when Add modal is reopened) ── *@
        @if (Model.ShowAddModal && !ViewData.ModelState.IsValid)
        {
            <div role="alert"
                 class="flex flex-col gap-1 rounded-xl border border-red-200 bg-red-50 px-4 py-3
                        text-sm text-red-700 dark:border-red-800 dark:bg-red-950/40 dark:text-red-300">
                <strong class="font-semibold">Please fix the errors in the Add Dish form:</strong>
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>• @err.ErrorMessage</span>
                }
            </div>
        }
        @if (Model.ShowEditModal && !ViewData.ModelState.IsValid)
        {
            <div role="alert"
                 class="flex flex-col gap-1 rounded-xl border border-red-200 bg-red-50 px-4 py-3
                        text-sm text-red-700 dark:border-red-800 dark:bg-red-950/40 dark:text-red-300">
                <strong class="font-semibold">Please fix the errors in the Edit Dish form:</strong>
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>• @err.ErrorMessage</span>
                }
            </div>
        }

        @* ═══════════════════════════════════════════
           TOP BAR — "LISTED KITCHEN DISHES" + "+ ADD NEW DISH"
           ═══════════════════════════════════════════ *@
        <div class="flex items-center justify-between">
            <h1 class="text-sm font-bold uppercase tracking-widest text-[var(--color-text)]">
                Listed Kitchen Dishes
            </h1>
            <button type="button"
                    @@click="openAddModal()"
                    class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)]
                           px-4 py-2 text-xs font-bold uppercase tracking-wider text-white shadow-sm
                           hover:bg-[var(--color-primary-hover)] focus:outline-none
                           focus:ring-2 focus:ring-[var(--color-primary)]/40 transition-colors cursor-pointer">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5"
                     viewBox="0 0 24 24" aria-hidden="true"><use href="#plus" /></svg>
                + Add New Dish
            </button>
        </div>

        @* ══════════════════════════════════════
           EMPTY STATE
           ══════════════════════════════════════ *@
        @if (Model.IsEmpty)
        {
            <div class="flex flex-col items-center justify-center gap-5 rounded-2xl
                        border border-dashed border-[var(--color-border)]
                        bg-[var(--color-surface-subtle)] px-8 py-16 text-center">
                <svg class="h-14 w-14 text-[var(--color-text-muted)]"
                     fill="none" stroke="currentColor" stroke-width="1.2"
                     viewBox="0 0 24 24" aria-hidden="true"><use href="#utensils" /></svg>
                <div>
                    <p class="text-base font-semibold text-[var(--color-text)]">You haven't added any dishes yet</p>
                    <p class="mt-1 text-sm text-[var(--color-text-muted)]">
                        Start building your menu so customers can discover your food.
                    </p>
                </div>
                <button type="button"
                        @@click="openAddModal()"
                        class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)]
                               px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-sm
                               hover:bg-[var(--color-primary-hover)] focus:outline-none
                               focus:ring-2 focus:ring-[var(--color-primary)]/40 transition-colors cursor-pointer">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5"
                         viewBox="0 0 24 24" aria-hidden="true"><use href="#plus" /></svg>
                    Add your first dish
                </button>
            </div>
        }
        else
        {
            @* ══════════════════════════════════════
               DISH CARD GRID  — 2 columns (IMAGE 1)
               ══════════════════════════════════════ *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

                @foreach (var dish in Model.Dishes)
                {
                    <article class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs flex flex-col justify-between gap-4"
                             aria-label="@dish.Name">

                        @* ── Top row: name/price/category + Available pill ── *@
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <h3 class="font-bold text-sm text-[var(--color-text)] leading-snug">@dish.Name</h3>
                                <span class="text-xs text-[var(--color-primary)] font-bold block mt-1">
                                    @dish.Price.ToString("0.00") EGP
                                </span>
                                <span class="text-[11px] text-[var(--color-text-muted)]">@dish.CategoryName</span>
                            </div>

                            @* Availability pill (IMAGE 1 — top-right of card) *@
                            @if (dish.IsAvailable)
                            {
                                <span class="shrink-0 inline-flex items-center gap-1 rounded-full border
                                             border-emerald-300 bg-emerald-50 px-2.5 py-0.5
                                             text-[11px] font-semibold text-emerald-800
                                             dark:border-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300">
                                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="shrink-0 inline-flex items-center gap-1 rounded-full border
                                             border-neutral-300 bg-neutral-100 px-2.5 py-0.5
                                             text-[11px] font-semibold text-neutral-500
                                             dark:border-neutral-700 dark:bg-neutral-900/70 dark:text-neutral-400">
                                    <span class="h-1.5 w-1.5 rounded-full bg-neutral-400" aria-hidden="true"></span>
                                    Unavailable
                                </span>
                            }
                        </div>

                        @* ── Divider + Edit / Delete ── *@
                        <div class="border-t border-[var(--color-border)] pt-3 flex items-center justify-end gap-1">

                            @* Edit button — opens Edit modal *@
                            <button type="button"
                                    aria-label="Edit @dish.Name"
                                    @@click="openEditModal(@dish.Id, @System.Text.Json.JsonSerializer.Serialize(dish.Name), @dish.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture), @dish.CategoryId, @(dish.IsAvailable ? "true" : "false"), @System.Text.Json.JsonSerializer.Serialize(dish.Description ?? ""), @dish.CuisineId, @System.Text.Json.JsonSerializer.Serialize(dish.ImageUrl ?? ""))"
                                    class="px-3 py-1.5 text-xs text-[var(--color-text-muted)] hover:text-[var(--color-primary)] font-semibold rounded-lg hover:bg-[var(--color-surface-subtle)] transition-colors flex items-center gap-1 cursor-pointer">
                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2"
                                     viewBox="0 0 24 24" aria-hidden="true"><use href="#pencil" /></svg>
                                Edit
                            </button>

                            @* Delete button — opens Delete modal *@
                            <button type="button"
                                    aria-label="Delete @dish.Name"
                                    @@click="openDeleteModal(@dish.Id, @System.Text.Json.JsonSerializer.Serialize(dish.Name))"
                                    class="px-3 py-1.5 text-xs text-rose-600 hover:text-rose-800 font-semibold rounded-lg hover:bg-rose-50 transition-colors flex items-center gap-1 cursor-pointer">
                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2"
                                     viewBox="0 0 24 24" aria-hidden="true"><use href="#trash-2" /></svg>
                                Delete
                            </button>

                        </div>
                    </article>
                }
            </div>
        }

    </div><!-- /max-w-6xl -->

    @* ══════════════════════════════════════════════════════════════════
       MODAL 1: ADD NEW DISH  (IMAGE 3)
       ══════════════════════════════════════════════════════════════════ *@
    <div x-show="showAdd"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
         role="dialog" aria-modal="true" aria-labelledby="add-modal-title">

        <div @@click.away="showAdd = false"
             class="relative w-full max-w-3xl bg-[var(--color-card-bg)] border border-[var(--color-border)]
                    rounded-3xl p-6 sm:p-8 shadow-2xl max-h-[90vh] overflow-y-auto">

            @* Header *@
            <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)] mb-6">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)]
                                flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <use href="#utensils"></use>
                        </svg>
                    </div>
                    <div>
                        <h3 id="add-modal-title"
                            class="text-base sm:text-lg font-bold uppercase tracking-wide text-[var(--color-text)]">
                            Add New Dish to Kitchen Menu
                        </h3>
                        <p class="text-[11px] text-[var(--color-text-muted)]">
                            Configure dish titles, pricing, baladi ingredients, and preset customization options
                        </p>
                    </div>
                </div>
                <button type="button" @@click="showAdd = false"
                        class="p-1 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer"
                        aria-label="Close">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#x"></use>
                    </svg>
                </button>
            </div>

            @* ── Add Dish Form ── *@
            <form asp-controller="MenuManagement"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data"
                  x-data="addFormJs()"
                  class="space-y-5 text-xs"
                  novalidate>

                @* Dish Title *@
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">
                        Dish Title <span class="text-red-500" aria-hidden="true">*</span>
                    </label>
                    <input type="text"
                           name="Name"
                           value="@addName"
                           maxlength="100"
                           placeholder="e.g. Stuffed Pigeon with Spiced Freekeh"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)]
                                  border border-[var(--color-border)] rounded-xl font-medium
                                  focus:border-[var(--color-primary)] focus:outline-none" />
                    <span asp-validation-for="AddFormData!.Name"
                          class="mt-0.5 block text-xs text-red-600 dark:text-red-400"></span>
                </div>

                @* Description & Heritage Spices *@
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">
                        Description &amp; Heritage Spices <span class="text-red-500" aria-hidden="true">*</span>
                    </label>
                    <textarea name="Description"
                              rows="2"
                              maxlength="1000"
                              placeholder="Slow-roasted domestic pigeon seasoned with coriander..."
                              class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)]
                                     border border-[var(--color-border)] rounded-xl font-medium
                                     focus:border-[var(--color-primary)] focus:outline-none">@addDesc</textarea>
                    <span asp-validation-for="AddFormData!.Description"
                          class="mt-0.5 block text-xs text-red-600 dark:text-red-400"></span>
                </div>

                @* Dish Category + Base Price + Cuisine — 3-col grid *@
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

                    @* Category *@
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">
                            Dish Category <span class="text-red-500" aria-hidden="true">*</span>
                        </label>
                        <select name="CategoryId"
                                class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)]
                                       border border-[var(--color-border)] rounded-xl font-medium
                                       focus:border-[var(--color-primary)] focus:outline-none">
                            <option value="0" disabled selected="@(addCategoryId == 0 ? "selected" : null)">Select a category</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Value"
                                        selected="@(cat.Value == addCategoryId.ToString() ? "selected" : null)">
                                    @cat.Text
                                </option>
                            }
                        </select>
                        <span asp-validation-for="AddFormData!.CategoryId"
                              class="mt-0.5 block text-xs text-red-600 dark:text-red-400"></span>
                    </div>

                    @* Base Price *@
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">
                            Base Price (EGP) <span class="text-red-500" aria-hidden="true">*</span>
                        </label>
                        <input type="number"
                               name="Price"
                               value="@addPrice"
                               step="0.01"
                               min="0.01"
                               max="100000"
                               placeholder="0.00"
                               class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)]
                                      border border-[var(--color-border)] rounded-xl font-bold
                                      focus:border-[var(--color-primary)] focus:outline-none" />
                        <span asp-validation-for="AddFormData!.Price"
                              class="mt-0.5 block text-xs text-red-600 dark:text-red-400"></span>
                    </div>

                    @* Cuisine (DEVIATION: required by model, not shown in original design) *@
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">
                            Cuisine <span class="text-red-500" aria-hidden="true">*</span>
                        </label>
                        <select name="CuisineId"
                                class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)]
                                       border border-[var(--color-border)] rounded-xl font-medium
                                       focus:border-[var(--color-primary)] focus:outline-none">
                            <option value="0" disabled selected="@(addCuisineId == 0 ? "selected" : null)">Select a cuisine</option>
                            @foreach (var c in Model.Cuisines)
                            {
                                <option value="@c.Value"
                                        selected="@(c.Value == addCuisineId.ToString() ? "selected" : null)">
                                    @c.Text
                                </option>
                            }
                        </select>
                        <span asp-validation-for="AddFormData!.CuisineId"
                              class="mt-0.5 block text-xs text-red-600 dark:text-red-400"></span>
                    </div>

                </div>

                @* Dish Photo (file upload) + Available Immediately toggle *@
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-start">
                    <div class="sm:col-span-8">
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">
                            Dish Photo <span class="text-xs font-normal text-[var(--color-text-muted)]">(optional · JPG/PNG/WEBP · max 2 MB)</span>
                        </label>

                        @* Preview *@
                        <div x-show="previewUrl" x-transition
                             class="relative w-28 h-28 mb-2 rounded-xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-surface-subtle)] shadow-sm">
                            <img :src="previewUrl" alt="Dish preview" class="h-full w-full object-cover" />
                            <button type="button" @@click="clearImage()"
                                    class="absolute top-1 end-1 flex h-5 w-5 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80 transition-colors"
                                    aria-label="Remove selected image">
                                <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5"
                                     viewBox="0 0 24 24"><use href="#x" /></svg>
                            </button>
                        </div>

                        @* Drop-zone *@
                        <label for="add-ImageFile"
                               :class="previewUrl ? 'hidden' : ''"
                               class="flex cursor-pointer flex-col items-center justify-center gap-1.5 rounded-xl
                                      border-2 border-dashed border-[var(--color-border)] bg-[var(--color-surface-subtle)]
                                      px-4 py-5 transition-colors hover:border-[var(--color-primary)]/60 hover:bg-[var(--color-primary)]/5">
                            <svg class="h-6 w-6 text-[var(--color-text-muted)]" fill="none" stroke="currentColor"
                                 stroke-width="1.5" viewBox="0 0 24 24"><use href="#image" /></svg>
                            <span class="text-xs font-medium text-[var(--color-text)]">Click to upload a photo</span>
                        </label>
                        <input type="file"
                               name="ImageFile"
                               id="add-ImageFile"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="sr-only"
                               x-ref="fileInput"
                               @@change="handleFile($event)" />
                        <p x-show="fileError" x-text="fileError"
                           class="mt-0.5 text-xs text-red-600 dark:text-red-400" role="alert"></p>
                    </div>

                    @* Available Immediately toggle *@
                    <div class="sm:col-span-4 flex items-center gap-3 sm:pt-7">
                        <button type="button"
                                @@click="isAvailable = !isAvailable"
                                :class="isAvailable ? 'bg-emerald-500' : 'bg-neutral-300 dark:bg-neutral-700'"
                                class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors cursor-pointer"
                                role="switch" :aria-checked="isAvailable.toString()">
                            <span :class="isAvailable ? 'translate-x-6' : 'translate-x-1'"
                                  class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-xs">
                            </span>
                        </button>
                        @* Hidden input so the toggle value is posted *@
                        <input type="hidden" name="IsAvailable" :value="isAvailable ? 'true' : 'false'" />
                        <span :class="isAvailable ? 'text-emerald-600' : 'text-neutral-400'"
                              class="font-bold text-xs"
                              x-text="isAvailable ? 'Available Immediately' : 'Currently Unavailable'">
                        </span>
                    </div>
                </div>

                @* ── Customization & Preset Option Groups (IMAGE 3) ── *@
                <div class="space-y-4 pt-4 border-t border-[var(--color-border)]">
                    <div class="flex items-center justify-between">
                        <div>
                            <h4 class="font-bold uppercase tracking-wider text-[var(--color-text)] text-[11px]">
                                Customization &amp; Preset Option Groups
                            </h4>
                            <p class="text-[11px] text-[var(--color-text-muted)]">
                                Add optional price surcharges
                                @* // TODO: enable when the model supports it: single-choice / multi-choice type select *@
                            </p>
                        </div>
                        <button type="button"
                                @@click="addGroup()"
                                class="px-3.5 py-1.5 bg-[var(--color-primary-light)] text-[var(--color-primary)]
                                       hover:bg-[var(--color-primary)] hover:text-white rounded-full font-bold
                                       uppercase text-[11px] transition-colors cursor-pointer">
                            + Add Option Group
                        </button>
                    </div>

                    @* Dynamic group rows — rendered by Alpine *@
                    <template x-for="(group, gIdx) in groups" :key="gIdx">
                        <div class="p-4 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border)] space-y-3">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div class="flex-1 flex flex-col sm:flex-row gap-2 items-start sm:items-center">
                                    @* Group name input — posted as OptionGroups[gIdx].Name *@
                                    <input type="text"
                                           :name="'OptionGroups['+gIdx+'].Name'"
                                           x-model="group.name"
                                           placeholder="Group Title (e.g. Rice Selection)"
                                           class="flex-1 p-2 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg font-bold text-xs" />
                                    @* // TODO: enable when the model supports it: single/multi-choice type select *@
                                    @* Required checkbox *@
                                    <label class="flex items-center gap-1.5 text-[11px] cursor-pointer whitespace-nowrap">
                                        <input type="checkbox"
                                               :name="'OptionGroups['+gIdx+'].IsRequired'"
                                               x-model="group.required"
                                               value="true"
                                               class="rounded accent-[var(--color-primary)]" />
                                        Required
                                    </label>
                                </div>
                                <button type="button"
                                        @@click="removeGroup(gIdx)"
                                        class="text-rose-600 hover:text-rose-800 text-[11px] font-bold cursor-pointer self-end sm:self-center">
                                    Delete Group
                                </button>
                            </div>

                            @* Option items in this group *@
                            <div class="space-y-2 pt-2 border-t border-[var(--color-border)]/60">
                                <template x-for="(opt, oIdx) in group.items" :key="oIdx">
                                    <div class="flex items-center gap-2">
                                        <input type="text"
                                               :name="'OptionGroups['+gIdx+'].Items['+oIdx+'].Name'"
                                               x-model="opt.name"
                                               placeholder="Option Name (e.g. Vermicelli Rice)"
                                               class="flex-1 p-1.5 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs" />
                                        <div class="flex items-center gap-1 w-32 shrink-0">
                                            <span class="text-[11px] text-[var(--color-text-muted)]">+EGP</span>
                                            <input type="number"
                                                   :name="'OptionGroups['+gIdx+'].Items['+oIdx+'].ExtraPrice'"
                                                   x-model.number="opt.extraPrice"
                                                   step="0.01" min="0" placeholder="0"
                                                   class="w-full p-1.5 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-lg text-xs font-bold" />
                                        </div>
                                        <button type="button"
                                                @@click="removeItem(gIdx, oIdx)"
                                                class="p-1 text-neutral-400 hover:text-rose-600 cursor-pointer"
                                                aria-label="Remove item">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <use href="#x"></use>
                                            </svg>
                                        </button>
                                    </div>
                                </template>
                                <button type="button"
                                        @@click="addItem(gIdx)"
                                        class="text-[var(--color-primary)] hover:underline font-bold text-[11px] pt-1 inline-flex items-center gap-1 cursor-pointer">
                                    + Add Choice Item
                                </button>
                            </div>
                        </div>
                    </template>
                </div>

                @* ── Actions ── *@
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border)]">
                    <button type="button"
                            @@click="showAdd = false"
                            class="px-4 py-2 rounded-full border border-[var(--color-border)]
                                   text-[var(--color-text)] font-bold uppercase tracking-wider
                                   hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit"
                            class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white
                                   font-bold uppercase tracking-wider px-6 py-2 rounded-full
                                   transition-all shadow-xs cursor-pointer">
                        Save &amp; Publish Dish
                    </button>
                </div>

            </form>
        </div>
    </div><!-- /Add modal -->

    @* ══════════════════════════════════════════════════════════════════
       MODAL 2: EDIT MENU DISH  (IMAGE 2)
       ══════════════════════════════════════════════════════════════════ *@
    <div x-show="showEdit"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
         role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">

        <div @@click.away="showEdit = false"
             class="relative w-full max-w-2xl bg-[var(--color-card-bg)] border border-[var(--color-border)]
                    rounded-3xl p-6 sm:p-8 shadow-2xl max-h-[90vh] overflow-y-auto">

            @* Header *@
            <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)] mb-6">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)]
                                flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <use href="#pencil"></use>
                        </svg>
                    </div>
                    <div>
                        <h3 id="edit-modal-title"
                            class="text-base sm:text-lg font-bold uppercase tracking-wide text-[var(--color-text)]">
                            Edit Menu Dish
                        </h3>
                        <p class="text-[11px] text-[var(--color-text-muted)]">
                            Update pricing, ingredients, prep time, or preset option surcharges
                        </p>
                    </div>
                </div>
                <button type="button" @@click="showEdit = false"
                        class="p-1 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer"
                        aria-label="Close">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#x"></use>
                    </svg>
                </button>
            </div>

            @* ── Edit Form ── *@
            <form asp-controller="MenuManagement"
                  asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data"
                  x-data="editFormJs()"
                  x-bind:action="'/MenuManagement/Edit/' + editDishId"
                  class="space-y-5 text-xs"
                  novalidate>

                @* Route + anti-forgery *@
                <input type="hidden" name="Id" :value="editDishId" />

                @* Hidden fields: carry Description and CuisineId so they are NEVER wiped (Scenario 4) *@
                <input type="hidden" name="Description" :value="editDescription" />
                <input type="hidden" name="CuisineId"   :value="editCuisineId" />

                @* Dish Title *@
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">
                        Dish Title <span class="text-red-500" aria-hidden="true">*</span>
                    </label>
                    <input type="text"
                           name="Name"
                           :value="editName"
                           maxlength="100"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)]
                                  border border-[var(--color-border)] rounded-xl font-medium
                                  focus:border-[var(--color-primary)] focus:outline-none" />
                </div>

                @* Dish Category + Base Price + Availability Status — 3-col *@
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

                    @* Category *@
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">
                            Dish Category <span class="text-red-500" aria-hidden="true">*</span>
                        </label>
                        <select name="CategoryId"
                                x-ref="catSelect"
                                class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)]
                                       border border-[var(--color-border)] rounded-xl font-medium
                                       focus:border-[var(--color-primary)] focus:outline-none">
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Value">@cat.Text</option>
                            }
                        </select>
                    </div>

                    @* Base Price *@
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">
                            Base Price (EGP) <span class="text-red-500" aria-hidden="true">*</span>
                        </label>
                        <input type="number"
                               name="Price"
                               :value="editPrice"
                               step="0.01" min="0.01" max="100000"
                               class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)]
                                      border border-[var(--color-border)] rounded-xl font-bold
                                      focus:border-[var(--color-primary)] focus:outline-none" />
                    </div>

                    @* Availability Status toggle (IMAGE 2) *@
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Availability Status</label>
                        <div class="flex items-center gap-2 mt-2">
                            <button type="button"
                                    @@click="editIsAvailable = !editIsAvailable"
                                    :class="editIsAvailable ? 'bg-emerald-500' : 'bg-neutral-300 dark:bg-neutral-700'"
                                    class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors cursor-pointer"
                                    role="switch" :aria-checked="editIsAvailable.toString()">
                                <span :class="editIsAvailable ? 'translate-x-6' : 'translate-x-1'"
                                      class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-xs"></span>
                            </button>
                            <input type="hidden" name="IsAvailable" :value="editIsAvailable ? 'true' : 'false'" />
                            <span :class="editIsAvailable ? 'text-emerald-600' : 'text-neutral-400'"
                                  class="font-bold text-xs border border-current rounded-full px-2.5 py-0.5"
                                  x-text="editIsAvailable ? 'Available for Orders' : 'Unavailable'">
                            </span>
                        </div>
                    </div>

                </div>

                @* Compact photo block: current photo + optional replace *@
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">
                        Dish Photo <span class="text-xs font-normal text-[var(--color-text-muted)]">(optional · leave blank to keep current)</span>
                    </label>

                    @* Existing photo (shown when no new file picked) *@
                    <div x-show="!previewUrl && editExistingImg" class="flex items-center gap-3 mb-2">
                        <div class="relative h-20 w-20 shrink-0 overflow-hidden rounded-xl border
                                    border-[var(--color-border)] bg-[var(--color-surface-subtle)] shadow-sm">
                            <img :src="editExistingImg" alt="Current dish photo" class="h-full w-full object-cover" />
                        </div>
                        <span class="text-[11px] text-[var(--color-text-muted)]">Current photo · select a new file to replace it.</span>
                    </div>

                    @* New-file preview *@
                    <div x-show="previewUrl" x-transition
                         class="relative w-20 h-20 mb-2 rounded-xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-surface-subtle)] shadow-sm">
                        <img :src="previewUrl" alt="New dish photo preview" class="h-full w-full object-cover" />
                        <button type="button" @@click="clearImage()"
                                class="absolute top-1 end-1 flex h-5 w-5 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80 transition-colors"
                                aria-label="Remove selected image">
                            <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5"
                                 viewBox="0 0 24 24"><use href="#x" /></svg>
                        </button>
                    </div>

                    @* Drop-zone *@
                    <label for="edit-ImageFile"
                           :class="previewUrl ? 'hidden' : ''"
                           class="flex cursor-pointer flex-col items-center justify-center gap-1.5 rounded-xl
                                  border-2 border-dashed border-[var(--color-border)] bg-[var(--color-surface-subtle)]
                                  px-4 py-4 transition-colors hover:border-[var(--color-primary)]/60 hover:bg-[var(--color-primary)]/5">
                        <svg class="h-5 w-5 text-[var(--color-text-muted)]" fill="none" stroke="currentColor"
                             stroke-width="1.5" viewBox="0 0 24 24"><use href="#image" /></svg>
                        <span class="text-xs font-medium text-[var(--color-text)]">Click to replace photo</span>
                    </label>
                    <input type="file"
                           name="ImageFile"
                           id="edit-ImageFile"
                           accept=".jpg,.jpeg,.png,.webp"
                           class="sr-only"
                           x-ref="fileInput"
                           @@change="handleFile($event)" />
                    <p x-show="fileError" x-text="fileError"
                       class="mt-0.5 text-xs text-red-600 dark:text-red-400" role="alert"></p>
                </div>

                @* ── Actions ── *@
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border)]">
                    <button type="button"
                            @@click="showEdit = false"
                            class="px-4 py-2 rounded-full border border-[var(--color-border)]
                                   text-[var(--color-text)] font-bold uppercase tracking-wider
                                   hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit"
                            class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white
                                   font-bold uppercase tracking-wider px-6 py-2 rounded-full
                                   transition-all shadow-xs cursor-pointer">
                        Save Dish Changes
                    </button>
                </div>

            </form>
        </div>
    </div><!-- /Edit modal -->

    @* ══════════════════════════════════════════════════════════════════
       MODAL 3: CONFIRM DISH DELETION  (IMAGE 4)
       ══════════════════════════════════════════════════════════════════ *@
    <div x-show="showDelete"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
         role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">

        <div @@click.away="showDelete = false"
             class="relative w-full max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)]
                    rounded-3xl p-6 sm:p-8 shadow-2xl">

            @* Header: pink trash icon (IMAGE 4) *@
            <div class="flex items-start gap-4 mb-5">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-rose-100 dark:bg-rose-950/40
                            flex items-center justify-center">
                    <svg class="w-6 h-6 text-rose-500" fill="none" stroke="currentColor"
                         stroke-width="2" viewBox="0 0 24 24">
                        <use href="#trash-2"></use>
                    </svg>
                </div>
                <div>
                    <h3 id="delete-modal-title"
                        class="text-base font-bold uppercase tracking-wide text-[var(--color-text)]">
                        Confirm Dish Deletion
                    </h3>
                    <p class="text-sm text-[var(--color-text-muted)] mt-0.5" x-text="deleteDishName"></p>
                </div>
            </div>

            @* Yellow policy notice (IMAGE 4) *@
            <div class="flex items-start gap-2.5 rounded-xl bg-amber-50 border border-amber-200
                        dark:bg-amber-950/30 dark:border-amber-800 px-4 py-3 mb-6">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-500" fill="none" stroke="currentColor"
                     stroke-width="2" viewBox="0 0 24 24">
                    <use href="#alert-triangle"></use>
                </svg>
                <div class="text-xs text-amber-700 dark:text-amber-300">
                    <strong class="font-semibold">Active Orders Policy Notice:</strong>
                    Deleting this dish removes it immediately from public marketplace browse.
                    Any already-accepted active orders remain valid for preparation.
                </div>
            </div>

            @* Form: POST to Delete *@
            <form asp-controller="MenuManagement"
                  asp-action="Delete"
                  method="post"
                  x-bind:action="'/MenuManagement/Delete/' + deleteDishId">
                <input type="hidden" name="id" :value="deleteDishId" />

                <div class="flex items-center justify-end gap-3">
                    <button type="button"
                            @@click="showDelete = false"
                            class="px-4 py-2 rounded-full border border-[var(--color-border)]
                                   text-[var(--color-text)] font-bold uppercase tracking-wider
                                   hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit"
                            class="bg-rose-600 hover:bg-rose-700 text-white font-bold uppercase
                                   tracking-wider px-6 py-2 rounded-full transition-all shadow-xs cursor-pointer">
                        Yes, Delete Dish
                    </button>
                </div>
            </form>

        </div>
    </div><!-- /Delete modal -->

</div><!-- /Alpine root -->

@section Scripts {
    <script>
        // ════════════════════════════════════════════════════════════════
        // menuPage() — root Alpine component for the whole Index page.
        // Manages Add / Edit / Delete modal visibility + data.
        // Uses textContent / .value everywhere — no Html.Raw on user data.
        // ════════════════════════════════════════════════════════════════
        function menuPage() {
            return {
                // Modal visibility flags (Razor initialises from server state)
                showAdd:    @showAddJs,
                showEdit:   @showEditJs,
                showDelete: false,

                // Edit modal payload
                editDishId:      @editId,
                editName:        @Json.Serialize(editName),
                editPrice:       @(editPrice != "" ? editPrice : "0"),
                editCategoryId:  @editCategoryId,
                editIsAvailable: @(editIsAvailable ? "true" : "false"),
                editDescription: @Json.Serialize(editDesc),
                editCuisineId:   @editCuisineId,
                editExistingImg: @Json.Serialize(editImgUrl),

                // Delete modal payload
                deleteDishId:   0,
                deleteDishName: '',

                // ── Open modals ──────────────────────────────────────────
                openAddModal() {
                    this.showAdd    = true;
                    this.showEdit   = false;
                    this.showDelete = false;
                },

                openEditModal(id, name, price, catId, avail, desc, cuisineId, imgUrl) {
                    this.editDishId      = id;
                    this.editName        = name;
                    this.editPrice       = price;
                    this.editCategoryId  = catId;
                    this.editIsAvailable = avail;
                    this.editDescription = desc;
                    this.editCuisineId   = cuisineId;
                    this.editExistingImg = imgUrl;

                    // Sync the category <select> to the dish's current categoryId
                    this.$nextTick(() => {
                        const sel = this.$el.querySelector('select[name="CategoryId"]');
                        if (sel) sel.value = String(catId);
                    });

                    this.showEdit   = true;
                    this.showAdd    = false;
                    this.showDelete = false;
                },

                openDeleteModal(id, name) {
                    this.deleteDishId   = id;
                    this.deleteDishName = name;
                    this.showDelete  = true;
                    this.showAdd     = false;
                    this.showEdit    = false;
                }
            };
        }

        // ════════════════════════════════════════════════════════════════
        // addFormJs() — Alpine sub-component for the Add modal's form.
        // Handles: availability toggle, image preview, option groups.
        // ════════════════════════════════════════════════════════════════
        function addFormJs() {
            return {
                isAvailable: @(addIsAvailable ? "true" : "false"),
                previewUrl:  '',
                fileError:   '',
                groups:      [],

                handleFile(event) {
                    const file = event.target.files?.[0];
                    if (!file) return;
                    const allowed = ['image/jpeg', 'image/png', 'image/webp'];
                    const maxBytes = 2 * 1024 * 1024;
                    if (!allowed.includes(file.type)) {
                        this.fileError = 'Only JPG, PNG, or WEBP images are allowed.';
                        this.clearImage(); return;
                    }
                    if (file.size > maxBytes) {
                        this.fileError = 'The image must be 2 MB or smaller.';
                        this.clearImage(); return;
                    }
                    this.fileError = '';
                    if (this.previewUrl) URL.revokeObjectURL(this.previewUrl);
                    this.previewUrl = URL.createObjectURL(file);
                },

                clearImage() {
                    if (this.previewUrl) { URL.revokeObjectURL(this.previewUrl); this.previewUrl = ''; }
                    if (this.$refs.fileInput) this.$refs.fileInput.value = '';
                },

                addGroup() {
                    this.groups.push({ name: '', required: false, items: [{ name: '', extraPrice: 0 }] });
                },
                removeGroup(gIdx) { this.groups.splice(gIdx, 1); },
                addItem(gIdx)     { this.groups[gIdx].items.push({ name: '', extraPrice: 0 }); },
                removeItem(gIdx, oIdx) { this.groups[gIdx].items.splice(oIdx, 1); }
            };
        }

        // ════════════════════════════════════════════════════════════════
        // editFormJs() — Alpine sub-component for the Edit modal's form.
        // Handles: image preview only (availability toggle is in menuPage).
        // ════════════════════════════════════════════════════════════════
        function editFormJs() {
            return {
                previewUrl: '',
                fileError:  '',

                handleFile(event) {
                    const file = event.target.files?.[0];
                    if (!file) return;
                    const allowed = ['image/jpeg', 'image/png', 'image/webp'];
                    const maxBytes = 2 * 1024 * 1024;
                    if (!allowed.includes(file.type)) {
                        this.fileError = 'Only JPG, PNG, or WEBP images are allowed.';
                        this.clearImage(); return;
                    }
                    if (file.size > maxBytes) {
                        this.fileError = 'The image must be 2 MB or smaller.';
                        this.clearImage(); return;
                    }
                    this.fileError = '';
                    if (this.previewUrl) URL.revokeObjectURL(this.previewUrl);
                    this.previewUrl = URL.createObjectURL(file);
                },

                clearImage() {
                    if (this.previewUrl) { URL.revokeObjectURL(this.previewUrl); this.previewUrl = ''; }
                    if (this.$refs.fileInput) this.$refs.fileInput.value = '';
                }
            };
        }
    </script>
}
