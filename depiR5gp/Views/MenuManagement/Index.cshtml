<partial name="~/Views/ChefDashboard/Partials/_ChefNav.cshtml" />

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6 pb-24">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-lg font-bold uppercase tracking-wide text-[var(--color-text)]">
                Kitchen Menu &amp; Dish Catalog
            </h2>
            <p class="text-xs text-[var(--color-text-muted)]">
                Add new baladi dishes, update pricing, manage preset option groups, or toggle availability.
            </p>
        </div>
        <a asp-controller="MenuManagement" asp-action="Create"
           class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase px-5 py-2.5 rounded-full cursor-pointer transition-all shadow-xs inline-flex items-center gap-1.5 self-start sm:self-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#plus"></use></svg>
            <span>+ Add New Dish</span>
        </a>
    </div>

    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
            <table class="w-full text-xs text-start">
                <thead>
                    <tr class="border-b border-[var(--color-border)] bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] font-bold uppercase text-[10px]">
                        <th class="p-4 text-start">Dish</th>
                        <th class="p-4 text-start">Category</th>
                        <th class="p-4 text-end">Base Price</th>
                        <th class="p-4 text-center">Availability</th>
                        <th class="p-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--color-border-light)]">
