    <!-- Add Dish Modal (from Views/Chefs/Partials/_AddDishModal.cshtml) -->
    <div x-cloak
         x-show="addDishModalOpen"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

        <div @@click.away="addDishModalOpen = false"
             class="relative w-full max-w-3xl bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-2xl max-h-[90vh] overflow-y-auto">

            <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)] mb-6">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
                    </div>
                    <div>
                        <h3 class="text-base sm:text-lg font-bold uppercase tracking-wide text-[var(--color-text)]">
                            Add New Dish to Kitchen Menu
                        </h3>
                        <p class="text-[11px] text-[var(--color-text-muted)]">
                            Configure dish titles, pricing, baladi ingredients, and preset customization options
                        </p>
                    </div>
                </div>
                <button type="button" @@click="addDishModalOpen = false" class="p-1 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                </button>
            </div>

            <!-- TODO(backend): POST /MenuManagement/Create with CreateDishDto, handle image upload, store preset options in DishOptionGroups -->
            <form method="post" action="/MenuManagement/Create" class="space-y-6 text-xs">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Dish Title (English)</label>
                        <input type="text" name="Name" required x-model="dishForm.name" placeholder="e.g. Stuffed Pigeon with Spiced Freekeh"
                               class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Dish Title (Arabic)</label>
                        <input type="text" name="NameAr" required x-model="dishForm.nameAr" placeholder="مثال: حمام محشي بالفريك البلدي المحمر"
                               class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Description &amp; Heritage Spices (English)</label>
                        <textarea rows="2" name="Description" required x-model="dishForm.description" placeholder="Slow-roasted domestic pigeon seasoned with coriander..."
                                  class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden"></textarea>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Description &amp; Heritage Spices (Arabic)</label>
                        <textarea rows="2" name="DescriptionAr" required x-model="dishForm.descriptionAr" placeholder="حمام بلدي محشو بالفريك المفلفل مع سمن بلدي..."
                                  class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden"></textarea>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Dish Category</label>
                        <select name="Category" x-model="dishForm.category"
                                class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden">
                            <option value="Traditional Egyptian">Traditional Egyptian (أكلات مصرية أصيلة)</option>
                            <option value="Tagines & Casseroles">Tagines &amp; Casseroles (طواجن فرن بلدي)</option>
                            <option value="Stuffed & Mahshi">Stuffed &amp; Mahshi (محاشي ومحمرات)</option>
                            <option value="Grills & Poultry">Grills &amp; Poultry (مشويات وطيور)</option>
                            <option value="Bakery & Desserts">Bakery &amp; Desserts (فطير ومخبوزات وحلويات)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Base Price (EGP)</label>
                        <input type="number" name="Price" step="5" min="10" required x-model.number="dishForm.price"
                               class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Prep Time (Minutes)</label>
                        <input type="number" name="PrepTimeMinutes" step="5" min="15" max="300" required x-model.number="dishForm.prepTime" placeholder="45"
                               class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
                    <div class="sm:col-span-8">
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Dish Photo URL</label>
                        <input type="url" name="ImageUrl" required x-model="dishForm.image" placeholder="https://images.unsplash.com/..."
                               class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>
                    <div class="sm:col-span-4 flex items-center justify-between sm:justify-start gap-3 sm:pt-6">
                        <input type="hidden" name="IsAvailable" :value="dishForm.isAvailable" />
                        <button type="button"
                                @@click="dishForm.isAvailable = !dishForm.isAvailable"
                                class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors cursor-pointer"
                                :class="dishForm.isAvailable ? 'bg-emerald-500' : 'bg-neutral-300 dark:bg-neutral-700'">
                            <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-xs"
                                  :class="dishForm.isAvailable ? 'translate-x-6' : 'translate-x-1'"></span>
                        </button>
                        <span class="font-bold text-xs"
                              :class="dishForm.isAvailable ? 'text-emerald-600' : 'text-neutral-400'"
                              x-text="dishForm.isAvailable ? 'Available Immediately' : 'Currently Unavailable'">
                        </span>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border)]">
                    <button type="button" @@click="addDishModalOpen = false"
                            class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                        <span>Cancel</span>
                    </button>
                    <button type="submit"
                            class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                        <span>Save &amp; Publish Dish</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Edit Dish Modal (from Views/Chefs/Partials/_EditDishModal.cshtml) -->
    <div x-cloak
         x-show="editDishModalOpen"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

        <div @@click.away="editDishModalOpen = false"
             class="relative w-full max-w-3xl bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-2xl max-h-[90vh] overflow-y-auto">

            <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)] mb-6">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#edit-3"></use></svg>
                    </div>
                    <div>
                        <h3 class="text-base sm:text-lg font-bold uppercase tracking-wide text-[var(--color-text)]">
                            Edit Menu Dish
                        </h3>
                        <p class="text-[11px] text-[var(--color-text-muted)]">
                            Update pricing, ingredients, prep time, or preset option surcharges
                        </p>
                    </div>
                </div>
                <button type="button" @@click="editDishModalOpen = false" class="p-1 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                </button>
            </div>

            <!-- TODO(backend): POST /MenuManagement/Edit with UpdateDishDto, validate chef ownership -->
            <form method="post" action="/MenuManagement/Edit" class="space-y-6 text-xs">
                @Html.AntiForgeryToken()
                <input type="hidden" name="DishId" :value="editingDish.id" />
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Dish Title (English)</label>
                        <input type="text" name="Name" required x-model="editingDish.name"
                               class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Dish Title (Arabic)</label>
                        <input type="text" name="NameAr" required x-model="editingDish.nameAr"
                               class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Dish Category</label>
                        <select name="Category" x-model="editingDish.category"
                                class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden">
                            <option value="Traditional Egyptian">Traditional Egyptian (أكلات مصرية أصيلة)</option>
                            <option value="Tagines & Casseroles">Tagines &amp; Casseroles (طواجن فرن بلدي)</option>
                            <option value="Stuffed & Mahshi">Stuffed &amp; Mahshi (محاشي ومحمرات)</option>
                            <option value="Grills & Poultry">Grills &amp; Poultry (مشويات وطيور)</option>
                            <option value="Bakery & Desserts">Bakery &amp; Desserts (فطير ومخبوزات وحلويات)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Base Price (EGP)</label>
                        <input type="number" name="Price" step="5" min="10" required x-model.number="editingDish.price"
                               class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden" />
                    </div>
                    <div>
                        <label class="block font-semibold mb-1 text-[var(--color-text)]">Availability Status</label>
                        <input type="hidden" name="IsAvailable" :value="editingDish.isAvailable" />
                        <button type="button"
                                @@click="editingDish.isAvailable = !editingDish.isAvailable"
                                class="w-full p-2.5 rounded-xl font-bold border transition-colors flex items-center justify-center gap-2 cursor-pointer"
                                :class="editingDish.isAvailable ? 'bg-emerald-50 text-emerald-800 border-emerald-300 dark:bg-emerald-950 dark:text-emerald-100' : 'bg-neutral-100 text-neutral-500 border-neutral-300 dark:bg-neutral-800 dark:text-neutral-400'">
                            <span class="w-2 h-2 rounded-full" :class="editingDish.isAvailable ? 'bg-emerald-500' : 'bg-neutral-400'"></span>
                            <span x-text="editingDish.isAvailable ? 'Available for Orders' : 'Marked Unavailable'"></span>
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border)]">
                    <button type="button" @@click="editDishModalOpen = false"
                            class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                        <span>Cancel</span>
                    </button>
                    <button type="submit"
                            class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                        <span>Save Dish Changes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Dish Confirm Dialog (from Views/Chefs/Partials/_DeleteDishConfirmDialog.cshtml) -->
    <div x-cloak
         x-show="deleteDishConfirmOpen"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

        <div @@click.away="deleteDishConfirmOpen = false"
             class="relative w-full max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-7 shadow-2xl space-y-5">

            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#trash-2"></use></svg>
                </div>
                <div>
                    <h3 class="text-base font-bold uppercase tracking-tight text-[var(--color-text)]">
                        Confirm Dish Deletion
                    </h3>
                    <span class="text-xs text-[var(--color-text-muted)] block" x-text="deletingDish?.name"></span>
                </div>
            </div>

            <div class="p-3.5 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/50 rounded-2xl text-xs space-y-1.5 text-amber-900 dark:text-amber-200">
                <p class="font-bold flex items-center gap-1.5">
                    <svg class="w-4 h-4 shrink-0 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#alert-triangle"></use></svg>
                    <span>Active Orders Policy Notice:</span>
                </p>
                <p class="leading-relaxed text-[11px]">
                    Deleting this dish removes it immediately from public marketplace browse. Any already-accepted active orders remain valid for preparation.
                </p>
            </div>

            <!-- TODO(backend): POST /MenuManagement/Delete, check for unresolved active orders and soft-delete in database -->
            <form method="post" action="/MenuManagement" class="flex items-center justify-end gap-3 pt-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="DishId" :value="deletingDish?.id" />
                <button type="button" @@click="deleteDishConfirmOpen = false"
                        class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] text-xs font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                    <span>Cancel</span>
                </button>
                <button type="submit"
                        class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                    <span>Yes, Delete Dish</span>
                </button>
            </form>
        </div>
    </div>
</div>
