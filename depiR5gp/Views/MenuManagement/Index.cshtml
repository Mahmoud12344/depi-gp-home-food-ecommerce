@model depiR5gp.ViewModels.MenuIndexVM
@{
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
    ViewData["Title"] = "Menu & Dishes";
    ViewData["ActiveChefTab"] = "menu";
}

<div x-data="{
        deleteModalOpen: false,
        deleteDishId: null,
        deleteDishName: '',
        openDelete(id, name) {
            this.deleteDishId = id;
            this.deleteDishName = name;
            this.deleteModalOpen = true;
        }
    }" class="w-full space-y-8">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-[var(--color-border)]">
        <div>
            <h1 class="text-2xl font-semibold text-[var(--color-text)] tracking-tight">Menu &amp; Dishes</h1>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">
                @Model.Dishes.Count dish@(Model.Dishes.Count == 1 ? "" : "es") · @Model.AvailableCount available · @Model.SoldOutCount sold out
            </p>
        </div>

        <a href="/MenuManagement/Create"
           class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-sm font-medium transition-colors w-fit">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#plus"></use></svg>
            <span>Add New Dish</span>
        </a>
    </div>

    @if (Model.Dishes.Count == 0)
    {
        <!-- Empty State -->
        <div class="bg-[var(--color-card-bg)] border border-dashed border-[var(--color-border)] rounded-2xl p-14 text-center space-y-4">
            <div class="w-14 h-14 rounded-2xl bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text-muted)] mx-auto flex items-center justify-center">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
            </div>
            <div class="space-y-1.5">
                <h2 class="text-lg font-semibold text-[var(--color-text)]">No dishes in your menu yet</h2>
                <p class="text-[15px] text-[var(--color-text-muted)] max-w-lg mx-auto">
                    Add your first homemade dish with photos, pricing, and optional add-ons so customers can order from your kitchen.
                </p>
            </div>
            <div class="pt-2">
                <a href="/MenuManagement/Create"
                   class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-[15px] font-medium transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#plus"></use></svg>
                    <span>Add Your First Dish</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Full-Width Dish Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @foreach (var dish in Model.Dishes)
            {
                <div x-data="{
                        available: @(dish.IsAvailable ? "true" : "false"),
                        busy: false,
                        async toggle() {
                            if (this.busy) return;
                            this.busy = true;
                            try {
                                const token = this.$refs.tokenWrap.querySelector('input[name=__RequestVerificationToken]')?.value || '';
                                const res = await fetch('/MenuManagement/ToggleAvailability/@dish.Id', {
                                    method: 'POST',
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest',
                                        'RequestVerificationToken': token
                                    }
                                });
                                if (!res.ok) throw new Error('Toggle failed');
                                const data = await res.json();
                                if (data.success) {
                                    this.available = !!data.isAvailable;
                                    window.dispatchEvent(new CustomEvent('hc-toast', {
                                        detail: { type: this.available ? 'success' : 'info', message: data.message }
                                    }));
                                }
                            } catch (e) {
                                window.dispatchEvent(new CustomEvent('hc-toast', {
                                    detail: { type: 'error', message: 'Could not update dish availability.' }
                                }));
                            } finally {
                                this.busy = false;
                            }
                        }
                    }"
                     class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl overflow-hidden flex flex-col justify-between transition-colors hover:border-[var(--color-primary)]/40">

                    <span x-ref="tokenWrap" class="hidden">@Html.AntiForgeryToken()</span>

                    <div>
                        <!-- Image -->
                        <div class="relative h-52 bg-[var(--color-surface-subtle)] overflow-hidden">
                            @if (!string.IsNullOrWhiteSpace(dish.ImageUrl))
                            {
                                <img src="@dish.ImageUrl" alt="@dish.Name"
                                     class="w-full h-full object-cover transition-opacity"
                                     :class="available ? '' : 'grayscale opacity-65'" />
                            }
                            else
                            {
                                <div class="w-full h-full flex flex-col items-center justify-center text-[var(--color-text-muted)] gap-2">
                                    <svg class="w-9 h-9 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
                                    <span class="text-sm">No photo</span>
                                </div>
                            }

                            <span class="absolute top-3 start-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--color-card-bg)]/95 border border-[var(--color-border)] text-xs font-medium text-[var(--color-text)] backdrop-blur-xs">
                                <span class="w-2 h-2 rounded-full" :class="available ? 'bg-emerald-500' : 'bg-rose-500'"></span>
                                <span x-text="available ? 'Available' : 'Sold Out'">@(dish.IsAvailable ? "Available" : "Sold Out")</span>
                            </span>
                        </div>

                        <!-- Content -->
                        <div class="p-6 space-y-3">
                            <div class="flex items-start justify-between gap-3">
                                <h2 class="text-lg font-semibold text-[var(--color-text)] leading-snug line-clamp-1">
                                    @dish.Name
                                </h2>
                                <span class="text-base font-semibold text-[var(--color-primary)] shrink-0">
                                    @dish.Price.ToString("N2") EGP
                                </span>
                            </div>

                            <p class="text-sm text-[var(--color-text-muted)]">
                                @dish.CategoryName · @dish.CuisineName · @dish.OptionsCount option@(dish.OptionsCount == 1 ? "" : "s")
                            </p>

                            @if (!string.IsNullOrWhiteSpace(dish.Description))
                            {
                                <p class="text-sm text-[var(--color-text-muted)] line-clamp-2 leading-relaxed">
                                    @dish.Description
                                </p>
                            }
                        </div>
                    </div>

                    <!-- Footer Actions -->
                    <div class="px-6 pb-6 pt-4 border-t border-[var(--color-border)] space-y-4">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium text-[var(--color-text-muted)]">Available for orders</span>
                            <button type="button"
                                    @@click="toggle()"
                                    :disabled="busy"
                                    aria-label="Toggle dish availability"
                                    class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors cursor-pointer disabled:opacity-60"
                                    :class="available ? 'bg-emerald-500' : 'bg-neutral-300 dark:bg-neutral-700'">
                                <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-xs"
                                      :class="available ? 'translate-x-6' : 'translate-x-1'"></span>
                            </button>
                        </div>

                        <div class="grid grid-cols-3 gap-2.5 text-sm">
                            <a href="/MenuManagement/Edit/@dish.Id"
                               class="py-2 px-3 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text)] font-medium text-center transition-colors">
                                Edit
                            </a>
                            <a href="/MenuManagement/ManageOptions/@dish.Id"
                               class="py-2 px-3 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-primary)] font-medium text-center transition-colors">
                                Options
                            </a>
                            <button type="button"
                                    @@click="openDelete(@dish.Id, @System.Text.Json.JsonSerializer.Serialize(dish.Name))"
                                    class="py-2 px-3 rounded-xl border border-[var(--color-border)] hover:border-rose-300 hover:text-rose-600 text-[var(--color-text-muted)] font-medium text-center transition-colors cursor-pointer">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Delete Confirmation Modal -->
    <div x-cloak
         x-show="deleteModalOpen"
         x-transition.opacity
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
        <div @@click.away="deleteModalOpen = false"
             class="w-full max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-6 shadow-xl space-y-5">
            <div class="space-y-1.5">
                <h3 class="text-lg font-semibold text-[var(--color-text)]">Remove dish from menu?</h3>
                <p class="text-[15px] text-[var(--color-text-muted)] leading-relaxed">
                    Are you sure you want to remove <strong class="text-[var(--color-text)]" x-text="deleteDishName"></strong>?
                    Dishes in active orders cannot be deleted.
                </p>
            </div>
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button"
                        @@click="deleteModalOpen = false"
                        class="px-4 py-2 rounded-xl border border-[var(--color-border)] text-sm font-medium text-[var(--color-text)] hover:bg-[var(--color-surface-subtle)] cursor-pointer">
                    Cancel
                </button>
                <form :action="'/MenuManagement/Delete/' + deleteDishId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-sm font-medium cursor-pointer">
                        Remove Dish
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
