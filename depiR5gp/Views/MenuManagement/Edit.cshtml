@model depiR5gp.ViewModels.DishFormVM
@{
    ViewData["Title"] = $"Edit {Model.Name} - Chef Portal";
    ViewData["ActiveChefTab"] = "menu";
}

<div class="w-full pb-24">
    <partial name="~/Views/ChefDashboard/Partials/_ChefNav.cshtml" />

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[var(--color-border-light)]">
                <div>
                    <h2 class="text-lg font-bold uppercase tracking-tight text-[var(--color-text)]">Edit Dish</h2>
                    <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
                        Update dish details, pricing, availability, or photo.
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/MenuManagement/ManageOptions/@Model.Id"
                       class="px-4 py-2 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white text-xs font-bold transition-colors">
                        Manage Options
                    </a>
                    <a href="/MenuManagement"
                       class="px-4 py-2 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-xs font-bold text-[var(--color-text)] transition-colors">
                        Back to Menu
                    </a>
                </div>
            </div>

            <form asp-controller="MenuManagement" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data"
                  x-data="{
                      previewUrl: @(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "null" : System.Text.Json.JsonSerializer.Serialize(Model.ExistingImageUrl)),
                      onFileChange(e) {
                          const file = e.target.files?.[0];
                          if (!file) return;
                          const reader = new FileReader();
                          reader.onload = ev => this.previewUrl = ev.target.result;
                          reader.readAsDataURL(file);
                      }
                  }"
                  class="space-y-5 text-xs">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly"
                         class="p-3.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-600 dark:text-rose-300 font-medium"></div>
                }

                <!-- Dish Image Upload + Preview -->
                <div class="flex flex-col sm:flex-row items-center gap-5 p-4 rounded-2xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-light)]">
                    <div class="w-28 h-28 rounded-2xl overflow-hidden bg-white dark:bg-neutral-900 border border-[var(--color-border)] flex items-center justify-center shrink-0">
                        <template x-if="previewUrl">
                            <img :src="previewUrl" alt="@Model.Name" class="w-full h-full object-cover" />
                        </template>
                        <template x-if="!previewUrl">
                            <svg class="w-9 h-9 text-[var(--color-text-muted)] opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
                        </template>
                    </div>
                    <div class="flex-1 w-full space-y-1.5">
                        <label asp-for="ImageFile" class="block font-bold text-[var(--color-text)]">Replace Dish Photo (optional)</label>
                        <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" @@change="onFileChange($event)"
                               class="w-full p-2 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl file:me-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[var(--color-primary-light)] file:text-[var(--color-primary)] cursor-pointer" />
                        <span asp-validation-for="ImageFile" class="text-rose-500 text-xs block"></span>
                    </div>
                </div>

                <!-- Dish Name & Price -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="sm:col-span-2 space-y-1.5">
                        <label asp-for="Name" class="block font-bold text-[var(--color-text)]">Dish Name</label>
                        <input asp-for="Name"
                               class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                        <span asp-validation-for="Name" class="text-rose-500 text-xs block"></span>
                    </div>
                    <div class="space-y-1.5">
                        <label asp-for="Price" class="block font-bold text-[var(--color-text)]">Base Price (EGP)</label>
                        <input asp-for="Price" type="number" step="0.50" min="1"
                               class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                        <span asp-validation-for="Price" class="text-rose-500 text-xs block"></span>
                    </div>
                </div>

                <!-- Category & Cuisine -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label asp-for="CategoryId" class="block font-bold text-[var(--color-text)]">Category</label>
                        <select asp-for="CategoryId"
                                class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium">
                            <option value="0">-- Select Category --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-rose-500 text-xs block"></span>
                    </div>
                    <div class="space-y-1.5">
                        <label asp-for="CuisineId" class="block font-bold text-[var(--color-text)]">Cuisine</label>
                        <select asp-for="CuisineId"
                                class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium">
                            <option value="0">-- Select Cuisine --</option>
                            @foreach (var cuisine in Model.Cuisines)
                            {
                                <option value="@cuisine.Id">@cuisine.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CuisineId" class="text-rose-500 text-xs block"></span>
                    </div>
                </div>

                <!-- Description -->
                <div class="space-y-1.5">
                    <label asp-for="Description" class="block font-bold text-[var(--color-text)]">Description &amp; Ingredients</label>
                    <textarea asp-for="Description" rows="4"
                              class="w-full p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium leading-relaxed"></textarea>
                    <span asp-validation-for="Description" class="text-rose-500 text-xs block"></span>
                </div>

                <!-- Availability Checkbox -->
                <div class="flex items-start gap-3 p-4 rounded-2xl bg-[var(--color-surface-subtle)] border border-[var(--color-border-light)]">
                    <input asp-for="IsAvailable" type="checkbox" id="editDishAvailableSwitch"
                           class="mt-0.5 w-4 h-4 rounded accent-[var(--color-primary)] cursor-pointer" />
                    <label for="editDishAvailableSwitch" class="cursor-pointer">
                        <span class="block font-bold text-[var(--color-text)]">Available for Ordering</span>
                        <span class="text-[11px] text-[var(--color-text-muted)]">Uncheck to temporarily mark this dish as Sold Out.</span>
                    </label>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border-light)]">
                    <a href="/MenuManagement"
                       class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-text)] font-bold uppercase tracking-wider transition-colors">
                        Cancel
                    </a>
                    <button type="submit"
                            class="px-6 py-2.5 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-xs">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
