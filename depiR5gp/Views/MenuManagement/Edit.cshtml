@*
    TODO [Backend]: Strongly-typed view binding for Edit Dish
    1. Uncomment the model directive once MenuManagementController.Edit(int id) passes the Dish:
       @model depiR5gp.Models.Menu.Dish
    2. In [HttpGet] MenuManagementController.Edit(int id):
       var dish = await unitOfWork.Dishes.GetByIdAsync(id);
       return View(dish);
*@
@{
    ViewData["Title"] = "Chef Portal - Edit Dish";
    var routeDishId = ViewContext.RouteData.Values["id"]?.ToString() ?? "1";
}

<partial name="~/Views/ChefDashboard/Partials/_ChefNav.cshtml" />

<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-24">
    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)]">
            <div>
                <h2 class="text-lg font-bold text-[var(--color-text)] uppercase tracking-wide">
                    Edit Menu Dish (#@routeDishId)
                </h2>
                <p class="text-xs text-[var(--color-text-muted)]">
                    Update dish title, price, category, description, or availability status.
                </p>
            </div>
            <a asp-controller="MenuManagement" asp-action="Index"
               class="text-xs font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-primary)]">
                &larr; Back to Menu
            </a>
        </div>

        <form method="post" asp-controller="MenuManagement" asp-action="Edit" class="space-y-6 text-xs">
            <input type="hidden" name="Id" value="@routeDishId" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="Name" class="block font-semibold mb-1.5 text-[var(--color-text)]">Dish Title (English)</label>
                    <input id="Name" name="Name" type="text" required value="Baladi Duck Molokhia with Vermicelli Rice"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div>
                    <label for="Price" class="block font-semibold mb-1.5 text-[var(--color-text)]">Base Price (EGP)</label>
                    <input id="Price" name="Price" type="number" step="5" min="10" value="240" required
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="CategoryId" class="block font-semibold mb-1.5 text-[var(--color-text)]">Category</label>
                    <select id="CategoryId" name="CategoryId"
                            class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden">
                        <option value="1" selected>Traditional Egyptian</option>
                        <option value="2">Tagines &amp; Casseroles</option>
                        <option value="3">Stuffed &amp; Mahshi</option>
                        <option value="4">Grills &amp; Poultry</option>
                        <option value="5">Bakery &amp; Desserts</option>
                    </select>
                </div>
                <div>
                    <label for="IsAvailable" class="block font-semibold mb-1.5 text-[var(--color-text)]">Availability Status</label>
                    <select id="IsAvailable" name="IsAvailable"
                            class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-bold focus:border-[var(--color-primary)] focus:outline-hidden">
                        <option value="true" selected>Available for Orders</option>
                        <option value="false">Temporarily Unavailable</option>
                    </select>
                </div>
            </div>

            <div>
                <label for="Description" class="block font-semibold mb-1.5 text-[var(--color-text)]">Dish Description &amp; Ingredients</label>
                <textarea id="Description" name="Description" rows="3" required
                          class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden">Minced fresh molokhia leaves whipped with golden baladi garlic and coriander ta'sheya, paired with roasted heritage duck and Egyptian vermicelli rice.</textarea>
            </div>

            <div>
                <label for="ImageUrl" class="block font-semibold mb-1.5 text-[var(--color-text)]">Dish Photo URL</label>
                <input id="ImageUrl" name="ImageUrl" type="url" required value="https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80"
                       class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
            </div>

            <div class="pt-4 border-t border-[var(--color-border)] flex items-center justify-between flex-wrap gap-3">
                <a asp-controller="MenuManagement" asp-action="ManageOptions" asp-route-dishId="@routeDishId"
                   class="text-xs font-bold text-[var(--color-primary)] hover:underline">
                    Manage Customization Options &rarr;
                </a>
                <div class="flex items-center gap-3">
                    <a asp-controller="MenuManagement" asp-action="Index"
                       class="px-5 py-2.5 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] font-semibold uppercase tracking-wider">
                        Cancel
                    </a>
                    <button type="submit"
                            class="px-6 py-2.5 bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider rounded-full shadow-xs transition-colors cursor-pointer">
                        Save Dish Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</main>
