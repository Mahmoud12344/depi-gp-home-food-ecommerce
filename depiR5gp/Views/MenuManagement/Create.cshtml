@model depiR5gp.ViewModels.DishFormVM
@{
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
    ViewData["Title"] = "Add New Dish";
    ViewData["ActiveChefTab"] = "menu";
}

<div class="w-full space-y-8">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[var(--color-border)]">
        <div>
            <h1 class="text-2xl sm:text-3xl font-semibold text-[var(--color-text)] tracking-tight">Add New Dish</h1>
            <p class="text-[15px] text-[var(--color-text-muted)] mt-1">
                Publish a new homemade dish to your kitchen menu.
            </p>
        </div>
        <a href="/MenuManagement"
           class="px-4 py-2.5 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-sm font-medium text-[var(--color-text)] transition-colors w-fit">
            Back to Menu
        </a>
    </div>

    <form asp-controller="MenuManagement" asp-action="Create" method="post" enctype="multipart/form-data"
          x-data="{
              previewUrl: null,
              onFileChange(e) {
                  const file = e.target.files?.[0];
                  if (!file) { this.previewUrl = null; return; }
                  const reader = new FileReader();
                  reader.onload = ev => this.previewUrl = ev.target.result;
                  reader.readAsDataURL(file);
              }
          }"
          class="divide-y divide-[var(--color-border)]">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly"
                 class="mb-6 p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-sm text-rose-700 dark:text-rose-300 font-medium"></div>
        }

        <!-- Photo -->
        <div class="py-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <div class="lg:col-span-4">
                <label asp-for="ImageFile" class="block text-[15px] font-medium text-[var(--color-text)]">Dish Photo</label>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">JPG, PNG, or WEBP up to 5 MB.</p>
            </div>
            <div class="lg:col-span-8 flex flex-col sm:flex-row items-start sm:items-center gap-5">
                <div class="w-24 h-24 rounded-2xl overflow-hidden bg-[var(--color-surface-subtle)] border border-[var(--color-border)] flex items-center justify-center shrink-0">
                    <template x-if="previewUrl">
                        <img :src="previewUrl" alt="Dish preview" class="w-full h-full object-cover" />
                    </template>
                    <template x-if="!previewUrl">
                        <svg class="w-8 h-8 text-[var(--color-text-muted)] opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
                    </template>
                </div>
                <div class="flex-1 w-full">
                    <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" @@change="onFileChange($event)"
                           class="w-full p-2.5 bg-[var(--color-card-bg)] text-sm text-[var(--color-text)] border border-[var(--color-border)] rounded-xl file:me-3 file:py-1.5 file:px-3.5 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-[var(--color-surface-subtle)] file:text-[var(--color-text)] cursor-pointer" />
                    <span asp-validation-for="ImageFile" class="text-rose-600 text-sm mt-1 block"></span>
                </div>
            </div>
        </div>

        <!-- Name & Price -->
        <div class="py-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <div class="lg:col-span-4">
                <span class="block text-[15px] font-medium text-[var(--color-text)]">Dish Name &amp; Base Price</span>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">Set a clear title and starting price in EGP.</p>
            </div>
            <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="sm:col-span-2">
                    <label asp-for="Name" class="block text-sm font-medium text-[var(--color-text)] mb-1.5">Dish Name</label>
                    <input asp-for="Name" placeholder="e.g., Traditional Stuffed Vine Leaves"
                           class="w-full px-4 py-3 bg-[var(--color-card-bg)] text-[15px] text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden" />
                    <span asp-validation-for="Name" class="text-rose-600 text-sm mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Price" class="block text-sm font-medium text-[var(--color-text)] mb-1.5">Price (EGP)</label>
                    <input asp-for="Price" type="number" step="0.50" min="1" placeholder="150.00"
                           class="w-full px-4 py-3 bg-[var(--color-card-bg)] text-[15px] text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden" />
                    <span asp-validation-for="Price" class="text-rose-600 text-sm mt-1 block"></span>
                </div>
            </div>
        </div>

        <!-- Category & Cuisine -->
        <div class="py-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <div class="lg:col-span-4">
                <span class="block text-[15px] font-medium text-[var(--color-text)]">Classification</span>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">Helps customers discover your dish via filters.</p>
            </div>
            <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="CategoryId" class="block text-sm font-medium text-[var(--color-text)] mb-1.5">Category</label>
                    <select asp-for="CategoryId"
                            class="w-full px-4 py-3 bg-[var(--color-card-bg)] text-[15px] text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden">
                        <option value="0">Select category</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-rose-600 text-sm mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="CuisineId" class="block text-sm font-medium text-[var(--color-text)] mb-1.5">Cuisine</label>
                    <select asp-for="CuisineId"
                            class="w-full px-4 py-3 bg-[var(--color-card-bg)] text-[15px] text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden">
                        <option value="0">Select cuisine</option>
                        @foreach (var cuisine in Model.Cuisines)
                        {
                            <option value="@cuisine.Id">@cuisine.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CuisineId" class="text-rose-600 text-sm mt-1 block"></span>
                </div>
            </div>
        </div>

        <!-- Description -->
        <div class="py-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <div class="lg:col-span-4">
                <label asp-for="Description" class="block text-[15px] font-medium text-[var(--color-text)]">Description &amp; Ingredients</label>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">Include portion size, key ingredients, and allergens.</p>
            </div>
            <div class="lg:col-span-8">
                <textarea asp-for="Description" rows="4" placeholder="Describe your dish, portion size, and preparation..."
                          class="w-full px-4 py-3 bg-[var(--color-card-bg)] text-[15px] text-[var(--color-text)] border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden leading-relaxed"></textarea>
                <span asp-validation-for="Description" class="text-rose-600 text-sm mt-1 block"></span>
            </div>
        </div>

        <!-- Availability -->
        <div class="py-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
            <div class="lg:col-span-4">
                <span class="block text-[15px] font-medium text-[var(--color-text)]">Availability</span>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">Make this dish orderable immediately upon publishing.</p>
            </div>
            <div class="lg:col-span-8">
                <label for="dishAvailableSwitch" class="inline-flex items-center gap-3 cursor-pointer">
                    <input asp-for="IsAvailable" type="checkbox" id="dishAvailableSwitch"
                           class="w-5 h-5 rounded accent-[var(--color-primary)] cursor-pointer" />
                    <span class="text-[15px] font-medium text-[var(--color-text)]">Available for ordering</span>
                </label>
            </div>
        </div>

        <!-- Footer -->
        <div class="pt-6 flex items-center justify-end gap-3">
            <a href="/MenuManagement"
               class="px-5 py-2.5 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[15px] font-medium text-[var(--color-text)] transition-colors">
                Cancel
            </a>
            <button type="submit"
                    class="px-6 py-2.5 rounded-xl bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-[15px] font-medium transition-colors cursor-pointer">
                Publish Dish
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
