@model depiR5gp.ViewModels.ReviewFormVM
@{
    var isEdit = Model.ReviewId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Your Review" : "Rate Chef & Dishes";
}

<div x-data="{
        reviewRating: @Model.Rating,
        reviewComment: @System.Text.Json.JsonSerializer.Serialize(Model.Comment ?? string.Empty),
        addTag(tag) {
            if (!this.reviewComment) {
                this.reviewComment = tag;
            } else if (!this.reviewComment.includes(tag)) {
                this.reviewComment = this.reviewComment.trimEnd() + ' · ' + tag;
            }
        }
    }"
     class="w-full pb-24">

    <!-- Breadcrumb banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="/" class="hover:text-[var(--color-primary)] font-medium">Home</a>
                <span aria-hidden="true">/</span>
                <a asp-controller="Customer" asp-action="Reviews" class="hover:text-[var(--color-primary)] font-medium">My Reviews</a>
                <span aria-hidden="true">/</span>
                <span class="text-[var(--color-text)] font-semibold">@(isEdit ? "Edit Review" : "Write a Review")</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                @(isEdit ? "Update Your Review" : "Rate Chef & Dishes")
            </h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5">
                Order #@Model.OrderReference · @Model.KitchenName · @Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy")
            </p>
        </div>
    </div>

    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl w-full p-6 sm:p-8 shadow-sm space-y-6">
            <!-- Chef & Ordered Dishes Summary -->
            <div class="flex items-start gap-3.5 pb-4 border-b border-[var(--color-border-light)]">
                @if (!string.IsNullOrWhiteSpace(Model.ChefPhotoUrl))
                {
                    <img src="@Model.ChefPhotoUrl" alt="@Model.KitchenName"
                         class="w-12 h-12 rounded-full object-cover border border-[var(--color-border)] shrink-0" />
                }
                else
                {
                    <div class="w-12 h-12 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center shrink-0">
                        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                    </div>
                }
                <div class="min-w-0 space-y-1.5">
                    <h2 class="text-base font-bold text-[var(--color-text)]">@Model.KitchenName</h2>
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var dish in Model.Dishes)
                        {
                            <span class="px-2.5 py-0.5 rounded-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-xs text-[var(--color-text)]">
                                @dish.DishName × @dish.Quantity
                            </span>
                        }
                    </div>
                </div>
            </div>

            <form asp-controller="Reviews"
                  asp-action="@(isEdit ? "Edit" : "Create")"
                  asp-route-id="@Model.ReviewId"
                  method="post"
                  class="space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="OrderId" />
                <input type="hidden" asp-for="ReviewId" />
                <input type="hidden" name="Rating" :value="reviewRating" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All"
                         class="p-3.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-xs text-rose-700 dark:text-rose-300 font-medium"></div>
                }

                <!-- Star Selector (1 to 5) -->
                <div class="text-center bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)] p-4">
                    <span class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-2.5">Overall Star Rating</span>
                    <div class="flex items-center justify-center gap-2">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <button type="button"
                                    @@click="reviewRating = @s"
                                    aria-label="@s star@(s == 1 ? "" : "s")"
                                    class="p-1 transition-transform hover:scale-125 focus:outline-hidden cursor-pointer"
                                    :class="@s <= reviewRating ? 'text-[var(--color-star)]' : 'text-neutral-300 dark:text-neutral-700'">
                                <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            </button>
                        }
                    </div>
                    <p class="text-xs font-semibold text-[var(--color-primary)] mt-2"
                       x-text="reviewRating === 5 ? 'Exceptional & Exceeded Expectations!' :
                               reviewRating === 4 ? 'Very Good & Delicious' :
                               reviewRating === 3 ? 'Good / Acceptable' :
                               reviewRating === 2 ? 'Needs Improvement' : 'Disappointed'"></p>
                </div>

                <!-- Detailed Feedback -->
                <div>
                    <label asp-for="Comment" class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
                        Your Review (Chef &amp; Dishes)
                    </label>
                    <textarea asp-for="Comment"
                              rows="4"
                              x-model="reviewComment"
                              required
                              minlength="5"
                              placeholder="Tell others about the taste, freshness, portion size, packaging, and pickup experience..."
                              class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl p-3 text-sm text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]"></textarea>
                    <span asp-validation-for="Comment" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <!-- Clickable Quick Compliment Chips -->
                <div>
                    <span class="block text-xs font-semibold text-[var(--color-text-muted)] mb-2">Quick highlights (click to add):</span>
                    <div class="flex flex-wrap gap-1.5">
                        <button type="button" @@click="addTag('Generous portions')"
                                class="px-3 py-1 rounded-full text-xs bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-primary)] cursor-pointer">
                            Generous portions
                        </button>
                        <button type="button" @@click="addTag('Hot & fresh pickup')"
                                class="px-3 py-1 rounded-full text-xs bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-primary)] cursor-pointer">
                            Hot &amp; fresh pickup
                        </button>
                        <button type="button" @@click="addTag('Authentic homemade flavor')"
                                class="px-3 py-1 rounded-full text-xs bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-primary)] cursor-pointer">
                            Authentic homemade flavor
                        </button>
                        <button type="button" @@click="addTag('Clean packaging')"
                                class="px-3 py-1 rounded-full text-xs bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-primary)] cursor-pointer">
                            Clean packaging
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border-light)]">
                    <a asp-controller="Customer" asp-action="Reviews"
                       class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-xs font-bold uppercase tracking-wider text-[var(--color-text)] transition-colors">
                        Cancel
                    </a>
                    <button type="submit"
                            class="px-6 py-2.5 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-sm">
                        @(isEdit ? "Update Review" : "Submit Review")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
