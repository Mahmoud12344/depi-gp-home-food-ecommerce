@model depiR5gp.Models.Chefs.ChefApplicationStatusVM
@{
    ViewData["Title"] = "Chef Application Status";
}

<div class="w-full pb-24">
    <!-- Header Banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-8">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-1.5">
            <span class="text-xs font-bold uppercase tracking-widest text-[var(--color-primary)]">Chef Onboarding</span>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                Application Status Tracker
            </h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)]">
                Track the verification status of your domestic kitchen application in real time.
            </p>
        </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-8 sm:p-10 shadow-sm text-center space-y-6">
            @if (Model.Status == "Pending")
            {
                <div class="w-16 h-16 mx-auto rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-300 flex items-center justify-center">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#clock"></use></svg>
                </div>
                <div class="space-y-2">
                    <span class="inline-block text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-amber-100 text-amber-900 dark:bg-amber-950/80 dark:text-amber-200 border border-amber-300 dark:border-amber-700">
                        Pending Review
                    </span>
                    <h2 class="text-xl font-bold text-[var(--color-text)]">Your application is under review</h2>
                    <p class="text-xs sm:text-sm text-[var(--color-text-muted)] max-w-md mx-auto leading-relaxed">
                        Our platform administration team is verifying your National ID and Health Certificate. You'll gain full kitchen management access once approved.
                    </p>
                </div>
            }
            else if (Model.Status == "Approved")
            {
                <div class="w-16 h-16 mx-auto rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-300 flex items-center justify-center">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check-circle-2"></use></svg>
                </div>
                <div class="space-y-2">
                    <span class="inline-block text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 dark:bg-emerald-950/80 dark:text-emerald-200 border border-emerald-300 dark:border-emerald-700">
                        Approved
                    </span>
                    <h2 class="text-xl font-bold text-[var(--color-text)]">Congratulations! Your kitchen is live</h2>
                    <p class="text-xs sm:text-sm text-[var(--color-text-muted)] max-w-md mx-auto leading-relaxed">
                        Your domestic kitchen has been verified. You can now manage your menu, customize your profile, and accept orders.
                    </p>
                </div>
                <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
                    <a href="/ChefDashboard"
                       class="px-6 py-2.5 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-xs">
                        Go to Chef Dashboard
                    </a>
                    <a asp-controller="Chefs" asp-action="EditProfile"
                       class="px-6 py-2.5 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-text)] text-xs font-bold uppercase tracking-wider transition-colors">
                        Edit Kitchen Profile
                    </a>
                </div>
            }
            else if (Model.Status == "Rejected")
            {
                <div class="w-16 h-16 mx-auto rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-300 flex items-center justify-center">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#alert-triangle"></use></svg>
                </div>
                <div class="space-y-2">
                    <span class="inline-block text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-rose-100 text-rose-900 dark:bg-rose-950/80 dark:text-rose-200 border border-rose-300 dark:border-rose-700">
                        Rejected
                    </span>
                    <h2 class="text-xl font-bold text-[var(--color-text)]">Application Needs Attention</h2>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.RejectionNotes))
                {
                    <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-xs text-rose-800 dark:text-rose-200 max-w-lg mx-auto text-start">
                        <strong class="block uppercase tracking-wider text-[10px] mb-1">Admin Feedback:</strong>
                        <span>@Model.RejectionNotes</span>
                    </div>
                }
                <div class="pt-2">
                    <a asp-controller="Chefs" asp-action="Onboarding"
                       class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-xs">
                        <span>Resubmit Application</span>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
