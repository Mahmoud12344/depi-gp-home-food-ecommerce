                                    :class="activePresetId === preset.id ? 'border-[var(--color-primary)] bg-[var(--color-primary)]/5 shadow-xs' : 'border-[var(--color-border)] bg-[var(--color-card-bg)] hover:border-[var(--color-primary)]/50 hover:bg-[var(--color-surface-subtle)]'">
                                <span class="text-xl shrink-0 p-1 bg-white/60 dark:bg-neutral-800 rounded-lg" x-text="preset.icon"></span>
                                <div class="min-w-0">
                                    <h4 class="text-xs font-bold text-[var(--color-text)]"
                                        x-text="$store.app.language === 'ar' ? preset.titleAr : preset.titleEn">
                                    </h4>
                                    <p class="text-[11px] text-[var(--color-text-muted)] line-clamp-2 mt-0.5"
                                       x-text="$store.app.language === 'ar' ? preset.promptAr : preset.promptEn">
                                    </p>
                                </div>
                            </button>
                        </template>
                    </div>
                </div>

            </div>

            <!-- Right Column: Grounded Recommended Dishes Panel -->
            <!-- TODO [Backend]: Bind catalog dishes grounded in LLM context vector embeddings (e.g. Model.GroundedDishes); bind DishId, Name, Price, KitchenName, ImageUrl, and AddToCart action -->
            <div class="lg:col-span-4 space-y-6">

                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-5 sm:p-6 shadow-sm">
                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-[var(--color-border)]">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#utensils"></use></svg>
                            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-text)]"
                                x-text="$store.app.language === 'ar' ? 'الأطباق المقترحة في هذه الجلسة' : 'Recommended Fresh Dishes'">
                                Recommended Fresh Dishes
                            </h3>
                        </div>
                        <span class="text-[11px] font-bold text-[var(--color-primary)]"
                              x-text="recommendedDishes.length > 0 ? `${recommendedDishes.length} ${$store.app.language === 'ar' ? 'أطباق متطابقة' : 'Dishes'}` : ($store.app.language === 'ar' ? 'اختر أو اكتب سؤالاً' : 'Awaiting prompt')">
                        </span>
                    </div>

                    <template x-if="recommendedDishes.length === 0">
                        <div class="py-12 text-center space-y-3">
                            <div class="w-12 h-12 mx-auto rounded-full bg-[var(--color-surface-subtle)] flex items-center justify-center text-[var(--color-text-muted)]">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chef-hat"></use></svg>
                            </div>
                            <p class="text-xs text-[var(--color-text-muted)] max-w-xs mx-auto"
                               x-text="$store.app.language === 'ar' ? 'اختر أحد الاقتراحات السريعة أو اكتب استفسارك في الصندوق وسيقوم المساعد باقتراح الأطباق المناسبة مباشرة من قائمة المطابخ الحية.' : 'Ask the assistant or choose a prompt to discover freshly prepared dishes matched to your craving.'">
                            </p>
                        </div>
                    </template>

                    <template x-if="recommendedDishes.length > 0">
                        <div class="space-y-4">
                            <template x-for="dish in recommendedDishes" :key="dish.id">
                                <div class="group border border-[var(--color-border)] hover:border-[var(--color-primary)] rounded-2xl p-3.5 bg-white dark:bg-neutral-800/80 transition-all shadow-xs flex flex-col gap-3">
                                    <div class="flex items-start gap-3">
                                        <img :src="dish.image"
                                             :alt="dish.name"
                                             class="w-20 h-20 rounded-xl object-cover shrink-0 group-hover:scale-105 transition-transform duration-300" />
                                        <div class="flex-1 min-w-0 space-y-1">
                                            <div class="flex items-center gap-2">
                                                <span class="text-[10px] font-bold text-[var(--color-primary)] bg-[var(--color-primary)]/10 px-2 py-0.5 rounded-full uppercase"
                                                      x-text="dish.kitchenName">
                                                </span>
                                                <template x-if="dish.isSale">
                                                    <span class="text-[10px] font-bold text-white bg-[var(--color-sale)] px-1.5 py-0.2 rounded-xs">
                                                        SALE
                                                    </span>
                                                </template>
                                            </div>

                                            <h4 @@click="$store.app.navigate(`#dish-v3/${dish.id}`)"
                                                class="font-bold text-xs text-[var(--color-text)] truncate cursor-pointer hover:text-[var(--color-primary)] transition-colors"
                                                x-text="$store.app.language === 'ar' ? dish.nameAr : dish.name">
                                            </h4>

                                            <div class="flex items-center gap-3 text-[11px] text-[var(--color-text-muted)]">
                                                <span class="flex items-center gap-1 text-amber-500 font-semibold">
                                                    <svg class="w-3 h-3 fill-amber-400 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><use href="#star"></use></svg>
                                                    <span x-text="dish.rating"></span>
                                                </span>
                                                <span>•</span>
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#clock"></use></svg>
                                                    <span x-text="`${dish.prepTimeMinutes} ${$store.app.language === 'ar' ? 'دقيقة' : 'min'}`"></span>
                                                </span>
                                            </div>

                                            <div class="flex items-baseline gap-2 pt-0.5">
                                                <span class="text-xs font-bold text-[var(--color-primary)]"
                                                      x-text="`${dish.price.toFixed(2)} EGP`">
                                                </span>
                                                <template x-if="dish.originalPrice">
                                                    <span class="text-[10px] text-[var(--color-text-muted)] line-through"
                                                          x-text="`${dish.originalPrice.toFixed(2)} EGP`">
                                                    </span>
                                                </template>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="pt-2 border-t border-[var(--color-border-light)] flex items-center justify-between gap-2">
                                        <a :href="`#dish-v3/${dish.id}`"
                                           class="text-[11px] font-semibold text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors flex items-center gap-1 cursor-pointer">
                                            <span x-text="$store.app.language === 'ar' ? 'تفاصيل الطبق والخيارات' : 'View Full Details'">View Full Details</span>
                                            <svg class="w-3 h-3" :class="$store.app.language === 'ar' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#arrow-right"></use></svg>
                                        </a>

                                        <button type="button"
                                                @@click="$store.app.addToCart(dish, 1, [])"
                                                class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-[11px] font-bold px-3 py-1.5 rounded-full flex items-center gap-1.5 transition-colors cursor-pointer">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#shopping-bag"></use></svg>
                                            <span x-text="$store.app.language === 'ar' ? 'إضافة للسلة' : 'Add to Cart'">Add to Cart</span>
                                        </button>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </template>
                </div>

                <!-- Chef Credentials Box -->
                <div class="bg-amber-500/5 border border-amber-500/20 rounded-2xl p-4 space-y-2 text-xs">
                    <div class="flex items-center gap-2 font-bold text-[var(--color-text)]">
                        <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chef-hat"></use></svg>
                        <span x-text="$store.app.language === 'ar' ? 'معايير مطبخ هوم شيف' : 'HomeChef Kitchen Standard'">HomeChef Kitchen Standard</span>
                    </div>
                    <p class="text-[11px] text-[var(--color-text-muted)] leading-relaxed"
                       x-text="$store.app.language === 'ar' ? 'جميع الأطباق المقترحة من قبل الذكاء الاصطناعي تطهى بواسطة طهاة منزليين مرخصين ومفتشين صحياً، وتعتمد حصراً على لحوم بلدية وسمن طبيعي بدون أية منكهات صناعية.' : 'All dishes suggested by our culinary AI are prepared by vetted, food-safety inspected domestic home chefs using fresh natural ingredients and zero artificial preservatives.'">
                    </p>
                </div>

            </div>

        </div>

    </div>
</div>

