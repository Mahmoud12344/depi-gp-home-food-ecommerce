    clearAll() {
        if (this.timerId) clearInterval(this.timerId);
        if (this.intervalId) clearInterval(this.intervalId);
    },
    handlePresetClick(preset) {
        this.activePresetId = preset.id;
        const text = $store.app.language === 'ar' ? preset.promptAr : preset.promptEn;
        this.inputValue = text;
        this.executePrompt(text, this.thinkEnabled, preset);
    },
    executePrompt(userPrompt, useThinking, presetObj) {
        this.clearAll();
        this.currentPrompt = userPrompt;
        this.answer = '';
        this.elapsedSeconds = 0;
        this.recommendedDishes = [];

        const preset = presetObj || this.presets.find(p => p.id === this.activePresetId) || this.presets[0];
        const stepTexts = $store.app.language === 'ar' ? preset.stepsAr : preset.stepsEn;
        const targetAnswer = $store.app.language === 'ar' ? preset.answerAr : preset.answerEn;
        const dishes = this.allDishes.filter(d => preset.matchedDishIds.includes(d.id));

        if (useThinking) {
            this.status = 'thinking';
            this.steps = [];

            this.timerId = setInterval(() => {
                this.elapsedSeconds += 1;
            }, 950);

            stepTexts.forEach((text, idx) => {
                setTimeout(() => {
                    this.steps = this.steps.map(s => ({ ...s, status: 'complete' }));
                    this.steps.push({ id: `step-${idx}`, text, status: 'active' });
                }, (idx + 1) * 600);
            });

            setTimeout(() => {
                if (this.timerId) clearInterval(this.timerId);
                this.steps = this.steps.map(s => ({ ...s, status: 'complete' }));
                this.status = 'answering';
                this.recommendedDishes = dishes;

                let charIndex = 0;
                this.intervalId = setInterval(() => {
                    charIndex += 4;
                    this.answer = targetAnswer.slice(0, charIndex);
                    if (charIndex >= targetAnswer.length) {
                        clearInterval(this.intervalId);
                        this.status = 'done';
                    }
                }, 20);
            }, (stepTexts.length + 1) * 600);
        } else {
            this.status = 'answering';
            this.steps = [];
            this.recommendedDishes = dishes;

            let charIndex = 0;
            this.intervalId = setInterval(() => {
                charIndex += 5;
                this.answer = targetAnswer.slice(0, charIndex);
                if (charIndex >= targetAnswer.length) {
                    clearInterval(this.intervalId);
                    this.status = 'done';
                }
            }, 18);
        }
    },
    handleFormSubmit() {
        if (!this.inputValue.trim()) return;
        this.executePrompt(this.inputValue.trim(), this.thinkEnabled);
    },
    resetChat() {
        this.clearAll();
        this.status = 'idle';
        this.answer = '';
        this.recommendedDishes = [];
        this.activePresetId = null;
        this.inputValue = '';
    }
