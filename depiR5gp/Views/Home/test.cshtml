@model System.Collections.Generic.List<depiR5gp.Models.TestModel>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<table class="table table-striped table-bordered">
    <thead>
    <th>Id</th>
    <th>Name</th>
    </thead>
    <tbody>
    @foreach (var t in Model){
        <tr>
            <td>@t.Id</td>
            <td>@t.Name</td>
        </tr>
    }
    </tbody>
</table>
