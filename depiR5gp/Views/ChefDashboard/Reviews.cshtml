@model depiR5gp.ViewModels.ChefReviewsTabVM
@using System.Globalization
@{
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
    ViewData["Title"] = "Customer Reviews - Chef Portal";
    ViewData["ActiveChefTab"] = "reviews";
    var inv = CultureInfo.InvariantCulture;
}

<div class="w-full space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-[var(--color-border)]">
        <div>
            <h1 class="text-2xl font-semibold text-[var(--color-text)] tracking-tight">Customer Reviews</h1>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">
                Verified feedback left by customers on your completed kitchen orders.
            </p>
        </div>
        <span class="text-[11px] font-bold px-3 py-1.5 rounded-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text-muted)] w-fit">
            Read-Only (Platform Policy)
        </span>
    </div>

    <div class="bg-[var(--color-surface-subtle)] border border-[var(--color-border)] p-4 rounded-2xl flex items-center justify-between text-xs">
        <div>
            <h3 class="font-bold uppercase text-[var(--color-text)]">
                Verified Kitchen Customer Feedback
            </h3>
            <p class="text-[11px] text-[var(--color-text-muted)] mt-0.5">
                @if (Model.TotalReviewsCount > 0)
                {
                    <span>Rating average: <strong class="text-[var(--color-primary)]">@Model.AverageRating.ToString("0.0", inv) / 5.0</strong> from @Model.TotalReviewsCount @(Model.TotalReviewsCount == 1 ? "review" : "reviews").</span>
                }
                else
                {
                    <span>No published reviews yet.</span>
                }
            </p>
        </div>
    </div>

    @if (Model.Reviews.Count == 0)
    {
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-10 text-center text-xs text-[var(--color-text-muted)]">
            Customer reviews will appear here as soon as customers rate your completed orders.
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var review in Model.Reviews)
            {
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs space-y-2 text-xs">
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-bold text-[var(--color-text)]">@review.CustomerName</span>
                            <span class="text-[var(--color-text-muted)]">·</span>
                            <span class="text-[11px] text-[var(--color-primary)] font-semibold">@review.DishSummary</span>
                        </div>
                        <span class="text-[11px] text-[var(--color-text-muted)]">
                            @review.CreatedAt.ToString("yyyy-MM-dd", inv)
                        </span>
                    </div>

                    <div class="flex items-center gap-1">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <svg class="w-3.5 h-3.5 fill-current @(i <= review.Rating ? "text-amber-500" : "text-neutral-300 dark:text-neutral-700")" viewBox="0 0 24 24">
                                <use href="#star"></use>
                            </svg>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                    {
                        <p class="text-[var(--color-text)] leading-relaxed italic">“@review.Comment”</p>
                    }
                </div>
            }
        </div>
    }
</div>
