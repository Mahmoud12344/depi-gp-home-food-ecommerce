@using depiR5gp.ViewModels
@{
    var activeTab = ViewData["ActiveChefTab"] as string ?? "orders";
    var header = ViewData["ChefHeader"] as ChefPortalHeaderVM ?? new ChefPortalHeaderVM
    {
        KitchenName = "My Home Kitchen",
        AreaName = "Cairo",
        IsAcceptingOrders = true,
        Status = "Approved"
    };
}

<!-- Breadcrumb banner -->
<div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
            <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                <span>Home</span>
            </a>
            <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
            <span class="text-[var(--color-text)] font-semibold">Chef Portal</span>
        </nav>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-2.5 flex-wrap">
                    <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                        Kitchen Management Hub
                    </h1>
                    @if (header.Status == "Approved")
                    {
                        <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200 border border-emerald-200 dark:border-emerald-800 text-[10px] font-bold uppercase">
                            Verified
                        </span>
                    }
                    else if (header.Status == "Pending")
                    {
                        <span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-200 border border-amber-200 dark:border-amber-800 text-[10px] font-bold uppercase">
                            Pending Review
                        </span>
                    }
                    else if (header.Status == "Rejected")
                    {
                        <span class="px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-200 border border-rose-200 dark:border-rose-800 text-[10px] font-bold uppercase">
                            Rejected
                        </span>
                    }
                </div>
                <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 leading-relaxed">
                    @header.KitchenName@(!string.IsNullOrWhiteSpace(header.AreaName) ? $" · {header.AreaName}" : "")
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <!-- Edit Profile Action (SCRUM-27 / SCRUM-30) -->
                <a href="/Chefs/EditProfile"
                   class="px-4 py-2 bg-[var(--color-card-bg)] hover:bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-xs font-semibold rounded-full text-[var(--color-text)] flex items-center gap-2 transition-colors cursor-pointer shadow-2xs">
                    <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#edit-3"></use></svg>
                    <span>Edit Kitchen Profile</span>
                </a>

                <!-- Kitchen Availability Switch (SCRUM-66) -->
                <div x-data="{
                        open: @(header.IsAcceptingOrders ? "true" : "false"),
                        busy: false,
                        async toggle() {
                            if (this.busy) return;
                            this.busy = true;
                            try {
                                const token = this.$refs.tokenWrap.querySelector('input[name=__RequestVerificationToken]')?.value || '';
                                const res = await fetch('/ChefDashboard/ToggleAvailability', {
                                    method: 'POST',
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest',
                                        'RequestVerificationToken': token
                                    }
                                });
                                if (!res.ok) throw new Error('Request failed');
                                const data = await res.json();
                                if (data.success) {
                                    this.open = !!data.isAcceptingOrders;
                                    window.dispatchEvent(new CustomEvent('hc-toast', {
                                        detail: { type: this.open ? 'success' : 'info', message: data.message }
                                    }));
                                }
                            } catch (e) {
                                window.dispatchEvent(new CustomEvent('hc-toast', {
                                    detail: { type: 'error', message: 'Could not update kitchen availability. Please try again.' }
                                }));
                            } finally {
                                this.busy = false;
                            }
                        }
                    }"
                     class="flex items-center gap-3 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-full px-4 py-2 shadow-2xs">
                    <span x-ref="tokenWrap" class="hidden">@Html.AntiForgeryToken()</span>
                    <span class="text-xs font-bold uppercase"
                          :class="open ? 'text-emerald-600' : 'text-rose-600'"
                          x-text="open ? 'Kitchen Open' : 'Kitchen Paused'">
                        @(header.IsAcceptingOrders ? "Kitchen Open" : "Kitchen Paused")
                    </span>
                    <button type="button"
                            @@click="toggle()"
                            :disabled="busy"
                            aria-label="Toggle kitchen order availability"
                            class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors cursor-pointer disabled:opacity-60"
                            :class="open ? 'bg-emerald-500' : 'bg-neutral-300 dark:bg-neutral-700'">
                        <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-xs"
                              :class="open ? 'translate-x-6' : 'translate-x-1'"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
    <!-- 4 Metric Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1">Pending Acceptance</span>
            <span class="text-2xl sm:text-3xl font-bold text-amber-600">@header.PendingOrdersCount</span>
        </div>
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1">In Preparation</span>
            <span class="text-2xl sm:text-3xl font-bold text-purple-600">@header.PreparingOrdersCount</span>
        </div>
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1">Ready for Pickup</span>
            <span class="text-2xl sm:text-3xl font-bold text-teal-600">@header.ReadyOrdersCount</span>
        </div>
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1">Net Wallet Earnings</span>
            <span class="text-2xl sm:text-3xl font-bold text-[var(--color-primary)]">@header.NetWalletEarnings.ToString("N2") EGP</span>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-[var(--color-border)] gap-3 sm:gap-6 overflow-x-auto pb-1">
        <a href="/ChefDashboard"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "overview" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Overview</span>
        </a>
        <a href="/ChefDashboard/Orders"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "orders" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Live Kitchen Orders</span> (<span>@header.ActiveOrdersCount</span>)
        </a>
        <a href="/MenuManagement"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "menu" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Menu &amp; Dishes</span> (<span>@header.DishesCount</span>)
        </a>
        <a href="/ChefDashboard/History"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "history" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Order History</span>
        </a>
        <a href="/ChefDashboard/Reviews"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "reviews" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Customer Reviews</span> (<span>@header.ReviewsCount</span>)
        </a>
        <a href="/ChefDashboard/Wallet"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "wallet" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Wallet &amp; Ledger</span>
        </a>
        <a href="/Chefs/EditProfile"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "profile" || activeTab == "hours" || activeTab == "documents" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Kitchen Profile</span>
        </a>
        <a href="/Dashboard"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "status" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Application Status</span>
        </a>
    </div>
</div>
