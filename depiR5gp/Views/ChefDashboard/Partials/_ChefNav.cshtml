@{
    var activeTab = ViewData["ActiveChefTab"] as string ?? "orders";
}
<!-- Views/ChefDashboard/Partials/_ChefNav.cshtml -->
<!-- Source: home_chef/src/pages/ChefDashboardPage.tsx (Views/Chefs/Partials/_ChefDashboard.cshtml) -->
<!-- Backlog Epics: SCRUM-22 Chef Profile, SCRUM-31 Menu Management, SCRUM-32 Chef Orders & Dashboard -->
<!-- TODO(backend): Bind authorized chef profile model (KitchenName, PickupArea, IsKitchenAvailable) and metric counts -->

<!-- Breadcrumb banner -->
<div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
            <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                <span>Home</span>
            </a>
            <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
            <span class="text-[var(--color-text)] font-semibold">Chef Portal</span>
        </nav>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">
                    Kitchen Management Hub
                </h1>
                <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 leading-relaxed">
                    Amina's Heritage Kitchen · Maadi, Cairo
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <!-- Edit Profile Action (SCRUM-30) -->
                <button type="button" @@click="editProfileOpen = true"
                        class="px-4 py-2 bg-[var(--color-card-bg)] hover:bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-xs font-semibold rounded-full text-[var(--color-text)] flex items-center gap-2 transition-colors cursor-pointer shadow-2xs">
                    <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#edit-3"></use></svg>
                    <span>Edit Profile &amp; Schedule</span>
                </button>

                <!-- Kitchen Availability Switch (SCRUM-66) -->
                <!-- TODO(backend): POST /ChefDashboard/ToggleAvailability to persist kitchen open/paused status -->
                <div class="flex items-center gap-3 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-full px-4 py-2 shadow-2xs">
                    <span class="text-xs font-bold uppercase"
                          :class="isKitchenAvailable ? 'text-emerald-600' : 'text-rose-600'"
                          x-text="isKitchenAvailable ? 'Kitchen Open' : 'Kitchen Paused'">
                        Kitchen Open
                    </span>
                    <button type="button"
                            @@click="isKitchenAvailable = !isKitchenAvailable; window.dispatchEvent(new CustomEvent('hc-toast', { detail: { type: 'info', message: isKitchenAvailable ? 'Kitchen is now taking orders.' : 'Kitchen orders paused.' } }));"
                            class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors cursor-pointer"
                            :class="isKitchenAvailable ? 'bg-emerald-500' : 'bg-neutral-300 dark:bg-neutral-700'">
                        <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform shadow-xs"
                              :class="isKitchenAvailable ? 'translate-x-6' : 'translate-x-1'"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8">
    <!-- 4 Metric Cards -->
    <!-- TODO(backend): Bind metric counts (Pending, Preparing, Ready, Net Wallet Earnings) from Chef repository/service -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1">Pending Acceptance</span>
            <span class="text-2xl sm:text-3xl font-bold text-amber-600">1</span>
        </div>
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1">In Preparation</span>
            <span class="text-2xl sm:text-3xl font-bold text-purple-600">1</span>
        </div>
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1">Ready for Pickup</span>
            <span class="text-2xl sm:text-3xl font-bold text-teal-600">0</span>
        </div>
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block mb-1">Net Wallet Earnings</span>
            <span class="text-2xl sm:text-3xl font-bold text-[var(--color-primary)]">4,820.00 EGP</span>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-[var(--color-border)] gap-3 sm:gap-6 overflow-x-auto pb-1">
        <a href="/ChefDashboard"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "overview" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Overview</span>
        </a>
        <a href="/ChefDashboard/Orders"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "orders" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Live Kitchen Orders</span> (<span>2</span>)
        </a>
        <a href="/MenuManagement"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "menu" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Menu &amp; Dishes</span> (<span>3</span>)
        </a>
        <a href="/ChefDashboard/History"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "history" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Order History</span>
        </a>
        <a href="/ChefDashboard/Reviews"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "reviews" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Customer Reviews</span> (<span>3</span>)
        </a>
        <a href="/ChefDashboard/Wallet"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "wallet" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Wallet &amp; Ledger</span>
        </a>
        <a href="/ChefDashboard/Profile"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "profile" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Kitchen Profile</span>
        </a>
        <a href="/ChefDashboard/WorkingHours"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "hours" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Working Hours</span>
        </a>
        <a href="/ChefDashboard/Documents"
           class="pb-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors border-b-2 whitespace-nowrap cursor-pointer @(activeTab == "documents" ? "border-[var(--color-primary)] text-[var(--color-primary)]" : "border-transparent text-[var(--color-text-muted)] hover:text-[var(--color-text)]")">
            <span>Documents</span>
        </a>
    </div>
</div>

<!-- Edit Chef Profile Modal Partial (SCRUM-30) -->
<div x-cloak
     x-show="editProfileOpen"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

    <div @@click.away="editProfileOpen = false"
         class="relative w-full max-w-2xl bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-2xl max-h-[90vh] overflow-y-auto">

        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)] mb-6">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chef-hat"></use></svg>
                </div>
                <div>
                    <h3 class="text-base sm:text-lg font-bold uppercase tracking-wide text-[var(--color-text)]">
                        Edit Chef &amp; Kitchen Profile
                    </h3>
                    <p class="text-[11px] text-[var(--color-text-muted)]">
                        Update kitchen bio, operating schedule, and pickup counter location
                    </p>
                </div>
            </div>
            <button type="button" @@click="editProfileOpen = false" class="p-1 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
            </button>
        </div>

        <!-- Edit Form -->
        <!-- TODO(backend): POST /ChefDashboard/Profile with ChefProfileEditModel, validate authorized chef claim, save bio and schedule -->
        <form method="post" action="/ChefDashboard/Profile" class="space-y-6 text-xs">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">Kitchen Name (English)</label>
                    <input type="text" name="KitchenName" required value="Amina's Heritage Kitchen"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">Kitchen Name (Arabic)</label>
                    <input type="text" name="KitchenNameAr" required value="مطبخ أمينة التراثي"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
            </div>

            <!-- Bio -->
            <div class="space-y-4">
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">Chef Bio &amp; Culinary Heritage (English)</label>
                    <textarea rows="3" name="Bio" required
                              class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden leading-relaxed">Cooking traditional Egyptian baladi recipes inherited from my grandmother in Upper Egypt, using 100% pure baladi ghee and farm-fresh poultry.</textarea>
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">Chef Bio (Arabic)</label>
                    <textarea rows="3" name="BioAr" required
                              class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden leading-relaxed">أطبخ أشهى الأكلات والوصفات المصرية التراثية المتوارثة عن جدتي من صعيد مصر، بالسمن البلدي الفلاحي والطيور الطازجة يومياً.</textarea>
                </div>
            </div>

            <!-- Photo URL & Pickup Area -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">Pickup Neighborhood Area (Public)</label>
                    <select name="PickupArea"
                            class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden">
                        <option value="Maadi" selected>Maadi (المعادي)</option>
                        <option value="Zamalek">Zamalek (الزمالك)</option>
                        <option value="New Cairo">New Cairo (القاهرة الجديدة)</option>
                        <option value="Nasr City">Nasr City (مدينة نصر)</option>
                        <option value="Heliopolis">Heliopolis (مصر الجديدة)</option>
                        <option value="Dokki">Dokki (الدقي)</option>
                        <option value="Mohandessin">Mohandessin (المهندسين)</option>
                        <option value="6th of October">6th of October (السادس من أكتوبر)</option>
                    </select>
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">Profile Photo URL</label>
                    <input type="url" name="AvatarUrl" required value="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=300&auto=format&fit=crop&q=80"
                           class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                </div>
            </div>

            <!-- Exact Pickup Street Address -->
            <div>
                <label class="block font-semibold mb-1 text-[var(--color-text)]">
                    Exact Pickup Counter Address (Disclosed to customer after order confirmation)
                </label>
                <input type="text" name="Address" required value="Bldg 14, Road 9, Degla, Maadi, Cairo (Ground Floor Gate)"
                       class="w-full p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] border border-[var(--color-border)] rounded-xl font-medium focus:border-[var(--color-primary)] focus:outline-hidden" />
                <p class="text-[11px] text-[var(--color-text-muted)] mt-1">
                    Home kitchen privacy guard: Only neighborhood area is public before ordering.
                </p>
            </div>

            <!-- Operating Working Hours Schedule -->
            <div class="space-y-3 pt-2 border-t border-[var(--color-border-light)]">
                <h4 class="font-bold uppercase tracking-wider text-[var(--color-text)] flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#clock"></use></svg>
                    <span>Kitchen Operating Hours Schedule</span>
                </h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                    <div class="p-3 bg-[var(--color-surface-subtle)] rounded-xl border border-[var(--color-border-light)] space-y-1">
                        <span class="font-bold text-[var(--color-text)]">Working Days:</span>
                        <div class="flex items-center gap-2 pt-1">
                            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-100 text-[11px] font-bold">Tuesday – Sunday</span>
                            <span class="text-[10px] text-neutral-400 font-medium">(Mondays Closed)</span>
                        </div>
                    </div>
                    <div class="p-3 bg-[var(--color-surface-subtle)] rounded-xl border border-[var(--color-border-light)] space-y-1">
                        <span class="font-bold text-[var(--color-text)]">Daily Pickup Hours:</span>
                        <div class="flex items-center gap-2 pt-1 font-bold text-[var(--color-primary)]">
                            <span>12:00 PM – 10:30 PM (Cairo Time)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--color-border)]">
                <button type="button" @@click="editProfileOpen = false"
                        class="px-5 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                    <span>Cancel</span>
                </button>
                <button type="submit"
                        class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                    <span>Save Profile Changes</span>
                </button>
            </div>
        </form>
    </div>
</div>
