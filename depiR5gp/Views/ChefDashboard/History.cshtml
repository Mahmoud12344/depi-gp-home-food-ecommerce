@model depiR5gp.ViewModels.ChefOrderHistoryVM
@using System.Globalization
@{
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
    ViewData["Title"] = "Order History - Chef Portal";
    ViewData["ActiveChefTab"] = "history";
    var inv = CultureInfo.InvariantCulture;

    string StatusBadgeClass(string status) => status switch
    {
        "Completed" => "bg-emerald-100 text-emerald-900 border-emerald-300 dark:bg-emerald-950 dark:text-emerald-100",
        "Rejected" => "bg-rose-100 text-rose-900 border-rose-300 dark:bg-rose-950 dark:text-rose-100",
        _ => "bg-neutral-100 text-neutral-800 border-neutral-300 dark:bg-neutral-800 dark:text-neutral-200"
    };
}

<div class="w-full space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-[var(--color-border)]">
        <div>
            <h1 class="text-2xl font-semibold text-[var(--color-text)] tracking-tight">Order History</h1>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">
                Historical record of completed, cancelled, and rejected orders for your kitchen.
            </p>
        </div>

        <form method="get" action="/ChefDashboard/History" class="flex items-center gap-2">
            <select name="status"
                    onchange="this.form.submit()"
                    class="px-3.5 py-2 bg-[var(--color-card-bg)] text-[var(--color-text)] border border-[var(--color-border)] rounded-xl text-xs font-semibold cursor-pointer">
                <option value="all" selected="@(Model.SelectedStatus == "all")">All Historical Statuses</option>
                <option value="Completed" selected="@(Model.SelectedStatus == "Completed")">Completed Only</option>
                <option value="Cancelled" selected="@(Model.SelectedStatus == "Cancelled")">Cancelled Only</option>
                <option value="Rejected" selected="@(Model.SelectedStatus == "Rejected")">Rejected Only</option>
            </select>
        </form>
    </div>

    @if (Model.Orders.Count == 0)
    {
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-10 text-center text-xs text-[var(--color-text-muted)]">
            No historical orders found for the selected filter.
        </div>
    }
    else
    {
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-xs">
            <div class="divide-y divide-[var(--color-border-light)] text-xs">
                @foreach (var o in Model.Orders)
                {
                    <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="space-y-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="font-bold text-sm text-[var(--color-primary)]">#@o.Reference</span>
                                <span class="@StatusBadgeClass(o.Status) text-[10px] px-2 py-0.5 rounded-full font-bold border">
                                    @o.Status
                                </span>
                            </div>
                            <h5 class="font-semibold text-xs text-[var(--color-text)]">@o.DishSummary</h5>
                            <p class="text-[11px] text-[var(--color-text-muted)]">
                                Customer: @o.CustomerName · Date: @o.CreatedAt.ToString("yyyy-MM-dd HH:mm", inv)
                            </p>
                            @if (!string.IsNullOrWhiteSpace(o.CancellationReason))
                            {
                                <p class="text-[11px] text-rose-600 dark:text-rose-400">
                                    Reason: @o.CancellationReason
                                </p>
                            }
                        </div>
                        <div class="text-end shrink-0">
                            <span class="font-bold text-sm text-[var(--color-text)] block">
                                @o.GrossTotal.ToString("N2", inv) EGP
                            </span>
                            @if (o.Status == "Completed")
                            {
                                <span class="text-[10px] text-emerald-600 font-semibold">
                                    Net: @o.NetEarnings.ToString("N2", inv) EGP
                                </span>
                            }
                            else
                            {
                                <span class="text-[10px] text-[var(--color-text-muted)] font-medium">
                                    No payout
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
