@model depiR5gp.ViewModels.ChefLiveOrdersVM
@using System.Globalization
@{
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
    ViewData["Title"] = "Live Kitchen Orders - Chef Portal";
    ViewData["ActiveChefTab"] = "orders";
    var inv = CultureInfo.InvariantCulture;

    string StatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-amber-100 text-amber-900 border-amber-300 dark:bg-amber-950 dark:text-amber-100",
        "Preparing" => "bg-purple-100 text-purple-900 border-purple-300 dark:bg-purple-950 dark:text-purple-100",
        "Ready" => "bg-teal-100 text-teal-900 border-teal-300 dark:bg-teal-950 dark:text-teal-100",
        _ => "bg-neutral-100 text-neutral-800 border-neutral-300 dark:bg-neutral-800 dark:text-neutral-200"
    };
}

<div x-data="{
    rejectOrderModalOpen: false,
    rejectingOrderId: 0,
    rejectingOrderNumber: '',
    rejectingCustomerName: '',
    rejectionReason: 'capacity',
    rejectionNote: '',
    openRejectModal(id, refNo, customer) {
        this.rejectingOrderId = id;
        this.rejectingOrderNumber = refNo;
        this.rejectingCustomerName = customer;
        this.rejectionReason = 'capacity';
        this.rejectionNote = '';
        this.rejectOrderModalOpen = true;
    }
}" class="w-full space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-[var(--color-border)]">
        <div>
            <h1 class="text-2xl font-semibold text-[var(--color-text)] tracking-tight">Live Kitchen Orders</h1>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">
                Accept incoming orders, update cooking progress, and mark meals ready for pickup.
            </p>
        </div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-xs font-semibold text-[var(--color-text)] w-fit">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>@Model.Orders.Count active @(Model.Orders.Count == 1 ? "order" : "orders")</span>
        </div>
    </div>

    @if (Model.Orders.Count == 0)
    {
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-10 text-center space-y-3 shadow-2xs">
            <div class="w-12 h-12 mx-auto rounded-full bg-[var(--color-surface-subtle)] text-[var(--color-primary)] flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#shopping-bag"></use></svg>
            </div>
            <h3 class="text-base font-semibold text-[var(--color-text)]">No Live Orders in Queue</h3>
            <p class="text-xs text-[var(--color-text-muted)] max-w-md mx-auto">
                Incoming customer orders requiring preparation or pickup will appear here automatically.
            </p>
            <div class="pt-1">
                <a href="/ChefDashboard/History" class="text-xs font-semibold text-[var(--color-primary)] hover:underline">
                    View Completed Order History &rarr;
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var order in Model.Orders)
            {
                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-6 shadow-xs flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
                    <div class="space-y-2.5 flex-1 min-w-0">
                        <div class="flex items-center gap-3 flex-wrap">
                            <span class="font-bold text-sm text-[var(--color-primary)]">#@order.Reference</span>
                            <span class="@StatusBadgeClass(order.Status) text-xs px-2.5 py-0.5 rounded-full font-bold border">
                                @order.Status
                            </span>
                            <span class="text-xs text-[var(--color-text-muted)]">
                                Placed @order.CreatedAt.ToString("MMM dd, HH:mm", inv) UTC
                            </span>
                        </div>

                        @if (order.Items.Count > 0)
                        {
                            <div class="space-y-1.5">
                                @foreach (var item in order.Items)
                                {
                                    <div>
                                        <h4 class="font-bold text-sm text-[var(--color-text)]">
                                            @item.DishName <span class="text-[var(--color-primary)]">(x@item.Quantity)</span>
                                        </h4>
                                        @if (item.OptionLabels.Count > 0)
                                        {
                                            <p class="text-xs text-[var(--color-text-muted)]">
                                                Options: @string.Join(" · ", item.OptionLabels)
                                            </p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Note))
                                        {
                                            <p class="mt-1 text-xs bg-[var(--color-surface-subtle)] p-2 rounded-xl border border-[var(--color-border-light)] text-[var(--color-text-muted)]">
                                                <strong>Instructions:</strong> <span>@item.Note</span>
                                            </p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <h4 class="font-bold text-sm text-[var(--color-text)]">Order #@order.Reference</h4>
                        }

                        <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--color-text-muted)] pt-1">
                            <span><strong class="text-[var(--color-text)]">Customer:</strong> @order.CustomerName</span>
                            <span>·</span>
                            <span><strong class="text-[var(--color-text)]">Payment:</strong> @order.PaymentMethod</span>
                            <span>·</span>
                            <span class="font-bold text-[var(--color-primary)]">@order.Total.ToString("N2", inv) EGP</span>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2 w-full lg:w-auto shrink-0">
                        @if (order.Status == "Pending")
                        {
                            <button type="button"
                                    data-ref="@order.Reference"
                                    data-customer="@order.CustomerName"
                                    @@click="openRejectModal(@order.OrderId, $el.dataset.ref, $el.dataset.customer)"
                                    class="px-4 py-2.5 border border-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-rose-700 dark:text-rose-300 text-xs font-bold uppercase rounded-full transition-colors cursor-pointer">
                                Reject Order
                            </button>

                            <form asp-controller="ChefDashboard" asp-action="UpdateOrderStatus" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <input type="hidden" name="nextStatus" value="Preparing" />
                                <button type="submit"
                                        class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase px-4 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                                    Accept &amp; Start Cooking
                                </button>
                            </form>
                        }
                        else if (order.Status == "Preparing")
                        {
                            <form asp-controller="ChefDashboard" asp-action="UpdateOrderStatus" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <input type="hidden" name="nextStatus" value="Ready" />
                                <button type="submit"
                                        class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold uppercase px-4 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                                    Mark Ready for Pickup
                                </button>
                            </form>
                        }
                        else if (order.Status == "Ready")
                        {
                            <form asp-controller="ChefDashboard" asp-action="UpdateOrderStatus" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <input type="hidden" name="nextStatus" value="Completed" />
                                <button type="submit"
                                        class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase px-4 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                                    Mark Completed
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Reject Order Modal Dialog -->
    <div x-cloak
         x-show="rejectOrderModalOpen"
         style="display: none;"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

        <div @@click.away="rejectOrderModalOpen = false"
             class="relative w-full max-w-lg bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-7 shadow-2xl space-y-5">

            <div class="flex items-center gap-3 pb-3 border-b border-[var(--color-border-light)]">
                <div class="w-10 h-10 rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x-circle"></use></svg>
                </div>
                <div>
                    <h3 class="text-base font-bold uppercase tracking-tight text-[var(--color-text)]">
                        Reject Order Request
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]"
                       x-text="`Order #${rejectingOrderNumber} · ${rejectingCustomerName}`"></p>
                </div>
            </div>

            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
                Select a reason to notify the customer immediately:
            </p>

            <form asp-controller="ChefDashboard" asp-action="RejectOrder" method="post" class="space-y-4 text-xs">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" :value="rejectingOrderId" />

                <div class="space-y-2.5">
                    <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] cursor-pointer">
                        <input type="radio" name="rejectReason" value="capacity" x-model="rejectionReason" class="accent-[var(--color-primary)]" checked />
                        <span class="text-[var(--color-text)] font-medium">Kitchen at maximum capacity for this time slot</span>
                    </label>
                    <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] cursor-pointer">
                        <input type="radio" name="rejectReason" value="ingredients" x-model="rejectionReason" class="accent-[var(--color-primary)]" />
                        <span class="text-[var(--color-text)] font-medium">Fresh ingredients out of stock for today</span>
                    </label>
                    <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] cursor-pointer">
                        <input type="radio" name="rejectReason" value="early_close" x-model="rejectionReason" class="accent-[var(--color-primary)]" />
                        <span class="text-[var(--color-text)] font-medium">Kitchen counter closed early today</span>
                    </label>
                    <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] cursor-pointer">
                        <input type="radio" name="rejectReason" value="instructions" x-model="rejectionReason" class="accent-[var(--color-primary)]" />
                        <span class="text-[var(--color-text)] font-medium">Special customer instructions cannot be accommodated</span>
                    </label>
                </div>

                <div>
                    <label class="block font-semibold mb-1 text-[var(--color-text)]">Optional Customer Courtesy Note</label>
                    <textarea rows="2" name="rejectionNote" x-model="rejectionNote" placeholder="e.g. Apologies, our fresh ingredients were fully reserved for tonight..."
                              class="w-full p-2.5 bg-white dark:bg-neutral-900 border border-[var(--color-border)] rounded-xl text-xs text-[var(--color-text)] focus:border-[var(--color-primary)] focus:outline-hidden"></textarea>
                </div>

                <div class="flex items-center justify-end gap-3 pt-3 border-t border-[var(--color-border)]">
                    <button type="button" @@click="rejectOrderModalOpen = false"
                            class="px-5 py-2 rounded-full border border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text-muted)] text-xs font-semibold uppercase tracking-wider transition-colors cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit"
                            class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold uppercase tracking-wider px-6 py-2 rounded-full transition-all shadow-xs cursor-pointer">
                        Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
