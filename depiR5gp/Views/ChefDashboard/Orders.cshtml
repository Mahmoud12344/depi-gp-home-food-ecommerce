@*
    TODO [Backend]: Strongly-typed view binding for Chef Live Kitchen Orders & Order History
    1. Uncomment the model directive once ChefDashboardController.Orders() passes the ChefProfile or Order list:
       @model depiR5gp.Models.Chefs.ChefProfile
    2. In [HttpGet] ChefDashboardController.Orders(string? status):
       Load active orders (Pending, Preparing, Ready) and historical orders (Completed, Cancelled, Rejected)
       including Order.User and Order.Items.
    3. In [HttpPost] ChefDashboardController.Orders(int OrderId, string NextStatus):
       Update Order.Status, append OrderStatusHistory { OrderId, Status = NextStatus, ChangedAt = DateTime.UtcNow },
       call await unitOfWork.CompleteAsync(), and RedirectToAction(nameof(Orders)).
*@
@{
    ViewData["Title"] = "Chef Portal - Live Kitchen Orders & Queue";
}

<partial name="~/Views/ChefDashboard/Partials/_ChefNav.cshtml" />

<main x-data="{
          rejectOrderModalOpen: false,
          rejectingOrder: { id: 102, orderNumber: 'HC-2026-9042', customerName: 'Nour El-Din' },
          addDishModalOpen: false,
          editDishModalOpen: false,
          deleteDishConfirmOpen: false,
          editingDish: { id: 1, name: 'Baladi Duck Molokhia with Vermicelli Rice', nameAr: 'ملوخية بالبط البلدي مع أرز بالشعرية', category: 'Traditional Egyptian', price: 240, isAvailable: true },
          deletingDish: { id: 1, name: 'Baladi Duck Molokhia with Vermicelli Rice' },
          dishForm: {
              isAvailable: true,
              optionGroups: [
                  {
                      title: 'Rice Choice',
                      type: 'radio',
                      required: true,
                      options: [
                          { name: 'Vermicelli Rice (أرز بالشعرية)', extraPrice: 0 },
                          { name: 'Egyptian White Rice (أرز مصري مفلفل)', extraPrice: 0 }
                      ]
                  }
              ]
          },
          addOptionGroup() {
              this.dishForm.optionGroups.push({ title: '', type: 'radio', required: false, options: [{ name: '', extraPrice: 0 }] });
          },
          removeOptionGroup(idx) {
              this.dishForm.optionGroups.splice(idx, 1);
          },
          addOptionItem(gIdx) {
              this.dishForm.optionGroups[gIdx].options.push({ name: '', extraPrice: 0 });
          },
          removeOptionItem(gIdx, oIdx) {
              this.dishForm.optionGroups[gIdx].options.splice(oIdx, 1);
          }
      }"
