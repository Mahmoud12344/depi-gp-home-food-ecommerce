@{
    ViewData["Title"] = "Chef Portal - Documents & Verification";
}

<partial name="~/Views/ChefDashboard/Partials/_ChefNav.cshtml" />

<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8"
      x-data="{
          uploadedDocs: [
              { name: 'National ID (Front & Back)', type: 'Identity', status: 'Approved', date: '2026-10-15', verified: true },
              { name: 'Government Health Certificate (شهادة صحية)', type: 'Hygiene', status: 'Approved', date: '2026-10-18', verified: true },
              { name: 'Kitchen Sanitation Inspection Proof', type: 'Inspection', status: 'Pending Review', date: '2026-10-24', verified: false }
          ],
          uploadNew() {
              $store.app.showToast('info', 'Document upload dialog simulated.');
          }
      }">

    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)] flex-wrap gap-4">
            <div>
                <h2 class="text-lg font-bold text-[var(--color-text)] uppercase tracking-wide">
                    Hygiene &amp; Identity Credentials
                </h2>
                <p class="text-xs text-[var(--color-text-muted)]">
                    Verified documents required by platform policy for domestic food safety standards.
                </p>
            </div>
            <button type="button" @@click="uploadNew()"
                    class="px-5 py-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase tracking-wider rounded-full shadow-2xs transition-colors cursor-pointer">
                + Upload New Certificate
            </button>
        </div>

        <div class="space-y-3 text-xs">
            <template x-for="doc in uploadedDocs" :key="doc.name">
                <div class="p-4 bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check-circle-2"></use></svg>
                        </div>
                        <div>
                            <p class="font-bold text-[var(--color-text)] text-sm" x-text="doc.name"></p>
                            <p class="text-[11px] text-[var(--color-text-muted)]" x-text="'Category: ' + doc.type + ' · Submitted: ' + doc.date"></p>
                        </div>
                    </div>
                    <span :class="doc.verified ? 'bg-emerald-500/10 text-emerald-600 border border-emerald-500/20' : 'bg-amber-500/10 text-amber-600 border border-amber-500/20'"
                          class="px-3 py-1 rounded-full font-bold text-[11px]"
                          x-text="doc.status"></span>
                </div>
            </template>
        </div>
    </div>
</main>
