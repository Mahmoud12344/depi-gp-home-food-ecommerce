@model depiR5gp.ViewModels.ChefWalletVM
@using System.Globalization
@{
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
    ViewData["Title"] = "Wallet & Payout Ledger - Chef Portal";
    ViewData["ActiveChefTab"] = "wallet";
    var inv = CultureInfo.InvariantCulture;
}

<div class="w-full space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-[var(--color-border)]">
        <div>
            <h1 class="text-2xl font-semibold text-[var(--color-text)] tracking-tight">Wallet &amp; Payouts</h1>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">
                Monitor your net kitchen earnings, platform commission deductions, and payout transfers.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block">Available Balance</span>
            <strong class="text-2xl text-[var(--color-primary)] block mt-1">@Model.AvailableBalance.ToString("N2", inv) EGP</strong>
            <span class="text-[11px] text-emerald-600 font-semibold mt-1 block">Ready for InstaPay Payout</span>
        </div>

        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block">
                Commission Deducted (@Model.EffectiveCommissionPercent.ToString("0.#", inv)%)
            </span>
            <strong class="text-2xl text-[var(--color-text)] block mt-1">@Model.CurrentMonthCommission.ToString("N2", inv) EGP</strong>
            <span class="text-[11px] text-[var(--color-text-muted)] mt-1 block">Current month platform operations</span>
        </div>

        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-5 shadow-xs">
            <span class="text-xs text-[var(--color-text-muted)] font-semibold uppercase block">Total Payouts Requested</span>
            <strong class="text-2xl text-[var(--color-text)] block mt-1">@Model.TotalDisbursed.ToString("N2", inv) EGP</strong>
            <span class="text-[11px] text-[var(--color-text-muted)] mt-1 block">Cumulative withdrawals</span>
        </div>
    </div>

    <!-- Instant Payout Trigger -->
    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
            <h4 class="font-bold uppercase text-[var(--color-text)] text-sm">Request Balance Payout</h4>
            <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
                Submit a payout transfer request for your current available balance (@Model.AvailableBalance.ToString("N2", inv) EGP).
            </p>
        </div>
        <form asp-controller="ChefDashboard" asp-action="RequestPayout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit"
                    disabled="@(Model.AvailableBalance <= 0m)"
                    class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] disabled:opacity-50 disabled:cursor-not-allowed text-white text-xs font-bold uppercase px-6 py-2.5 rounded-full transition-all shadow-xs cursor-pointer">
                <span>Transfer Balance Now</span>
            </button>
        </form>
    </div>

    <!-- Financial Transaction Ledger Table -->
    <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-6 shadow-xs space-y-4">
        <h4 class="font-bold uppercase text-[var(--color-text)] text-sm">
            Financial Transaction Ledger
        </h4>

        @if (Model.LedgerRows.Count == 0)
        {
            <p class="text-xs text-[var(--color-text-muted)] py-6 text-center">
                No completed order credits or payouts recorded yet.
            </p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-start">
                    <thead>
                        <tr class="border-b border-[var(--color-border)] text-[var(--color-text-muted)] font-bold uppercase text-[10px]">
                            <th class="pb-3 text-start">Date &amp; Time</th>
                            <th class="pb-3 text-start">Reference #</th>
                            <th class="pb-3 text-start">Type</th>
                            <th class="pb-3 text-end">Gross (EGP)</th>
                            <th class="pb-3 text-end">Commission</th>
                            <th class="pb-3 text-end">Net (EGP)</th>
                            <th class="pb-3 text-end">Balance</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[var(--color-border-light)] font-medium">
                        @foreach (var row in Model.LedgerRows)
                        {
                            var isPositive = row.NetDelta >= 0m;
                            <tr class="hover:bg-[var(--color-surface-subtle)] transition-colors">
                                <td class="py-3 text-[var(--color-text-muted)]">@row.OccurredAt.ToString("yyyy-MM-dd HH:mm", inv)</td>
                                <td class="py-3 font-bold text-[var(--color-primary)]">@row.Reference</td>
                                <td class="py-3 text-[var(--color-text)]">@row.TypeLabel</td>
                                <td class="py-3 text-end">
                                    @(row.GrossAmount.HasValue ? row.GrossAmount.Value.ToString("N2", inv) : "—")
                                </td>
                                <td class="py-3 text-end text-neutral-400">
                                    @(row.CommissionAmount.HasValue ? $"-{row.CommissionAmount.Value.ToString("N2", inv)}" : "—")
                                </td>
                                <td class="py-3 text-end font-bold @(isPositive ? "text-emerald-600" : "text-rose-600")">
                                    @(isPositive ? "+" : "")@row.NetDelta.ToString("N2", inv)
                                </td>
                                <td class="py-3 text-end font-bold text-[var(--color-text)]">
                                    @row.RunningBalance.ToString("N2", inv) EGP
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
