@using depiR5gp.ViewModels
@{
    Layout = "~/Views/Shared/_ChefLayout.cshtml";
    ViewData["Title"] = "Chef Dashboard";
    ViewData["ActiveChefTab"] = "overview";

    var header = ViewData["ChefHeader"] as ChefPortalHeaderVM ?? new ChefPortalHeaderVM
    {
        KitchenName = "My Home Kitchen"
    };
}

<div class="w-full space-y-8">
    <!-- Clean Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-[var(--color-text)] tracking-tight">Dashboard</h1>
            <p class="text-sm text-[var(--color-text-muted)] mt-1">
                Overview of @header.KitchenName orders, menu, and earnings.
            </p>
        </div>
        <a href="/MenuManagement/Create"
           class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-sm font-medium transition-colors w-fit">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#plus"></use></svg>
            <span>Add New Dish</span>
        </a>
    </div>

    <!-- 4 Live Metric Cards (Shown only on Dashboard Overview) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-xl p-5">
            <span class="text-xs font-medium text-[var(--color-text-muted)] block">Pending Acceptance</span>
            <span class="text-2xl font-semibold text-[var(--color-text)] mt-1.5 block">@header.PendingOrdersCount</span>
        </div>
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-xl p-5">
            <span class="text-xs font-medium text-[var(--color-text-muted)] block">In Preparation</span>
            <span class="text-2xl font-semibold text-[var(--color-text)] mt-1.5 block">@header.PreparingOrdersCount</span>
        </div>
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-xl p-5">
            <span class="text-xs font-medium text-[var(--color-text-muted)] block">Ready for Pickup</span>
            <span class="text-2xl font-semibold text-[var(--color-text)] mt-1.5 block">@header.ReadyOrdersCount</span>
        </div>
        <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-xl p-5">
            <span class="text-xs font-medium text-[var(--color-text-muted)] block">Net Earnings</span>
            <span class="text-2xl font-semibold text-[var(--color-primary)] mt-1.5 block">@header.NetWalletEarnings.ToString("N2") EGP</span>
        </div>
    </div>

    <!-- Quick Shortcuts -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <a href="/MenuManagement"
           class="bg-[var(--color-card-bg)] border border-[var(--color-border)] hover:border-[var(--color-primary)] rounded-2xl p-6 transition-colors flex items-center justify-between gap-4">
            <div>
                <h2 class="text-base font-semibold text-[var(--color-text)]">Menu &amp; Dishes (@header.DishesCount)</h2>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">Manage dishes, prices, availability, and options.</p>
            </div>
            <svg class="w-5 h-5 text-[var(--color-text-muted)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#arrow-right"></use></svg>
        </a>

        <a href="/Chefs/EditProfile?tab=hours"
           class="bg-[var(--color-card-bg)] border border-[var(--color-border)] hover:border-[var(--color-primary)] rounded-2xl p-6 transition-colors flex items-center justify-between gap-4">
            <div>
                <h2 class="text-base font-semibold text-[var(--color-text)]">Kitchen Profile &amp; Hours</h2>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">Update details, working hours, and documents.</p>
            </div>
            <svg class="w-5 h-5 text-[var(--color-text-muted)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#arrow-right"></use></svg>
        </a>

        <a href="/ChefDashboard/Orders"
           class="bg-[var(--color-card-bg)] border border-[var(--color-border)] hover:border-[var(--color-primary)] rounded-2xl p-6 transition-colors flex items-center justify-between gap-4">
            <div>
                <h2 class="text-base font-semibold text-[var(--color-text)]">Live Orders (@header.ActiveOrdersCount)</h2>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">Accept, prepare, and complete incoming orders.</p>
            </div>
            <svg class="w-5 h-5 text-[var(--color-text-muted)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#arrow-right"></use></svg>
        </a>
    </div>
</div>
