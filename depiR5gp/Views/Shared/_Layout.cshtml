<!DOCTYPE html>
@{
    var noScroll = ViewData["NoScroll"] as bool? == true || ViewData["HideFooter"] as bool? == true;
}
<html lang="en" data-theme="light" dir="ltr" class="scroll-smooth @(noScroll ? "h-full overflow-hidden" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeChef Marketplace</title>
    
    <!-- Zero-Flicker Hydration Script: Applies theme & dir before first paint -->
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('hc_theme') || 'light';
                var lang = localStorage.getItem('hc_lang') || 'en';
                document.documentElement.setAttribute('data-theme', theme);
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
                document.documentElement.lang = lang;
                document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
            } catch (e) {}
        })();
    </script>

    <!-- Google Fonts: Jost (English/Latin) and Tajawal (Arabic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,600;0,700;1,400&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />

    <!-- Pure Tailwind CSS v4 -->
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="bg-[var(--color-bg)] text-[var(--color-text)] antialiased transition-colors duration-200 min-h-screen flex flex-col font-sans @(noScroll ? "h-screen overflow-hidden" : "")"
      x-data>
    
    <!-- Inline SVG Lucide Sprite (100% Reliable, Zero-Latency, Zero-CORS) -->
    @await Html.PartialAsync("~/Views/Shared/Icons/_Sprite.cshtml")
    
    <!-- Header -->
    @await Html.PartialAsync("~/Views/Shared/Partials/_Header.cshtml")

    <!-- Main Content Area -->
    <main role="main" class="flex-1 @(noScroll ? "min-h-0 overflow-hidden flex flex-col" : "")">
        @RenderBody()
    </main>

    <!-- Footer -->
    @if (ViewData["HideFooter"] as bool? != true)
    {
        @await Html.PartialAsync("~/Views/Shared/Partials/_Footer.cshtml")
    }

    <!-- Global Modals, Drawers & Overlays -->
    @await Html.PartialAsync("~/Views/Shared/Partials/_FilterDrawer.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_OptionsDialog.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_CartConflictDialog.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_QuickViewModal.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_ToastContainer.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_ChatModal.cshtml")
    @if (ViewData["HideAIAssistant"] as bool? != true)
    {
        @await Html.PartialAsync("~/Views/Shared/Partials/_AIAssistantWidget.cshtml")
    }

    <!-- Local Vanilla JS Interactive Modules -->
    <script src="/js/components/circular3DGallery.js"></script>
    <script src="/js/components/verticalImageStack.js"></script>
    <script src="/js/components/thinkingPromptInput.js"></script>

    <!-- Local Alpine.js Core (100% CDN-free) -->
    <script defer src="/lib/alpine/alpine.min.js"></script>

    <!-- Bootstrap & jQuery preserved as-is -->
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
