<!DOCTYPE html>
<html lang="en" data-theme="light" dir="ltr" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeChef Marketplace</title>
    
    <!-- Zero-Flicker Hydration Script: Applies theme & dir before first paint -->
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('hc_theme') || 'light';
                var lang = localStorage.getItem('hc_lang') || 'en';
                document.documentElement.setAttribute('data-theme', theme);
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
                document.documentElement.lang = lang;
                document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
            } catch (e) {}
        })();
    </script>

    <!-- Google Fonts: Jost (English/Latin) and Tajawal (Arabic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />

    <!-- Pure Tailwind CSS v4 with Cache Busting -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-[var(--color-bg)] text-[var(--color-text)] antialiased transition-colors duration-200 min-h-screen flex flex-col font-sans"
      x-data>
    
    <!-- Inline SVG Lucide Sprite (100% Reliable, Zero-Latency, Zero-CORS) -->
    <partial name="~/Views/Shared/Icons/_Sprite.cshtml" />
    
    <!-- Header -->
    <partial name="Partials/_Header" />

    <!-- Main Content Area -->
    <main role="main" class="flex-1">

        <!-- TempData Notification Banners (تنبيهات ثابتة لا تختفي إلا بضغط زر الإغلاق) -->
        <div class="container mx-auto px-4 pt-4">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center justify-content-between p-3 mb-4 text-red-800 bg-red-100 rounded-3 border border-red-200 shadow-sm" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <strong class="font-medium">@TempData["ErrorMessage"]</strong>
                    </div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center justify-content-between p-3 mb-4 text-green-800 bg-green-100 rounded-3 border border-green-200 shadow-sm" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <strong class="font-medium">@TempData["SuccessMessage"]</strong>
                    </div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- Footer -->
    <partial name="Partials/_Footer" />

    <!-- Global Modals, Drawers & Overlays -->
    <partial name="Partials/_FilterDrawer" />
    <partial name="Partials/_OptionsDialog" />
    <partial name="Partials/_CartConflictDialog" />
    <partial name="Partials/_LoginModal" />
    <partial name="Partials/_ForgotPasswordModal" />
    <partial name="~/Views/Support/Partials/_ContactSupportModal.cshtml" />
    <partial name="Partials/_QuickViewModal" />
    <partial name="Partials/_ToastContainer" />
    <partial name="Partials/_ChatModal" />
    <partial name="Partials/_AIAssistantWidget" />
    <partial name="Partials/_PrototypeBar" />

    <!-- Local Vanilla JS Interactive Modules -->
    <script src="~/js/components/circular3DGallery.js" asp-append-version="true"></script>
    <script src="~/js/components/verticalImageStack.js" asp-append-version="true"></script>
    <script src="~/js/components/thinkingPromptInput.js" asp-append-version="true"></script>

    <!-- Local Alpine Store (Hash routing & global state) -->
    <script src="~/js/store.js" asp-append-version="true"></script>

    <!-- Local Alpine.js Core (100% CDN-free) -->
    <script defer src="~/lib/alpine/alpine.min.js"></script>

    <!-- Bootstrap & jQuery preserved as-is -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
