<!DOCTYPE html>
@{
    var noScroll = ViewData["NoScroll"] as bool? == true || ViewData["HideFooter"] as bool? == true;
}
<html lang="en" data-theme="light" dir="ltr" class="scroll-smooth @(noScroll ? "h-full overflow-hidden" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeChef Marketplace</title>
    
    <!-- Zero-Flicker Hydration Script: Applies theme & dir before first paint -->
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('hc_theme') || 'light';
                var lang = localStorage.getItem('hc_lang') || 'en';
                document.documentElement.setAttribute('data-theme', theme);
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
                document.documentElement.lang = lang;
                document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
            } catch (e) {}
        })();
    </script>

    <!-- Google Fonts: Jost (English/Latin) and Tajawal (Arabic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,600;0,700;1,400&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />

    <!-- Pure Tailwind CSS v4 -->
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="bg-[var(--color-bg)] text-[var(--color-text)] antialiased transition-colors duration-200 min-h-screen flex flex-col font-sans @(noScroll ? "h-screen overflow-hidden" : "")"
      x-data>
    
    <!-- Global Anti-Forgery Token for AJAX requests -->
    <form id="__AjaxGlobalAntiForgeryForm" class="hidden" style="display: none;">
        @Html.AntiForgeryToken()
    </form>

    <!-- Inline SVG Lucide Sprite (100% Reliable, Zero-Latency, Zero-CORS) -->
    @await Html.PartialAsync("~/Views/Shared/Icons/_Sprite.cshtml")
    
    <!-- Header -->
    @if (ViewData["HideHeader"] as bool? != true)
    {
        @await Html.PartialAsync("~/Views/Shared/Partials/_Header.cshtml")
    }

    <!-- Main Content Area -->
    <main role="main" class="flex-1 @(noScroll ? "min-h-0 overflow-hidden flex flex-col" : "")">

        <!-- TempData Notification Banners -->
        @if (TempData["ErrorMessage"] != null || TempData["SuccessMessage"] != null || TempData["InfoMessage"] != null)
        {
            <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 space-y-3">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div x-data="{ show: true }" x-show="show" class="flex items-center justify-between gap-3 p-3.5 text-sm text-rose-800 dark:text-rose-200 bg-rose-50 dark:bg-rose-950/60 rounded-xl border border-rose-200 dark:border-rose-800 shadow-xs" role="alert">
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#alert-circle"></use></svg>
                            <strong class="font-medium">@TempData["ErrorMessage"]</strong>
                        </div>
                        <button type="button" @@click="show = false" class="p-1 text-rose-600 hover:opacity-75 cursor-pointer" aria-label="Close">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                        </button>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div x-data="{ show: true }" x-show="show" data-success-notification class="flex items-center justify-between gap-3 p-3.5 text-sm text-emerald-800 dark:text-emerald-200 bg-emerald-50 dark:bg-emerald-950/60 rounded-xl border border-emerald-200 dark:border-emerald-800 shadow-xs transition-opacity duration-300" role="alert">
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check-circle-2"></use></svg>
                            <strong class="font-medium">@TempData["SuccessMessage"]</strong>
                        </div>
                        <button type="button" @@click="show = false" class="p-1 text-emerald-600 hover:opacity-75 cursor-pointer" aria-label="Close">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                        </button>
                    </div>
                }

                @if (TempData["InfoMessage"] != null)
                {
                    <div x-data="{ show: true }" x-show="show" data-success-notification class="flex items-center justify-between gap-3 p-3.5 text-sm text-blue-800 dark:text-blue-200 bg-blue-50 dark:bg-blue-950/60 rounded-xl border border-blue-200 dark:border-blue-800 shadow-xs transition-opacity duration-300" role="alert">
                        <div class="flex items-center gap-2.5">
                            <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#info"></use></svg>
                            <strong class="font-medium">@TempData["InfoMessage"]</strong>
                        </div>
                        <button type="button" @@click="show = false" class="p-1 text-blue-600 hover:opacity-75 cursor-pointer" aria-label="Close">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
                        </button>
                    </div>
                }
            </div>
        }
        @RenderBody()
    </main>

    <!-- Footer -->
    @if (ViewData["HideFooter"] as bool? != true)
    {
        @await Html.PartialAsync("~/Views/Shared/Partials/_Footer.cshtml")
    }

    <!-- Global Modals, Drawers & Overlays -->
    @await Html.PartialAsync("~/Views/Shared/Partials/_OptionsDialog.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_CartConflictDialog.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_QuickViewModal.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_ToastContainer.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_ChatModal.cshtml")
    @if (ViewData["HideAIAssistant"] as bool? != true)
    {
        @await Html.PartialAsync("~/Views/Shared/Partials/_AIAssistantWidget.cshtml")
    }

    <!-- Local Vanilla JS Interactive Modules -->
    <script src="/js/components/circular3DGallery.js"></script>
    <script src="/js/components/verticalImageStack.js"></script>
    <script src="/js/components/thinkingPromptInput.js"></script>

    <!-- Local Alpine.js Core (100% CDN-free) -->
    <script defer src="/lib/alpine/alpine.min.js"></script>

    <!-- Bootstrap & jQuery preserved as-is -->
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>

    <script>
        document.querySelectorAll('[data-success-notification]').forEach(notification => {
            window.setTimeout(() => {
                notification.classList.add('opacity-0');
                window.setTimeout(() => notification.remove(), 300);
            }, 5000);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
