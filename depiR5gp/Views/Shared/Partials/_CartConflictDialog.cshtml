<!-- Views/Shared/Partials/_CartConflictDialog.cshtml -->
<!-- Source: home_chef/src/components/common/CartConflictDialog.tsx -->
<!-- TODO [Backend]: Validate single-chef cart business rule in CartService/Session; handle conflict resolution endpoint (keep existing vs replace items) if cart is stored server-side -->

<div x-cloak
     x-show="$store.app.cartConflictPending"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

    <div class="relative w-full max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-sm p-6 shadow-2xl"
         @@click.away="$store.app.resolveCartConflict('keep_current')">

        <!-- Warning Icon -->
        <div class="w-12 h-12 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <use href="#alert-triangle"></use>
            </svg>
        </div>

        <h3 class="text-center text-lg font-bold uppercase tracking-tight text-[var(--color-text)] mb-2"
            x-text="$store.app.language === 'ar' ? 'طلب من مطبخ جديد' : 'Order From One Kitchen Only'">
            Order From One Kitchen Only
        </h3>

        <div class="bg-[var(--color-surface-subtle)] p-3 rounded-xs border border-[var(--color-border-light)] text-xs text-[var(--color-text-muted)] space-y-2 mb-4 leading-relaxed">
            <p x-text="$store.app.language === 'ar'
                ? `سلتك الحالية تحتوي على وجبات من (${$store.app.cart.chefName || 'المطبخ الحالي'}). وحسب شروط المنصة، يتم استلام وتحضير الطلب من مطبخ منزلي واحد في كل مرة.`
                : `Your current cart has dishes from ${$store.app.cart.chefName || 'Current Chef'}. Platform policy requires separate carts for each home kitchen to coordinate pickup and preparation.`">
                Your current cart has dishes from another kitchen. Platform policy requires separate carts for each home kitchen.
            </p>
            <div class="flex items-center gap-2 text-xs font-semibold text-[var(--color-primary)]">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#chef-hat"></use>
                </svg>
                <span x-text="$store.app.language === 'ar'
                    ? `الطلب الجديد: ${$store.app.cartConflictPending?.dish?.kitchenNameAr || $store.app.cartConflictPending?.dish?.kitchenName || 'مطبخ جديد'}`
                    : `Incoming order: ${$store.app.cartConflictPending?.dish?.kitchenName || 'New Kitchen'}`">
                    Incoming order: New Kitchen
                </span>
            </div>
        </div>

        <p class="text-xs text-[var(--color-text)] font-medium text-center mb-6"
           x-text="$store.app.language === 'ar'
               ? 'هل ترغب في بدء سلة جديدة وحذف الأطباق السابقة، أم الاحتفاظ بسلتك الحالية؟'
               : 'Would you like to start a new cart and clear previous items, or keep your current cart?'">
            Would you like to start a new cart and clear previous items, or keep your current cart?
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3">
            <button type="button"
                    @@click="$store.app.resolveCartConflict('keep_current')"
                    class="flex-1 inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50 disabled:cursor-not-allowed select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-transparent border-2 border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white focus-visible:outline-[var(--color-primary)]">
                <span x-text="$store.app.language === 'ar' ? 'الاحتفاظ بالسلة الحالية' : 'Keep Current Cart'">Keep Current Cart</span>
            </button>

            <button type="button"
                    @@click="$store.app.resolveCartConflict('start_new')"
                    class="flex-1 inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50 disabled:cursor-not-allowed select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] active:scale-[0.98] focus-visible:outline-[var(--color-primary)] hover:shadow-lg hover:shadow-[var(--color-primary)]/20">
                <span x-text="$store.app.language === 'ar' ? 'بدء سلة جديدة' : 'Start New Cart'">Start New Cart</span>
            </button>
        </div>
    </div>
</div>

