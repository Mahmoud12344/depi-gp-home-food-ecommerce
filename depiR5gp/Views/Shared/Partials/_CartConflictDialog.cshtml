<!-- Views/Shared/Partials/_CartConflictDialog.cshtml -->
<!-- Source: home_chef/src/components/common/CartConflictDialog.tsx -->
<!-- TODO(backend): Validate single-chef cart business rule in CartService/Session; handle conflict resolution endpoint (keep existing vs replace items) if cart is stored server-side -->

<div x-cloak
     x-data="{ open: false, incomingKitchen: 'New Kitchen', incomingDishId: 1 }"
     @@open-cart-conflict.window="if ($event.detail) { incomingKitchen = $event.detail.kitchenName || 'New Kitchen'; incomingDishId = $event.detail.dishId || 1; } open = true"
     x-show="open"
     style="display: none;"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

    <div class="relative w-full max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-sm p-6 shadow-2xl"
         @@click.away="open = false">

        <!-- Warning Icon -->
        <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-700 dark:text-amber-300 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <use href="#alert-triangle"></use>
            </svg>
        </div>

        <h3 class="text-center text-lg font-bold uppercase tracking-tight text-[var(--color-text)] mb-2">
            Order From One Kitchen Only
        </h3>

        <div class="bg-[var(--color-surface-subtle)] p-3 rounded-xs border border-[var(--color-border-light)] text-xs text-[var(--color-text-muted)] space-y-2 mb-4 leading-relaxed">
            <p>
                Your current cart has dishes from Amina's Heritage Kitchen. Platform policy requires separate carts for each home kitchen to coordinate pickup and preparation.
            </p>
            <div class="flex items-center gap-2 text-xs font-semibold text-[var(--color-primary)]">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#chef-hat"></use>
                </svg>
                <span>Incoming order: <span x-text="incomingKitchen">New Kitchen</span></span>
            </div>
        </div>

        <p class="text-xs text-[var(--color-text)] font-medium text-center mb-6">
            Would you like to start a new cart and clear previous items, or keep your current cart?
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3">
            <button type="button"
                    @@click="open = false"
                    class="flex-1 inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-transparent border-2 border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white">
                <span>Keep Current Cart</span>
            </button>

            <!-- TODO(backend): POST to /Cart/ReplaceAndAdd -->
            <form method="post" action="/Cart/Add" class="flex-1">
                @Html.AntiForgeryToken()
                <input type="hidden" name="dishId" :value="incomingDishId" />
                <input type="hidden" name="replaceExistingCart" value="true" />
                <button type="submit"
                        class="w-full inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)]">
                    <span>Start New Cart</span>
                </button>
            </form>
        </div>
    </div>
</div>
