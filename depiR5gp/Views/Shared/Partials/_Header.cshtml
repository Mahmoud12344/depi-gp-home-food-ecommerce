@*
  Header Component Partial
  Source: home_chef/src/components/layout/Header.tsx
*@
@{
    var currentPath = Context.Request.Path.Value ?? "/";
}
<header class="sticky top-0 z-30 w-full bg-[var(--color-surface)] shadow-xs transition-colors"
        x-data="{ mobileMenuOpen: false, searchOpen: false, notificationsOpen: false, userDropdownOpen: false }">

    <!-- 1. Marquee Announcement Bar: Dark text on coral with min 13px font size -->
    <div class="w-full bg-[#ff7e6b] text-[#1f1b19] text-[13px] py-2 overflow-hidden border-b border-black/10 select-none font-medium">
        <div class="animate-marquee flex items-center gap-8 whitespace-nowrap tracking-wide">
            <span>Order authentic home-cooked food from certified domestic kitchens</span>
            <span class="opacity-60">✦</span>
            <span>Direct kitchen counter pickup · NO delivery markups</span>
            <span class="opacity-60">✦</span>
            <span>Join our foodie club &amp; enjoy up to 20% off your first kitchen pickup</span>
            <span class="opacity-60">✦</span>
            <span>100% pure Egyptian baladi ghee &amp; freshly butchered meats</span>
            <span class="opacity-60">✦</span>
            <span>Order authentic home-cooked food from certified domestic kitchens</span>
            <span class="opacity-60">✦</span>
            <span>Direct kitchen counter pickup · NO delivery markups</span>
        </div>
    </div>

    <!-- 2. Main Header Bar: 1fr auto 1fr Grid for perfectly centered logo -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="h-18 sm:h-20 grid grid-cols-[1fr_auto_1fr] items-center gap-4">
            <!-- Left Column (1fr) -->
            <div class="flex items-center justify-start gap-4 min-w-0">
                <!-- Mobile hamburger button -->
                <div class="flex items-center lg:hidden">
                    <button type="button"
                            @@click="mobileMenuOpen = !mobileMenuOpen"
                            class="p-2 text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors cursor-pointer"
                            aria-label="Open mobile menu">
                        <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#menu"></use></svg>
                        <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display: none;"><use href="#x"></use></svg>
                    </button>
                </div>

                <!-- Left: Desktop Navigation Links -->
                <nav class="hidden lg:flex items-center gap-5 xl:gap-7">
                    <a href="/"
                       class="@(currentPath == "/" ? "text-[var(--color-primary)]" : "text-[var(--color-text)] hover:text-[var(--color-primary)]") relative text-[13px] font-bold uppercase tracking-wider transition-colors py-2 cursor-pointer flex items-center gap-1.5 whitespace-nowrap shrink-0">
                        <span>HOME</span>
                        @if (currentPath == "/")
                        {
                            <span class="absolute bottom-0 inset-x-0 h-0.5 bg-[var(--color-primary)]"></span>
                        }
                    </a>

                    <a href="/Dishes"
                       class="@(currentPath.StartsWith("/Dishes", StringComparison.OrdinalIgnoreCase) ? "text-[var(--color-primary)]" : "text-[var(--color-text)] hover:text-[var(--color-primary)]") relative text-[13px] font-bold uppercase tracking-wider transition-colors py-2 cursor-pointer flex items-center gap-1.5 whitespace-nowrap shrink-0">
                        <span>DISHES</span>
                        <span class="bg-[var(--color-sale)] text-white text-[11px] font-bold px-1.5 py-0.5 rounded-xs leading-none">SALE</span>
                        @if (currentPath.StartsWith("/Dishes", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="absolute bottom-0 inset-x-0 h-0.5 bg-[var(--color-primary)]"></span>
                        }
                    </a>

                    <a href="/Chefs"
                       class="@(currentPath.StartsWith("/Chefs", StringComparison.OrdinalIgnoreCase) ? "text-[var(--color-primary)]" : "text-[var(--color-text)] hover:text-[var(--color-primary)]") relative text-[13px] font-bold uppercase tracking-wider transition-colors py-2 cursor-pointer flex items-center gap-1.5 whitespace-nowrap shrink-0">
                        <span>CHEFS</span>
                        @if (currentPath.StartsWith("/Chefs", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="absolute bottom-0 inset-x-0 h-0.5 bg-[var(--color-primary)]"></span>
                        }
                    </a>

                    <a href="/AIAssistant"
                       class="@(currentPath.StartsWith("/AIAssistant", StringComparison.OrdinalIgnoreCase) ? "text-[var(--color-primary)]" : "text-[var(--color-text)] hover:text-[var(--color-primary)]") relative text-[13px] font-bold uppercase tracking-wider transition-colors py-2 cursor-pointer flex items-center gap-1.5 whitespace-nowrap shrink-0">
                        <svg class="w-3.5 h-3.5 text-amber-500 animate-pulse shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#sparkles"></use></svg>
                        <span>AI ASSISTANT</span>
                        @if (currentPath.StartsWith("/AIAssistant", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="absolute bottom-0 inset-x-0 h-0.5 bg-[var(--color-primary)]"></span>
                        }
                    </a>
                </nav>
            </div>

            <!-- Center Column (auto): Truly Centered Brand Logo -->
            <div class="flex items-center justify-center shrink-0">
                <a href="/" class="group flex items-center gap-2.5 text-start cursor-pointer">
                    <div class="w-10 h-10 rounded-full border-2 border-[var(--color-primary)] flex items-center justify-center text-[var(--color-primary)] group-hover:bg-[var(--color-primary)] group-hover:text-white transition-colors">
                        <svg class="w-6 h-6 stroke-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chef-hat"></use></svg>
                    </div>
                    <div class="flex flex-col leading-tight">
                        <span class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--color-primary)] font-serif uppercase">
                            HomeChef
                        </span>
                        <span class="text-[13px] tracking-widest uppercase text-[var(--color-text-muted)] font-semibold">
                            Marketplace
                        </span>
                    </div>
                </a>
            </div>

            <!-- Right Column (1fr): Justified End -->
            <div class="flex items-center justify-end gap-2 sm:gap-3 min-w-0">
                <!-- Currency indicator -->
                <div class="hidden sm:flex items-center text-[13px] font-semibold text-[var(--color-text-muted)] gap-2 pe-1 border-e border-[var(--color-border)]">
                    <span class="text-[var(--color-text)]">EGP</span>
                </div>

                <!-- Global Theme Toggle (Main Application) -->
                <button type="button"
                        @@click="window.toggleTheme()"
                        title="Toggle Dark / Light Theme"
                        aria-label="Toggle Dark / Light Theme"
                        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-text)] hover:text-[var(--color-primary)] flex items-center justify-center transition-colors cursor-pointer shrink-0">
                    <svg class="w-4 h-4 text-neutral-600 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#moon"></use></svg>
                    <svg class="w-4 h-4 text-amber-400 hidden dark:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#sun"></use></svg>
                </button>

                <!-- Search Icon Button -->
                <button type="button"
                        @@click="searchOpen = !searchOpen"
                        title="Search dishes and chefs"
                        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-text)] hover:text-[var(--color-primary)] flex items-center justify-center transition-colors cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#search"></use></svg>
                </button>

                <!-- Chat Inbox Icon Button (SCRUM-299) -->
                <a href="/Chat"
                   title="Live Chat Inbox"
                   class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-text)] hover:text-[var(--color-primary)] flex items-center justify-center transition-colors cursor-pointer relative">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#message-circle"></use></svg>
                    <!-- TODO(backend): Bind unread messages count -->
                    <span class="absolute -top-1 -end-1 w-4.5 h-4.5 bg-emerald-600 text-white text-[11px] font-bold rounded-full flex items-center justify-center leading-none">
                        2
                    </span>
                </a>

                <!-- Notification Bell -->
                <div class="relative">
                    <button type="button"
                            @@click="notificationsOpen = !notificationsOpen"
                            title="Notifications"
                            class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-text)] hover:text-[var(--color-primary)] flex items-center justify-center transition-colors cursor-pointer relative">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#bell"></use></svg>
                        <!-- TODO(backend): Unread notifications count badge -->
                        <span class="absolute -top-1 -end-1 w-4.5 h-4.5 bg-[var(--color-primary)] text-white text-[13px] font-bold rounded-full flex items-center justify-center leading-none">
                            2
                        </span>
                    </button>

                    <!-- Notification dropdown -->
                    <div x-show="notificationsOpen"
                         @@click.outside="notificationsOpen = false"
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 scale-95"
                         x-transition:enter-end="opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-150"
                         x-transition:leave-start="opacity-100 scale-100"
                         x-transition:leave-end="opacity-0 scale-95"
                         style="display: none;"
                         class="absolute end-0 mt-2 w-72 sm:w-80 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl shadow-xl p-3 z-50">
                        <div class="flex items-center justify-between pb-2 mb-2 border-b border-[var(--color-border-light)] text-xs font-bold uppercase tracking-wider text-[var(--color-text)]">
                            <span>Notifications</span>
                            <span class="text-[10px] text-[var(--color-primary)] font-medium">
                                2 <span>unread</span>
                            </span>
                        </div>
                        <div class="space-y-2 max-h-60 overflow-y-auto">
                            <!-- TODO(backend): Loop through notifications model -->
                            <!-- BEGIN SAMPLE -->
                            <a href="/Orders/Track/1" class="block p-2 rounded-xl text-xs cursor-pointer transition-colors bg-[var(--color-primary-light)] font-medium">
                                <p class="font-semibold text-[var(--color-primary)]">
                                    Order #HC-2026-9041 Accepted!
                                </p>
                                <p class="text-[11px] text-[var(--color-text)] mt-0.5">
                                    Chef Amina accepted your Molokhia &amp; Duck order. Pickup in 45m.
                                </p>
                            </a>
                            <a href="/Dishes" class="block p-2 rounded-xl text-xs cursor-pointer transition-colors opacity-70 hover:bg-[var(--color-surface-subtle)]">
                                <p class="font-semibold text-[var(--color-primary)]">
                                    Weekend Baladi Roast Special
                                </p>
                                <p class="text-[11px] text-[var(--color-text)] mt-0.5">
                                    Chef Tarek published 3 new Egyptian clay tagines for Friday pickup.
                                </p>
                            </a>
                            <!-- END SAMPLE -->
                        </div>
                    </div>
                </div>

                <!-- Account Icon Button -->
                <!-- TODO(backend): Check User.Identity.IsAuthenticated; show login link for guests and profile dropdown for authenticated users -->
                <div class="relative">
                    <button type="button"
                            @@click="userDropdownOpen = !userDropdownOpen"
                            title="My Account"
                            class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-text)] hover:text-[var(--color-primary)] flex items-center justify-center transition-colors cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#user"></use></svg>
                    </button>

                    <!-- User Dropdown for logged in roles -->
                    <div x-show="userDropdownOpen"
                         @@click.outside="userDropdownOpen = false"
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 scale-95"
                         x-transition:enter-end="opacity-100 scale-100"
                         style="display: none;"
                         class="absolute end-0 mt-2 w-52 bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl shadow-xl p-2 z-50 text-xs">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var activeRole = User.IsInRole("Admin") ? "Admin"
                                           : User.IsInRole("Chef") ? "Chef"
                                           : User.IsInRole("Support") ? "Support"
                                           : "Customer";
                            <div class="p-2 border-b border-[var(--color-border-light)] mb-1">
                                <p class="font-bold text-[var(--color-text)] truncate">@User.Identity.Name</p>
                                <p class="text-[10px] text-[var(--color-primary)] font-semibold uppercase">@activeRole</p>
                            </div>

                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/Admin" @@click="userDropdownOpen = false"
                                   class="block w-full text-start px-2 py-1.5 hover:bg-[var(--color-surface-subtle)] rounded-xs font-semibold text-[var(--color-primary)]">
                                    <span>Admin Dashboard</span>
                                </a>
                            }
                            @if (User.IsInRole("Chef"))
                            {
                                <a href="/ChefDashboard" @@click="userDropdownOpen = false"
                                   class="block w-full text-start px-2 py-1.5 hover:bg-[var(--color-surface-subtle)] rounded-xs font-semibold text-[var(--color-primary)]">
                                    <span>Chef Dashboard</span>
                                </a>
                            }
                            @if (User.IsInRole("Support"))
                            {
                                <a href="/Support/AgentDesk" @@click="userDropdownOpen = false"
                                   class="block w-full text-start px-2 py-1.5 hover:bg-[var(--color-surface-subtle)] rounded-xs font-semibold text-[var(--color-primary)]">
                                    <span>Support Agent Desk</span>
                                </a>
                            }

                            <a href="/Customer/Profile" @@click="userDropdownOpen = false"
                               class="block w-full text-start px-2 py-1.5 hover:bg-[var(--color-surface-subtle)] rounded-xs">
                                <span>My Profile</span>
                            </a>
                            <a href="/Customer/MyOrders" @@click="userDropdownOpen = false"
                               class="block w-full text-start px-2 py-1.5 hover:bg-[var(--color-surface-subtle)] rounded-xs">
                                <span>Order History</span>
                            </a>
                            <a href="/Chat" @@click="userDropdownOpen = false"
                               class="block w-full text-start px-2 py-1.5 hover:bg-[var(--color-surface-subtle)] rounded-xs flex items-center justify-between">
                                <span>Chat Inbox</span>
                                <span class="px-1.5 py-0.5 rounded-full bg-emerald-600 text-white font-bold text-[10px]">2</span>
                            </a>
                            <a href="/Support" @@click="userDropdownOpen = false"
                               class="block w-full text-start px-2 py-1.5 hover:bg-[var(--color-surface-subtle)] rounded-xs">
                                <span>My Support Cases</span>
                            </a>
                            <a href="/Customer/Points" @@click="userDropdownOpen = false"
                               class="block w-full text-start px-2 py-1.5 hover:bg-[var(--color-surface-subtle)] rounded-xs">
                                <span>Loyalty Points</span>
                            </a>

                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit"
                                        class="w-full text-start px-2 py-1.5 text-rose-600 hover:bg-rose-50 rounded-xs flex items-center gap-1.5 mt-1 border-t border-[var(--color-border-light)] cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#log-out"></use></svg>
                                    <span>Sign Out</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" @@click="userDropdownOpen = false"
                               class="block w-full text-start px-2 py-1.5 hover:bg-[var(--color-surface-subtle)] rounded-xs font-semibold text-[var(--color-primary)]">
                                <span>Sign In</span>
                            </a>
                            <a asp-controller="Account" asp-action="Register" @@click="userDropdownOpen = false"
                               class="block w-full text-start px-2 py-1.5 hover:bg-[var(--color-surface-subtle)] rounded-xs">
                                <span>Create Account</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- Wishlist / Favorites Circular Button with Badge -->
                <a href="/Customer/Favorites"
                   title="Wishlist"
                   class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-text)] hover:text-[var(--color-primary)] flex items-center justify-center transition-colors cursor-pointer relative">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#heart"></use></svg>
                    <!-- TODO(backend): Bind favorites count -->
                    <span class="absolute -top-1 -end-1 w-4 h-4 bg-[var(--color-secondary-btn)] text-white text-[10px] font-bold rounded-full flex items-center justify-center">
                        2
                    </span>
                </a>

                <!-- Cart Circular Button with Badge -->
                <a href="/Cart"
                   title="Shopping Cart"
                   class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[var(--color-border)] hover:border-[var(--color-primary)] text-[var(--color-text)] hover:text-[var(--color-primary)] flex items-center justify-center transition-colors cursor-pointer relative">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#shopping-bag"></use></svg>
                    <!-- TODO(backend): Bind cart item count -->
                    <span class="absolute -top-1 -end-1 w-4 h-4 bg-[var(--color-primary)] text-white text-[10px] font-bold rounded-full flex items-center justify-center">
                        1
                    </span>
                </a>
            </div>
        </div>

        <!-- Search Bar Dropdown -->
        <!-- TODO(backend): Receive GET /Dishes?search=... in DishesController.Index -->
        <div x-show="searchOpen"
             x-transition
             style="display: none;"
             class="py-3 border-t border-[var(--color-border)]">
            <form method="get" action="/Dishes" class="flex items-center gap-2 max-w-xl mx-auto">
                @if (Context.Request.Path.StartsWithSegments("/Dishes"))
                {
                    foreach (var key in new[] { "category", "area", "minPrice", "maxPrice", "sort" })
                    {
                        var v = Context.Request.Query[key].ToString();
                        if (!string.IsNullOrEmpty(v))
                        {
                            <input type="hidden" name="@key" value="@v" />
                        }
                    }
                }
                <div class="relative flex-1">
                    <input type="text"
                           name="search"
                           placeholder="Search dishes, cuisine or chef name (e.g. Molokhia, Duck, Tagine)..."
                           class="w-full text-xs p-2.5 ps-10 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border-2 border-[var(--color-border)] rounded-full focus:border-[var(--color-primary)] focus:outline-hidden font-medium shadow-xs" />
                    <svg class="w-4 h-4 text-[var(--color-primary)] absolute start-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#search"></use></svg>
                </div>
                <button type="submit"
                        class="bg-[var(--color-primary)] text-white text-xs font-bold px-6 py-2.5 uppercase tracking-wider rounded-full cursor-pointer hover:bg-[var(--color-primary-hover)] transition-all shadow-xs">
                    Search
                </button>
            </form>
        </div>
    </div>

    <!-- Mobile Menu Drawer -->
    <div x-show="mobileMenuOpen"
         @@click.outside="mobileMenuOpen = false"
         x-transition
         style="display: none;"
         class="lg:hidden border-t border-[var(--color-border)] bg-[var(--color-card-bg)] px-4 py-4 space-y-3">
        <a href="/" @@click="mobileMenuOpen = false"
           class="flex items-center gap-2 w-full text-start py-2 text-xs font-bold uppercase tracking-wider text-[var(--color-text)] hover:text-[var(--color-primary)]">
            <span>HOME</span>
        </a>
        <a href="/Dishes" @@click="mobileMenuOpen = false"
           class="flex items-center gap-2 w-full text-start py-2 text-xs font-bold uppercase tracking-wider text-[var(--color-text)] hover:text-[var(--color-primary)]">
            <span>DISHES</span>
            <span class="bg-[var(--color-sale)] text-white text-[11px] font-bold px-1.5 py-0.5 rounded-xs leading-none">SALE</span>
        </a>
        <a href="/Chefs" @@click="mobileMenuOpen = false"
           class="flex items-center gap-2 w-full text-start py-2 text-xs font-bold uppercase tracking-wider text-[var(--color-text)] hover:text-[var(--color-primary)]">
            <span>CHEFS</span>
        </a>
        <a href="/AIAssistant" @@click="mobileMenuOpen = false"
           class="flex items-center gap-2 w-full text-start py-2 text-xs font-bold uppercase tracking-wider text-[var(--color-text)] hover:text-[var(--color-primary)]">
            <svg class="w-3.5 h-3.5 text-amber-500 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#sparkles"></use></svg>
            <span>AI ASSISTANT</span>
        </a>

        <!-- Mobile Theme Toggle -->
        <div class="pt-3 border-t border-[var(--color-border)] flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)]">Theme</span>
            <button type="button"
                    @@click="window.toggleTheme()"
                    class="px-3.5 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-subtle)] hover:border-[var(--color-primary)] text-[var(--color-text)] flex items-center gap-2 text-xs font-semibold transition-colors cursor-pointer">
                <svg class="w-4 h-4 text-neutral-600 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#moon"></use></svg>
                <svg class="w-4 h-4 text-amber-400 hidden dark:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#sun"></use></svg>
                <span class="dark:hidden">Dark Mode</span>
                <span class="hidden dark:inline">Light Mode</span>
            </button>
        </div>
    </div>
</header>
