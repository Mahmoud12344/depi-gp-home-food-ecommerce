@*
  CoverflowCarousel Component Partial
  Used in: Views/Home/Index.cshtml (Section 3: Fresh From Home Ovens)
  Provides an interactive 3D coverflow carousel with drag/touch support, keyboard navigation,
  and active dish captions with instant cart and favorite actions.
*@

<div x-data="{
    pos: 0,
    target: 0,
    selected: 0,
    count: 6,
    rotate: 44,
    depth: 0.6,
    perspective: 3,
    falloff: 0.56,
    fade: 0.12,
    gap: 0.08,
    loop: true,
    cardWidthPx: 250,
    raf: null,
    drag: null,

    init() {
        this.count = this.$refs.cards?.children?.length || 6;
        this.measure();
        window.addEventListener('resize', () => {
            this.measure();
            this.paint();
        });
        this.$nextTick(() => {
            this.measure();
            this.paint();
        });
    },

    measure() {
        const card = this.$refs.cards?.children?.[0];
        if (card) {
            this.cardWidthPx = card.offsetWidth || 250;
        }
    },

    paint() {
        const pitch = this.cardWidthPx * (1 + this.gap);
        const pos = this.pos;
        const cards = this.$refs.cards?.children;
        if (!cards) return;

        for (let index = 0; index < this.count; index++) {
            const card = cards[index];
            if (!card) continue;

            let offset = index - pos;
            if (this.loop) {
                offset = ((offset % this.count) + this.count) % this.count;
                if (offset > this.count / 2) offset -= this.count;
            }

            const distance = Math.abs(offset);
            const ramp = Math.pow(distance, this.falloff);
            const tilt = Math.min(this.rotate * ramp, 82) * Math.sign(offset);

            card.style.transform = `translateX(calc(-50% + ${offset * pitch}px)) translateZ(${-this.depth * this.cardWidthPx * ramp}px) rotateY(${-tilt}deg)`;

            const edge = this.loop ? Math.min(1, Math.max(0, this.count / 2 - distance)) : 1;
            card.style.opacity = String(Math.max(0, 1 - this.fade * distance) * edge);
            card.style.zIndex = String(100 - Math.round(distance));
        }
    },

    settle(target) {
        if (this.raf) cancelAnimationFrame(this.raf);
        this.target = target;
        this.selected = ((Math.round(target) % this.count) + this.count) % this.count;

        const step = () => {
            const remaining = this.target - this.pos;
            if (Math.abs(remaining) < 0.0004) {
                this.pos = this.target;
                this.paint();
                this.raf = null;
                return;
            }
            this.pos += remaining * 0.16;
            this.paint();
            this.raf = requestAnimationFrame(step);
        };
        this.raf = requestAnimationFrame(step);
    },

    clamp(pos) {
        return this.loop ? pos : Math.max(0, Math.min(this.count - 1, pos));
    },

    goTo(index) {
        const target = this.loop
            ? index + Math.round((this.target - index) / this.count) * this.count
            : index;
        this.settle(this.clamp(target));
    },

    nudge(by) {
        this.settle(this.clamp(Math.round(this.target) + by));
    },

    onPointerDown(event) {
        if (this.raf) {
            cancelAnimationFrame(this.raf);
            this.raf = null;
        }
        try { event.currentTarget.setPointerCapture(event.pointerId); } catch(e) {}
        this.target = this.pos;
        this.drag = {
            id: event.pointerId,
            x: event.clientX,
            pos: this.pos,
            v: 0,
            t: performance.now()
        };
    },

    onPointerMove(event) {
        if (!this.drag || this.drag.id !== event.pointerId) return;
        const pitch = this.cardWidthPx * (1 + this.gap);
        if (!pitch) return;
        const now = performance.now();
        const previous = this.pos;
        this.pos = this.clamp(this.drag.pos - (event.clientX - this.drag.x) / pitch);
        this.drag.v = ((this.pos - previous) / Math.max(now - this.drag.t, 1)) * 1000;
        this.drag.t = now;

        const index = ((Math.round(this.pos) % this.count) + this.count) % this.count;
        if (index !== this.selected) this.selected = index;
        this.paint();
    },

    endDrag(event) {
        if (!this.drag || this.drag.id !== event.pointerId) return;
        const carried = Math.max(-2, Math.min(2, (this.drag.v || 0) * 0.18));
        this.drag = null;
        this.settle(this.clamp(Math.round(this.pos + carried)));
    }
}"
