<!-- Views/Shared/Partials/_ForgotPasswordModal.cshtml -->
<!-- Subtask SCRUM-320: Forgot & Reset Password Recovery Modal -->
<!-- TODO [Backend]: POST /api/auth/forgot-password with email; POST /api/auth/reset-password with token, newPassword -->

<div x-show="$store.app.forgotPasswordOpen"
     x-transition.opacity.duration.200ms
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/60 backdrop-blur-xs"
     style="display: none;"
     role="dialog"
     aria-modal="true"
     x-data="{
         step: 'request', // 'request' | 'sent' | 'reset'
         email: '',
         newPassword: '',
         confirmPassword: '',
         get passwordMismatch() {
             return this.confirmPassword.length > 0 && this.newPassword !== this.confirmPassword;
         }
     }">

    <div @@click.away="$store.app.forgotPasswordOpen = false"
         x-show="$store.app.forgotPasswordOpen"
         x-transition.scale.origin.center.duration.200ms
         class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl space-y-6">

        <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#lock"></use></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[var(--color-text)]"
                        x-text="$store.app.language === 'ar' ? 'استعادة كلمة المرور' : 'Account Recovery'">
                        Account Recovery
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]"
                       x-text="step === 'reset' ? ($store.app.language === 'ar' ? 'قم بتعيين كلمة مرور جديدة قوية' : 'Create a new secure password') : ($store.app.language === 'ar' ? 'أدخل بريدك الإلكتروني لاستلام رابط الاستعادة' : 'Enter your email to receive recovery instructions')"></p>
                </div>
            </div>
            <button type="button"
                    @@click="$store.app.forgotPasswordOpen = false; step = 'request';"
                    class="p-2 rounded-full text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
            </button>
        </div>

        <!-- Step 1: Request Reset Link -->
        <div x-show="step === 'request'" class="space-y-4">
            <form @@submit.prevent="step = 'sent';" class="space-y-4 text-xs">
                <div>
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5"
                           x-text="$store.app.language === 'ar' ? 'البريد الإلكتروني المسجل' : 'Registered Email Address'">
                        Registered Email Address
                    </label>
                    <input type="email"
                           x-model="email"
                           required
                           placeholder="you@example.com"
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)] font-medium" />
                </div>

                <button type="submit"
                        class="w-full py-3 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-sm">
                    <span x-text="$store.app.language === 'ar' ? 'إرسال رابط استعادة كلمة المرور' : 'Send Password Reset Link'">Send Password Reset Link</span>
                </button>
            </form>

            <div class="text-center pt-2">
                <button type="button"
                        @@click="$store.app.forgotPasswordOpen = false; $store.app.loginModalOpen = true;"
                        class="text-xs text-[var(--color-primary)] hover:underline font-semibold cursor-pointer"
                        x-text="$store.app.language === 'ar' ? 'العودة لتسجيل الدخول' : 'Back to Sign In'">
                    Back to Sign In
                </button>
            </div>
        </div>

        <!-- Step 1.5: Sent Confirmation & Demo Reset Jump -->
        <div x-show="step === 'sent'" class="space-y-4 text-center py-2 text-xs">
            <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-600 flex items-center justify-center mx-auto">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check"></use></svg>
            </div>
            <h4 class="font-bold text-sm text-[var(--color-text)]"
                x-text="$store.app.language === 'ar' ? 'تم إرسال رابط الاستعادة إلى بريدك' : 'Reset Link Sent Successfully'">
                Reset Link Sent Successfully
            </h4>
            <p class="text-[var(--color-text-muted)] leading-relaxed"
               x-text="$store.app.language === 'ar' ? 'يرجى مراجعة صندوق الوارد والضغط على الرابط لإعادة تعيين كلمة المرور.' : 'Check your inbox for a secure one-time link to create a new password.'">
            </p>
            <div class="pt-2">
                <button type="button"
                        @@click="step = 'reset';"
                        class="text-[11px] underline text-[var(--color-primary)] font-medium cursor-pointer">
                    Simulate Clicking Email Reset Link
                </button>
            </div>
        </div>

        <!-- Step 2: Set New Password Form -->
        <div x-show="step === 'reset'" class="space-y-4">
            <form @@submit.prevent="
                if (newPassword === confirmPassword && newPassword.length >= 6) {
                    $store.app.forgotPasswordOpen = false;
                    step = 'request';
                    $store.app.addNotification({
                        title: $store.app.language === 'ar' ? 'تم تحديث كلمة المرور' : 'Password Updated',
                        message: $store.app.language === 'ar' ? 'تم تعيين كلمة المرور الجديدة بنجاح. يمكنك تسجيل الدخول الآن.' : 'Your new password has been saved. Please sign in.',
                        type: 'success'
                    });
                    $store.app.loginModalOpen = true;
                }
            " class="space-y-4 text-xs">
                <div>
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5"
                           x-text="$store.app.language === 'ar' ? 'كلمة المرور الجديدة' : 'New Password'">
                        New Password
                    </label>
                    <input type="password"
                           x-model="newPassword"
                           required
                           minlength="6"
                           placeholder="At least 6 characters"
                           class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]" />
                </div>

                <div>
                    <label class="block font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5"
                           x-text="$store.app.language === 'ar' ? 'تأكيد كلمة المرور' : 'Confirm New Password'">
                        Confirm New Password
                    </label>
                    <input type="password"
                           x-model="confirmPassword"
                           required
                           minlength="6"
                           class="w-full bg-[var(--color-surface-subtle)] border rounded-xl px-3.5 py-2.5 text-[var(--color-text)] focus:outline-hidden"
                           :class="passwordMismatch ? 'border-rose-500' : 'border-[var(--color-border)] focus:border-[var(--color-primary)]'" />
                    <p x-show="passwordMismatch" class="text-rose-500 text-[10px] mt-1 font-semibold"
                       x-text="$store.app.language === 'ar' ? 'كلمتا المرور غير متطابقتين' : 'Passwords do not match'"></p>
                </div>

                <button type="submit"
                        :disabled="passwordMismatch || newPassword.length < 6"
                        class="w-full py-3 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-sm disabled:opacity-50">
                    <span x-text="$store.app.language === 'ar' ? 'حفظ كلمة المرور الجديدة' : 'Save New Password'">Save New Password</span>
                </button>
            </form>
        </div>
    </div>
</div>

