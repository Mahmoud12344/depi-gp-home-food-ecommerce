<!-- Uses vanilla JS module: ~/js/components/thinkingPromptInput.js -->

@* PROTOTYPE-ONLY: BEGIN *@
<div x-data="{
    status: 'idle',
    prompt: '',
    answer: '',
    handlePromptSubmit() {
        if (!this.prompt.trim()) return;
        this.status = 'thinking';
        this.answer = '';
        if (window.initThinkingPrompt) {
            window.initThinkingPrompt(this.$el, {
                steps: [1, 2, 3],
                stepDelay: 700,
                onComplete: () => {
                    this.status = 'done';
                    this.answer = 'Based on your craving, we found fresh Baladi Duck Molokhia and Oxtail Tagine from Amina\'s Heritage Kitchen in Maadi, ready for hot pickup in 45 minutes.';
                }
            });
        }
    }
}"
     class="w-full max-w-2xl mx-auto bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-5 shadow-xl">

    <!-- Header bar -->
    <div class="flex items-center justify-between pb-3 border-b border-[var(--color-border-light)] mb-4">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--color-primary)]">
            <svg class="w-4 h-4 text-amber-500 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <use href="#sparkles"></use>
            </svg>
            <span>AI Reasoning Food Explorer</span>
        </div>
        <span data-thinking-badge class="text-[11px] font-mono text-[var(--color-text-muted)]">
            Ready
        </span>
    </div>

    <!-- Thinking steps container -->
    <div x-show="status === 'thinking'" style="display: none;" class="mb-4 bg-[var(--color-surface-subtle)] p-3 rounded-2xl border border-[var(--color-border-light)] space-y-2">
        <div data-thinking-steps class="space-y-1.5 text-xs">
            <div data-step-index="0" class="flex items-center gap-2 opacity-40 transition-opacity duration-300">
                <span data-step-icon class="w-4 h-4 flex items-center justify-center">
                    <span class="w-2 h-2 rounded-full bg-neutral-400"></span>
                </span>
                <span>Analyzing dietary preferences and area...</span>
            </div>
            <div data-step-index="1" class="flex items-center gap-2 opacity-40 transition-opacity duration-300">
                <span data-step-icon class="w-4 h-4 flex items-center justify-center">
                    <span class="w-2 h-2 rounded-full bg-neutral-400"></span>
                </span>
                <span>Checking live domestic kitchen capacity...</span>
            </div>
            <div data-step-index="2" class="flex items-center gap-2 opacity-40 transition-opacity duration-300">
                <span data-step-icon class="w-4 h-4 flex items-center justify-center">
                    <span class="w-2 h-2 rounded-full bg-neutral-400"></span>
                </span>
                <span>Matching fresh heirloom recipes...</span>
            </div>
        </div>
    </div>

    <!-- Answer preview -->
    <div x-show="answer" style="display: none;" class="mb-4 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800 text-xs text-emerald-900 dark:text-emerald-100 leading-relaxed">
        <p x-text="answer"></p>
        <div class="mt-3 flex gap-2">
            <a href="/Dishes" class="text-xs font-bold text-[var(--color-primary)] hover:underline inline-flex items-center gap-1">
                <span>View Recommended Dishes</span> →
            </a>
        </div>
    </div>

    <!-- Input Form -->
    <!-- TODO(backend): POST prompt to /AIAssistant/Ask -->
    <form method="post" action="/AIAssistant/Ask" @@submit.prevent="handlePromptSubmit()" class="relative flex items-center">
        @Html.AntiForgeryToken()
        <input type="text"
               name="prompt"
               x-model="prompt"
               placeholder="Describe what you feel like eating today..."
               class="w-full text-xs sm:text-sm p-3.5 pe-12 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-full focus:border-[var(--color-primary)] focus:outline-hidden font-medium shadow-inner" />
        <button type="submit"
                class="absolute end-2 w-9 h-9 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white flex items-center justify-center transition-all cursor-pointer shadow-md">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <use href="#arrow-up"></use>
            </svg>
        </button>
    </form>
</div>
@* PROTOTYPE-ONLY: END *@
