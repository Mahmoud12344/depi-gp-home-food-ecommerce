<!-- Views/Shared/Partials/_AIAssistantWidget.cshtml -->
<!-- Source: home_chef/src/components/common/AIAssistantWidget.tsx -->
<!-- TODO(backend): Integrate with AI recommendation service / LLM endpoint -->

<div x-data="{ isOpen: false }">
    <!-- Floating Trigger Button -->
    <div class="fixed bottom-14 end-4 sm:bottom-16 sm:end-6 z-40">
        <button type="button"
                @@click="isOpen = !isOpen"
                class="flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase tracking-wider px-4 py-3 rounded-full shadow-xl shadow-[var(--color-primary)]/30 border border-white/20 cursor-pointer transition-transform hover:scale-105 active:scale-95">
            <svg class="w-4 h-4 text-amber-300 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <use href="#sparkles"></use>
            </svg>
            <span class="hidden sm:inline">Foodie AI Assistant</span>
        </button>
    </div>

    <!-- Slide-Up Chat Window -->
    <div x-cloak
         x-show="isOpen"
         style="display: none;"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 translate-y-5 scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 translate-y-0 scale-100"
         x-transition:leave-end="opacity-0 translate-y-5 scale-95"
         class="fixed bottom-28 end-4 sm:end-6 z-50 w-full max-w-sm sm:max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl shadow-2xl overflow-hidden flex flex-col h-[520px]">

        <!-- Header -->
        <div class="bg-[var(--color-primary)] text-white p-4 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#chef-hat"></use>
                    </svg>
                </div>
                <div>
                    <h3 class="font-bold text-xs uppercase tracking-wide">
                        HomeChef AI Assistant
                    </h3>
                    <p class="text-[10px] opacity-80">
                        Recommends available home kitchen dishes
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-1">
                <a href="/AIAssistant"
                   title="Maximize to full AI Assistant page"
                   class="p-1 hover:bg-white/20 rounded-full transition-colors cursor-pointer text-white"
                   aria-label="Maximize">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#maximize-2"></use>
                    </svg>
                </a>
                <button type="button"
                        @@click="isOpen = false"
                        class="p-1 hover:bg-white/20 rounded-full transition-colors cursor-pointer text-white"
                        aria-label="Close">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#x"></use>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Messages Body -->
        <!-- TODO(backend): Stream conversational AI suggestions or connect to /AIAssistant/Ask; bind grounded dishes payload -->
        <div class="flex-1 p-4 overflow-y-auto space-y-4 text-xs">
            <!-- BEGIN SAMPLE -->
            <div class="me-auto max-w-[90%] space-y-2">
                <div class="bg-[var(--color-surface-subtle)] text-[var(--color-text)] p-3.5 rounded-2xl leading-relaxed">
                    <p>Welcome to HomeChef! Tell me what you feel like eating today (e.g., "something spicy with meat", "traditional dessert", or "fresh bread") and I will recommend real home kitchen specials!</p>
                </div>

                <!-- Recommended Dishes cards -->
                <div class="space-y-2 pt-1">
                    <a href="/Dishes/Details/1"
                       class="flex items-center gap-3 p-2.5 rounded-xl border border-[var(--color-border)] bg-white dark:bg-neutral-800 hover:border-[var(--color-primary)] cursor-pointer transition-all shadow-xs">
                        <img src="https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80"
                             alt="Baladi Duck Molokhia with Vermicelli Rice"
                             class="w-12 h-12 rounded-lg object-cover shrink-0" />
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold uppercase text-[11px] text-[var(--color-text)] truncate">
                                Baladi Duck Molokhia with Vermicelli Rice
                            </h4>
                            <p class="text-[10px] text-[var(--color-primary)] font-semibold">
                                240.00 EGP · Amina's Heritage Kitchen
                            </p>
                        </div>
                        <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <use href="#arrow-right"></use>
                        </svg>
                    </a>

                    <a href="/Dishes/Details/2"
                       class="flex items-center gap-3 p-2.5 rounded-xl border border-[var(--color-border)] bg-white dark:bg-neutral-800 hover:border-[var(--color-primary)] cursor-pointer transition-all shadow-xs">
                        <img src="https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=600&auto=format&fit=crop&q=80"
                             alt="Oxtail Tagine with Baby Caramelized Onions"
                             class="w-12 h-12 rounded-lg object-cover shrink-0" />
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold uppercase text-[11px] text-[var(--color-text)] truncate">
                                Oxtail Tagine with Baby Caramelized Onions
                            </h4>
                            <p class="text-[10px] text-[var(--color-primary)] font-semibold">
                                310.00 EGP · Om Nabil Casseroles
                            </p>
                        </div>
                        <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <use href="#arrow-right"></use>
                        </svg>
                    </a>
                </div>
            </div>
            <!-- END SAMPLE -->
        </div>

        <!-- Input Bar -->
        <!-- TODO(backend): POST prompt to /AIAssistant/Ask -->
        <form method="post" action="/AIAssistant/Ask" class="p-3 border-t border-[var(--color-border)] flex items-center gap-2 bg-[var(--color-card-bg)]">
            @Html.AntiForgeryToken()
            <input type="text"
                   name="prompt"
                   placeholder="e.g. Something spicy with rice..."
                   required
                   class="flex-1 text-xs p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-full focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
            <button type="submit"
                    class="w-8 h-8 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white flex items-center justify-center transition-colors cursor-pointer shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#send"></use>
                </svg>
            </button>
        </form>
    </div>
</div>
