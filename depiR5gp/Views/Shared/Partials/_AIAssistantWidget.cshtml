<!-- Views/Shared/Partials/_AIAssistantWidget.cshtml -->
<!-- Source: home_chef/src/components/common/AIAssistantWidget.tsx -->
<!-- TODO [Backend]: Integrate with AI recommendation service / LLM endpoint -->

<div x-data="{
    isOpen: false,
    input: '',
    messages: [
        {
            id: 'm-init',
            sender: 'assistant',
            text: $store.app.language === 'ar'
                ? 'مرحباً بك! أنا مساعد الذواقة الذكي. صف لي ماذا تشتهي اليوم وسأقترح عليك أشهى الأطباق المحضرة بالسمن البلدي من مطابخ حيك!'
                : 'Welcome to HomeChef! Tell me what you feel like eating today (e.g., &quot;something spicy with meat&quot;, &quot;traditional dessert&quot;, or &quot;fresh bread&quot;) and I will recommend real home kitchen specials!',
            recommendedDishes: [
                {
                    id: 'dish-1',
                    name: 'Baladi Duck Molokhia with Vermicelli Rice',
                    nameAr: 'ملوخية بالبط البلدي مع أرز بالشعرية',
                    price: 240,
                    kitchenName: 'Amina\'s Heritage Kitchen',
                    image: 'https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80'
                },
                {
                    id: 'dish-2',
                    name: 'Oxtail Tagine with Baby Caramelized Onions',
                    nameAr: 'طاجن عكاوي بالبصل القاورما المكرمل',
                    price: 310,
                    kitchenName: 'Om Nabil Casseroles',
                    image: 'https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=600&auto=format&fit=crop&q=80'
                }
            ]
        }
    ],
    handleSend() {
        if (!this.input.trim()) return;
        const userText = this.input.trim().toLowerCase();
        this.messages.push({
            id: 'user-' + Date.now(),
            sender: 'user',
            text: this.input.trim()
        });
        this.input = '';

        setTimeout(() => {
            let matched = [];
            if (userText.includes('spic') || userText.includes('حار') || userText.includes('meat') || userText.includes('لحم') || userText.includes('عكاوي')) {
                matched = [
                    {
                        id: 'dish-2',
                        name: 'Oxtail Tagine with Baby Caramelized Onions',
                        nameAr: 'طاجن عكاوي بالبصل القاورما المكرمل',
                        price: 310,
                        kitchenName: 'Om Nabil Casseroles',
                        image: 'https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=600&auto=format&fit=crop&q=80'
                    },
                    {
                        id: 'dish-1',
                        name: 'Baladi Duck Molokhia with Vermicelli Rice',
                        nameAr: 'ملوخية بالبط البلدي مع أرز بالشعرية',
                        price: 240,
                        kitchenName: 'Amina\'s Heritage Kitchen',
                        image: 'https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80'
                    }
                ];
            } else if (userText.includes('sweet') || userText.includes('حل') || userText.includes('dessert') || userText.includes('ام علي')) {
                matched = [
                    {
                        id: 'dish-6',
                        name: 'Baladi Cream Om Ali with Pistachios',
                        nameAr: 'أم علي بالقشطة البلدي والفستق الحلبي',
                        price: 110,
                        kitchenName: 'Hajjah Fatma Bakery',
                        image: 'https://images.unsplash.com/photo-1579954115545-a95591f28bfc?w=600&auto=format&fit=crop&q=80'
                    }
                ];
            } else if (userText.includes('bread') || userText.includes('فطير') || userText.includes('مخبوز')) {
                matched = [
                    {
                        id: 'dish-4',
                        name: 'Authentic Baladi Meshaltet Feteer (Large)',
                        nameAr: 'فطير مشلتت فلاحي بالسمن البلدي (كبير)',
                        price: 180,
                        kitchenName: 'Hajjah Fatma Bakery',
                        image: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?w=600&auto=format&fit=crop&q=80'
                    }
                ];
            } else {
                matched = [
                    {
                        id: 'dish-1',
                        name: 'Baladi Duck Molokhia with Vermicelli Rice',
                        nameAr: 'ملوخية بالبط البلدي مع أرز بالشعرية',
                        price: 240,
                        kitchenName: 'Amina\'s Heritage Kitchen',
                        image: 'https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80'
                    },
                    {
                        id: 'dish-2',
                        name: 'Oxtail Tagine with Baby Caramelized Onions',
                        nameAr: 'طاجن عكاوي بالبصل القاورما المكرمل',
                        price: 310,
                        kitchenName: 'Om Nabil Casseroles',
                        image: 'https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=600&auto=format&fit=crop&q=80'
                    }
                ];
            }

            this.messages.push({
                id: 'bot-' + Date.now(),
                sender: 'assistant',
                text: $store.app.language === 'ar'
                    ? 'بناءً على طلبك، إليك أفضل الأطباق المتاحة للطهي والاستلام الساخن الآن:'
                    : 'Based on your craving, here are freshly prepared dishes from verified kitchens near you:',
                recommendedDishes: matched
            });
        }, 600);
    }
}">
    <!-- Floating Trigger Button -->
    <div class="fixed bottom-14 end-4 sm:bottom-16 sm:end-6 z-40">
        <button type="button"
                @@click="isOpen = !isOpen"
                class="flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-xs font-bold uppercase tracking-wider px-4 py-3 rounded-full shadow-xl shadow-[var(--color-primary)]/30 border border-white/20 cursor-pointer transition-transform hover:scale-105 active:scale-95">
            <svg class="w-4 h-4 text-amber-300 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <use href="#sparkles"></use>
            </svg>
            <span class="hidden sm:inline" x-text="$store.app.language === 'ar' ? 'مساعد الذواقة' : 'Foodie AI Assistant'">Foodie AI Assistant</span>
        </button>
    </div>

    <!-- Slide-Up Chat Window -->
    <div x-cloak
         x-show="isOpen"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 translate-y-5 scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 translate-y-0 scale-100"
         x-transition:leave-end="opacity-0 translate-y-5 scale-95"
         class="fixed bottom-28 end-4 sm:end-6 z-50 w-full max-w-sm sm:max-w-md bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl shadow-2xl overflow-hidden flex flex-col h-[520px]">

        <!-- Header -->
        <div class="bg-[var(--color-primary)] text-white p-4 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#chef-hat"></use>
                    </svg>
                </div>
                <div>
                    <h3 class="font-bold text-xs uppercase tracking-wide"
                        x-text="$store.app.language === 'ar' ? 'مساعد الأكل البيتي الذكي' : 'HomeChef AI Assistant'">
                        HomeChef AI Assistant
                    </h3>
                    <p class="text-[10px] opacity-80"
                       x-text="$store.app.language === 'ar' ? 'يقترح من القائمة الحقيقية المتاحة' : 'Recommends available home kitchen dishes'">
                        Recommends available home kitchen dishes
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-1">
                <button type="button"
                        @@click="window.location.href = '/AIAssistant'; isOpen = false;"
                        :title="$store.app.language === 'ar' ? 'تكبير لصفحة المساعد المخصصة' : 'Maximize to full AI Assistant page'"
                        class="p-1 hover:bg-white/20 rounded-full transition-colors cursor-pointer text-white"
                        aria-label="Maximize">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#maximize-2"></use>
                    </svg>
                </button>
                <button type="button"
                        @@click="isOpen = false"
                        class="p-1 hover:bg-white/20 rounded-full transition-colors cursor-pointer text-white"
                        aria-label="Close">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#x"></use>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Messages Body -->
        <!-- TODO [Backend]: Stream conversational AI suggestions or connect to /api/ai/quick-chat; bind grounded dishes payload -->
        <div class="flex-1 p-4 overflow-y-auto space-y-4 text-xs">
            <template x-for="m in messages" :key="m.id">
                <div :class="m.sender === 'user' ? 'ms-auto max-w-[80%]' : 'me-auto max-w-[90%]'"
                     class="space-y-2">
                    <div :class="m.sender === 'user' ? 'bg-[var(--color-primary)] text-white' : 'bg-[var(--color-surface-subtle)] text-[var(--color-text)]'"
                         class="p-3.5 rounded-2xl leading-relaxed">
                        <p x-text="m.text"></p>
                    </div>

                    <!-- Recommended Dishes cards -->
                    <template x-if="m.recommendedDishes && m.recommendedDishes.length > 0">
                        <div class="space-y-2 pt-1">
                            <template x-for="dish in m.recommendedDishes" :key="dish.id">
                                <div @@click="window.location.href = '/Dishes/Details/1'; isOpen = false;"
                                     class="flex items-center gap-3 p-2.5 rounded-xl border border-[var(--color-border)] bg-white dark:bg-neutral-800 hover:border-[var(--color-primary)] cursor-pointer transition-all shadow-xs">
                                    <img :src="dish.image"
                                         :alt="dish.name"
                                         class="w-12 h-12 rounded-lg object-cover shrink-0" />
                                    <div class="flex-1 min-w-0">
                                        <h4 class="font-bold uppercase text-[11px] text-[var(--color-text)] truncate"
                                            x-text="$store.app.language === 'ar' ? dish.nameAr : dish.name">
                                        </h4>
                                        <p class="text-[10px] text-[var(--color-primary)] font-semibold"
                                           x-text="(dish.price || 0).toFixed(2) + ' EGP · ' + dish.kitchenName">
                                        </p>
                                    </div>
                                    <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0"
                                         :class="$store.app.language === 'ar' ? 'rotate-180' : ''"
                                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#arrow-right"></use>
                                    </svg>
                                </div>
                            </template>
                        </div>
                    </template>
                </div>
            </template>
        </div>

        <!-- Input Bar -->
        <form @@submit.prevent="handleSend()" class="p-3 border-t border-[var(--color-border)] flex items-center gap-2 bg-[var(--color-card-bg)]">
            <input type="text"
                   x-model="input"
                   :placeholder="$store.app.language === 'ar' ? 'مثال: وجبة دسمة باللحم، أو حلوى خفيفة...' : 'e.g. Something spicy with rice...'"
                   class="flex-1 text-xs p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-full focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
            <button type="submit"
                    class="w-8 h-8 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white flex items-center justify-center transition-colors cursor-pointer shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#send"></use>
                </svg>
            </button>
        </form>
    </div>
</div>

