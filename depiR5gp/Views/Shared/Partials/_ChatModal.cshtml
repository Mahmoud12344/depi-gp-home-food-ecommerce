<!-- Views/Shared/Partials/_ChatModal.cshtml -->
<!-- Source: home_chef/src/components/common/ChatModal.tsx -->
<!-- TODO(backend): Connect to SignalR ChatHub for real-time order messaging -->

<div x-cloak
     x-data="{ open: false }"
     @@open-chat-modal.window="open = true"
     x-show="open"
     style="display: none;"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">

    <div class="relative w-full max-w-lg bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl shadow-2xl overflow-hidden flex flex-col h-[560px]"
         @@click.away="open = false">

        <!-- Header with Chef Online status -->
        <!-- TODO(backend): Bind Chef name, kitchen name, order reference number, and real-time online status via SignalR presence tracker -->
        <div class="p-4 bg-[var(--color-primary)] text-white flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="relative">
                    <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <use href="#chef-hat"></use>
                        </svg>
                    </div>
                    <span class="absolute bottom-0 end-0 w-3 h-3 bg-emerald-400 border-2 border-white rounded-full"></span>
                </div>
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-tight">
                        Chef Amina Mansour (Amina's Heritage Kitchen)
                    </h3>
                    <p class="text-[10px] opacity-90 flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>
                        <span>Online · Order #HC-2026-9041 Coordination</span>
                    </p>
                </div>
            </div>

            <button type="button"
                    @@click="open = false"
                    class="p-1.5 hover:bg-white/20 rounded-full transition-colors cursor-pointer"
                    aria-label="Close chat">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#x"></use>
                </svg>
            </button>
        </div>

        <!-- Message Thread -->
        <!-- TODO(backend): Loop through Order.Messages (or query /api/chat/order/{orderId}); subscribe to SignalR ReceiveMessage event -->
        <div class="flex-1 p-5 overflow-y-auto space-y-3.5 text-xs">
            <!-- BEGIN SAMPLE -->
            <div class="ms-auto text-end max-w-[80%] space-y-1">
                <div class="bg-[var(--color-primary)] text-white p-3.5 rounded-2xl leading-relaxed inline-block text-start">
                    <p>Assalamu alaykum Chef Amina, can you please ensure the duck has extra crispy skin?</p>
                </div>
                <div class="flex items-center gap-1.5 text-[10px] text-[var(--color-text-muted)] px-1 justify-end">
                    <span>15:15</span>
                    <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#check-check"></use>
                    </svg>
                </div>
            </div>

            <div class="me-auto text-start max-w-[80%] space-y-1">
                <div class="bg-[var(--color-surface-subtle)] text-[var(--color-text)] p-3.5 rounded-2xl leading-relaxed inline-block text-start">
                    <p>Wa alaykum assalam Mr. Tamer! Absolutely, I use baladi ghee under the grill for a crisp crackling.</p>
                </div>
                <div class="flex items-center gap-1.5 text-[10px] text-[var(--color-text-muted)] px-1 justify-start">
                    <span>15:20</span>
                </div>
            </div>

            <div class="me-auto text-start max-w-[80%] space-y-1">
                <div class="bg-[var(--color-surface-subtle)] text-[var(--color-text)] p-3.5 rounded-2xl leading-relaxed inline-block text-start">
                    <p>Your duck is roasting nicely now! Will be fresh and hot for you.</p>
                </div>
                <div class="flex items-center gap-1.5 text-[10px] text-[var(--color-text-muted)] px-1 justify-start">
                    <span>15:28</span>
                </div>
            </div>
            <!-- END SAMPLE -->
        </div>

        <!-- Message Input -->
        <!-- TODO(backend): POST to /Chat/SendMessage or invoke ChatHub.SendOrderMessage(orderId, messageText) via SignalR connection -->
        <form method="post" action="/Chat/SendMessage" class="p-4 border-t border-[var(--color-border)] flex items-center gap-2 bg-[var(--color-card-bg)]">
            @Html.AntiForgeryToken()
            <input type="hidden" name="conversationId" value="1" />
            <input type="text"
                   name="messageText"
                   placeholder="Type message to Chef Amina..."
                   required
                   class="flex-1 text-xs p-3 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-full focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
            <button type="submit"
                    class="w-10 h-10 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white flex items-center justify-center transition-all cursor-pointer shadow-md shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#send"></use>
                </svg>
            </button>
        </form>
    </div>
</div>

