<!-- Views/Shared/Partials/_VerticalImageStack.cshtml -->
<!-- Source: home_chef/components/ui/vertical-image-stack.tsx -->
<!-- Uses vanilla JS module: ~/js/components/verticalImageStack.js -->

<div x-data="{
    currentIndex: 0,
    images: [
        {
            id: 1,
            src: 'https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=1000&auto=format&fit=crop&q=80',
            alt: 'Authentic Egyptian Molokhia with roasted duck'
        },
        {
            id: 2,
            src: 'https://images.unsplash.com/photo-1544025162-d76694265947?w=1000&auto=format&fit=crop&q=80',
            alt: 'Earthenware clay tagine with tender meat'
        },
        {
            id: 3,
            src: 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1000&auto=format&fit=crop&q=80',
            alt: 'Artisan Egyptian gourmet dining spread'
        },
        {
            id: 4,
            src: 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=1000&auto=format&fit=crop&q=80',
            alt: 'Freshly roasted kitchen BBQ skewers'
        },
        {
            id: 5,
            src: 'https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=1000&auto=format&fit=crop&q=80',
            alt: 'Alexandrian spiced liver and baked bread'
        }
    ]
}"
     x-init="window.initVerticalStack && window.initVerticalStack($el, { currentIndex: 0, aspectRatio: 'standard' })"
     class="relative w-full py-10 flex items-center justify-center overflow-hidden select-none">

    <!-- Card Stack Container -->
    <div data-stack-cards
         class="relative flex items-center justify-center"
         style="width: 410px; max-width: 100%; height: 420px; perspective: 1200px;">

        <template x-for="(img, idx) in images" :key="img.id">
            <div data-stack-card
                 class="absolute cursor-grab active:cursor-grabbing transition-transform duration-300"
                 style="transform-style: preserve-3d;">
                <div class="relative h-[320px] sm:h-[370px] w-[300px] sm:w-[360px] overflow-hidden rounded-[24px] bg-[var(--color-card-bg)] border border-[var(--color-border)] shadow-xl transition-all">
                    <!-- Subtle top sheen -->
                    <div class="absolute inset-0 z-10 rounded-[24px] bg-gradient-to-b from-white/10 via-transparent to-black/25 pointer-events-none"></div>

                    <img :src="img.src"
                         :alt="img.alt"
                         class="object-cover w-full h-full pointer-events-none select-none" />
                </div>
            </div>
        </template>
    </div>

    <!-- Navigation dots on the side -->
    <div class="absolute end-4 sm:end-6 top-1/2 flex -translate-y-1/2 flex-col gap-2 z-20">
        <template x-for="(img, idx) in images" :key="'dot-' + img.id">
            <button type="button"
                    class="w-2.5 h-2.5 rounded-full transition-all cursor-pointer"
                    :class="currentIndex === idx ? 'bg-[var(--color-primary)] scale-125' : 'bg-neutral-400/40 hover:bg-neutral-400'"></button>
        </template>
    </div>
</div>

