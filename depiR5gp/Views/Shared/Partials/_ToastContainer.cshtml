@*
  Toast Container Component Partial
  Source: home_chef/src/components/common/ToastContainer.tsx
*@
<!-- TODO(backend): Render server TempData["SuccessMessage"] / TempData["ErrorMessage"] flash notifications here -->
<div x-data="{ open: @(TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null ? "true" : "false"), message: '@(TempData["SuccessMessage"] ?? TempData["ErrorMessage"] ?? "")', type: '@(TempData["ErrorMessage"] != null ? "error" : "success")' }"
     @@show-toast.window="message = $event.detail?.message || 'Action completed!'; type = $event.detail?.type || 'success'; open = true; setTimeout(() => open = false, 3500)"
     x-show="open"
     style="display: none;"
     class="fixed bottom-20 end-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none">
    <div class="pointer-events-auto flex items-start gap-3 p-3.5 rounded-sm border shadow-lg transition-all duration-200 bg-white dark:bg-neutral-900"
         :class="{
            'border-emerald-200 dark:border-emerald-800': type === 'success',
            'border-rose-200 dark:border-rose-800': type === 'error',
            'border-blue-200 dark:border-blue-800': type === 'info',
            'border-amber-200 dark:border-amber-800': type === 'warning'
         }">
        <svg x-show="type === 'success'" class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#check-circle-2"></use></svg>
        <svg x-show="type === 'error'" class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#alert-circle"></use></svg>
        <svg x-show="type === 'info'" class="w-4 h-4 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#info"></use></svg>
        <svg x-show="type === 'warning'" class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#alert-triangle"></use></svg>

        <div class="flex-1 min-w-0">
            <p class="text-xs text-[var(--color-text)] leading-snug" x-text="message"></p>
        </div>

        <button type="button"
                @@click="open = false"
                class="text-neutral-400 hover:text-neutral-700 transition-colors cursor-pointer"
                aria-label="Dismiss toast">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
        </button>
    </div>
</div>
