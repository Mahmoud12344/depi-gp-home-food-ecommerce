<!-- Views/Shared/Partials/_DishCard.cshtml -->
<!-- Source: home_chef/src/components/common/DishCard.tsx -->
<!-- TODO [Backend]: Bind dish model dynamically via Razor or Web API -->

<div @@click="$store.app.navigate('#dish/dish-1')"
     class="group relative bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl p-4 transition-all duration-300 hover:shadow-xl hover:shadow-[var(--color-primary)]/5 cursor-pointer flex flex-col justify-between overflow-hidden hover:-translate-y-1">

    <!-- Image Container with Badges and Hover Action Buttons -->
    <!-- TODO [Backend]: Bind Dish.ImageUrl, Dish.IsSale, Dish.DiscountPercentage, and DishId for favorite/cart actions -->
    <div class="relative w-full aspect-square bg-neutral-100 dark:bg-neutral-800 overflow-hidden rounded-xl mb-3.5">
        <img src="https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80"
             alt="Baladi Duck Molokhia with Vermicelli Rice"
             class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
             loading="lazy" />

        <!-- SALE Badge -->
        <span class="absolute top-3 start-3 bg-[var(--color-sale)] text-white text-[10px] font-bold px-2.5 py-0.5 uppercase tracking-wider rounded-full shadow-sm z-10">
            SALE
        </span>

        <!-- Discount Stamp Burst -->
        <div class="absolute top-2.5 end-2.5 discount-burst w-12 h-12 flex items-center justify-center text-center shadow-md z-10 select-none">
            <span class="text-[10px] font-bold leading-tight">
                15%<br />OFF
            </span>
        </div>

        <!-- Floating Pill of Dark Icon Buttons on Hover -->
        <div class="absolute bottom-3 inset-x-0 flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-3 group-hover:translate-y-0 z-20">
            <button type="button"
                    @@click.stop="$store.app.toggleFavorite('dish-1')"
                    aria-label="Add to wishlist"
                    class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                <svg class="w-4 h-4" :class="$store.app.isFavorite('dish-1') ? 'fill-rose-500 text-rose-500' : 'stroke-current'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#heart"></use>
                </svg>
            </button>
            <button type="button"
                    @@click.stop="$store.app.addToCart({ id: 'dish-1', name: 'Baladi Duck Molokhia with Vermicelli Rice', price: 240, chefId: 'chef-1', kitchenName: 'Amina\'s Heritage Kitchen', isAvailable: true })"
                    aria-label="Add to cart"
                    class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs disabled:opacity-50">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#shopping-bag"></use>
                </svg>
            </button>
            <button type="button"
                    @@click.stop="$store.app.quickViewDish = { id: 'dish-1', name: 'Baladi Duck Molokhia with Vermicelli Rice', nameAr: 'ملوخية بالبط البلدي مع أرز بالشعرية', price: 240, originalPrice: 280, rating: 4.9, reviewCount: 48, description: 'Minced fresh molokhia leaves whipped with golden baladi garlic and coriander ta\u2019sheya, paired with roasted heritage duck and Egyptian vermicelli rice.', descriptionAr: 'ملوخية خضراء طازجة مخروطة يدوياً مع طشة الثوم البلدي والكزبرة الجافة، تقدم مع نصف بطة محمرة في الفرن وأرز مصري بالشعرية.', kitchenName: 'Amina\'s Heritage Kitchen', kitchenNameAr: 'مطبخ أمينة التراثي', category: 'Traditional Egyptian', categoryAr: 'أكلات مصرية تقليدية', pickupArea: 'Maadi, Cairo', pickupAreaAr: 'المعادي، القاهرة', prepTimeMinutes: 45, isAvailable: true, isSale: true, image: 'https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80' }"
                    aria-label="Quick view"
                    class="w-9 h-9 bg-neutral-950/95 hover:bg-[var(--color-primary)] text-white border border-white/20 rounded-full flex items-center justify-center transition-all shadow-md hover:scale-110 cursor-pointer backdrop-blur-xs">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#eye"></use>
                </svg>
            </button>
        </div>
    </div>

    <!-- Meta Subtitle -->
    <div>
        <div class="text-[11px] text-[var(--color-text-muted)] truncate mb-1">
            <span x-text="$store.app.language === 'ar' ? 'أكلات مصرية تقليدية' : 'Traditional Egyptian'">Traditional Egyptian</span>
            <span class="mx-1.5 opacity-60">·</span>
            <span class="text-[var(--color-primary)] font-semibold"
                  x-text="$store.app.language === 'ar' ? 'مطبخ أمينة التراثي' : 'Amina\'s Heritage Kitchen'">
                Amina's Heritage Kitchen
            </span>
        </div>

        <!-- Title -->
        <!-- TODO [Backend]: Bind Dish.Name, Dish.Price, Dish.OriginalPrice, Rating, and PrepTimeMinutes from Model.Dish -->
        <h3 class="text-sm sm:text-base font-bold uppercase tracking-tight text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors line-clamp-1 mb-1.5"
            x-text="$store.app.language === 'ar' ? 'ملوخية بالبط البلدي مع أرز بالشعرية' : 'Baladi Duck Molokhia with Vermicelli Rice'">
            Baladi Duck Molokhia with Vermicelli Rice
        </h3>

        <!-- Price & Strikethrough -->
        <div class="flex items-baseline gap-2 mb-2">
            <span class="text-base font-bold text-[var(--color-primary)]">
                240.00 EGP
            </span>
            <span class="text-xs text-[var(--color-text-muted)] line-through">
                280.00 EGP
            </span>
        </div>

        <!-- Stars -->
        <div class="flex items-center justify-between text-xs text-[var(--color-text-muted)] pt-2 border-t border-[var(--color-border-light)]">
            <div class="flex items-center gap-1.5">
                <div class="flex items-center text-[var(--color-star)]">
                    <template x-for="i in 5" :key="i">
                        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                            <use href="#star"></use>
                        </svg>
                    </template>
                </div>
                <span class="text-[11px] font-medium">(48)</span>
            </div>

            <span class="text-[11px] flex items-center gap-1 text-[var(--color-text-muted)]">
                <svg class="w-3 h-3 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#clock"></use>
                </svg>
                <span>45m</span>
            </span>
        </div>
    </div>
</div>

