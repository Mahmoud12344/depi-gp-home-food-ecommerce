<!-- Views/Shared/Partials/_ChefCard.cshtml -->
<!-- Source: home_chef/src/components/common/ChefCard.tsx -->
<!-- TODO(backend): Bind chef profile model dynamically (ChefId, KitchenName, ChefName, PhotoUrl, IsVerified, IsAvailable, Rating, ReviewCount, Bio, PickupArea, WorkingHours) -->

<div x-data="{ isFav: false }"
     @@click="window.location.href = '/Chefs/Details/1'"
     class="group bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-[var(--color-primary)]/5 cursor-pointer flex flex-col justify-between hover:-translate-y-1">

    <div>
        <!-- Cover Photo with rounded upper edge -->
        <!-- TODO(backend): Bind Chef.PhotoUrl, Chef.IsVerified, Chef.IsAvailable, and ChefId -->
        <div class="relative h-48 w-full bg-neutral-100 dark:bg-neutral-800 overflow-hidden">
            <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=800&auto=format&fit=crop&q=80"
                 alt="Amina's Heritage Kitchen"
                 class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
                 loading="lazy" />

            <!-- Verified domestic kitchen badge -->
            <div class="absolute top-3.5 start-3.5 bg-neutral-950/90 text-white border border-white/20 backdrop-blur-xs text-[11px] font-bold px-3 py-1 rounded-full flex items-center gap-1.5 shadow-md">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#check-circle-2"></use>
                </svg>
                <span>Verified Kitchen</span>
            </div>

            <!-- Favorite heart -->
            <button type="button"
                    @@click.stop="isFav = !isFav"
                    aria-label="Save chef to favorites"
                    class="absolute top-3.5 end-3.5 w-8 h-8 rounded-full bg-neutral-950/90 border border-white/20 backdrop-blur-xs flex items-center justify-center text-white hover:text-rose-400 transition-all shadow-md hover:scale-110 cursor-pointer">
                <svg class="w-4 h-4" :class="isFav ? 'fill-rose-500 text-rose-500' : 'stroke-current'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#heart"></use>
                </svg>
            </button>

            <!-- Availability pill -->
            <div class="absolute bottom-3 start-3.5">
                <span class="inline-flex items-center gap-1.5 text-[11px] font-bold bg-neutral-950/90 text-emerald-200 border border-emerald-500/50 backdrop-blur-xs px-3 py-1 rounded-full shadow-md">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Taking Orders Now</span>
                </span>
            </div>
        </div>

        <!-- Content -->
        <!-- TODO(backend): Bind Chef.KitchenName, Chef.ChefName, Rating, ReviewCount, Bio, PickupArea, and WorkingHours from Model -->
        <div class="p-5">
            <div class="flex items-start justify-between gap-2 mb-1.5">
                <div>
                    <h3 class="text-base sm:text-lg font-bold text-[var(--color-text)] dark:text-white uppercase tracking-tight group-hover:text-[var(--color-primary)] transition-colors">
                        Amina's Heritage Kitchen
                    </h3>
                    <p class="text-xs text-[var(--color-primary)] font-semibold mt-0.5">
                        Chef Amina Mansour
                    </p>
                </div>

                <!-- Stars -->
                <div class="flex items-center gap-1 bg-amber-50 dark:bg-amber-950/80 border border-amber-200 dark:border-amber-700 px-2.5 py-1 rounded-full shrink-0">
                    <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 24 24">
                        <use href="#star"></use>
                    </svg>
                    <span class="text-xs font-bold text-amber-950 dark:text-amber-100">4.9</span>
                    <span class="text-[10px] text-amber-800 dark:text-amber-200 font-semibold">(124)</span>
                </div>
            </div>

            <p class="text-xs text-[var(--color-text-muted)] line-clamp-2 mt-2 mb-4 leading-relaxed">
                Family heirloom recipes prepared in an inspected domestic kitchen using 100% baladi ghee, fresh butchery and organic farm herbs.
            </p>

            <div class="space-y-1.5 text-xs text-[var(--color-text-muted)] border-t border-[var(--color-border-light)] pt-3">
                <div class="flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-[var(--color-primary)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#map-pin"></use>
                    </svg>
                    <span class="truncate">Maadi, Cairo</span>
                </div>
                <div class="flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <use href="#clock"></use>
                    </svg>
                    <span class="truncate">12:00 PM - 9:00 PM (Sat - Thu)</span>
                </div>
            </div>
        </div>
    </div>

    <div class="px-5 pb-5 pt-0">
        <a href="/Chefs/Details/1"
           @@click.stop
           class="block text-center w-full bg-transparent hover:bg-[var(--color-primary)] text-[var(--color-primary)] hover:text-white border-2 border-[var(--color-primary)] text-xs font-semibold uppercase tracking-wider py-2.5 rounded-full transition-all duration-200 cursor-pointer shadow-2xs hover:shadow-md">
            <span>View Kitchen Menu</span>
        </a>
    </div>
</div>
