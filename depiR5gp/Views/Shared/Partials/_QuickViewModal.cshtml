<!-- Views/Shared/Partials/_QuickViewModal.cshtml -->
<!-- Source: home_chef/src/components/common/QuickViewModal.tsx -->
<!-- TODO(backend): Load quick view details asynchronously or bind dish model -->

<div x-cloak
     x-data="{
         open: false,
         quantity: 1,
         dish: {
             id: 1,
             name: 'Baladi Duck Molokhia with Vermicelli Rice',
             price: 240,
             originalPrice: 280,
             rating: 4.9,
             reviewCount: 48,
             description: 'Minced fresh molokhia leaves whipped with golden baladi garlic and coriander ta\u2019sheya, paired with roasted heritage duck and Egyptian vermicelli rice.',
             kitchenName: 'Amina\'s Heritage Kitchen',
             category: 'Traditional Egyptian',
             pickupArea: 'Maadi, Cairo',
             prepTimeMinutes: 45,
             isAvailable: true,
             isSale: true,
             image: 'https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80'
         }
     }"
     @@open-quick-view.window="if ($event.detail) dish = $event.detail; quantity = 1; open = true"
     x-show="open"
     style="display: none;"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs overflow-y-auto">

    <div class="relative w-full max-w-2xl bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl shadow-2xl my-8 overflow-hidden"
         @@click.away="open = false">

        <!-- Close Button -->
        <button type="button"
                @@click="open = false"
                class="absolute top-4 end-4 z-10 p-1.5 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer"
                aria-label="Close">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <use href="#x"></use>
            </svg>
        </button>

        <div class="grid grid-cols-1 md:grid-cols-2">
            <!-- Image -->
            <div class="relative h-64 md:h-full bg-neutral-100 dark:bg-neutral-800 overflow-hidden">
                <img :src="dish.image"
                     :alt="dish.name"
                     src="https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80"
                     alt="Baladi Duck Molokhia with Vermicelli Rice"
                     class="w-full h-full object-cover" />
                <span x-show="dish.isSale"
                      class="absolute top-3 start-3 bg-[var(--color-sale)] text-white text-[10px] font-bold px-2.5 py-0.5 uppercase tracking-wider rounded-full shadow-xs">
                    SALE
                </span>
            </div>

            <!-- Details -->
            <!-- TODO(backend): Bind Dish model (Name, Category, KitchenName, Price, OriginalPrice, Rating, ReviewCount, Description) or load via /api/dishes/{id}/quick-view -->
            <div class="p-6 flex flex-col justify-between">
                <div>
                    <div class="text-xs text-[var(--color-text-muted)] mb-1">
                        <span x-text="dish.category">Traditional Egyptian</span>
                        <span class="mx-1.5">/</span>
                        <span class="text-[var(--color-primary)] font-semibold"
                              x-text="dish.kitchenName">Amina's Heritage Kitchen</span>
                    </div>

                    <h2 class="text-lg sm:text-xl font-bold uppercase tracking-tight text-[var(--color-text)] mb-2"
                        x-text="dish.name">
                        Baladi Duck Molokhia with Vermicelli Rice
                    </h2>

                    <!-- Price -->
                    <div class="flex items-baseline gap-2.5 mb-2.5">
                        <span class="text-xl font-bold text-[var(--color-primary)]"
                              x-text="(dish.price || 0).toFixed(2) + ' EGP'">
                            240.00 EGP
                        </span>
                        <span x-show="dish.originalPrice"
                              class="text-sm text-[var(--color-text-muted)] line-through"
                              x-text="(dish.originalPrice || 0).toFixed(2) + ' EGP'">
                            280.00 EGP
                        </span>
                    </div>

                    <!-- Stars -->
                    <div class="flex items-center gap-2 text-xs text-[var(--color-text-muted)] mb-4">
                        <div class="flex items-center text-[var(--color-star)]">
                            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                        </div>
                        <span>(<span x-text="dish.reviewCount || 48">48</span> <span>verified reviews</span>)</span>
                    </div>

                    <p class="text-xs text-[var(--color-text-muted)] leading-relaxed mb-4 line-clamp-3"
                       x-text="dish.description">
                        Minced fresh molokhia leaves whipped with golden baladi garlic and coriander ta’sheya, paired with roasted heritage duck and Egyptian vermicelli rice.
                    </p>

                    <div class="space-y-1 text-xs text-[var(--color-text-muted)] mb-6">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <use href="#map-pin"></use>
                            </svg>
                            <span x-text="dish.pickupArea">Maadi, Cairo</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <use href="#clock"></use>
                            </svg>
                            <span><span x-text="dish.prepTimeMinutes || 45">45</span> <span>mins fresh preparation</span></span>
                        </div>
                    </div>
                </div>

                <div class="space-y-3 pt-3 border-t border-[var(--color-border-light)]">
                    <!-- TODO(backend): POST to CartController.Add -->
                    <form method="post" action="/Cart/Add" class="flex items-center gap-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="dishId" :value="dish.id" />
                        <input type="hidden" name="quantity" :value="quantity" />

                        <!-- Stepper -->
                        <div class="flex items-center border border-[var(--color-border)] rounded-full p-0.5 bg-white dark:bg-neutral-800">
                            <button type="button"
                                    @@click="quantity = Math.max(1, quantity - 1)"
                                    class="w-8 h-8 rounded-full flex items-center justify-center font-bold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer">
                                −
                            </button>
                            <span class="w-8 text-center text-xs font-bold" x-text="quantity">1</span>
                            <button type="button"
                                    @@click="quantity = quantity + 1"
                                    class="w-8 h-8 rounded-full flex items-center justify-center font-bold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer">
                                +
                            </button>
                        </div>

                        <button type="submit"
                                :disabled="dish.isAvailable === false"
                                class="flex-1 inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)]">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <use href="#shopping-bag"></use>
                            </svg>
                            <span x-text="dish.isAvailable !== false ? 'Add to Cart' : 'Unavailable'">Add to Cart</span>
                        </button>
                    </form>

                    <a href="/Dishes/Details/1"
                       class="w-full text-center text-xs font-semibold text-[var(--color-primary)] hover:underline pt-1 block cursor-pointer">
                        <span>View Full Dish Page &amp; Ingredients</span> →
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
