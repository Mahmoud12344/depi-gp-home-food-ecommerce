@model depiR5gp.Models.Menu.DishCatalogViewModel
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var cuisineTotal = Model.Cuisines.Sum(c => c.Count);
    var areaTotal = Model.Areas.Sum(a => a.Count);
}
<!-- Views/Shared/Partials/_FilterDrawer.cshtml -->
<!-- Source: home_chef/src/components/common/FilterDrawer.tsx -->
<!-- TODO(backend): Filter dishes/chefs server-side via GET query parameters -->

<div x-cloak
     x-data="{
         open: false,
         selectedCuisine: '@(Model.Filter.CuisineId?.ToString() ?? "all")',
         selectedArea: '@(Model.Filter.Area ?? "all")',
         minPrice: '@(Model.Filter.MinPrice?.ToString(inv) ?? "")',
         maxPrice: '@(Model.Filter.MaxPrice?.ToString(inv) ?? "")',
         get priceError() {
             if (this.minPrice && this.maxPrice && Number(this.minPrice) > Number(this.maxPrice)) {
                 return 'Minimum price cannot exceed maximum price.';
             }
             return '';
         }
     }"
     @@open-filter-drawer.window="open = true"
     x-show="open"
     style="display: none;"
     class="fixed inset-0 z-50 flex overflow-hidden">

    <!-- Backdrop -->
    <div @@click="open = false"
         class="fixed inset-0 bg-black/50 backdrop-blur-xs transition-opacity duration-300"></div>

    <!-- Drawer content -->
    <form method="get" action="/Dishes"
          class="me-auto relative z-10 w-full max-w-xs sm:max-w-sm bg-[var(--color-card-bg)] border-e border-[var(--color-border)] shadow-2xl flex flex-col h-full transform transition-transform duration-300 ease-in-out">

        <input type="hidden" name="category" :value="selectedCuisine === 'all' ? '' : selectedCuisine" />
        <input type="hidden" name="area" :value="selectedArea" />
        @if (Model.Filter.Search != null) { <input type="hidden" name="search" value="@Model.Filter.Search" /> }
        @if (Model.Filter.Sort != "featured") { <input type="hidden" name="sort" value="@Model.Filter.Sort" /> }

        <!-- Drawer Header -->
        <div class="flex items-center justify-between p-4 sm:p-5 border-b border-[var(--color-border)]">
            <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)]">
                Filter Menu &amp; Cuisines
            </h2>
            <button type="button"
                    @@click="open = false"
                    class="p-1.5 text-neutral-400 hover:text-[var(--color-text)] transition-colors cursor-pointer"
                    aria-label="Close filters">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#x"></use>
                </svg>
            </button>
        </div>

        <!-- Drawer Body -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-6">
            <!-- Cuisines Section -->
            <!-- TODO(backend): Loop through active Cuisines and item counts from catalog query (Model.FilterCuisines) -->
            <div>
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-text)]">
                        Cuisine &amp; Category
                    </h3>
                    <button type="button"
                            x-show="selectedCuisine !== 'all'"
                            @@click="selectedCuisine = 'all'"
                            class="text-[11px] text-[var(--color-primary)] hover:underline cursor-pointer">
                        Reset
                    </button>
                </div>

                <div class="space-y-1.5">
                    <button type="button"
                            @@click="selectedCuisine = 'all'"
                            :class="selectedCuisine === 'all' ? 'bg-[var(--color-primary-light)] text-[var(--color-primary)] font-semibold' : 'hover:bg-[var(--color-surface-subtle)] text-[var(--color-text)]'"
                            class="w-full flex items-center justify-between py-1.5 px-2 rounded-xs text-xs text-start transition-colors cursor-pointer">
                        <div class="flex items-center gap-2">
                            <div :class="selectedCuisine === 'all' ? 'bg-[var(--color-primary)] border-[var(--color-primary)] text-white' : 'border-neutral-400 bg-white dark:bg-neutral-800'"
                                 class="w-3.5 h-3.5 rounded-xs border flex items-center justify-center">
                                <svg x-show="selectedCuisine === 'all'" class="w-2.5 h-2.5 stroke-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <use href="#check"></use>
                                </svg>
                            </div>
                            <span>All Cuisines</span>
                        </div>
                        <span class="text-[11px] text-[var(--color-text-muted)]">(@cuisineTotal)</span>
                    </button>

                    @foreach (var c in Model.Cuisines)
                    {
                        <button type="button"
                                @@click="selectedCuisine = '@c.Value'"
                                :class="selectedCuisine === '@c.Value' ? 'bg-[var(--color-primary-light)] text-[var(--color-primary)] font-semibold' : 'hover:bg-[var(--color-surface-subtle)] text-[var(--color-text)]'"
                                class="w-full flex items-center justify-between py-1.5 px-2 rounded-xs text-xs text-start transition-colors cursor-pointer">
                            <div class="flex items-center gap-2">
                                <div :class="selectedCuisine === '@c.Value' ? 'bg-[var(--color-primary)] border-[var(--color-primary)] text-white' : 'border-neutral-400 bg-white dark:bg-neutral-800'"
                                     class="w-3.5 h-3.5 rounded-xs border flex items-center justify-center">
                                    <svg x-show="selectedCuisine === '@c.Value'" class="w-2.5 h-2.5 stroke-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <use href="#check"></use>
                                    </svg>
                                </div>
                                <span>@c.Name</span>
                            </div>
                            <span class="text-[11px] text-[var(--color-text-muted)]">(@c.Count)</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Area Section -->
            <!-- TODO(backend): Loop through distinct Pickup Areas and domestic kitchen counts (Model.FilterAreas) -->
            <div class="border-t border-[var(--color-border-light)] pt-5">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-text)]">
                        Pickup Area
                    </h3>
                    <button type="button"
                            x-show="selectedArea !== 'all'"
                            @@click="selectedArea = 'all'"
                            class="text-[11px] text-[var(--color-primary)] hover:underline cursor-pointer">
                        Reset
                    </button>
                </div>

                <div class="space-y-1.5">
                    <button type="button"
                            @@click="selectedArea = 'all'"
                            :class="selectedArea === 'all' ? 'bg-[var(--color-primary-light)] text-[var(--color-primary)] font-semibold' : 'hover:bg-[var(--color-surface-subtle)] text-[var(--color-text)]'"
                            class="w-full flex items-center justify-between py-1.5 px-2 rounded-xs text-xs text-start transition-colors cursor-pointer">
                        <div class="flex items-center gap-2">
                            <div :class="selectedArea === 'all' ? 'border-[var(--color-primary)]' : 'border-neutral-400 bg-white dark:bg-neutral-800'"
                                 class="w-3.5 h-3.5 rounded-full border flex items-center justify-center">
                                <div x-show="selectedArea === 'all'" class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)]"></div>
                            </div>
                            <span class="truncate">All Areas</span>
                        </div>
                        <span class="text-[11px] text-[var(--color-text-muted)] shrink-0">(@areaTotal)</span>
                    </button>

                    @foreach (var a in Model.Areas)
                    {
                        <button type="button"
                                @@click="selectedArea = '@a.Value'"
                                :class="selectedArea === '@a.Value' ? 'bg-[var(--color-primary-light)] text-[var(--color-primary)] font-semibold' : 'hover:bg-[var(--color-surface-subtle)] text-[var(--color-text)]'"
                                class="w-full flex items-center justify-between py-1.5 px-2 rounded-xs text-xs text-start transition-colors cursor-pointer">
                            <div class="flex items-center gap-2">
                                <div :class="selectedArea === '@a.Value' ? 'border-[var(--color-primary)]' : 'border-neutral-400 bg-white dark:bg-neutral-800'"
                                     class="w-3.5 h-3.5 rounded-full border flex items-center justify-center">
                                    <div x-show="selectedArea === '@a.Value'" class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)]"></div>
                                </div>
                                <span class="truncate">@a.Name</span>
                            </div>
                            <span class="text-[11px] text-[var(--color-text-muted)] shrink-0">(@a.Count)</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Price Range Section -->
            <div class="border-t border-[var(--color-border-light)] pt-5">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-text)]">
                        Price Range
                    </h3>
                    <button type="button"
                            x-show="minPrice || maxPrice"
                            @@click="minPrice = ''; maxPrice = '';"
                            class="text-[11px] text-[var(--color-primary)] hover:underline cursor-pointer">
                        Reset
                    </button>
                </div>

                <p class="text-[11px] text-[var(--color-text-muted)] mb-3">
                    The highest dish price is @Model.MaxDishPrice.ToString("0.00", inv) EGP
                </p>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-[10px] text-[var(--color-text-muted)] uppercase font-semibold mb-1">
                            From (EGP)
                        </label>
                        <input type="number"
                               name="minPrice"
                               min="0"
                               placeholder="0"
                               x-model="minPrice"
                               class="w-full text-xs p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                    </div>
                    <div>
                        <label class="block text-[10px] text-[var(--color-text-muted)] uppercase font-semibold mb-1">
                            To (EGP)
                        </label>
                        <input type="number"
                               name="maxPrice"
                               min="0"
                               placeholder="@Model.MaxDishPrice.ToString("0", inv)"
                               x-model="maxPrice"
                               class="w-full text-xs p-2.5 bg-white dark:bg-neutral-900 text-[var(--color-text)] placeholder:text-neutral-500 dark:placeholder:text-neutral-400 border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden font-medium" />
                    </div>
                </div>

                <p x-show="priceError" x-text="priceError" class="text-[11px] text-rose-600 mt-2 font-medium"></p>
            </div>
        </div>

        <!-- Drawer Footer Actions -->
        <div class="p-4 sm:p-5 border-t border-[var(--color-border)] bg-[var(--color-surface-subtle)] flex items-center gap-2">
            <a href="/Dishes"
               class="flex-1 inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-transparent border-2 border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white">
                <span>Clear All</span>
            </a>
            <button type="submit"
                    class="flex-1 inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)]">
                <span>Apply</span>
            </button>
        </div>
    </form>
</div>