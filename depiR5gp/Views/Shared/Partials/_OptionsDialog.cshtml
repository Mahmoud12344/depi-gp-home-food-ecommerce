<!-- Views/Shared/Partials/_OptionsDialog.cshtml -->
<div x-cloak
     x-data="{
         open: false,
         dish: { id: 1, name: '', kitchenName: '', price: 0, isAvailable: true, hasRequiredOptions: false },
         quantity: 1,
         note: '',
         get total() {
             return (Number(this.dish.price) || 0) * this.quantity;
         }
     }"
     @@open-options-modal.window="if ($event.detail) dish = $event.detail; quantity = 1; note = ''; open = true"
     @@cart-added.window="open = false"
     x-show="open"
     style="display: none;"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs overflow-y-auto">

    <form method="post" action="/Cart/Add"
          :data-dish-name="dish.name"
          class="relative w-full max-w-lg bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-2xl shadow-xl my-8 overflow-hidden"
          @@click.away="open = false">
        @Html.AntiForgeryToken()
        <input type="hidden" name="dishId" :value="dish.id" />
        <input type="hidden" name="quantity" :value="quantity" />

        <!-- Header -->
        <div class="flex items-start justify-between p-4 sm:p-5 border-b border-[var(--color-border)]">
            <div>
                <span class="text-xs text-[var(--color-primary)] font-semibold" x-text="dish.kitchenName"></span>
                <h3 class="text-base sm:text-lg font-bold uppercase tracking-tight text-[var(--color-text)] mt-0.5" x-text="dish.name"></h3>
                <p class="text-xs text-[var(--color-text-muted)] mt-0.5">
                    Select quantity &amp; add kitchen notes
                </p>
            </div>
            <button type="button"
                    @@click="open = false"
                    class="p-1.5 text-neutral-400 hover:text-[var(--color-text)] transition-colors rounded-xs cursor-pointer"
                    aria-label="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
            </button>
        </div>

        <!-- Body -->
        <div class="p-4 sm:p-6 space-y-5 max-h-[60vh] overflow-y-auto">
            <template x-if="dish.hasRequiredOptions">
                <div class="p-3.5 rounded-xl bg-amber-50 dark:bg-amber-950/50 border border-amber-200 dark:border-amber-800 text-xs text-amber-900 dark:text-amber-200">
                    This dish has required customization options (such as portion or stuffing choice). Please open the dish page to choose your options.
                </div>
            </template>
            <div class="pt-1" x-show="!dish.hasRequiredOptions">
                <div class="flex items-center justify-between mb-1.5">
                    <label for="dish-note" class="text-xs font-bold uppercase tracking-wider text-[var(--color-text)]">
                        Note for Chef (Optional)
                    </label>
                    <span :class="note.length >= 190 ? 'text-rose-600 font-bold' : 'text-[var(--color-text-muted)]'"
                          class="text-[11px] font-mono"
                          x-text="note.length + '/200'">0/200</span>
                </div>
                <textarea id="dish-note"
                          name="specialInstructions"
                          x-model="note"
                          rows="3"
                          maxlength="200"
                          placeholder="e.g. Mild garlic, crispy bread, packing instructions..."
                          class="w-full text-xs p-3 border border-[var(--color-border)] rounded-xl focus:border-[var(--color-primary)] focus:outline-hidden bg-white dark:bg-neutral-900 text-[var(--color-text)] resize-none"></textarea>
                <p class="text-[11px] text-[var(--color-text-muted)] mt-1">
                    Need custom dish options? <a :href="'/Dishes/Details/' + dish.id" class="text-[var(--color-primary)] font-semibold hover:underline">Open full dish page</a>.
                </p>
            </div>
        </div>

        <!-- Footer with Quantity Stepper and Add Button -->
        <div class="p-4 sm:p-5 border-t border-[var(--color-border)] bg-[var(--color-surface-subtle)] flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center border border-[var(--color-border)] bg-white dark:bg-neutral-800 rounded-full p-0.5" x-show="!dish.hasRequiredOptions">
                <button type="button"
                        @@click="quantity = Math.max(1, quantity - 1)"
                        class="w-9 h-9 rounded-full flex items-center justify-center text-base font-semibold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer"
                        aria-label="Decrease quantity">−</button>
                <span class="w-10 text-center font-bold text-xs" x-text="quantity">1</span>
                <button type="button"
                        @@click="quantity = quantity + 1"
                        class="w-9 h-9 rounded-full flex items-center justify-center text-base font-semibold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer"
                        aria-label="Increase quantity">+</button>
            </div>

            <template x-if="!dish.hasRequiredOptions">
                <button type="submit"
                        :disabled="dish.isAvailable === false"
                        class="w-full sm:w-auto inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#shopping-bag"></use></svg>
                    <span x-show="dish.isAvailable !== false">Add to Order · <span x-text="total.toFixed(2) + ' EGP'">0.00 EGP</span></span>
                    <span x-show="dish.isAvailable === false">Currently Unavailable</span>
                </button>
            </template>
            <template x-if="dish.hasRequiredOptions">
                <a :href="'/Dishes/Details/' + dish.id"
                   class="w-full inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)]">
                    <span>Choose Required Options</span>
                </a>
            </template>
        </div>
    </form>
</div>
