<!-- Views/Shared/Partials/_OptionsDialog.cshtml -->
<!-- Source: home_chef/src/components/common/OptionsDialog.tsx -->
<!-- TODO [Backend]: Bind dish option groups, pricing modifiers, and cart customization server-side -->

<div x-cloak
     x-show="$store.app.optionsModalDish"
     x-data="{
         quantity: 1,
         selectedOptions: {},
         note: '',
         errors: [],
         init() {
             this.$watch('$store.app.optionsModalDish', (dish) => {
                 if (dish) {
                     this.quantity = 1;
                     this.note = '';
                     this.errors = [];
                     const initial = {};
                     (dish.optionGroups || []).forEach((group) => {
                         if (group.isRequired && !group.isMultiSelect && group.values?.length > 0) {
                             const firstVal = group.values[0];
                             initial[group.name] = [{
                                 groupName: group.name,
                                 valueName: $store.app.language === 'ar' ? firstVal.nameAr : firstVal.name,
                                 priceModifier: firstVal.priceModifier
                             }];
                         } else {
                             initial[group.name] = [];
                         }
                     });
                     this.selectedOptions = initial;
                 }
             });
         },
         get allSelected() {
             return Object.values(this.selectedOptions).flat();
         },
         get optionsExtra() {
             return this.allSelected.reduce((acc, opt) => acc + (opt.priceModifier || 0), 0);
         },
         get unitPrice() {
             const base = $store.app.optionsModalDish?.price || 0;
             return base + this.optionsExtra;
         },
         get total() {
             return this.unitPrice * this.quantity;
         },
         isSelected(groupName, valLabel) {
             const group = this.selectedOptions[groupName] || [];
             return group.some(opt => opt.valueName === valLabel);
         },
         selectRadio(groupName, valueName, priceModifier) {
             this.selectedOptions[groupName] = [{ groupName, valueName, priceModifier }];
             this.errors = [];
         },
         toggleCheckbox(groupName, valueName, priceModifier) {
             const current = this.selectedOptions[groupName] || [];
             const exists = current.some(opt => opt.valueName === valueName);
             if (exists) {
                 this.selectedOptions[groupName] = current.filter(opt => opt.valueName !== valueName);
             } else {
                 this.selectedOptions[groupName] = [...current, { groupName, valueName, priceModifier }];
             }
             this.errors = [];
         },
         validate() {
             const dish = $store.app.optionsModalDish;
             if (!dish) return false;
             const errs = [];
             (dish.optionGroups || []).forEach(group => {
                 const sel = this.selectedOptions[group.name] || [];
                 if (group.isRequired && sel.length === 0) {
                     errs.push($store.app.language === 'ar'
                         ? 'يرجى تحديد اختيار لـ: ' + (group.nameAr || group.name)
                         : 'Please select an option for: ' + group.name);
                 }
             });
             this.errors = errs;
             return errs.length === 0;
         },
         handleConfirmAddToCart() {
             if (!this.validate()) return;
             const dish = $store.app.optionsModalDish;
             const added = $store.app.addToCart(dish, this.quantity, this.allSelected, this.note.trim());
             if (added) {
                 $store.app.optionsModalDish = null;
             }
         }
     }"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs overflow-y-auto">

    <div class="relative w-full max-w-lg bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-sm shadow-xl my-8 overflow-hidden"
         @@click.away="$store.app.optionsModalDish = null">

        <!-- Header -->
        <div class="flex items-start justify-between p-4 sm:p-5 border-b border-[var(--color-border)]">
            <div>
                <span class="text-xs text-[var(--color-primary)] font-medium"
                      x-text="$store.app.language === 'ar' ? $store.app.optionsModalDish?.kitchenNameAr : $store.app.optionsModalDish?.kitchenName">
                </span>
                <h3 class="text-base sm:text-lg font-bold uppercase tracking-tight text-[var(--color-text)] mt-0.5"
                    x-text="$store.app.language === 'ar' ? $store.app.optionsModalDish?.nameAr : $store.app.optionsModalDish?.name">
                </h3>
                <p class="text-xs text-[var(--color-text-muted)] mt-0.5"
                   x-text="$store.app.language === 'ar' ? 'تخصيص الوجبة وإضافات المطبخ' : 'Customize options & special instructions'">
                    Customize options & special instructions
                </p>
            </div>
            <button type="button"
                    @@click="$store.app.optionsModalDish = null"
                    class="p-1.5 text-neutral-400 hover:text-[var(--color-text)] transition-colors rounded-xs cursor-pointer"
                    aria-label="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <use href="#x"></use>
                </svg>
            </button>
        </div>

        <!-- Body -->
        <div class="p-4 sm:p-6 space-y-6 max-h-[60vh] overflow-y-auto">
            <!-- Validation errors -->
            <div x-show="errors.length > 0" class="bg-rose-50 border border-rose-200 text-rose-800 text-xs p-3 rounded-xs space-y-1">
                <template x-for="(err, i) in errors" :key="i">
                    <p x-text="'• ' + err"></p>
                </template>
            </div>

            <!-- Option Groups -->
            <!-- TODO [Backend]: Loop through Dish.OptionGroups (DishOptionGroup model); bind GroupName, IsRequired, IsMultiSelect, and OptionValues with PriceModifiers -->
            <template x-if="$store.app.optionsModalDish?.optionGroups && $store.app.optionsModalDish?.optionGroups.length > 0">
                <div class="space-y-5">
                    <template x-for="group in $store.app.optionsModalDish.optionGroups" :key="group.id">
                        <div class="border-b border-[var(--color-border-light)] pb-5 last:border-0">
                            <div class="flex items-baseline justify-between mb-2.5">
                                <h4 class="text-sm font-bold uppercase tracking-wide text-[var(--color-text)]"
                                    x-text="$store.app.language === 'ar' ? group.nameAr : group.name">
                                </h4>
                                <template x-if="group.isRequired">
                                    <span class="text-[11px] font-semibold text-[var(--color-primary)] bg-[var(--color-primary-light)] px-2 py-0.5 rounded-xs"
                                          x-text="$store.app.language === 'ar' ? 'مطلوب' : 'Required'">
                                    </span>
                                </template>
                                <template x-if="!group.isRequired">
                                    <span class="text-[11px] text-[var(--color-text-muted)]"
                                          x-text="$store.app.language === 'ar' ? 'اختياري' : 'Optional'">
                                    </span>
                                </template>
                            </div>

                            <!-- Values list -->
                            <div class="space-y-2">
                                <template x-for="val in group.values" :key="val.id">
                                    <div>
                                        <!-- Multi-select checkbox -->
                                        <template x-if="group.isMultiSelect">
                                            <label @@click.prevent="toggleCheckbox(group.name, ($store.app.language === 'ar' ? val.nameAr : val.name), val.priceModifier)"
                                                   :class="isSelected(group.name, ($store.app.language === 'ar' ? val.nameAr : val.name))
                                                       ? 'border-[var(--color-primary)] bg-[var(--color-primary-light)] text-[var(--color-primary)] font-medium'
                                                       : 'border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text)]'"
                                                   class="flex items-center justify-between p-2.5 rounded-xs border cursor-pointer transition-colors">
                                                <div class="flex items-center gap-2.5">
                                                    <div :class="isSelected(group.name, ($store.app.language === 'ar' ? val.nameAr : val.name))
                                                             ? 'bg-[var(--color-primary)] border-[var(--color-primary)] text-white'
                                                             : 'border-neutral-400 bg-white'"
                                                         class="w-4 h-4 rounded-xs border flex items-center justify-center transition-colors">
                                                        <svg x-show="isSelected(group.name, ($store.app.language === 'ar' ? val.nameAr : val.name))" class="w-3 h-3 stroke-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <use href="#check"></use>
                                                        </svg>
                                                    </div>
                                                    <span class="text-xs" x-text="$store.app.language === 'ar' ? val.nameAr : val.name"></span>
                                                </div>
                                                <template x-if="val.priceModifier > 0">
                                                    <span class="text-xs font-semibold" x-text="'+' + val.priceModifier.toFixed(2) + ' EGP'"></span>
                                                </template>
                                            </label>
                                        </template>

                                        <!-- Single select radio -->
                                        <template x-if="!group.isMultiSelect">
                                            <label @@click="selectRadio(group.name, ($store.app.language === 'ar' ? val.nameAr : val.name), val.priceModifier)"
                                                   :class="isSelected(group.name, ($store.app.language === 'ar' ? val.nameAr : val.name))
                                                       ? 'border-[var(--color-primary)] bg-[var(--color-primary-light)] text-[var(--color-primary)] font-medium'
                                                       : 'border-[var(--color-border)] hover:bg-[var(--color-surface-subtle)] text-[var(--color-text)]'"
                                                   class="flex items-center justify-between p-2.5 rounded-xs border cursor-pointer transition-colors">
                                                <div class="flex items-center gap-2.5">
                                                    <div :class="isSelected(group.name, ($store.app.language === 'ar' ? val.nameAr : val.name))
                                                             ? 'border-[var(--color-primary)]'
                                                             : 'border-neutral-400 bg-white'"
                                                         class="w-4 h-4 rounded-full border flex items-center justify-center transition-colors">
                                                        <div x-show="isSelected(group.name, ($store.app.language === 'ar' ? val.nameAr : val.name))" class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></div>
                                                    </div>
                                                    <span class="text-xs" x-text="$store.app.language === 'ar' ? val.nameAr : val.name"></span>
                                                </div>
                                                <template x-if="val.priceModifier > 0">
                                                    <span class="text-xs font-semibold" x-text="'+' + val.priceModifier.toFixed(2) + ' EGP'"></span>
                                                </template>
                                            </label>
                                        </template>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>
            </template>

            <template x-if="!$store.app.optionsModalDish?.optionGroups || $store.app.optionsModalDish?.optionGroups.length === 0">
                <p class="text-xs text-[var(--color-text-muted)] italic"
                   x-text="$store.app.language === 'ar' ? 'لا توجد خيارات إضافية لهذا الطبق.' : 'No required options for this dish.'">
                    No required options for this dish.
                </p>
            </template>

            <!-- Note Field -->
            <div class="pt-2">
                <div class="flex items-center justify-between mb-1.5">
                    <label for="dish-note"
                           class="text-xs font-bold uppercase tracking-wider text-[var(--color-text)]"
                           x-text="$store.app.language === 'ar' ? 'ملاحظة للشيف (اختياري)' : 'Note for Chef (Optional)'">
                        Note for Chef (Optional)
                    </label>
                    <span :class="note.length >= 190 ? 'text-rose-600 font-bold' : 'text-[var(--color-text-muted)]'"
                          class="text-[11px] font-mono"
                          x-text="note.length + '/200'">
                        0/200
                    </span>
                </div>
                <textarea id="dish-note"
                          x-model="note"
                          rows="2"
                          maxlength="200"
                          :placeholder="$store.app.language === 'ar' ? 'مثال: بدون بصل، الطشة خفيفة، التسليم ساخن...' : 'e.g. Mild garlic, crispy bread, packing instructions...'"
                          class="w-full text-xs p-3 border border-[var(--color-border)] rounded-xs focus:border-[var(--color-primary)] focus:outline-hidden bg-transparent resize-none"></textarea>
                <p class="text-[11px] text-[var(--color-text-muted)] mt-1"
                   x-text="$store.app.language === 'ar' ? 'الملاحظات مخصصة لتعليمات التحضير ولا تغير سعر الطبق.' : 'Notes are for preparation preferences only and do not alter prices.'">
                    Notes are for preparation preferences only and do not alter prices.
                </p>
            </div>
        </div>

        <!-- Footer with Quantity Stepper and Add Button -->
        <div class="p-4 sm:p-5 border-t border-[var(--color-border)] bg-[var(--color-surface-subtle)] flex flex-col sm:flex-row items-center justify-between gap-3">
            <!-- Quantity Stepper -->
            <div class="flex items-center border border-[var(--color-border)] bg-white dark:bg-neutral-800 rounded-xs">
                <button type="button"
                        @@click="quantity = Math.max(1, quantity - 1)"
                        class="w-9 h-9 flex items-center justify-center text-base font-semibold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer"
                        aria-label="Decrease quantity">
                    −
                </button>
                <span class="w-10 text-center font-bold text-xs" x-text="quantity"></span>
                <button type="button"
                        @@click="quantity = quantity + 1"
                        class="w-9 h-9 flex items-center justify-center text-base font-semibold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer"
                        aria-label="Increase quantity">
                    +
                </button>
            </div>

            <!-- Add to cart action -->
            <button type="button"
                    @@click="handleConfirmAddToCart()"
                    class="w-full sm:w-auto inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50 disabled:cursor-not-allowed select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] active:scale-[0.98] focus-visible:outline-[var(--color-primary)] hover:shadow-lg hover:shadow-[var(--color-primary)]/20">
                <span>
                    <span x-text="$store.app.language === 'ar' ? 'أضف للطلب' : 'Add to Order'">Add to Order</span> · <span x-text="total.toFixed(2) + ' EGP'"></span>
                </span>
            </button>
        </div>
    </div>
</div>

