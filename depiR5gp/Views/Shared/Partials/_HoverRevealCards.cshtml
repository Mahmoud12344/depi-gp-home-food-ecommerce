@*
  HoverRevealCards Component Partial
  Used in: Views/Home/Index.cshtml
  Displays interactive culinary category cards with a focus/hover-reveal depth effect.
*@

<!-- TODO(backend): Loop through active categories (e.g., Model.Categories); bind CategoryId, CategoryName, ImageUrl, and DishesCount -->
<div role="list"
     aria-label="Handcrafted Dishes By Category"
     class="hover-reveal-group group grid w-full grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">

    <!-- BEGIN SAMPLE -->
    <!-- 1. Traditional Egyptian -->
    <a href="/Dishes?category=egyptian"
       role="listitem"
       aria-label="Traditional Egyptian, 12 Dishes"
       class="hover-reveal-card relative h-80 cursor-pointer overflow-hidden rounded-2xl bg-neutral-900 shadow-xl transition-all duration-500 ease-in-out border border-black/10 dark:border-white/10 block">
        <img src="https://images.unsplash.com/photo-1541832676-9b763b0239ab?w=800&auto=format&fit=crop&q=80"
             alt="Traditional Egyptian Cuisine"
             loading="lazy"
             class="absolute inset-0 w-full h-full object-cover pointer-events-none transition-transform duration-700 ease-out" />
        <div class="absolute inset-0 pointer-events-none"
             style="background: linear-gradient(to top, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.45) 55%, transparent 100%);">
        </div>
        <div class="absolute bottom-0 inset-x-0 p-6 text-white text-start z-10 pointer-events-none flex flex-col justify-end">
            <p class="text-xs font-semibold uppercase tracking-widest text-amber-300 mb-1 drop-shadow-sm">
                12 Dishes
            </p>
            <h3 class="text-xl font-bold uppercase tracking-tight text-white drop-shadow-md leading-tight">
                Traditional Egyptian
            </h3>
        </div>
    </a>

