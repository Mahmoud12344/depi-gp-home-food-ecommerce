<!-- Views/Orders/Partials/_OrderReviewModal.cshtml -->
<!-- Subtasks SCRUM-245 & SCRUM-548: Customer Order Review and Rating Modal -->
<!-- TODO [Backend]: POST /api/reviews with orderId, rating, comment, and tags -->

<div x-show="showReviewModal"
     x-transition.opacity.duration.200ms
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/60 backdrop-blur-xs"
     style="display: none;"
     role="dialog"
     aria-modal="true">

    <div @@click.away="showReviewModal = false"
         x-show="showReviewModal"
         x-transition.scale.origin.center.duration.200ms
         class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl space-y-6">

        <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[var(--color-text)]"
                        x-text="$store.app.language === 'ar' ? 'تقييم الوجبة وتجربة الشيف' : 'Rate Your Dish & Experience'">
                        Rate Your Dish & Experience
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]"
                       x-text="(activeOrder ? activeOrder.dishTitle : '') + ' · #' + (activeOrder ? activeOrder.orderNumber : '')"></p>
                </div>
            </div>
            <button type="button"
                    @@click="showReviewModal = false"
                    class="p-2 rounded-full text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#x"></use></svg>
            </button>
        </div>

        <form @@submit.prevent="
            showReviewModal = false;
            $store.app.addNotification({
                title: $store.app.language === 'ar' ? 'تم استلام تقييمك بنجاح' : 'Review Submitted',
                message: $store.app.language === 'ar' ? 'شكراً لمشاركتك! سيظهر تقييمك في صفحة الشيف بعد التحقق التلقائي.' : 'Thank you! Your verified review has been submitted for moderation.',
                type: 'success'
            });
        " class="space-y-5">

            <!-- Star selector (1 to 5) -->
            <div class="text-center py-2 bg-[var(--color-surface-subtle)] rounded-2xl border border-[var(--color-border-light)] p-4">
                <span class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-2.5"
                      x-text="$store.app.language === 'ar' ? 'اختر تقييمك بالنجوم' : 'Select Star Rating'">Select Star Rating</span>
                <div class="flex items-center justify-center gap-2">
                    <template x-for="star in [1, 2, 3, 4, 5]" :key="star">
                        <button type="button"
                                @@click="reviewRating = star"
                                class="p-1 text-2xl transition-transform hover:scale-125 focus:outline-hidden cursor-pointer"
                                :class="star <= reviewRating ? 'text-[var(--color-star)]' : 'text-neutral-300 dark:text-neutral-700'">
                            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><use href="#star"></use></svg>
                        </button>
                    </template>
                </div>
                <p class="text-xs font-semibold text-[var(--color-primary)] mt-2"
                   x-text="reviewRating === 5 ? ($store.app.language === 'ar' ? 'ممتاز ويفوق التوقعات! 🌟' : 'Exceptional & Exceeded Expectations! 🌟') :
                           reviewRating === 4 ? ($store.app.language === 'ar' ? 'جيد جداً ولذيذ 👍' : 'Very Good & Delicious 👍') :
                           reviewRating === 3 ? ($store.app.language === 'ar' ? 'مقبول / عادي 👌' : 'Average / Acceptable 👌') :
                           reviewRating === 2 ? ($store.app.language === 'ar' ? 'يحتاج إلى تحسين 👎' : 'Needs Improvement 👎') :
                           ($store.app.language === 'ar' ? 'غير راضٍ على الإطلاق ⚠️' : 'Disappointed ⚠️')"></p>
            </div>

            <!-- Review Feedback Textarea -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5"
                       x-text="$store.app.language === 'ar' ? 'تعليقك وتفاصيل الوجبة' : 'Your Detailed Feedback'">
                    Your Detailed Feedback
                </label>
                <textarea rows="3"
                          x-model="reviewComment"
                          required
                          minlength="5"
                          placeholder="Tell other foodies about the taste, seasoning, freshness, packaging, and pickup experience..."
                          class="w-full bg-[var(--color-surface-subtle)] border border-[var(--color-border)] rounded-xl p-3 text-xs text-[var(--color-text)] focus:outline-hidden focus:border-[var(--color-primary)]"></textarea>
                <p class="text-[10px] text-[var(--color-text-muted)] mt-1"
                   x-text="$store.app.language === 'ar' ? 'يساعد تقييمك الأمين الطهاة المنزليين على تطوير وصفاتهم ويفيد مجتمع الأكيلة.' : 'Your honest review helps domestic chefs refine their craft and guides fellow food lovers.'"></p>
            </div>

            <!-- Quick compliments tags -->
            <div>
                <span class="block text-[11px] font-bold text-[var(--color-text-muted)] mb-2"
                      x-text="$store.app.language === 'ar' ? 'أبرز مميزات التجربة:' : 'What stood out most?'">What stood out most?</span>
                <div class="flex flex-wrap gap-1.5">
                    <span class="px-2.5 py-1 rounded-full text-[11px] bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-primary)] cursor-pointer">
                        🍗 Generous Portions
                    </span>
                    <span class="px-2.5 py-1 rounded-full text-[11px] bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-primary)] cursor-pointer">
                        🔥 Hot & Fresh Pickup
                    </span>
                    <span class="px-2.5 py-1 rounded-full text-[11px] bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-primary)] cursor-pointer">
                        🌿 Authentic Baladi Spices
                    </span>
                    <span class="px-2.5 py-1 rounded-full text-[11px] bg-[var(--color-surface-subtle)] border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-primary)] cursor-pointer">
                        ✨ Clean Packaging
                    </span>
                </div>
            </div>

            <!-- Anonymous Review Checkbox -->
            <label class="flex items-center gap-2 cursor-pointer text-xs text-[var(--color-text)]">
                <input type="checkbox" x-model="reviewAnonymous" class="rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]">
                <span x-text="$store.app.language === 'ar' ? 'نشر التقييم باسم مستعار (إخفاء اسمي الحقيقي)' : 'Publish review anonymously (hide my full name)'">Publish review anonymously (hide my full name)</span>
            </label>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-[var(--color-border-light)]">
                <button type="button"
                        @@click="showReviewModal = false"
                        class="px-4 py-2.5 rounded-full border border-[var(--color-border)] hover:bg-neutral-100 dark:hover:bg-neutral-800 text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer text-[var(--color-text)]"
                        x-text="$store.app.language === 'ar' ? 'إلغاء' : 'Cancel'">
                    Cancel
                </button>
                <button type="submit"
                        class="px-5 py-2.5 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white text-xs font-bold uppercase tracking-wider transition-colors cursor-pointer shadow-sm"
                        x-text="$store.app.language === 'ar' ? 'إرسال التقييم' : 'Submit Review'">
                    Submit Review
                </button>
            </div>
        </form>
    </div>
</div>

