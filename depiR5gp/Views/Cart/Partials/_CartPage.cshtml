<!-- Views/Cart/Partials/_CartPage.cshtml -->
<!-- Source: home_chef/src/pages/CartPage.tsx -->
<!-- TODO [Backend]: Sync cart with server-side session or customer order draft -->

<div class="w-full pb-24">
    <!-- Breadcrumb banner -->
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="#home" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#home"></use></svg>
                    <span x-text="$store.app.language === 'ar' ? 'الرئيسية' : 'Home'">Home</span>
                </a>
                <svg class="w-4 h-4 text-neutral-400 shrink-0" :class="$store.app.language === 'ar' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chevron-right"></use></svg>
                <span class="text-[var(--color-text)] font-semibold" x-text="$store.app.language === 'ar' ? 'سلة التسوق' : 'Cart'">Cart</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]"
                x-text="$store.app.language === 'ar' ? 'سلة التسوق' : 'Your Shopping Cart'">
                Your Shopping Cart
            </h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 leading-relaxed"
               x-text="$store.app.cart.chefName ? ($store.app.language === 'ar' ? ('الطلب مخصص من مطبخ: ' + $store.app.cart.chefName) : ('Order from kitchen: ' + $store.app.cart.chefName)) : ''">
            </p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
        <!-- Empty State -->
        <div x-show="$store.app.cart.items.length === 0"
             class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-12 text-center space-y-4 max-w-lg mx-auto shadow-sm">
            <div class="w-16 h-16 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center mx-auto">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#shopping-bag"></use></svg>
            </div>
            <h2 class="text-xl font-bold uppercase tracking-tight text-[var(--color-text)]"
                x-text="$store.app.language === 'ar' ? 'سلة التسوق فارغة حالياً' : 'Your Shopping Cart Is Empty'">
                Your Shopping Cart Is Empty
            </h2>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed"
               x-text="$store.app.language === 'ar' ? 'استكشف أشهى الأطباق المنزلية الطازجة من طهاة حيك وأضف وجبتك المفضلة.' : 'Explore freshly baked and slow-simmered meals cooked with real country butter in verified local kitchens.'">
                Explore freshly baked and slow-simmered meals cooked with real country butter in verified local kitchens.
            </p>
            <a href="#dishes"
               class="inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] active:scale-[0.98]">
                <span x-text="$store.app.language === 'ar' ? 'تصفح أطباق اليوم' : 'Browse Fresh Dishes'">Browse Fresh Dishes</span>
                <svg class="w-4 h-4" :class="$store.app.language === 'ar' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#arrow-right"></use></svg>
            </a>
        </div>

        <!-- Populated Cart Content -->
        <div x-show="$store.app.cart.items.length > 0" class="space-y-8">
            <!-- Single-Chef Notice -->
            <div class="p-4 bg-[var(--color-primary-light)] text-[var(--color-primary)] rounded-2xl border border-[var(--color-primary)]/20 flex items-center justify-between text-xs">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#chef-hat"></use></svg>
                    <span x-text="$store.app.language === 'ar'
                        ? ('أنت تطلب حالياً من: (' + ($store.app.cart.chefName || '') + ') · استلام مباشر من باب المطبخ')
                        : ('Currently ordering from: ' + ($store.app.cart.chefName || '') + ' · Direct kitchen counter pickup')">
                    </span>
                </div>
                <button type="button"
                        @@click="$store.app.clearCart()"
                        class="text-xs font-semibold underline hover:opacity-80 cursor-pointer shrink-0"
                        x-text="$store.app.language === 'ar' ? 'إفراغ السلة' : 'Clear Cart'">
                    Clear Cart
                </button>
            </div>

            <!-- Cart Table -->
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-xs">
                <div class="hidden sm:grid grid-cols-12 gap-4 p-5 text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] border-b border-[var(--color-border)]">
                    <div class="col-span-6" x-text="$store.app.language === 'ar' ? 'الوجبة' : 'Product'">Product</div>
                    <div class="col-span-3 text-center" x-text="$store.app.language === 'ar' ? 'الكمية' : 'Quantity'">Quantity</div>
                    <div class="col-span-3 text-end" x-text="$store.app.language === 'ar' ? 'الإجمالي' : 'Total'">Total</div>
                </div>

                <!-- TODO [Backend]: Iterate through Cart.Items; bind DishId, Name, Price, SelectedOptions, InstructionsNote, Quantity, and LineTotal -->
                <div class="divide-y divide-[var(--color-border-light)]">
                    <template x-for="item in $store.app.cart.items" :key="item.id">
                        <div class="p-5 flex flex-col sm:grid sm:grid-cols-12 gap-4 items-center">
                            <!-- Product Column -->
                            <div class="sm:col-span-6 flex items-start gap-4 w-full">
                                <img src="https://images.unsplash.com/photo-1547928576-a4a33237cbc3?w=600&auto=format&fit=crop&q=80"
                                     :alt="item.dish?.name || 'Dish'"
                                     class="w-20 h-20 rounded-xl object-cover shrink-0 border border-[var(--color-border)]" />
                                <div class="space-y-1 min-w-0">
                                    <h3 class="text-sm font-bold uppercase tracking-tight text-[var(--color-text)]"
                                        x-text="$store.app.language === 'ar' ? (item.dish?.nameAr || item.dish?.name || 'وجبة') : (item.dish?.name || 'Dish')">
                                    </h3>
                                    <p class="text-xs font-semibold text-[var(--color-primary)]"
                                       x-text="(item.unitPrice || 0).toFixed(2) + ' EGP'">
                                    </p>
                                    <template x-if="item.selectedOptions && item.selectedOptions.length > 0">
                                        <div class="text-[11px] text-[var(--color-text-muted)] space-y-0.5 pt-0.5">
                                            <template x-for="(opt, idx) in item.selectedOptions" :key="idx">
                                                <p>
                                                    <span class="font-medium text-[var(--color-text)]" x-text="opt.groupName + ':'"></span> <span x-text="opt.valueName"></span>
                                                </p>
                                            </template>
                                        </div>
                                    </template>
                                    <template x-if="item.note">
                                        <p class="text-[11px] text-[var(--color-text-muted)] italic pt-0.5" x-text="'“' + item.note + '”'"></p>
                                    </template>
                                </div>
                            </div>

                            <!-- Quantity Stepper Column -->
                            <div class="sm:col-span-3 flex items-center justify-center gap-2 w-full sm:w-auto">
                                <div class="flex items-center border border-[var(--color-border)] rounded-full bg-white dark:bg-neutral-800 p-1">
                                    <button type="button"
                                            @@click="$store.app.updateCartQty(item.id, item.quantity - 1)"
                                            class="w-7 h-7 rounded-full flex items-center justify-center font-bold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer">−</button>
                                    <span class="w-8 text-center text-xs font-bold" x-text="item.quantity"></span>
                                    <button type="button"
                                            @@click="$store.app.updateCartQty(item.id, item.quantity + 1)"
                                            class="w-7 h-7 rounded-full flex items-center justify-center font-bold hover:bg-[var(--color-surface-subtle)] transition-colors cursor-pointer">+</button>
                                </div>
                                <button type="button"
                                        @@click="$store.app.removeCartItem(item.id)"
                                        class="p-2 text-neutral-400 hover:text-rose-600 transition-colors cursor-pointer"
                                        title="Remove item">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#trash-2"></use></svg>
                                </button>
                            </div>

                            <!-- Line Total Column -->
                            <div class="sm:col-span-3 sm:text-end w-full sm:w-auto text-end">
                                <span class="text-base font-bold text-[var(--color-text)]"
                                      x-text="(item.lineTotal || 0).toFixed(2) + ' EGP'">
                                </span>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Bottom Summary Panel -->
            <!-- TODO [Backend]: Bind Cart.Subtotal, DeliveryFee (0.00 EGP for pickup), EstimatedTaxes, and GrandTotal from Cart session/entity -->
            <div class="flex flex-col sm:flex-row justify-end items-end gap-6 pt-4">
                <div class="w-full sm:w-80 space-y-4 text-end">
                    <div class="space-y-1">
                        <div class="flex items-baseline justify-between text-sm">
                            <span class="text-[var(--color-text-muted)] font-semibold uppercase"
                                  x-text="$store.app.language === 'ar' ? 'المجموع الفرعي:' : 'Subtotal:'">Subtotal:</span>
                            <span class="text-2xl font-bold text-[var(--color-primary)]"
                                  x-text="($store.app.cart.subtotal || 0).toFixed(2) + ' EGP'"></span>
                        </div>
                        <p class="text-[11px] text-[var(--color-text-muted)]"
                           x-text="$store.app.language === 'ar' ? 'الاستلام مباشر من المطبخ. تطبق خصومات نقاط الولاء عند إتمام الطلب.' : 'Pickup directly at kitchen counter. Loyalty points discount applied at checkout.'">
                            Pickup directly at kitchen counter. Loyalty points discount applied at checkout.
                        </p>
                    </div>

                    <button type="button"
                            @@click="if ($store.app.role === 'guest') { $store.app.loginModalOpen = true; } else { $store.app.navigate('#checkout'); }"
                            class="w-full inline-flex items-center justify-center font-medium uppercase tracking-wider transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 select-none cursor-pointer rounded-full text-sm md:text-base px-8 py-3.5 gap-2.5 shadow-md bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)] active:scale-[0.98]">
                        <span x-text="$store.app.language === 'ar' ? 'متابعة الدفع والاستلام' : 'Check Out'">Check Out</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

