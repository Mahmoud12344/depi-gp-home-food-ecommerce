@model depiR5gp.ViewModels.CartPageVM
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="w-full pb-24">
    <div class="relative w-full bg-[var(--color-surface-subtle)] border-b border-[var(--color-border)] py-6 md:py-8 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <nav aria-label="Breadcrumb" class="flex items-center text-[13px] text-[var(--color-text-muted)] gap-2 flex-wrap mb-2">
                <a href="/" class="hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5 cursor-pointer font-medium"><span>Home</span></a>
                <span>›</span>
                <span class="text-[var(--color-text)] font-semibold">Cart</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-[var(--color-text)]">Your Shopping Cart</h1>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1.5 leading-relaxed">Your selected dishes</p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
        @if (Model.Items.Count == 0)
        {
            <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl p-12 text-center space-y-4 max-w-lg mx-auto shadow-sm">
                <div class="w-16 h-16 rounded-full bg-[var(--color-primary-light)] text-[var(--color-primary)] flex items-center justify-center mx-auto">🛍</div>
                <h2 class="text-xl font-bold uppercase tracking-tight text-[var(--color-text)]">Your Shopping Cart Is Empty</h2>
                <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">Explore freshly prepared meals from verified local kitchens.</p>
                <a href="/Dishes" class="inline-flex items-center justify-center font-medium uppercase tracking-wider rounded-full text-xs md:text-sm px-6 py-2.5 gap-2 shadow-xs bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-hover)]">Browse Fresh Dishes</a>
            </div>
        }
        else
        {
        <div class="space-y-6">
                <div class="p-4 bg-[var(--color-primary-light)] text-[var(--color-primary)] rounded-2xl border border-[var(--color-primary)]/20 flex items-center justify-between gap-3 text-xs">
                    <form method="post" action="/Cart/Clear" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="text-xs font-semibold underline hover:opacity-80 cursor-pointer">Clear Cart</button>
                    </form>
                </div>

                <div class="bg-[var(--color-card-bg)] border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-xs">
                    <div class="hidden sm:grid grid-cols-12 gap-4 p-5 text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] border-b border-[var(--color-border)]">
                        <div class="col-span-6">Product</div><div class="col-span-3 text-center">Quantity</div><div class="col-span-3 text-end">Total</div>
                    </div>
                    <div class="divide-y divide-[var(--color-border-light)]">
                        @foreach (var item in Model.Items)
                        {
                            <div class="p-5 flex flex-col sm:grid sm:grid-cols-12 gap-4 items-center">
                                <div class="sm:col-span-6 flex items-start gap-4 w-full">
                                    <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/icons/chibi-chef.png" : item.ImageUrl)" alt="@item.Name" class="w-20 h-20 rounded-xl object-cover shrink-0 border border-[var(--color-border)]" />
                                    <div class="space-y-1 min-w-0">
                                        <h3 class="text-sm font-bold uppercase tracking-tight text-[var(--color-text)]">@item.Name</h3>
                                        <p class="text-xs font-semibold text-[var(--color-primary)]">@item.UnitPrice.ToString("N2") EGP</p>
                                        @if (!string.IsNullOrWhiteSpace(item.PresetKey)) { <p class="text-[11px] text-[var(--color-text-muted)]">Customized dish</p> }
                                        @if (!string.IsNullOrWhiteSpace(item.Note)) { <p class="text-[11px] text-[var(--color-text-muted)] italic">“@item.Note”</p> }
                                        @if (!item.IsAvailable) { <p class="text-[11px] font-semibold text-rose-600">Currently unavailable</p> }
                                    </div>
                                </div>
                                <div class="sm:col-span-3 flex items-center justify-center gap-2 w-full sm:w-auto">
                                     <form method="post" action="/Cart/UpdateQuantity" class="flex items-center border border-[var(--color-border)] rounded-full bg-white dark:bg-neutral-800 p-1" data-cart-quantity-form>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                         <button type="button" data-quantity-step="-1" class="px-2 text-xs font-semibold cursor-pointer" aria-label="Decrease quantity">−</button>
                                         <input type="number" name="quantity" value="@item.Quantity" min="1" max="100" class="w-12 text-center text-xs font-bold bg-transparent border-0" aria-label="Quantity" readonly />
                                         <button type="button" data-quantity-step="1" class="px-2 text-xs font-semibold cursor-pointer" aria-label="Increase quantity">+</button>
                                    </form>
                                    <form method="post" action="/Cart/Remove">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <button type="submit" class="p-2 text-neutral-400 hover:text-rose-600 transition-colors cursor-pointer" title="Remove item">×</button>
                                    </form>
                                </div>
                                 <div class="sm:col-span-3 sm:text-end w-full sm:w-auto text-end"><span data-cart-line-total="@item.Id" class="text-base font-bold text-[var(--color-text)]">@item.LineTotal.ToString("N2") EGP</span></div>
                            </div>
                        }
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row justify-end items-end gap-6 pt-4">
                    <div class="w-full sm:w-80 space-y-4 text-end">
                         <div class="flex items-baseline justify-between text-sm"><span class="text-[var(--color-text-muted)] font-semibold uppercase">Subtotal:</span><span data-cart-subtotal class="text-2xl font-bold text-[var(--color-primary)]">@Model.Subtotal.ToString("N2") EGP</span></div>
                        <p class="text-[11px] text-[var(--color-text-muted)]">Pickup directly at kitchen counter.</p>
                        <a href="/Checkout" class="w-full inline-flex items-center justify-center font-medium uppercase tracking-wider rounded-full text-sm md:text-base px-8 py-3.5 gap-2.5 shadow-md text-white bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)]">Check Out</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>